tests:it("rawset value behavior matches between paths", function()
    local t1 = {}
    local t2 = {}
    tests:assert_equal(fast_rawset(t1, "k", "v"), t1, "fast rawset must return its table")
    tests:assert_equal(s.rawset(t2, "k", "v"), t2, "slow rawset must return its table")
    fast_rawset(t1, 2.0, "two")
    s.rawset(t2, 2.0, "two")
    tests:assert_equal(t1[2], "two", "fast rawset must normalize integral float keys")
    tests:assert_equal(t2[2], "two", "slow rawset must normalize integral float keys")
    fast_rawset(t1, 1.5, "frac")
    s.rawset(t2, 1.5, "frac")
    tests:assert_equal(t1[1.5], t2[1.5])
    fast_rawset(t1, "k", nil)
    s.rawset(t2, "k", nil)
    tests:assert_equal(t1.k, nil)
    tests:assert_equal(t2.k, nil)
end)


tests:it("method-call syntax matches the fast-form results", function()
    local str = "Hello"
    tests:assert_equal(str:sub(2, 4), fast_sub(str, 2, 4))
    tests:assert_equal(str:len(), fast_len(str))
    tests:assert_equal(str:byte(2), fast_byte(str, 2))
    tests:assert_equal(str:upper(), fast_upper(str))
    tests:assert_equal(str:reverse(), fast_reverse(str))
end)


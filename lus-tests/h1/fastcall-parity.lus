-- Fastcall parity suite.
-- Every builtin registered in the fastcall table must behave identically
-- whether a call site compiles to OP_FASTCALL (a direct global call with the
-- registered argument count) or to a plain OP_CALL through a local alias.
-- This file drives both forms over a shared corpus of adversarial inputs and
-- asserts identical results, identical result subtypes, and identical error
-- reasons. It also pins the qualified-versus-plain error-name behavior of
-- fastcall fallbacks so future changes to name derivation are deliberate.
-- Emission is proven with framework.get_fastcalls so the fast form really is
-- fast and the alias form really is not.

global print, require, string, math, table, utf8, vector, type, tostring, tonumber, rawlen, rawget, rawset, rawequal, setmetatable, getmetatable, assert, select, pledge, next, pairs, ipairs, coroutine, error, os, time, _G

pledge("load", "fs:read=./lus-tests/*", "env=ASAN_OPTIONS", "seal")

local framework = require("lus-tests.framework")
local tests = framework.new("fastcall-parity")
local FC = framework.FC

local nan = 0 / 0
local inf = math.huge

-- Shared junk values so error messages are identical across the two calls.
local EMPTY_T = {}
local SHARED_T = {}
local VEC = vector.create(4)
local color = enum RED, GREEN, BLUE end

-- ==== Fast-form helpers ====
-- Each helper contains exactly one direct global call with the registered
-- fastcall argument count, so the call inside compiles to OP_FASTCALL.

local function fast_type(a) return type(a) end
local function fast_rawlen(a) return rawlen(a) end
local function fast_rawget(a, b) return rawget(a, b) end
local function fast_rawset(a, b, c) return rawset(a, b, c) end
local function fast_rawequal(a, b) return rawequal(a, b) end
local function fast_assert(a) return assert(a) end
local function fast_getmetatable(a) return getmetatable(a) end
local function fast_setmetatable(a, b) return setmetatable(a, b) end
local function fast_tonumber(a) return tonumber(a) end
local function fast_tostring(a) return tostring(a) end

local function fast_abs(a) return math.abs(a) end
local function fast_max(a, b) return math.max(a, b) end
local function fast_min(a, b) return math.min(a, b) end
local function fast_ceil(a) return math.ceil(a) end
local function fast_floor(a) return math.floor(a) end
local function fast_sqrt(a) return math.sqrt(a) end
local function fast_sin(a) return math.sin(a) end
local function fast_cos(a) return math.cos(a) end
local function fast_tan(a) return math.tan(a) end
local function fast_asin(a) return math.asin(a) end
local function fast_acos(a) return math.acos(a) end
local function fast_atan(a) return math.atan(a) end
local function fast_exp(a) return math.exp(a) end
local function fast_log(a) return math.log(a) end
local function fast_deg(a) return math.deg(a) end
local function fast_rad(a) return math.rad(a) end
local function fast_fmod(a, b) return math.fmod(a, b) end
local function fast_ult(a, b) return math.ult(a, b) end
local function fast_tointeger(a) return math.tointeger(a) end
local function fast_mathtype(a) return math.type(a) end
local function fast_ldexp(a, b) return math.ldexp(a, b) end

local function fast_len(a) return string.len(a) end
local function fast_trim(a) return string.trim(a) end
local function fast_ltrim(a) return string.ltrim(a) end
local function fast_rtrim(a) return string.rtrim(a) end
local function fast_split(a, b) return string.split(a, b) end
local function fast_join(a, b) return string.join(a, b) end
local function fast_sub(a, b, c) return string.sub(a, b, c) end
local function fast_byte(a, b) return string.byte(a, b) end
local function fast_char(a) return string.char(a) end
local function fast_lower(a) return string.lower(a) end
local function fast_upper(a) return string.upper(a) end
local function fast_reverse(a) return string.reverse(a) end

local function fast_sum(a) return table.sum(a) end
local function fast_mean(a) return table.mean(a) end
local function fast_median(a) return table.median(a) end
local function fast_stdev(a) return table.stdev(a) end
local function fast_transpose(a) return table.transpose(a) end
local function fast_reshape(a, b, c) return table.reshape(a, b, c) end

local function fast_vcreate(a) return vector.create(a) end
local function fast_vclone(a) return vector.clone(a) end
local function fast_vsize(a) return vector.size(a) end
local function fast_vresize(a, b) return vector.resize(a, b) end

local function fast_ulen(a) return utf8.len(a) end
local function fast_ucodepoint(a) return utf8.codepoint(a) end
local function fast_uchar(a) return utf8.char(a) end
local function fast_uoffset(a, b) return utf8.offset(a, b) end

local function fast_tdays(a) return time.days(a) end
local function fast_thours(a) return time.hours(a) end
local function fast_tminutes(a) return time.minutes(a) end
local function fast_tseconds(a) return time.seconds(a) end
local function fast_tmillis(a) return time.millis(a) end
local function fast_tinstant(a) return time.instant(a) end

-- ==== Slow aliases ====
-- Calling through a table field on a local can never compile to OP_FASTCALL,
-- so these bindings force the plain C dispatch path.

local s = {
    type = type, rawlen = rawlen, rawget = rawget, rawset = rawset,
    rawequal = rawequal, assert = assert, getmetatable = getmetatable,
    setmetatable = setmetatable, tonumber = tonumber, tostring = tostring,
    abs = math.abs, max = math.max, min = math.min, ceil = math.ceil,
    floor = math.floor, sqrt = math.sqrt, sin = math.sin, cos = math.cos,
    tan = math.tan, asin = math.asin, acos = math.acos, atan = math.atan,
    exp = math.exp, log = math.log, deg = math.deg, rad = math.rad,
    fmod = math.fmod, ult = math.ult, tointeger = math.tointeger,
    mathtype = math.type, ldexp = math.ldexp,
    len = string.len, trim = string.trim, ltrim = string.ltrim,
    rtrim = string.rtrim, split = string.split, join = string.join,
    sub = string.sub, byte = string.byte, char = string.char,
    lower = string.lower, upper = string.upper, reverse = string.reverse,
    sum = table.sum, mean = table.mean, median = table.median,
    stdev = table.stdev, transpose = table.transpose, reshape = table.reshape,
    vcreate = vector.create, vclone = vector.clone, vsize = vector.size,
    vresize = vector.resize,
    ulen = utf8.len, ucodepoint = utf8.codepoint, uchar = utf8.char,
    uoffset = utf8.offset,
    tdays = time.days, thours = time.hours, tminutes = time.minutes,
    tseconds = time.seconds, tmillis = time.millis, tinstant = time.instant,
}

-- Alias wrappers used for the multi-return comparison. They mirror the shape
-- of the fast helpers exactly, but the callee is an alias.
local function slow_uoffset_wrap(a, b) return s.uoffset(a, b) end
local function slow_ulen_wrap(a) return s.ulen(a) end

-- ==== Comparison machinery ====

-- Structural equality that also distinguishes number subtypes, treats two
-- NaNs as equal, and separates -0.0 from 0.0 through tostring.
local function deep_same(a, b)
    if type(a) ~= type(b) then
        return false
    end
    if type(a) == "number" then
        if a ~= a and b ~= b then
            return true
        end
        if math.type(a) ~= math.type(b) then
            return false
        end
        return a == b and tostring(a) == tostring(b)
    end
    if type(a) ~= "table" then
        return a == b
    end
    if a == b then
        return true
    end
    local extra = 0
    for k, v in pairs(a) do
        extra = extra + 1
        if not deep_same(v, b[k]) then
            return false
        end
    end
    for _ in pairs(b) do
        extra = extra - 1
    end
    return extra == 0
end

-- Normalizes an error value down to its comparable core. The location prefix
-- and the function name inside an argument error depend on the call site by
-- design, so both are removed before comparison.
local function err_core(e)
    local line = string.match(tostring(e), "([^\n]*)") or ""
    local stripped = string.match(line, "^.-:%d+: (.*)$") or line
    local prefix, reason = string.match(stripped, "^(bad%s.-argument%s#%-?%d+)%s+to%s+'[^']*'%s+(%(.*%))$")
    if prefix then
        return prefix .. " " .. reason
    end
    return stripped
end

-- Calls f with the exact case argument count and captures the first result
-- in a single-value context, where the VM pads missing results with nil.
-- The wrapper always returns exactly two values so that catch never has to
-- pad, which sidesteps the zero-result catch bug covered by a soft test
-- below.
local function call_one(f, nargs, case)
    local r
    if nargs == 1 then
        r = f(case[2])
    elseif nargs == 2 then
        r = f(case[2], case[3])
    else
        r = f(case[2], case[3], case[4])
    end
    return true, r
end

-- Runs one corpus case through the fast form and the alias form, asserting
-- identical outcome, identical first result, and identical error core.
local function run_pair(fastf, slowf, nargs, case, name)
    local label = name .. " [" .. tostring(case[1]) .. "]"
    -- On success catch yields (true, true, result) because call_one always
    -- returns two values. On failure it yields (false, error) and the third
    -- receiver is never read.
    local okf, ef, rf = catch call_one(fastf, nargs, case)
    local oks, es, rs = catch call_one(slowf, nargs, case)
    if not okf then
        rf = ef
    end
    if not oks then
        rs = es
    end
    if okf ~= oks then
        error(label .. ": fast ok=" .. tostring(okf) .. " slow ok=" .. tostring(oks)
            .. " fast result=" .. tostring(rf) .. " slow result=" .. tostring(rs))
    end
    if okf then
        if not deep_same(rf, rs) then
            error(label .. ": fast=" .. tostring(rf) .. " (" .. tostring(math.type(rf))
                .. ") slow=" .. tostring(rs) .. " (" .. tostring(math.type(rs)) .. ")")
        end
    else
        local cf = err_core(rf)
        local cs = err_core(rs)
        if cf ~= cs then
            error(label .. ": fast error [" .. cf .. "] slow error [" .. cs .. "]")
        end
    end
end

local function parity_over(fastf, slowf, nargs, corpus, name)
    for _, case in ipairs(corpus) do
        run_pair(fastf, slowf, nargs, case, name)
    end
end

-- ==== Emission proofs ====
tests:describe("emission proofs")

local emission_list = {
    {"type", fast_type, FC.TYPE},
    {"rawlen", fast_rawlen, FC.RAWLEN},
    {"rawget", fast_rawget, FC.RAWGET},
    {"rawset", fast_rawset, FC.RAWSET},
    {"rawequal", fast_rawequal, FC.RAWEQUAL},
    {"assert", fast_assert, FC.ASSERT},
    {"getmetatable", fast_getmetatable, FC.GETMETATABLE},
    {"setmetatable", fast_setmetatable, FC.SETMETATABLE},
    {"tonumber", fast_tonumber, FC.TONUMBER},
    {"tostring", fast_tostring, FC.TOSTRING},
    {"math.abs", fast_abs, FC.MATH_ABS},
    {"math.max", fast_max, FC.MATH_MAX},
    {"math.min", fast_min, FC.MATH_MIN},
    {"math.ceil", fast_ceil, FC.MATH_CEIL},
    {"math.floor", fast_floor, FC.MATH_FLOOR},
    {"math.sqrt", fast_sqrt, FC.MATH_SQRT},
    {"math.sin", fast_sin, FC.MATH_SIN},
    {"math.cos", fast_cos, FC.MATH_COS},
    {"math.tan", fast_tan, FC.MATH_TAN},
    {"math.asin", fast_asin, FC.MATH_ASIN},
    {"math.acos", fast_acos, FC.MATH_ACOS},
    {"math.atan", fast_atan, FC.MATH_ATAN},
    {"math.exp", fast_exp, FC.MATH_EXP},
    {"math.log", fast_log, FC.MATH_LOG},
    {"math.deg", fast_deg, FC.MATH_DEG},
    {"math.rad", fast_rad, FC.MATH_RAD},
    {"math.fmod", fast_fmod, FC.MATH_FMOD},
    {"math.ult", fast_ult, FC.MATH_ULT},
    {"math.tointeger", fast_tointeger, FC.MATH_TOINTEGER},
    {"math.type", fast_mathtype, FC.MATH_TYPE},
    {"math.ldexp", fast_ldexp, FC.MATH_LDEXP},
    {"string.len", fast_len, FC.STRING_LEN},
    {"string.trim", fast_trim, FC.STRING_TRIM},
    {"string.ltrim", fast_ltrim, FC.STRING_LTRIM},
    {"string.rtrim", fast_rtrim, FC.STRING_RTRIM},
    {"string.split", fast_split, FC.STRING_SPLIT},
    {"string.join", fast_join, FC.STRING_JOIN},
    {"string.sub", fast_sub, FC.STRING_SUB},
    {"string.byte", fast_byte, FC.STRING_BYTE},
    {"string.char", fast_char, FC.STRING_CHAR},
    {"string.lower", fast_lower, FC.STRING_LOWER},
    {"string.upper", fast_upper, FC.STRING_UPPER},
    {"string.reverse", fast_reverse, FC.STRING_REVERSE},
    {"table.sum", fast_sum, FC.TABLE_SUM},
    {"table.mean", fast_mean, FC.TABLE_MEAN},
    {"table.median", fast_median, FC.TABLE_MEDIAN},
    {"table.stdev", fast_stdev, FC.TABLE_STDEV},
    {"table.transpose", fast_transpose, FC.TABLE_TRANSPOSE},
    {"table.reshape", fast_reshape, FC.TABLE_RESHAPE},
    {"vector.create", fast_vcreate, FC.VECTOR_CREATE},
    {"vector.clone", fast_vclone, FC.VECTOR_CLONE},
    {"vector.size", fast_vsize, FC.VECTOR_SIZE},
    {"vector.resize", fast_vresize, FC.VECTOR_RESIZE},
    {"utf8.len", fast_ulen, FC.UTF8_LEN},
    {"utf8.codepoint", fast_ucodepoint, FC.UTF8_CODEPOINT},
    {"utf8.char", fast_uchar, FC.UTF8_CHAR},
    {"utf8.offset", fast_uoffset, FC.UTF8_OFFSET},
    {"time.days", fast_tdays, FC.TIME_DAYS},
    {"time.hours", fast_thours, FC.TIME_HOURS},
    {"time.minutes", fast_tminutes, FC.TIME_MINUTES},
    {"time.seconds", fast_tseconds, FC.TIME_SECONDS},
    {"time.millis", fast_tmillis, FC.TIME_MILLIS},
    {"time.instant", fast_tinstant, FC.TIME_INSTANT},
}

tests:it("every fast-form helper compiles to OP_FASTCALL", function()
    for _, e in ipairs(emission_list) do
        tests:assert_fastcall(e[2], e[3], "helper for " .. e[1] .. " did not emit OP_FASTCALL")
    end
end)

tests:it("alias-form call sites emit no OP_FASTCALL at all", function()
    local function alias_probe(a, b, c)
        local r = s.abs(a)
        r = s.max(a, b)
        r = s.sub(a, b, c)
        r = s.type(a)
        r = s.sum(a)
        r = s.uoffset(a, b)
        r = s.vcreate(a)
        return r
    end
    local fcs = framework.get_fastcalls(alias_probe)
    tests:assert_true(next(fcs) == nil, "alias probe unexpectedly contains OP_FASTCALL")
    local fcs2 = framework.get_fastcalls(slow_uoffset_wrap)
    tests:assert_true(next(fcs2) == nil, "slow utf8.offset wrapper unexpectedly contains OP_FASTCALL")
end)

tests:it("_G-indexed and method-call forms emit no OP_FASTCALL", function()
    local function g_probe() return _G.type(42) end
    tests:assert_no_fastcall(g_probe, FC.TYPE)
    local function m_probe(str) return str:sub(2, 4) end
    tests:assert_no_fastcall(m_probe, FC.STRING_SUB)
end)

-- ==== Math unary parity ====
tests:describe("math unary parity")

local unary_math = {
    {"int zero", 0},
    {"neg zero float", -0.0},
    {"one", 1},
    {"neg int", -7},
    {"float", 2.5},
    {"neg float", -2.5},
    {"tiny", 1e-300},
    {"nan", nan},
    {"inf", inf},
    {"neg inf", -inf},
    {"maxinteger", math.maxinteger},
    {"mininteger", math.mininteger},
    {"big float", 1e308},
    {"2^53", 2.0 ^ 53},
    {"2^63 float", 2.0 ^ 63},
    {"numeric string", "12"},
    {"junk string", "x"},
    {"boolean", true},
    {"nil", nil},
    {"table", EMPTY_T},
}

tests:it("math.abs parity over the numeric corpus", function()
    parity_over(fast_abs, s.abs, 1, unary_math, "abs")
end)

tests:it("math.ceil parity over the numeric corpus", function()
    parity_over(fast_ceil, s.ceil, 1, unary_math, "ceil")
end)

tests:it("math.floor parity over the numeric corpus", function()
    parity_over(fast_floor, s.floor, 1, unary_math, "floor")
end)

tests:it("math.sqrt parity over the numeric corpus", function()
    parity_over(fast_sqrt, s.sqrt, 1, unary_math, "sqrt")
end)

tests:it("math.exp parity over the numeric corpus", function()
    parity_over(fast_exp, s.exp, 1, unary_math, "exp")
end)

tests:it("math.log parity over the numeric corpus", function()
    parity_over(fast_log, s.log, 1, unary_math, "log")
end)

tests:it("math.deg parity over the numeric corpus", function()
    parity_over(fast_deg, s.deg, 1, unary_math, "deg")
end)

tests:it("math.rad parity over the numeric corpus", function()
    parity_over(fast_rad, s.rad, 1, unary_math, "rad")
end)

tests:it("trig function parity over the numeric corpus", function()
    local pairs_list = {
        {fast_sin, s.sin, "sin"},
        {fast_cos, s.cos, "cos"},
        {fast_tan, s.tan, "tan"},
        {fast_asin, s.asin, "asin"},
        {fast_acos, s.acos, "acos"},
        {fast_atan, s.atan, "atan"},
    }
    for _, p in ipairs(pairs_list) do
        parity_over(p[1], p[2], 1, unary_math, p[3])
    end
end)

tests:it("math.tointeger parity over the numeric corpus", function()
    -- The numeric-string case lives in a dedicated soft test below.
    local corpus = {
        {"int", 5}, {"float integral", 5.0}, {"float frac", 5.5},
        {"neg zero", -0.0}, {"nan", nan}, {"inf", inf},
        {"maxinteger", math.maxinteger}, {"mininteger", math.mininteger},
        {"2^63 float", 2.0 ^ 63}, {"junk string", "x"}, {"boolean", true},
        {"nil", nil}, {"table", EMPTY_T},
    }
    parity_over(fast_tointeger, s.tointeger, 1, corpus, "tointeger")
end)

tests:it("math.type parity over the numeric corpus", function()
    local corpus = {
        {"int", 5}, {"float", 5.5}, {"nan", nan}, {"inf", inf},
        {"maxinteger", math.maxinteger}, {"numeric string", "12"},
        {"junk string", "x"}, {"boolean", true}, {"nil", nil},
        {"table", EMPTY_T}, {"enum", color.RED},
    }
    parity_over(fast_mathtype, s.mathtype, 1, corpus, "math.type")
end)

-- ==== Math binary parity ====
tests:describe("math binary parity")

tests:it("math.max parity over safe pairs", function()
    -- NaN operands, mixed-subtype winners, and signed-zero ties are known
    -- divergences covered by the soft tests below.
    local corpus = {
        {"int pair", 1, 2},
        {"int swapped", 9, -3},
        {"equal ints", 4, 4},
        {"extremes", math.mininteger, math.maxinteger},
        {"float pair", 1.5, 2.5},
        {"float negatives", -1.5, -2.5},
        {"equal floats", 3.5, 3.5},
        {"inf pair", inf, -inf},
        {"float winner", 1, 2.5},
        {"string arg", "8", 3},
        {"boolean", true, 1},
        {"nil second", 5, nil},
    }
    parity_over(fast_max, s.max, 2, corpus, "max")
end)

tests:it("math.min parity over safe pairs", function()
    local corpus = {
        {"int pair", 1, 2},
        {"int swapped", 9, -3},
        {"equal ints", 4, 4},
        {"extremes", math.mininteger, math.maxinteger},
        {"float pair", 1.5, 2.5},
        {"float negatives", -1.5, -2.5},
        {"equal floats", 3.5, 3.5},
        {"inf pair", inf, -inf},
        {"float winner", 3, 2.5},
        {"string arg", "8", 3},
        {"boolean", true, 1},
        {"nil second", 5, nil},
    }
    parity_over(fast_min, s.min, 2, corpus, "min")
end)

tests:it("math.fmod parity over pairs", function()
    local corpus = {
        {"int basic", 7, 3},
        {"neg dividend", -7, 3},
        {"neg divisor", 7, -3},
        {"both neg", -7, -3},
        {"mininteger by -1", math.mininteger, -1},
        {"maxinteger by 2", math.maxinteger, 2},
        {"float", 7.5, 2},
        {"float by zero", 7.5, 0},
        {"neg zero result", -6, 3.0},
        {"nan operand", nan, 3},
        {"int by zero", 7, 0},
        {"numeric strings", "8", "3"},
        {"junk", "x", 3},
        {"nil divisor", 7, nil},
    }
    parity_over(fast_fmod, s.fmod, 2, corpus, "fmod")
end)

tests:it("math.ult parity over pairs", function()

-- ==== String parity ====
tests:describe("string parity")

local LONG_MIXED = string.rep(" Ab\0Yz\255\128\200 \t", 9)

local str_corpus = {
    {"empty", ""},
    {"single", "a"},
    {"spaces", "  hello  "},
    {"only ws", " \t\r\n "},
    {"vertical ws", "\v\f x \v\f"},
    {"embedded nul", "a\0b"},
    {"leading nul", "\0ab"},
    {"trailing nul", "ab\0"},
    {"high bytes", "\128\200\255"},
    {"utf8 text", "caf\195\169 \195\128\195\137"},
    {"long mixed", LONG_MIXED},
    {"ws around nul", " \0 "},
    {"number coercion", 42},
    {"float coercion", 2.5},
    {"boolean", true},
    {"table", EMPTY_T},
    {"nil", nil},
}

tests:it("string.len parity over the string corpus", function()
    parity_over(fast_len, s.len, 1, str_corpus, "len")
end)

tests:it("string.trim parity over the string corpus", function()
    parity_over(fast_trim, s.trim, 1, str_corpus, "trim")
end)

tests:it("string.ltrim parity over the string corpus", function()
    parity_over(fast_ltrim, s.ltrim, 1, str_corpus, "ltrim")
end)

tests:it("string.rtrim parity over the string corpus", function()
    parity_over(fast_rtrim, s.rtrim, 1, str_corpus, "rtrim")
end)

tests:it("string.lower parity over the string corpus", function()
    parity_over(fast_lower, s.lower, 1, str_corpus, "lower")
end)

tests:it("string.upper parity over the string corpus", function()
    parity_over(fast_upper, s.upper, 1, str_corpus, "upper")
end)

tests:it("string.reverse parity over the string corpus", function()
    parity_over(fast_reverse, s.reverse, 1, str_corpus, "reverse")
end)

tests:it("string.sub parity over boundary triples", function()
    local corpus = {
        {"mid", "hello", 2, 4},
        {"full", "hello", 1, 5},
        {"neg range", "hello", -3, -1},
        {"clamp end", "hello", 1, 100},
        {"clamp start", "hello", -100, 2},
        {"zero start", "hello", 0, 2},
        {"reversed", "hello", 3, 2},
        {"empty subject", "", 1, 1},
        {"minint start", "hello", math.mininteger, 2},
        {"maxint end", "hello", 2, math.maxinteger},
        {"minint end", "hello", 1, math.mininteger},
        {"float indices", "hello", 1.0, 3.0},
        {"frac index", "hello", 1.5, 3},
        {"nul subject", "a\0b\0c", 2, 4},
        {"number subject", 12345, 2, 3},
        {"table subject", EMPTY_T, 1, 2},
        {"nil end", "hello", 2, nil},
    }
    parity_over(fast_sub, s.sub, 3, corpus, "sub")
end)

tests:it("string.byte parity over safe positions", function()
    -- Start positions of zero or below -#s are a known divergence covered by
    -- the soft test below.
    local corpus = {
        {"first", "hello", 1},
        {"last", "hello", 5},
        {"past end", "hello", 6},
        {"neg last", "hello", -1},
        {"neg first", "hello", -5},
        {"empty subject", "", 1},
        {"maxint", "hello", math.maxinteger},
        {"nul byte", "\0", 1},
        {"high byte", "\255", 1},
        {"float index", "hello", 2.0},
        {"frac index", "hello", 1.5},
        {"junk subject", true, 1},
        {"nil index", "hello", nil},
    }
    parity_over(fast_byte, s.byte, 2, corpus, "byte")
end)


end)

tests:it("getmetatable parity over values", function()
    local mt = {}
    local plain = setmetatable({}, mt)
    local locked = setmetatable({}, {__metatable = "locked"})
    local falsy = setmetatable({}, {__metatable = false})
    local corpus = {
        {"no metatable", {}},
        {"with metatable", plain},
        {"protected string", locked},
        {"protected false", falsy},
        {"string", "x"},
        {"number", 5},
        {"nil", nil},
        {"boolean", true},
    }
    parity_over(fast_getmetatable, s.getmetatable, 1, corpus, "getmetatable")
    tests:assert_equal(fast_getmetatable(plain), mt, "fast getmetatable must return the metatable object")
    tests:assert_equal(fast_getmetatable("x"), s.getmetatable("x"), "string metatable must be the same object on both paths")
end)

tests:it("setmetatable success behavior matches between paths", function()
    local mt = {}
    local t1 = {}
    local t2 = {}
    tests:assert_equal(fast_setmetatable(t1, mt), t1, "fast setmetatable must return its table")
    tests:assert_equal(s.setmetatable(t2, mt), t2, "slow setmetatable must return its table")
    tests:assert_equal(getmetatable(t1), mt)
    tests:assert_equal(getmetatable(t2), mt)
    fast_setmetatable(t1, nil)
    s.setmetatable(t2, nil)
    tests:assert_equal(getmetatable(t1), nil)
    tests:assert_equal(getmetatable(t2), nil)
end)


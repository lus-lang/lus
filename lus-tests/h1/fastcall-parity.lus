-- ==== Regression pins for once-divergent cases ====
tests:describe("regression pins for once-divergent cases")

tests:it("math.max NaN operands agree between paths", function()
    run_pair(fast_max, s.max, 2, {"nan first", nan, 1}, "max")
    run_pair(fast_max, s.max, 2, {"nan second", 1, nan}, "max")
end)

tests:it("math.min NaN operands agree between paths", function()
    run_pair(fast_min, s.min, 2, {"nan first", nan, 1}, "min")
    run_pair(fast_min, s.min, 2, {"nan second", 1, nan}, "min")
end)

tests:it("math.max and math.min preserve subtype and tie choice", function()
    run_pair(fast_max, s.max, 2, {"int winner", 3, 2.5}, "max")
    run_pair(fast_min, s.min, 2, {"int winner", 2, 3.5}, "min")
    run_pair(fast_max, s.max, 2, {"mixed tie", 2, 2.0}, "max")
    run_pair(fast_max, s.max, 2, {"signed zero tie", -0.0, 0.0}, "max")
end)

tests:it("string.byte start-position clamping agrees between paths", function()
    run_pair(fast_byte, s.byte, 2, {"zero index", "hello", 0}, "byte")
    run_pair(fast_byte, s.byte, 2, {"mininteger index", "hello", math.mininteger}, "byte")
    run_pair(fast_byte, s.byte, 2, {"below -len", "hello", -100}, "byte")
end)

tests:it("table stats treat numeric strings identically on both paths", function()
    local data = {1, "10", 2}
    run_pair(fast_sum, s.sum, 1, {"numeric strings", data}, "sum")
    run_pair(fast_mean, s.mean, 1, {"numeric strings", data}, "mean")
    run_pair(fast_median, s.median, 1, {"numeric strings", data}, "median")
    run_pair(fast_stdev, s.stdev, 1, {"numeric strings", data}, "stdev")
end)

tests:it("table.sum reads metamethod-backed tables identically on both paths", function()
    local backing = {10, 20, 30}
    local proxy = setmetatable({}, {
        __index = function(_, k) return backing[k] end,
        __len = function() return 3 end,
    })
    run_pair(fast_sum, s.sum, 1, {"proxy table", proxy}, "sum")
end)

tests:it("math.tointeger numeric string agrees between paths", function()
    run_pair(fast_tointeger, s.tointeger, 1, {"numeric string", "10"}, "tointeger")
end)

tests:it("fastcall sites preserve multi-return value counts", function()
    local subject = "h\195\169llo"
    local fast_n = select("#", fast_uoffset(subject, -1))
    local slow_n = select("#", slow_uoffset_wrap(subject, -1))
    tests:assert_equal(fast_n, slow_n,
        "utf8.offset return count: fast " .. fast_n .. " slow " .. slow_n)
    local fast_len_n = select("#", fast_ulen("ab\128"))
    local slow_len_n = select("#", slow_ulen_wrap("ab\128"))
    tests:assert_equal(fast_len_n, slow_len_n,
        "utf8.len invalid return count: fast " .. fast_len_n .. " slow " .. slow_len_n)
end)

tests:it("catch pads missing results with nil", function()
    local ok, r = catch (function() return end)()
    tests:assert_true(ok, "the empty function must not fail")
    tests:assert_equal(type(r), "nil",
        "expected nil for the missing result, got " .. type(r))
end)

-- ==== Error-name pinning ====
tests:describe("time scalar constructor parity")

-- Durations and instants are userdata, so first-result identity cannot be
-- compared structurally. Value parity goes through __eq here and through the
-- accessor methods below. The corpus routes coercions (integral floats and
-- numeric strings), errors, and overflow boundaries through both dispatch
-- paths, which must agree everywhere.
local dur_corpus = {
    {"zero", 0},
    {"one", 1},
    {"neg one", -1},
    {"typical", 37},
    {"maxinteger", math.maxinteger},
    {"mininteger", math.mininteger},
    {"integral float", 2.0},
    {"fractional float", 2.5},
    {"numeric string", "5"},
    {"junk string", "x"},
    {"nil", nil},
    {"false", false},
    {"table", EMPTY_T},
}

-- Appends the overflow boundary rows for one unit: the largest magnitudes
-- the intrinsic handles inline and the first magnitudes it declines, which
-- both forms must then route through the C path identically.
local function with_boundaries(unit)
    local corpus = {}
    for _, case in ipairs(dur_corpus) do
        corpus[#corpus + 1] = case
    end
    local hi = math.maxinteger // unit
    local lo = math.mininteger // unit
    corpus[#corpus + 1] = {"pos boundary", hi}
    corpus[#corpus + 1] = {"pos boundary + 1", hi + 1}
    corpus[#corpus + 1] = {"neg boundary", lo}
    corpus[#corpus + 1] = {"neg boundary + 1", lo + 1}
    return corpus
end

tests:it("time.days agrees across dispatch paths", function()
    parity_over(fast_tdays, s.tdays, 1, with_boundaries(86400), "time.days")
end)

tests:it("time.hours agrees across dispatch paths", function()
    parity_over(fast_thours, s.thours, 1, with_boundaries(3600), "time.hours")
end)

tests:it("time.minutes agrees across dispatch paths", function()
    parity_over(fast_tminutes, s.tminutes, 1, with_boundaries(60), "time.minutes")
end)

tests:it("time.seconds agrees across dispatch paths", function()
    parity_over(fast_tseconds, s.tseconds, 1, dur_corpus, "time.seconds")
end)

tests:it("time.millis agrees across dispatch paths", function()
    parity_over(fast_tmillis, s.tmillis, 1, with_boundaries(1000000), "time.millis")
end)

tests:it("time.instant agrees across dispatch paths", function()
    parity_over(fast_tinstant, s.tinstant, 1, dur_corpus, "time.instant")
end)

tests:it("getmetatable over time userdata honors the protection marker", function()
    -- Time metatables set __metatable = false, so both dispatch paths must
    -- return the protection marker, not the metatable and not nil.
    local d = s.tseconds(1)
    tests:assert_equal(fast_getmetatable(d), false,
        "fastcall getmetatable must read the userdata's own metatable")
    tests:assert_equal(s.getmetatable(d), false,
        "C getmetatable must read the userdata's own metatable")
end)

tests:it("duration accessors and tostring agree across dispatch paths", function()
    for _, n in ipairs({0, 1, -1, 999, -999, 86399, -86401, 123456789}) do
        local f = fast_tmillis(n)
        local g = s.tmillis(n)
        tests:assert_true(f == g, "millis(" .. n .. ") __eq mismatch")
        tests:assert_equal(f:seconds(), g:seconds(), "millis(" .. n .. ") :seconds()")
        tests:assert_equal(f:millis(), g:millis(), "millis(" .. n .. ") :millis()")
        tests:assert_equal(tostring(f), tostring(g), "millis(" .. n .. ") tostring")
        local fd = fast_tdays(n)
        local gd = s.tdays(n)
        tests:assert_true(fd == gd, "days(" .. n .. ") __eq mismatch")
        tests:assert_equal(tostring(fd), tostring(gd), "days(" .. n .. ") tostring")
    end
end)

tests:it("instants built fast interoperate with the two argument C form", function()
    for _, n in ipairs({0, 1, -1, 1000000000, -1000000000}) do
        local f = fast_tinstant(n)
        local g = time.instant(n, 0)
        tests:assert_true(f == g, "instant(" .. n .. ") differs from instant(n, 0)")
        tests:assert_equal(f:epoch(), g:epoch(), "instant(" .. n .. ") :epoch()")
        tests:assert_equal(tostring(f), tostring(g), "instant(" .. n .. ") tostring")
    end
end)

tests:it("fast durations compose with duration arithmetic", function()
    tests:assert_true(fast_tdays(1) == fast_thours(24), "days(1) ~= hours(24)")
    tests:assert_true(fast_thours(1) == fast_tminutes(60), "hours(1) ~= minutes(60)")
    tests:assert_true(fast_tminutes(1) == fast_tseconds(60), "minutes(1) ~= seconds(60)")
    tests:assert_true(fast_tseconds(1) == fast_tmillis(1000), "seconds(1) ~= millis(1000)")
    local sum = fast_tseconds(30) + fast_tseconds(30)
    tests:assert_true(sum == fast_tminutes(1), "30s + 30s ~= 1min")
end)

tests:describe("error-name pinning")

local function caught_name(fn)
    local ok, err = catch fn()
    if ok then
        return nil, nil, "call unexpectedly succeeded"
    end
    local argn, name = string.match(tostring(err), "bad argument #(%d+) to '([^']+)'")
    return name, tonumber(argn), tostring(err)
end

-- A fastcall site that falls back for its error loses the call-site name, so
-- the runtime derives a qualified module name for the message. These cases
-- pin that behavior per module function.
tests:each("fast-form fallback errors carry qualified names", {
    {"math.sqrt", function() return math.sqrt("x") end, "math.sqrt", 1, "number expected, got string"},
    {"math.fmod", function() return math.fmod(7, 0) end, "math.fmod", 2, "zero"},
    {"math.ult", function() return math.ult(1.5, 2) end, "math.ult", 1, "number has no integer representation"},
    {"string.len", function() return string.len(true) end, "string.len", 1, "string expected, got boolean"},
    {"string.sub", function() return string.sub("a", true, 2) end, "string.sub", 2, "number expected, got boolean"},
    {"string.byte", function() return string.byte(true, 1) end, "string.byte", 1, "string expected, got boolean"},
    {"string.char", function() return string.char(256) end, "string.char", 1, "value out of range"},
    {"string.split", function() return string.split(EMPTY_T, ",") end, "string.split", 1, "string expected, got table"},
    {"string.join", function() return string.join("x", ",") end, "string.join", 1, "table expected, got string"},
    {"table.sum", function() return table.sum("x") end, "table.sum", 1, "table expected, got string"},
    {"table.transpose", function() return table.transpose(5) end, "table.transpose", 1, "table expected, got number"},
    {"table.reshape", function() return table.reshape(EMPTY_T, 0, 0) end, "table.reshape", 2, "rows must be positive"},
    {"vector.create", function() return vector.create(-1) end, "vector.create", 1, "capacity must be non"},
    {"vector.resize", function() return vector.resize(VEC, -1) end, "vector.resize", 2, "size must be non"},
    {"utf8.char", function() return utf8.char(-1) end, "utf8.char", 1, "value out of range"},
    {"utf8.codepoint", function() return utf8.codepoint("") end, "utf8.codepoint", 3, "out of bounds"},
    {"utf8.offset", function() return utf8.offset(true, 1) end, "utf8.offset", 1, "string expected, got boolean"},
    {"time.seconds", function() return time.seconds("x") end, "time.seconds", 1, "number expected, got string"},
    {"time.millis", function() return time.millis(2.5) end, "time.millis", 1, "number has no integer representation"},
    {"time.instant", function() return time.instant(false) end, "time.instant", 1, "number expected, got boolean"},
}, function(label, fn, want_name, want_argn, want_reason)
    local name, argn, full = caught_name(fn)
    tests:assert_equal(name, want_name, label .. ": got name " .. tostring(name) .. " in " .. tostring(full))
    tests:assert_equal(argn, want_argn, label .. ": got arg #" .. tostring(argn))
    tests:assert_contains(tostring(full), want_reason, label .. ": reason mismatch in " .. tostring(full))
end)

-- Base-library fastcalls resolve to their plain global name because the
-- global table lookup strips the _G prefix.
tests:each("base-library fallback errors carry plain names", {
    {"setmetatable", function() return setmetatable(EMPTY_T, "x") end, "setmetatable", 2},
    {"rawlen", function() return rawlen(true) end, "rawlen", 1},
    {"rawget", function() return rawget(5, 1) end, "rawget", 1},
    {"rawset", function() return rawset(5, 1, 1) end, "rawset", 1},
}, function(label, fn, want_name, want_argn)
    local name, argn, full = caught_name(fn)
    tests:assert_equal(name, want_name, label .. ": got name " .. tostring(name) .. " in " .. tostring(full))
    tests:assert_equal(argn, want_argn, label .. ": got arg #" .. tostring(argn))
end)

-- A call whose argument count does not match the registered fastcall arity
-- compiles to a normal call, so the error name comes from the call site
-- field and stays unqualified.
tests:each("non-fastcall arity errors keep the call-site field name", {
    {"sub with two args", function() return string.sub("a", true) end, "sub", 2},
    {"byte with one arg", function() return string.byte(true) end, "byte", 1},
    {"log with two args", function() return math.log(true, 10) end, "log", 1},
    {"instant with two args", function() return time.instant(5, "x") end, "instant", 2},
}, function(label, fn, want_name, want_argn)
    local name, argn, full = caught_name(fn)
    tests:assert_equal(name, want_name, label .. ": got name " .. tostring(name) .. " in " .. tostring(full))
    tests:assert_equal(argn, want_argn, label .. ": got arg #" .. tostring(argn))
end)

tests:it("alias calls report the variable name instead", function()
    local mysqrt = math.sqrt
    local ok, err = catch mysqrt("x")
    tests:assert_false(ok, "alias sqrt on a string must error")
    tests:assert_contains(tostring(err), "bad argument #1 to 'mysqrt'")
end)

tests:finish()

-- ==== Vector parity ====
tests:describe("vector parity")

tests:it("vector.create and vector.size parity", function()
    for _, n in ipairs({0, 1, 8, 100}) do
        local vf = fast_vcreate(n)
        local vs = s.vcreate(n)
        tests:assert_equal(fast_vsize(vf), n, "fast create size " .. n)
        tests:assert_equal(s.vsize(vs), n, "slow create size " .. n)
        tests:assert_equal(fast_vsize(vs), s.vsize(vf), "cross path size " .. n)
    end
    local corpus = {
        {"negative", -1},
        {"float", 2.5},
        {"junk", "x"},
        {"nil", nil},
        {"table", EMPTY_T},
    }
    parity_over(fast_vcreate, s.vcreate, 1, corpus, "vector.create")
    parity_over(fast_vsize, s.vsize, 1, {{"non-vector", 42}, {"table", EMPTY_T}, {"nil", nil}}, "vector.size")
end)

tests:it("vector.clone content parity", function()
    local src = vector.create(4)
    vector.pack(src, 0, "BBBB", 1, 2, 3, 254)
    local cf = fast_vclone(src)
    local cs = s.vclone(src)
    tests:assert_equal(vector.size(cf), 4)
    tests:assert_equal(vector.size(cs), 4)
    local f1, f2, f3, f4 = vector.unpack(cf, 0, "BBBB")
    local s1, s2, s3, s4 = vector.unpack(cs, 0, "BBBB")
    tests:assert_equal(f1, s1)
    tests:assert_equal(f2, s2)
    tests:assert_equal(f3, s3)
    tests:assert_equal(f4, s4)
    tests:assert_true(cf ~= src and cs ~= src, "clones must be new objects")
    parity_over(fast_vclone, s.vclone, 1, {{"non-vector", 42}, {"string", "x"}, {"nil", nil}}, "vector.clone")
end)

tests:it("vector.resize parity and content preservation", function()
    local v1 = vector.create(4)
    local v2 = vector.create(4)
    vector.pack(v1, 0, "BBBB", 9, 8, 7, 6)
    vector.pack(v2, 0, "BBBB", 9, 8, 7, 6)
    tests:assert_equal(fast_vresize(v1, 8), s.vresize(v2, 8), "resize return values must match")
    tests:assert_equal(vector.size(v1), 8)
    tests:assert_equal(vector.size(v2), 8)
    local a1, a2, a3, a4, a5 = vector.unpack(v1, 0, "BBBBB")
    local b1, b2, b3, b4, b5 = vector.unpack(v2, 0, "BBBBB")
    tests:assert_true(a1 == b1 and a2 == b2 and a3 == b3 and a4 == b4 and a5 == b5,
        "grown contents must match between paths")
    fast_vresize(v1, 0)
    s.vresize(v2, 0)
    tests:assert_equal(vector.size(v1), 0)
    tests:assert_equal(vector.size(v2), 0)
    local corpus = {
        {"negative", VEC, -1},
        {"float", VEC, 2.5},
        {"junk size", VEC, "x"},
        {"non-vector", 42, 4},
        {"nil size", VEC, nil},
    }
    parity_over(fast_vresize, s.vresize, 2, corpus, "vector.resize")
end)

-- Requesting maxinteger bytes makes malloc return NULL on a plain build,
-- but the ASAN allocator aborts the whole process on such a request, so the
-- assertion is skipped when the sanitizer environment is detected (the CI
-- sanitize job always exports ASAN_OPTIONS).
if os.getenv("ASAN_OPTIONS") ~= nil then
    tests:skip("vector allocation failure delivers a string error value",
        "allocating maxinteger bytes aborts under the ASAN allocator")
else
    tests:it("vector allocation failure delivers a string error value", function()
        local ok, err = catch vector.create(math.maxinteger)
        tests:assert_false(ok)
        tests:assert_equal(err, "not enough memory")
        local v = vector.create(2)
        local ok2, err2 = catch vector.resize(v, math.maxinteger)
        tests:assert_false(ok2)
        tests:assert_equal(err2, "not enough memory")
    end)
end


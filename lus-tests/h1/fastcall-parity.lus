-- ==== Table statistics parity ====
tests:describe("table statistics parity")

local stats_corpus = {
    {"empty", {}},
    {"ints", {1, 2, 3, 4, 5}},
    {"floats", {2.5, -2.5, 0.5}},
    {"mixed", {1, 2.5, -3}},
    {"single int", {42}},
    {"single float", {0.25}},
    {"maxint twice", {math.maxinteger, math.maxinteger}},
    {"signed zeros", {-0.0, 0.0}},
    {"even count", {1, 2, 3, 4}},
    {"unsorted", {9, -1, 4, 0}},
    {"hole", {1, nil, 3}},
    {"boolean elements", {true, false}},
    {"table element", {EMPTY_T, 1}},
    {"string subject", "x"},
    {"nil subject", nil},
}

tests:it("table.sum parity over the stats corpus", function()
    parity_over(fast_sum, s.sum, 1, stats_corpus, "sum")
    run_pair(fast_sum, s.sum, 1, {"inf element", {inf, 1}}, "sum")
    run_pair(fast_sum, s.sum, 1, {"nan element", {nan, 1}}, "sum")
end)

tests:it("table.mean parity over the stats corpus", function()
    parity_over(fast_mean, s.mean, 1, stats_corpus, "mean")
    run_pair(fast_mean, s.mean, 1, {"nan element", {nan, 1}}, "mean")
end)

tests:it("table.median parity over the stats corpus", function()
    parity_over(fast_median, s.median, 1, stats_corpus, "median")
end)

tests:it("table.stdev parity over the stats corpus", function()
    -- The fast path uses Welford accumulation and the slow path is two-pass,
    -- so results are compared with a tolerance on exact-friendly data and the
    -- corpus avoids values where the algorithms legitimately drift.
    for _, case in ipairs(stats_corpus) do
        local okf, rf = catch fast_stdev(case[2])
        local oks, rs = catch s.stdev(case[2])
        tests:assert_equal(okf, oks, "stdev [" .. case[1] .. "]: outcome mismatch")
        if okf then
            if rf ~= rf or rs ~= rs then
                tests:assert_true(rf ~= rf and rs ~= rs, "stdev [" .. case[1] .. "]: NaN on one path only")
            else
                tests:assert_near(rf, rs, 1e-12, "stdev [" .. case[1] .. "]: fast " .. tostring(rf) .. " slow " .. tostring(rs))
            end
        else
            tests:assert_equal(err_core(rf), err_core(rs), "stdev [" .. case[1] .. "]: error mismatch")
        end
    end
end)

tests:it("table.transpose parity over matrices", function()
    local corpus = {
        {"square", {{1, 2}, {3, 4}}},
        {"wide", {{1, 2, 3}}},
        {"tall", {{1}, {2}, {3}}},
        {"empty", {}},
        {"empty rows", {{}, {}}},
        {"string subject", "x"},

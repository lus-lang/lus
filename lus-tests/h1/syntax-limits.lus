--[[
    Parser and codegen limit torture tests for Lus.

    Every source under test is generated cheaply with string.rep and
    table.concat and handed to load() so that a limit is exercised in the
    compiler, never in this file's own call stack. The contract being pinned
    is twofold. When a construct sits within its documented limit the chunk
    must compile and run to the expected value. When it exceeds a limit the
    compiler must return a graceful, catchable error whose message names the
    limit, and it must never crash the process.

    This complements cstack.lus, which exercises runtime C stack depth rather
    than the parser and code generator.
]]
global print, require, assert, type, string, table, select, tostring, tonumber, load, error, ipairs, pledge

pledge("load", "fs:read=./lus-tests/*", "seal")

local framework = require("lus-tests.framework")
local tests = framework.new("syntax-limits")

-- Assert that a generated source fails to compile and that the load error
-- carries the given plain-text fragment. Using string.find in plain mode
-- keeps fragments like "(limit is 200)" from being read as patterns.
local function expect_compile_error(src, fragment)
    local f, err = load(src)
    if f then
        error("expected a compile error but the source loaded successfully")
    end
    err = tostring(err)
    if fragment and not string.find(err, fragment, 1, true) then
        error("expected the error to contain '" .. fragment .. "' but got: " .. err)
    end
end

-- Assert that a generated source compiles, run it, and return its value.
local function expect_run(src)
    local f, err = load(src)
    if not f then
        error("expected the source to compile but got: " .. tostring(err))
    end
    return f()
end

-- Assert only that a generated source compiles.
local function expect_compiles(src)
    local f, err = load(src)
    if not f then
        error("expected the source to compile but got: " .. tostring(err))
    end
end

-- Build a source that wraps an inner fragment in n repetitions of a prefix
-- and suffix, for example n nested parentheses or n nested do blocks.
local function wrap(prefix, inner, suffix, n)
    return string.rep(prefix, n) .. inner .. string.rep(suffix, n)
end

-- Deep nesting that stays well under the parser recursion limit must compile
-- and, where it produces a value, evaluate correctly.
tests:each("deep nesting within limits compiles", {
    {"parentheses", "return " .. wrap("(", "1", ")", 100)},
    {"do blocks", "local x = 1 " .. wrap("do ", "x = 2", " end", 150)},
    {"if chains", "local x = 1 " .. wrap("if true then ", "x = 2", " end", 150)},
    {"while blocks", "local x = 1 " .. wrap("while x == 2 do ", "x = 2", " end", 150)},
    {"function definitions", "return " .. wrap("function() return ", "1", " end", 50)},
    {"do expressions", "local x = " .. wrap("do provide ", "7", " end", 50) .. " return x"},
}, function(name, src)
    expect_compiles(src)
end)

-- The innermost value of a moderately deep parenthesis and do-expression nest
-- must survive intact, proving the nesting compiled to correct code rather
-- than merely accepting the tokens.
tests:it("deeply parenthesized value is preserved", function()
    local v = expect_run("return " .. wrap("(", "1234", ")", 120))
    assert(v == 1234, "expected 1234, got " .. tostring(v))
end)

tests:it("deeply nested do expression provides its value", function()
    local v = expect_run("local x = " .. wrap("do provide ", "99", " end", 40) .. " return x")
    assert(v == 99, "expected 99, got " .. tostring(v))
end)

-- Nesting far past the recursion limit must be reported as a catchable stack
-- overflow, never a crash. The threshold is build dependent so the failing
-- depths here are chosen comfortably above it.
tests:each("nesting past the limit errors gracefully", {
    {"parentheses", "return " .. wrap("(", "1", ")", 800)},
    {"do blocks", "local x = 1 " .. wrap("do ", "x = 2", " end", 800)},
    {"if chains", "local x = 1 " .. wrap("if true then ", "x = 2", " end", 800)},
    {"while blocks", "local x = 1 " .. wrap("while x == 2 do ", "x = 2", " end", 800)},
    {"function definitions", "return " .. wrap("function() return ", "1", " end", 800)},
    {"do expressions", "local x = " .. wrap("do provide ", "1", " end", 800) .. " return x"},
}, function(name, src)
    expect_compile_error(src, "stack overflow")
end)

-- A run of consecutive empty labels drives the same parser recursion. A deep
-- run must still fail with a catchable error rather than crashing.
tests:it("many consecutive empty labels error gracefully", function()
    local parts = {"local n = 0"}
    for i = 1, 800 do parts[#parts + 1] = "::E" .. i .. "::" end
    parts[#parts + 1] = "return n"
    expect_compile_error(table.concat(parts, " "), "stack overflow")
end)

-- Build a chunk declaring n distinct locals in the main function.
local function many_locals(n)
    local parts = {}
    for i = 1, n do parts[#parts + 1] = "local a" .. i .. " = " .. i end
    parts[#parts + 1] = "return a" .. n
    return table.concat(parts, " ")
end

tests:it("exactly 200 locals compiles and runs", function()
    local v = expect_run(many_locals(200))
    assert(v == 200, "expected 200, got " .. tostring(v))
end)

tests:each("more than 200 locals is rejected", {
    {201}, {250}, {500},
}, function(n)
    expect_compile_error(many_locals(n), "too many local variables (limit is 200)")
end)

-- Build a chunk whose innermost function captures n distinct outer names as
-- upvalues. The names are split across the main chunk and one nested function
-- so that neither enclosing function trips the 200 local limit first.
local function many_upvalues(total)
    local outer = 200
    if total < outer then outer = total end
    local top = {}
    for i = 1, outer do top[#top + 1] = "local u" .. i .. " = " .. i end
    local mid = {}
    for i = outer + 1, total do mid[#mid + 1] = "local u" .. i .. " = " .. i end
    local refs = {}
    for i = 1, total do refs[#refs + 1] = "u" .. i end
    return table.concat(top, " ")
        .. " return function() "
        .. table.concat(mid, " ")
        .. " return function() return " .. table.concat(refs, "+") .. " end end"
end

tests:it("exactly 255 upvalues compiles", function()
    expect_compiles(many_upvalues(255))
end)

tests:each("more than 255 upvalues is rejected", {
    {256}, {400},
}, function(n)
    expect_compile_error(many_upvalues(n), "too many upvalues (limit is 255)")
end)

-- Build a call with n literal arguments.
local function call_with_args(n)
    local a = {}
    for i = 1, n do a[#a + 1] = "1" end
    return "local function f(...) return select('#', ...) end return f(" .. table.concat(a, ",") .. ")"
end

tests:each("large argument counts within the register limit run", {
    {200, 200}, {250, 250},
}, function(n, expected)
    local got = expect_run(call_with_args(n))
    assert(got == expected, "expected " .. expected .. " args, got " .. tostring(got))
end)

tests:each("argument counts past the register limit are rejected", {
    {256}, {400},
}, function(n)
    expect_compile_error(call_with_args(n), "too many registers (limit is 255)")
end)

-- Build an enum with n members and read back the numeric index of the last.
local function big_enum(n)
    local m = {}
    for i = 1, n do m[#m + 1] = "M" .. i end
    return "local e = enum " .. table.concat(m, ", ") .. " end return tonumber(e[" .. n .. "])"
end

tests:each("enums up to the member limit compile and index correctly", {
    {50}, {200}, {255},
}, function(n)
    local got = expect_run(big_enum(n))
    assert(got == n, "expected last member index " .. n .. ", got " .. tostring(got))
end)

tests:each("enums past the member limit are rejected", {
    {256}, {1000},
}, function(n)
    expect_compile_error(big_enum(n), "too many names in enum")
end)

-- Build an interpolated string with n segments, each interpolating a literal
-- integer, and return the byte length of the result.
local function interp_segments(n)
    local p = {}
    for i = 1, n do p[#p + 1] = "$(" .. i .. ")" end
    return "local s = `" .. table.concat(p, "") .. "` return #s"
end

-- Concatenating "1".."2"..."n" yields a predictable byte length.
local function decimal_run_length(n)
    local total = 0
    for i = 1, n do total = total + #tostring(i) end
    return total
end

tests:each("interpolation with many segments concatenates correctly", {
    {100}, {200}, {255},
}, function(n)
    local got = expect_run(interp_segments(n))
    local want = decimal_run_length(n)
    assert(got == want, "expected length " .. want .. ", got " .. tostring(got))
end)

tests:each("interpolation too complex for registers is rejected", {
    {400}, {1000},
}, function(n)
    expect_compile_error(interp_segments(n), "too many registers")
end)

-- A single kilometre-long line must compile and run. The body increments a
-- counter once per statement so the return value pins correct reassembly.
tests:each("very long single-line sources compile and run", {
    {2000}, {5000}, {10000},
}, function(n)
    local src = "local x = 0 " .. string.rep("x = x + 1 ", n) .. "return x"
    local got = expect_run(src)
    assert(got == n, "expected " .. n .. ", got " .. tostring(got))
end)

-- A table constructor flushes its elements periodically, so a very large
-- constructor compiles where a same-sized argument list would not.
tests:each("large table constructors compile", {
    {2000}, {5000},
}, function(n)
    local p = {}
    for i = 1, n do p[#p + 1] = tostring(i) end
    local got = expect_run("local t = {" .. table.concat(p, ",") .. "} return #t")
    assert(got == n, "expected " .. n .. " elements, got " .. tostring(got))
end)

-- A chunk with hundreds of labels separated by real statements must compile
-- and run, exercising the label table without recursion pressure.
tests:each("many labels with statements between them compile and run", {
    {200}, {500},
}, function(n)
    local parts = {"local n = 0"}
    for i = 1, n do
        parts[#parts + 1] = "::L" .. i .. "::"
        parts[#parts + 1] = "n = n + 1"
    end
    parts[#parts + 1] = "return n"
    local got = expect_run(table.concat(parts, " "))
    assert(got == n, "expected " .. n .. " labels visited, got " .. tostring(got))
end)

-- A deep run of optional chains against a nil base is fully short circuited
-- and must evaluate to nil at any depth.
tests:each("deep optional chains short circuit to nil", {
    {100}, {500}, {1000}, {2000},
}, function(n)
    local got = expect_run("local t = nil return t" .. string.rep("?.b", n))
    assert(got == nil, "expected nil, got " .. tostring(got))
end)

-- Feed a chunk to load() through a reader function that hands back one byte at
-- a time. The reader's pieces must be reassembled into the original source.
tests:it("reader streaming one byte at a time reassembles the chunk", function()
    local src = "local s = 0 for i = 1, 100 do s = s + i end return s"
    local pos = 0
    local reader = function()
        pos = pos + 1
        if pos > #src then return nil end
        return string.sub(src, pos, pos)
    end
    local f = load(reader)
    assert(f, "expected the streamed chunk to compile")
    assert(f() == 5050, "expected 5050 from the reassembled chunk")
end)

-- The same chunk streamed in irregular three byte pieces must reassemble
-- identically, proving the loader does not assume aligned reads.
tests:it("reader streaming in three byte pieces reassembles the chunk", function()
    local src = "local s = 0 for i = 1, 250 do s = s + i end return s"
    local pos = 1
    local reader = function()
        if pos > #src then return nil end
        local piece = string.sub(src, pos, pos + 2)
        pos = pos + 3
        return piece
    end
    local f = load(reader)
    assert(f, "expected the streamed chunk to compile")
    assert(f() == 31375, "expected 31375 from the reassembled chunk")
end)

-- A reader that returns the empty string signals end of input, so any later
-- pieces are ignored and only the source up to that point is compiled.
tests:it("reader returning empty string terminates the chunk", function()
    local pieces = {"return 111 ", "", "+ 222"}
    local i = 0
    local reader = function()
        i = i + 1
        return pieces[i]
    end
    local f = load(reader)
    assert(f, "expected the truncated chunk to compile")
    assert(f() == 111, "expected only the pre-terminator source to be compiled")
end)

-- A reader that returns nil on the very first call yields an empty chunk,
-- which compiles to a function that returns no values.
tests:it("reader returning nil immediately yields an empty chunk", function()
    local f = load(function() return nil end)
    assert(f, "expected an empty chunk to compile")
    assert(select("#", f()) == 0, "expected the empty chunk to return no values")
end)

-- A kilometre-long line delivered through a byte-at-a-time reader must still
-- compile and run, combining the streaming and long-line stress paths.
tests:it("reader streaming a very long single line reassembles it", function()
    local src = "local x = 0 " .. string.rep("x = x + 1 ", 3000) .. "return x"
    local pos = 0
    local reader = function()
        pos = pos + 1
        if pos > #src then return nil end
        return string.sub(src, pos, pos)
    end
    local f = load(reader)
    assert(f, "expected the long streamed chunk to compile")
    assert(f() == 3000, "expected 3000 from the reassembled long line")
end)

-- The reader contract follows reference Lua. A reader must hand back a string
-- piece, and nil or the empty string ends the chunk. A value that cannot be a
-- string piece, such as a boolean or a table, makes load return nil together
-- with "reader function must return a string" rather than compiling. A number
-- return is a coercible string piece, so it is accepted the same as any other
-- string and is exercised by the streaming tests above rather than here.
tests:it("reader returning a non-coercible value fails cleanly", function()
    local boolf, boolerr = load(function() return true end)
    assert(boolf == nil, "a boolean reader return must not compile")
    assert(string.find(tostring(boolerr),
        "reader function must return a string", 1, true),
        "expected the reader-contract message for a boolean return")
    local tblf, tblerr = load(function() return {} end)
    assert(tblf == nil, "a table reader return must not compile")
    assert(string.find(tostring(tblerr),
        "reader function must return a string", 1, true),
        "expected the reader-contract message for a table return")
end)

tests:finish()

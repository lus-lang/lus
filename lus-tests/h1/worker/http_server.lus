global worker, network, tostring

local config = worker.peek()
local server <close> = network.tcp.bind("127.0.0.1", config.port)
worker.message("ready")

local connection <close> = server:accept()
while true do
    local line = connection:receive("*l")
    if line == "" then break end
end

local body = config.body or ""
local response = "HTTP/1.1 " .. tostring(config.status) .. " Fixture\r\n"
    .. "Content-Length: " .. tostring(#body) .. "\r\n"
    .. "Connection: close\r\n"
if config.location then
    response = response .. "Location: " .. config.location .. "\r\n"
end
connection:send(response .. "\r\n" .. body)
connection:close()
server:close()
worker.message("done")

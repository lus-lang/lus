-- Property-based coverage for table.sort and dedicated coverage for the
-- Lus table.compact extension.
--
-- The core of the suite is a check(t, cmp) helper in the spirit of Lua's own
-- sort.lua. It asserts two independent properties after every sort. First the
-- result is ordered according to the comparator. Second the result is a
-- permutation of the input, proven by comparing element multisets built with
-- occurrence counts. A sort that dropped, duplicated, or invented an element
-- would pass an ordering check alone, so the permutation check is what makes
-- these tests able to fail on a subtly broken sort.
--
-- Inputs are generated by a small linear congruential generator with fixed
-- seeds so runs are deterministic and reproducible. Deterministic randomness
-- lives here on purpose because math.random determinism is covered elsewhere.
-- Adversarial shapes (presorted, reverse-sorted, all-equal, organ-pipe, and
-- few-distinct) stress the partition heuristics that a naive quicksort mishandles.

global print, require, assert, type, table, math, os, string, pairs, ipairs, next, setmetatable, tostring, io, collectgarbage, error, pledge

pledge("load", "fs:read=./lus-tests/*", "seal")

local framework = require("lus-tests.framework")
local tests = framework.new("sortprop")

-- A 31-bit linear congruential generator. Seeded explicitly by each caller so
-- every generated array is deterministic across runs and machines.
local function lcg(seed)
    local state = seed & 0x7fffffff
    return function()
        state = (state * 1103515245 + 12345) & 0x7fffffff
        return state
    end
end

-- Build a multiset (value to occurrence count) over the first n entries.
local function multiset(t, n)
    local m = {}
    for i = 1, n do
        local v = t[i]
        m[v] = (m[v] or 0) + 1
    end
    return m
end

-- Two multisets are equal when every value has the same count in both.
local function multiset_equal(a, b)
    for k, v in pairs(a) do
        if b[k] ~= v then return false end
    end
    for k, v in pairs(b) do
        if a[k] ~= v then return false end
    end
    return true
end

-- Verify that the first n entries are ordered. With no comparator the default
-- ascending order is checked, otherwise adjacent pairs must not be strictly out
-- of order under cmp, meaning cmp(t[i], t[i-1]) is never true.
local function is_ordered(t, n, cmp)
    for i = 2, n do
        if cmp then
            if cmp(t[i], t[i - 1]) then return false, i end
        else
            if t[i] < t[i - 1] then return false, i end
        end
    end
    return true
end

-- The property harness. Records the input multiset, sorts in place, then
-- asserts ordering and permutation preservation.
local function check(t, cmp)
    local n = #t
    local before = multiset(t, n)
    table.sort(t, cmp)
    assert(#t == n, "length changed during sort")
    local ok, at = is_ordered(t, n, cmp)
    assert(ok, "result not ordered at index " .. tostring(at))
    local after = multiset(t, n)
    assert(multiset_equal(before, after), "result is not a permutation of the input")
end

-- Deterministic array builders keyed by shape name.
local function build(shape, n, seed)
    local a = {}
    if shape == "sorted" then
        for i = 1, n do a[i] = i end
    elseif shape == "reverse" then
        for i = 1, n do a[i] = n - i + 1 end
    elseif shape == "equal" then
        for i = 1, n do a[i] = 7 end
    elseif shape == "organpipe" then
        local half = n // 2
        for i = 1, half do a[i] = i end
        for i = half + 1, n do a[i] = n - i + 1 end
    elseif shape == "fewdistinct" then
        local rng = lcg(seed or 1)
        for i = 1, n do a[i] = rng() % 4 end
    elseif shape == "random" then
        local rng = lcg(seed or 1)
        for i = 1, n do a[i] = rng() % 1000 end
    elseif shape == "randomwide" then
        local rng = lcg(seed or 1)
        for i = 1, n do a[i] = rng() end
    else
        error("unknown shape " .. tostring(shape))
    end
    return a
end

-- The ordering predicate must discriminate, otherwise every property test below
-- would be vacuous. Confirm it flags an unsorted run and accepts a sorted one,
-- for both the default order and a custom comparator.
tests:it("ordering predicate discriminates sorted from unsorted", function()
    assert(is_ordered({1, 2, 3}, 3) == true)
    assert(is_ordered({1, 3, 2}, 3) == false)
    assert(is_ordered({3, 2, 1}, 3, function(x, y) return x > y end) == true)
    assert(is_ordered({3, 1, 2}, 3, function(x, y) return x > y end) == false)
end)

-- Confirm the permutation check itself distinguishes different multisets.
tests:it("multiset comparison distinguishes contents", function()
    assert(multiset_equal({1, 1, 2}, {1, 1, 2}) == true)
    assert(multiset_equal(multiset({5, 5, 3}, 3), multiset({3, 5, 5}, 3)) == true)
    assert(multiset_equal(multiset({5, 5, 3}, 3), multiset({3, 3, 5}, 3)) == false)
    assert(multiset_equal({[1] = 2}, {[1] = 3}) == false)
end)

-- Default ascending sort over deterministic random arrays at a spread of sizes,
-- including the empty and singleton boundaries and up to a few thousand.
tests:each("default sort preserves order and multiset", {
    {0}, {1}, {2}, {3}, {5}, {10}, {17}, {64}, {100}, {257}, {1000}, {5000},
}, function(n)
    check(build("random", n, n * 31 + 1))
end)

-- The same property under a reverse comparator so the ordering predicate is
-- exercised, not just the default path.
tests:each("reverse comparator preserves order and multiset", {
    {1}, {2}, {10}, {100}, {1000}, {5000},
}, function(n)
    check(build("random", n, n * 13 + 5), function(x, y) return x > y end)
end)

-- Adversarial shapes at meaningful sizes. Each is both the ordering stress and
-- the permutation proof in one pass.
tests:each("adversarial shapes sort correctly", {
    {"sorted", 2000}, {"reverse", 2000}, {"equal", 2000},
    {"organpipe", 2000}, {"fewdistinct", 2000},
    {"sorted", 5000}, {"reverse", 5000}, {"equal", 5000},
    {"organpipe", 5000}, {"fewdistinct", 5000},
}, function(shape, n)
    check(build(shape, n, 99))
end)

-- Wide-range random keys where almost every element is distinct, catching any
-- pivot handling that only works when duplicates are common.
tests:it("wide distinct random keys sort correctly", function()
    check(build("randomwide", 4000, 424242))
end)

-- A comparator that always reports its first argument as smaller is not a strict
-- weak order and must be rejected once the sort explores enough of the array.
tests:it("always-true comparator raises invalid order function", function()
    local a = build("random", 500, 3)
    tests:assert_throws(function()
        table.sort(a, function() return true end)
    end, "invalid order function for sorting")
end)

-- A less-or-equal comparator differs from a strict order only on equal elements,
-- so it must be driven by an array with duplicates to be detected as invalid.
tests:it("less-or-equal comparator raises invalid order function", function()
    local a = {}
    for i = 1, 400 do a[i] = i % 6 end
    tests:assert_throws(function()
        table.sort(a, function(x, y) return x <= y end)
    end, "invalid order function for sorting")
end)

-- A greater-or-equal comparator is the descending analogue of the above and is
-- equally invalid on data with duplicates.
tests:it("greater-or-equal comparator raises invalid order function", function()
    local a = {}
    for i = 1, 400 do a[i] = i % 7 end
    tests:assert_throws(function()
        table.sort(a, function(x, y) return x >= y end)
    end, "invalid order function for sorting")
end)

-- An error raised inside the comparator must propagate unchanged out of sort,
-- and the partially sorted array must still hold the same multiset it started
-- with because sorting only ever swaps existing elements.
tests:it("comparator error propagates and leaves a permutation", function()
    local a = {}
    for i = 1, 300 do a[i] = i end
    local before = multiset(a, 300)
    tests:assert_throws(function()
        table.sort(a, function(x, y)
            if x == 150 then error("comparator boom") end
            return x < y
        end)
    end, "comparator boom")
    assert(#a == 300, "length changed after failed sort")
    assert(multiset_equal(before, multiset(a, 300)), "array is no longer a permutation after a failed sort")
end)

-- The default order relies on the standard comparison, so a heterogeneous array
-- must raise the usual compare error naming both type names.
tests:it("default sort of mixed types raises attempt to compare", function()
    tests:assert_throws(function()
        table.sort({1, "a", 2})
    end, "attempt to compare")
end)

-- The default order routes through the runtime comparison, so a custom __lt
-- metamethod on the elements must drive the ordering.
tests:it("default sort dispatches through __lt metamethod", function()
    local mt = {__lt = function(x, y) return x.v < y.v end}
    local function box(v) return setmetatable({v = v}, mt) end
    local a = {box(5), box(1), box(3), box(4), box(2)}
    table.sort(a)
    for i = 1, 5 do
        assert(a[i].v == i, "expected " .. i .. " at position " .. i .. " got " .. a[i].v)
    end
end)

-- With repeated keys under __lt the sort still produces a non-decreasing run and
-- keeps every object, even though ties may land in any order.
tests:it("__lt sort with ties preserves every element", function()
    local mt = {__lt = function(x, y) return x.v < y.v end}
    local function box(v) return setmetatable({v = v}, mt) end
    local a = {box(3), box(1), box(3), box(1), box(2), box(2)}
    table.sort(a)
    for i = 2, 6 do
        assert(not (a[i].v < a[i - 1].v), "not ordered under __lt at " .. i)
    end
    local counts = {}
    for i = 1, 6 do counts[a[i].v] = (counts[a[i].v] or 0) + 1 end
    assert(counts[1] == 2 and counts[2] == 2 and counts[3] == 2, "an element was lost or duplicated")
end)

-- String elements sort lexicographically under the default order.
tests:it("default sort orders strings lexicographically", function()
    local a = {"delta", "alpha", "charlie", "bravo", "alpha"}
    check(a)
    assert(a[1] == "alpha" and a[2] == "alpha" and a[3] == "bravo")
    assert(a[4] == "charlie" and a[5] == "delta")
end)

-- Sort only touches indices 1 through the border, so keys beyond the array
-- length are left exactly as they were.
tests:it("sort leaves keys past the array length untouched", function()
    local a = {3, 1, 2}
    a[10] = 99
    a.label = "kept"
    table.sort(a)
    assert(a[1] == 1 and a[2] == 2 and a[3] == 3)
    assert(a[10] == 99, "hash key past the border was modified")
    assert(a.label == "kept", "named key was modified")
end)

-- A nil tail defines a border, and sorting operates over the elements up to it.
tests:it("sort handles a nil tail via the length border", function()
    local a = {5, 3, 1}
    a[4] = nil
    table.sort(a)
    assert(#a == 3 and a[1] == 1 and a[2] == 3 and a[3] == 5)
end)

-- Non-function comparator and non-table list are argument errors.
tests:it("sort rejects a non-function comparator", function()
    tests:assert_throws(function()
        table.sort({3, 1, 2}, 5)
    end, "function expected")
end)

tests:it("sort rejects a non-table list", function()
    tests:assert_throws(function()
        table.sort(nil)
    end, "table expected")
end)

-- Empty and single-element arrays are trivially sorted and must not error.
tests:it("sort of empty and single element arrays is a no-op", function()
    local e = {}
    table.sort(e)
    assert(#e == 0)
    local s = {42}
    table.sort(s)
    assert(#s == 1 and s[1] == 42)
end)

-- --- table.compact coverage ---

-- Compacting anything that is not a table is an argument error.
tests:each("compact rejects non-table arguments", {
    {5}, {"x"}, {true}, {nil},
}, function(v)
    tests:assert_throws(function()
        table.compact(v)
    end, "table expected")
end)

-- Compact returns the same table it received, so callers can chain.
tests:it("compact returns the identical table", function()
    local t = {1, 2, 3, x = "a"}
    assert(table.compact(t) == t)
end)

-- Compact preserves array contents, hash contents, and their combination.
tests:it("compact preserves array and hash contents", function()
    local t = {10, 20, 30, x = "a", y = "b"}
    t[4] = 40
    table.compact(t)
    assert(#t == 4)
    assert(t[1] == 10 and t[2] == 20 and t[3] == 30 and t[4] == 40)
    assert(t.x == "a" and t.y == "b")
end)

-- A hole is a real gap, and compact keeps the values on both sides of it rather
-- than sliding elements down to close the gap.
tests:it("compact keeps values on both sides of a hole", function()
    local t = {}
    t[1] = 1
    t[3] = 3
    t[5] = 5
    table.compact(t)
    assert(t[1] == 1 and t[3] == 3 and t[5] == 5)
    assert(t[2] == nil and t[4] == nil)
end)

-- A table whose entries are all string keys has no array part, and compact
-- leaves those entries reachable with a zero border.
tests:it("compact of a hash-only table preserves entries", function()
    local t = {}
    t.a = 1
    t.b = 2
    t.c = 3
    table.compact(t)
    assert(#t == 0)
    assert(t.a == 1 and t.b == 2 and t.c == 3)
end)

-- Compacting a table that holds nothing is legal and leaves it empty.
tests:it("compact of an empty table stays empty", function()
    local t = {}
    assert(table.compact(t) == t)
    assert(next(t) == nil)
end)

-- Compaction is idempotent, so a second call changes nothing observable.
tests:it("compact is idempotent", function()
    local t = {10, 20, 30, tag = "z"}
    table.compact(t)
    table.compact(t)
    assert(#t == 3)
    assert(t[1] == 10 and t[2] == 20 and t[3] == 30 and t.tag == "z")
end)

-- After compaction the length border and ipairs traversal agree with the
-- contiguous contents.
tests:it("compact keeps length and ipairs consistent on a dense array", function()
    local t = {1, 2, 3, 4, 5}
    table.compact(t)
    assert(#t == 5)
    local count = 0
    local sum = 0
    for _, v in ipairs(t) do
        count = count + 1
        sum = sum + v
    end
    assert(count == 5 and sum == 15)
end)

-- ipairs stops at the first nil regardless of compaction, and compaction does
-- not move the trailing value across the hole.
tests:it("compact preserves ipairs stopping at a hole", function()
    local t = {1, 2, 3, 4, 5}
    t[3] = nil
    table.compact(t)
    local count = 0
    for _, _ in ipairs(t) do count = count + 1 end
    assert(count == 2, "ipairs should stop at the hole")
    assert(t[4] == 4 and t[5] == 5, "trailing values must survive compaction")
end)

-- Compact performs raw storage access and does not trigger index metamethods
-- for the entries it relocates.
tests:it("compact does not fire index metamethods", function()
    local fired = false
    local t = setmetatable({1, 2, 3}, {
        __index = function() fired = true return 0 end,
        __newindex = function() fired = true end,
    })
    table.compact(t)
    assert(fired == false, "compact must use raw access")
    assert(t[1] == 1 and t[2] == 2 and t[3] == 3)
end)

-- Compaction after a mass deletion keeps the surviving entries intact. The
-- memory reclamation itself is measured softly to avoid allocator noise.
tests:soft("compact reclaims capacity after mass deletion", function()
    local t = {}
    for i = 1, 20000 do
        t[i] = i
        t["k" .. i] = i
    end
    for i = 6, 20000 do
        t[i] = nil
        t["k" .. i] = nil
    end
    collectgarbage("collect")
    local before = collectgarbage("count")
    table.compact(t)
    collectgarbage("collect")
    local after = collectgarbage("count")
    for i = 1, 5 do
        assert(t[i] == i and t["k" .. i] == i, "surviving entries must remain after compaction")
    end
    assert(after < before, "compaction should not grow memory after a mass deletion")
end)

tests:finish()

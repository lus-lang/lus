global require, ipairs, pairs, type, string, table, io, tojson, fromjson, tostring, pledge, select, tonumber, _lsp_handle, _lsp_handle_frame

pledge("load", "fs:read=./*")

-- Override io.write to capture output BEFORE loading wasm.lus
local capture_buffer = ""

local original_write = io.write
io.write = function(...)
  for i = 1, select("#", ...) do
    capture_buffer = capture_buffer .. tostring(select(i, ...))
  end
  return io  -- match io.write chaining
end

-- Now require wasm.lus which will define _lsp_handle and call pledge("seal")
require("lus-language.wasm")

local framework = require("lus-tests.framework")
local tests = framework.new("lsp-integration")
local transport = require("lus-language.transport")
local modules = require("lus-language.analysis.modules")
local uri_util = require("lus-language.util.uri")
local server_core = require("lus-language.server")

-- ---------------------------------------------------------------------------
-- Test helpers
-- ---------------------------------------------------------------------------

-- Helper to build an LSP range without inline ["end"] (formatter bug workaround)
local function make_range(sl, sc, el, ec)
  local r = {start = {line = sl, character = sc}}
  r["end"] = {line = el, character = ec}
  return r
end

local msg_id = 0

local function next_id()
  msg_id = msg_id + 1
  return msg_id
end

local function send(msg)
  capture_buffer = ""
  _lsp_handle(tojson(msg))
  return capture_buffer
end

local function send_request(method, params)
  local id = next_id()
  return send({
    jsonrpc = "2.0",
    id = id,
    method = method,
    params = params or {},
  }), id
end

local function send_notification(method, params)
  return send({
    jsonrpc = "2.0",
    method = method,
    params = params or {},
  })
end

-- Parse the first LSP response from the captured output
local function parse_response(raw)
  if not raw or raw == "" then return nil end
  -- Find Content-Length header
  local len_str = string.match(raw, "Content%-Length: (%d+)")
  if not len_str then return nil end
  -- Find the JSON body after the header
  local body_start = string.find(raw, "\r\n\r\n")
  if not body_start then return nil end
  local body = string.sub(raw, body_start + 4)
  local ok, result = catch fromjson(body)
  if ok then return result end
  return nil
end

-- Parse all LSP messages from captured output
local function parse_all_responses(raw)
  if not raw or raw == "" then return {} end
  local results = {}
  local pos = 1
  while pos <= #raw do
    local len_start, len_end = string.find(raw, "Content%-Length: (%d+)", pos)
    if not len_start then break end
    local len_str = string.match(raw, "Content%-Length: (%d+)", pos)
    local len = tonumber(len_str)
    local header_end = string.find(raw, "\r\n\r\n", len_end)
    if not header_end then break end
    local body_start = header_end + 4
    local body = string.sub(raw, body_start, body_start + len - 1)
    local ok, msg = catch fromjson(body)
    if ok and msg then
      results[#results + 1] = msg
    end
    pos = body_start + len
  end
  return results
end

-- =========================================================================
-- Tests
-- =========================================================================

tests:describe("LSP protocol integration")

-- Initialize handshake
tests:it("returns capabilities on initialize", function()
  local raw = send_request("initialize", {
    processId = 1,
    rootUri = "file:///test",
    capabilities = {},
  })
  local resp = parse_response(raw)
  tests:assert_not_nil(resp)
  tests:assert_not_nil(resp.result)
  tests:assert_not_nil(resp.result.capabilities)
  tests:assert_true(resp.result.capabilities.hoverProvider == true)
  tests:assert_true(resp.result.capabilities.definitionProvider == true)
  tests:assert_true(resp.result.capabilities.documentHighlightProvider == true)
  tests:assert_true(resp.result.capabilities.selectionRangeProvider == true)
  tests:assert_true(
    resp.result.capabilities.workspace.workspaceFolders.supported == true
  )
  tests:assert_equal(resp.result.serverInfo.version, "1.7.0")
end)

-- Initialized notification
tests:it("accepts initialized notification without error", function()
  local raw = send_notification("initialized", {})
  -- Should produce no response (it's a notification)
  tests:assert_equal(raw, "")
end)

-- Open document triggers diagnostics
tests:it("publishes diagnostics on didOpen", function()
  local raw = send_notification("textDocument/didOpen", {
    textDocument = {
      uri = "file:///test/integration.lus",
      languageId = "lus",
      version = 1,
      text = "local x = 1",
    },
  })
  -- Should publish diagnostics notification
  local msgs = parse_all_responses(raw)
  tests:assert_true(#msgs >= 1, "expected at least 1 message (diagnostics)")
  local diag_msg = msgs[1]
  tests:assert_equal(diag_msg.method, "textDocument/publishDiagnostics")
  tests:assert_not_nil(diag_msg.params)
  tests:assert_equal(diag_msg.params.uri, "file:///test/integration.lus")
end)

-- Change document triggers updated diagnostics with errors
tests:it("publishes error diagnostics on didChange with broken code", function()
  local raw = send_notification("textDocument/didChange", {
    textDocument = {
      uri = "file:///test/integration.lus",
      version = 2,
    },
    contentChanges = {
      {
        range = make_range(0, 0, 0, 11),
        text = "local = = =",
      },
    },
  })
  local msgs = parse_all_responses(raw)
  tests:assert_true(#msgs >= 1, "expected diagnostics")
  local diag_msg = msgs[1]
  tests:assert_equal(diag_msg.method, "textDocument/publishDiagnostics")
  tests:assert_true(#diag_msg.params.diagnostics > 0, "expected error diagnostics")
end)

-- Fix the doc back to valid code for subsequent tests
tests:it("clears diagnostics on valid code change", function()
  local raw = send_notification("textDocument/didChange", {
    textDocument = {
      uri = "file:///test/integration.lus",
      version = 3,
    },
    contentChanges = {
      {
        range = make_range(0, 0, 0, 11),
        text = "local x = 1\nlocal y = x + 1",
      },
    },
  })
  local msgs = parse_all_responses(raw)
  tests:assert_true(#msgs >= 1, "expected diagnostics notification")
  local diag_msg = nil
  for _, m in ipairs(msgs) do
    if m.method == "textDocument/publishDiagnostics" then diag_msg = m end
  end
  tests:assert_not_nil(diag_msg, "expected a publishDiagnostics notification")
  tests:assert_equal(diag_msg.params.uri, "file:///test/integration.lus")
  -- the syntax error must be gone: no error-severity diagnostics remain
  -- (lint hints like unused-local may still ride along)
  local error_count = 0
  for _, d in ipairs(diag_msg.params.diagnostics) do
    if d.severity == 1 then error_count = error_count + 1 end
    tests:assert_true(not string.find(d.message, "expected"),
      "stale syntax error should be cleared, still got: " .. d.message)
  end
  tests:assert_equal(error_count, 0, "error diagnostics should be cleared")
end)

-- Document symbols
tests:it("returns document symbols", function()
  local raw = send_request("textDocument/documentSymbol", {
    textDocument = {uri = "file:///test/integration.lus"},
  })
  local resp = parse_response(raw)
  tests:assert_not_nil(resp)
  tests:assert_not_nil(resp.result)
  tests:assert_type(resp.result, "table")
end)

-- Hover
tests:it("returns hover information", function()
  -- position (0, 6) sits on the x of "local x = 1", so hover must
  -- resolve to real content, not null
  local raw = send_request("textDocument/hover", {
    textDocument = {uri = "file:///test/integration.lus"},
    position = {line = 0, character = 6},
  })
  local resp = parse_response(raw)
  tests:assert_not_nil(resp)
  tests:assert_type(resp.result, "table")
  tests:assert_not_nil(resp.result.contents, "hover should carry contents")
  tests:assert_contains(resp.result.contents.value, "local x")
end)

-- Completion
tests:it("returns completions", function()
  local raw = send_request("textDocument/completion", {
    textDocument = {uri = "file:///test/integration.lus"},
    position = {line = 1, character = 10},
  })
  local resp = parse_response(raw)
  tests:assert_not_nil(resp)
  tests:assert_not_nil(resp.result)
end)

-- Unknown method returns MethodNotFound
tests:it("returns MethodNotFound for unknown methods", function()
  local raw = send_request("textDocument/unknownMethod", {
    textDocument = {uri = "file:///test/integration.lus"},
  })
  local resp = parse_response(raw)
  tests:assert_not_nil(resp)
  tests:assert_not_nil(resp.error)
  tests:assert_equal(resp.error.code, -32601)
end)

-- Document highlight
tests:it("returns document highlights", function()
  local raw = send_request("textDocument/documentHighlight", {
    textDocument = {uri = "file:///test/integration.lus"},
    position = {line = 0, character = 6},
  })
  local resp = parse_response(raw)
  tests:assert_not_nil(resp)
  tests:assert_not_nil(resp.result)
end)

-- Selection range
tests:it("returns selection ranges", function()
  local raw = send_request("textDocument/selectionRange", {
    textDocument = {uri = "file:///test/integration.lus"},
    positions = {{line = 0, character = 6}},
  })
  local resp = parse_response(raw)
  tests:assert_not_nil(resp)
  tests:assert_not_nil(resp.result)
end)

-- Code action
tests:it("returns code actions for diagnostics", function()
  local raw = send_request("textDocument/codeAction", {
    textDocument = {uri = "file:///test/integration.lus"},
    range = make_range(0, 0, 0, 0),
    context = {diagnostics = {}},
  })
  local resp = parse_response(raw)
  tests:assert_not_nil(resp)
  tests:assert_not_nil(resp.result)
end)

-- Prepare rename
tests:it("returns prepare rename result", function()
  local raw = send_request("textDocument/prepareRename", {
    textDocument = {uri = "file:///test/integration.lus"},
    position = {line = 0, character = 6},
  })
  local resp = parse_response(raw)
  tests:assert_not_nil(resp)
  -- result may be null or a range+placeholder depending on position
end)

-- Shutdown
tests:it("responds to shutdown with null result", function()
  local raw = send_request("shutdown", {})
  local resp = parse_response(raw)
  tests:assert_not_nil(resp)
  -- result should be null (JSON null)
  -- In Lus, tojson encodes NaN as null, and fromjson may decode it as nil or NaN
end)

-- Close document
tests:it("accepts didClose without error", function()
  local raw = send_notification("textDocument/didClose", {
    textDocument = {uri = "file:///test/integration.lus"},
  })
  -- Should produce no direct response (notification)
  -- But might produce diagnostics clear
end)

-- Full lifecycle test
tests:describe("full lifecycle")

tests:it("open -> edit -> get completions -> close", function()
  -- Open
  send_notification("textDocument/didOpen", {
    textDocument = {
      uri = "file:///test/lifecycle.lus",
      languageId = "lus",
      version = 1,
      text = "local greeting = 'hello'\nlocal msg = gre",
    },
  })

  -- Edit (add more text)
  send_notification("textDocument/didChange", {
    textDocument = {uri = "file:///test/lifecycle.lus", version = 2},
    contentChanges = {
      {
        range = make_range(1, 15, 1, 15),
        text = "eting",
      },
    },
  })

  -- Get completions
  local raw = send_request("textDocument/completion", {
    textDocument = {uri = "file:///test/lifecycle.lus"},
    position = {line = 1, character = 20},
  })
  local resp = parse_response(raw)
  tests:assert_not_nil(resp)

  -- Close
  send_notification("textDocument/didClose", {
    textDocument = {uri = "file:///test/lifecycle.lus"},
  })
end)

-- =========================================================================
-- Strict framing and workspace mirrors
-- =========================================================================

tests:describe("strict framing")

tests:it("accepts one canonical frame", function()
  local body = '{"jsonrpc":"2.0","id":1,"method":"shutdown"}'
  local msg, reason = transport.parse_frame(
    "Content-Length: " .. #body .. "\r\n\r\n" .. body
  )
  tests:assert_nil(reason)
  tests:assert_equal(msg.method, "shutdown")

  msg, reason = transport.parse_frame(
    "Content-Length: " .. #body ..
    "\r\nContent-Type: application/vscode-jsonrpc; charset=utf-8" ..
    "\r\n\r\n" .. body
  )
  tests:assert_nil(reason)
  tests:assert_equal(msg.method, "shutdown")
end)

tests:it("rejects ambiguous or noncanonical framing", function()
  local body = "{}"
  local cases = {
    "Content-Length: 2\n\n" .. body,
    "Content-Length: 2\r\nContent-Length: 2\r\n\r\n" .. body,
    "Content-Length: 1\r\n\r\n" .. body,
    "Content-Length: 3\r\n\r\n" .. body,
    "Content-Length: 16777217\r\n\r\n",
    "Content-Length: +2\r\n\r\n" .. body,
    "Content-Length: 02\r\n\r\n" .. body,
    "Content-Length: 2\r\nContent-Type: text/plain\r\n\r\n" .. body,
  }
  for _, frame in ipairs(cases) do
    local msg, reason = transport.parse_frame(frame)
    tests:assert_nil(msg)
    tests:assert_not_nil(reason)
  end
end)

tests:it("rejects invalid UTF-8 and JSON trailing data", function()
  local bad_utf8 = "{\"x\":\"\255\"}"
  local msg, reason = transport.decode_json(bad_utf8)
  tests:assert_nil(msg)
  tests:assert_contains(reason, "UTF%-8")

  msg, reason = transport.decode_json("{} true")
  tests:assert_nil(msg)
  tests:assert_contains(reason, "invalid JSON")
end)

tests:it("routes false-valued JSON to Invalid Request", function()
  for _, body in ipairs({"null", "false"}) do
    local msg, reason = transport.decode_json(body)
    tests:assert_nil(reason)
    local fresh = server_core.new()
    local response = fresh.dispatch(msg)
    tests:assert_equal(response.error.code, -32600)
  end
end)

tests:it("caps outbound JSON bodies at 16 MiB", function()
  local frame, reason = transport.encode_message({
    jsonrpc = "2.0",
    id = 82,
    result = string.rep("x", transport.MAX_FRAME_BYTES),
  })
  tests:assert_nil(frame)
  tests:assert_contains(reason, "16 MiB")
end)

tests:it("keeps framed WASM dispatch aligned with the shared server", function()
  local fresh = server_core.new()
  fresh.dispatch({
    jsonrpc = "2.0",
    id = 80,
    method = "initialize",
    params = {rootUri = "file:///test"},
  })
  local direct = fresh.dispatch({
    jsonrpc = "2.0",
    id = 81,
    method = "lus/unknown",
    params = {},
  })

  local body = tojson({
    jsonrpc = "2.0",
    id = 81,
    method = "lus/unknown",
    params = {},
  })
  capture_buffer = ""
  _lsp_handle_frame(
    "Content-Length: " .. #body .. "\r\n\r\n" .. body
  )
  local framed = parse_response(capture_buffer)
  tests:assert_equal(framed.error.code, direct.error.code)
  tests:assert_equal(framed.error.message, direct.error.message)
end)

tests:describe("workspace mirror")

local ROOT_A = "vscode-remote://ssh-remote+box/work/a"
local ROOT_B = "vscode-remote://ssh-remote+box/work/b"
local URI_A = ROOT_A .. "/lib/tool.lus"
local URI_B = ROOT_B .. "/lib/tool.lus"
local MIRROR_URI = ROOT_A .. "/closed.lus"

local function upsert(root_uri, relative_path, exact_uri, version, text)
  send_notification("lus/workspace/upsert", {
    rootUri = root_uri,
    relativePath = relative_path,
    uri = exact_uri,
    version = version,
    text = text,
  })
end

tests:it("accepts a silent workspace seed before initialization", function()
  local fresh = server_core.new()
  capture_buffer = ""
  fresh.dispatch({
    jsonrpc = "2.0",
    method = "lus/workspace/reset",
    params = {roots = {ROOT_A}},
  })
  fresh.dispatch({
    jsonrpc = "2.0",
    method = "lus/workspace/upsert",
    params = {
      rootUri = ROOT_A,
      relativePath = "seeded.lus",
      uri = ROOT_A .. "/seeded.lus",
      version = 1,
      text = "return true",
    },
  })
  tests:assert_equal(capture_buffer, "")
  local response = fresh.dispatch({
    jsonrpc = "2.0",
    id = 91,
    method = "initialize",
    params = {workspaceFolders = {{uri = ROOT_A, name = "a"}}},
  })
  tests:assert_equal(response.result.serverInfo.version, "1.7.0")
  tests:assert_equal(modules.resolve("seeded", ROOT_A .. "/main.lus"),
    ROOT_A .. "/seeded.lus")
  capture_buffer = ""
  fresh.dispatch({
    jsonrpc = "2.0",
    method = "initialized",
    params = {},
  })
  tests:assert_true(string.find(
    capture_buffer, ROOT_A .. "/seeded.lus", 1, true
  ) ~= nil)
end)

tests:it("resolves the requesting root first and preserves exact URIs", function()
  send_notification("lus/workspace/reset", {roots = {ROOT_A, ROOT_B}})
  upsert(ROOT_A, "lib/tool.lus", URI_A, 1,
    "local M = {}\nM.a = 1\nreturn M")
  upsert(ROOT_B, "lib/tool.lus", URI_B, 1,
    "local M = {}\nM.b = 2\nreturn M")

  tests:assert_equal(modules.resolve("lib.tool", ROOT_A .. "/main.lus"), URI_A)
  tests:assert_equal(modules.resolve("lib.tool", ROOT_B .. "/main.lus"), URI_B)
end)

tests:it("uses the documented candidate order including Lua init files", function()
  local direct = ROOT_B .. "/pkg.lus"
  upsert(ROOT_B, "pkg/init.lus", ROOT_B .. "/pkg/init.lus", 1,
    "return {from_init = true}")
  upsert(ROOT_B, "pkg.lus", direct, 1, "return {from_file = true}")
  upsert(ROOT_B, "fallback/init.lua", ROOT_B .. "/fallback/init.lua", 1,
    "return {lua_init = true}")

  tests:assert_equal(modules.resolve("pkg", ROOT_B .. "/main.lus"), direct)
  tests:assert_equal(modules.resolve("fallback", ROOT_B .. "/main.lus"),
    ROOT_B .. "/fallback/init.lua")
end)

tests:it("invalidates versioned module exports without cross-root leakage", function()
  local a_exports = modules.get_exports("lib.tool", ROOT_A .. "/main.lus")
  local b_exports = modules.get_exports("lib.tool", ROOT_B .. "/main.lus")
  tests:assert_equal(a_exports[1].name, "a")
  tests:assert_equal(b_exports[1].name, "b")

  upsert(ROOT_A, "lib/tool.lus", URI_A, 2,
    "local M = {}\nM.updated = 3\nreturn M")
  a_exports = modules.get_exports("lib.tool", ROOT_A .. "/main.lus")
  b_exports = modules.get_exports("lib.tool", ROOT_B .. "/main.lus")
  tests:assert_equal(a_exports[1].name, "updated")
  tests:assert_equal(b_exports[1].name, "b")
end)

tests:it("promotes a newly created higher-priority module candidate", function()
  upsert(ROOT_B, "promote.lus", ROOT_B .. "/promote.lus", 1,
    "local M = {}\nM.from_b = true\nreturn M")
  local exports = modules.get_exports("promote", ROOT_A .. "/main.lus")
  tests:assert_equal(exports[1].name, "from_b")

  upsert(ROOT_A, "promote.lus", ROOT_A .. "/promote.lus", 1,
    "local M = {}\nM.from_a = true\nreturn M")
  exports = modules.get_exports("promote", ROOT_A .. "/main.lus")
  tests:assert_equal(exports[1].name, "from_a")
end)

tests:it("indexes closed files while open text remains authoritative", function()
  upsert(ROOT_A, "closed.lus", MIRROR_URI, 1,
    "global mirrored_symbol\nmirrored_symbol = 1")

  local raw = send_request("workspace/symbol", {query = "mirrored_symbol"})
  local resp = parse_response(raw)
  tests:assert_true(#resp.result >= 1)

  send_notification("textDocument/didOpen", {
    textDocument = {
      uri = MIRROR_URI,
      languageId = "lus",
      version = 2,
      text = "global open_symbol\nopen_symbol = 2",
    },
  })
  raw = send_request("workspace/symbol", {query = "open_symbol"})
  resp = parse_response(raw)
  tests:assert_true(#resp.result >= 1)

  send_notification("textDocument/didClose", {
    textDocument = {uri = MIRROR_URI},
  })
  raw = send_request("workspace/symbol", {query = "mirrored_symbol"})
  resp = parse_response(raw)
  tests:assert_true(#resp.result >= 1)
end)

tests:it("deletes closed mirrors and retains URI authorities", function()
  send_notification("lus/workspace/delete", {
    rootUri = ROOT_A,
    relativePath = "closed.lus",
    uri = MIRROR_URI,
    version = 3,
  })
  local raw = send_request("workspace/symbol", {query = "mirrored_symbol"})
  local resp = parse_response(raw)
  tests:assert_equal(#resp.result, 0)

  tests:assert_equal(uri_util.to_path("file://server/share/a.lus"),
    "//server/share/a.lus")
  tests:assert_true(uri_util.within("file://SERVER/Share/Project",
    "file://server/share/project/a.lus"))
  tests:assert_equal(uri_util.join(ROOT_A, "space name/main.lus"),
    ROOT_A .. "/space%20name/main.lus")
end)

tests:it("resolves Windows drive and UNC workspace URIs", function()
  local windows_root = "file:///C:/Workspace"
  local unc_root = "file://server/share/project"
  send_notification("lus/workspace/reset", {roots = {windows_root, unc_root}})
  upsert(windows_root, "lib/win.lus",
    "file:///C:/Workspace/lib/win.lus", 1, "return true")
  upsert(unc_root, "lib/unc.lus",
    "file://server/share/project/lib/unc.lus", 1, "return true")

  tests:assert_equal(modules.resolve("lib.win",
    "file:///C:/Workspace/main.lus"),
    "file:///C:/Workspace/lib/win.lus")
  tests:assert_equal(modules.resolve("lib.unc",
    "file://server/share/project/main.lus"),
    "file://server/share/project/lib/unc.lus")
end)

tests:it("uses recorded and most-specific nested workspace roots", function()
  local parent_root = "vscode-remote://ssh-remote+box/work"
  local nested_root = parent_root .. "/project"
  send_notification("lus/workspace/reset", {
    roots = {parent_root, nested_root, ROOT_B},
  })
  upsert(parent_root, "lib/choice.lus",
    parent_root .. "/lib/choice.lus", 1,
    "local M = {}\nM.from_parent = true\nreturn M")
  upsert(nested_root, "lib/choice.lus",
    nested_root .. "/lib/choice.lus", 1,
    "local M = {}\nM.from_nested = true\nreturn M")
  upsert(parent_root, "lib/remaining.lus",
    parent_root .. "/lib/remaining.lus", 1, "return true")
  upsert(ROOT_B, "lib/remaining.lus",
    ROOT_B .. "/lib/remaining.lus", 1, "return true")

  local recorded_uri = nested_root .. "/src/recorded.lus"
  upsert(parent_root, "project/src/recorded.lus", recorded_uri, 1,
    "return true")
  tests:assert_equal(modules.resolve("lib.choice", recorded_uri),
    parent_root .. "/lib/choice.lus")

  local unrecorded_uri = nested_root .. "/src/unrecorded.lus"
  tests:assert_equal(modules.resolve("lib.choice", unrecorded_uri),
    nested_root .. "/lib/choice.lus")
  tests:assert_equal(modules.resolve("lib.remaining", unrecorded_uri),
    parent_root .. "/lib/remaining.lus")

  local parent_exports = modules.get_exports("lib.choice", recorded_uri)
  local nested_exports = modules.get_exports("lib.choice", unrecorded_uri)
  tests:assert_equal(parent_exports[1].name, "from_parent")
  tests:assert_equal(nested_exports[1].name, "from_nested")
end)

tests:it("treats unavailable disk probes as absent", function()
  local denied_root = "file:///outside-lsp-workspace"
  send_notification("lus/workspace/reset", {roots = {denied_root}})
  local ok, resolved = catch modules.resolve(
    "missing", denied_root .. "/main.lus"
  )
  tests:assert_true(ok, "rooted probe must not escape")
  tests:assert_nil(resolved)

  local denied_uri = denied_root .. "/lint.lus"
  local raw = send_notification("textDocument/didOpen", {
    textDocument = {
      uri = denied_uri,
      languageId = "lus",
      version = 1,
      text = "local unused = require('missing')",
    },
  })
  local messages = parse_all_responses(raw)
  local found_unused = false
  for _, message in ipairs(messages) do
    for _, diagnostic in ipairs(
      message.params and message.params.diagnostics or {}
    ) do
      if string.find(diagnostic.message, "Unused", 1, true) then
        found_unused = true
      end
    end
  end
  tests:assert_true(found_unused, "pledged lint must keep running")
  send_notification("textDocument/didClose", {
    textDocument = {uri = denied_uri},
  })

  send_notification("lus/workspace/reset", {roots = {}})
  ok, resolved = catch modules.resolve(
    "/outside-lsp-workspace/missing", denied_root .. "/main.lus"
  )
  tests:assert_true(ok, "rootless probe must not escape")
  tests:assert_nil(resolved)
end)

tests:it("does not probe host disk for mirrored or virtual origins", function()
  local file_root = "file:///mirrored-lsp-workspace"
  local file_origin = file_root .. "/main.lus"
  send_notification("lus/workspace/reset", {roots = {file_root}})
  upsert(file_root, "main.lus", file_origin, 1, "return true")

  local original_open = io.open
  local probes = 0
  io.open = function()
    probes = probes + 1
    return nil, "unavailable"
  end
  local ok, resolved = catch modules.resolve("not_mirrored", file_origin)
  io.open = original_open
  tests:assert_true(ok)
  tests:assert_nil(resolved)
  tests:assert_equal(probes, 0)

  local virtual_root = "memory://workspace/project"
  local virtual_origin = virtual_root .. "/main.lus"
  send_notification("lus/workspace/reset", {roots = {virtual_root}})
  upsert(virtual_root, "main.lus", virtual_origin, 1, "return true")
  probes = 0
  io.open = function()
    probes = probes + 1
    return nil, "unavailable"
  end
  ok, resolved = catch modules.resolve("not_virtual", virtual_origin)
  io.open = original_open
  tests:assert_true(ok)
  tests:assert_nil(resolved)
  tests:assert_equal(probes, 0)
end)

-- =========================================================================
tests:finish()

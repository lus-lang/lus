  "h2": {
    "entries": [
      {
        "id": "h2/stack",
        "target": "test_stack",
        "source": "lus-tests/h2/test_stack.c"
      },
      {
        "id": "h2/call",
        "target": "test_call",
        "source": "lus-tests/h2/test_call.c"
      },
      {
        "id": "h2/sqlite",
        "target": "test_sqlite",
        "source": "lus-tests/h2/test_sqlite.c",
        "sqlite_include": true
      },
      {
        "id": "h2/query",
        "target": "test_query",
        "source": "lus-tests/h2/test_query.c"
      },
      {
        "id": "h2/query_hostile",
        "target": "test_query_hostile",
        "source": "lus-tests/h2/test_query_hostile.c",
        "sqlite_include": true
      },
      {
        "id": "h2/worker",
        "target": "test_worker",
        "source": "lus-tests/h2/test_worker.c",
        "timeout": 30,
        "fixtures": ["lus-tests/h2/worker_state.lus"]
      },
      {
        "id": "h2/worker-idle",
        "target": "test_worker_idle",
        "source": "lus-tests/h2/test_worker_idle.c",
        "timeout": 30,
        "fixtures": ["lus-tests/h4/worker_idle.lus"]
      },
      {
        "id": "h2/bundle_handle",
        "target": "test_bundle_handle",
        "source": "lus-tests/h2/test_bundle_handle.c",
        "timeout": 30
      },
      {
        "id": "h2/prefix",
        "target": "test_prefix",
        "source": "lus-tests/h2/test_prefix.c",
        "lus_c_args": true
      },
      {
        "id": "h2/wasm_bridge",
        "target": "test_wasm_bridge",
        "source": "lus-tests/h2/test_wasm_bridge.c",
        "timeout": 90,
        "extra_sources": ["lus/wasm/lus_wasm.c"],
        "wasm_include": true,
        "lus_c_args": true
      },
      {
        "id": "h2/authpath_windows",
        "target": "test_authpath_windows",
        "source": "lus-tests/h2/test_authpath_windows.c",
        "timeout": 90,
        "platforms": ["windows"]
      },
      {
        "id": "h2/authpath_posix",
        "target": "test_authpath_posix",
        "source": "lus-tests/h2/test_authpath_posix.c",
        "timeout": 30,
        "platforms": ["darwin", "linux"]
      }
    ],
    "required_roles": {
      "idle-worker": {
        "fixture": "lus-tests/h4/worker_idle.lus",
        "consumer": "h2/worker-idle"
      }
    }
  }

-- In-memory SQLite statement and row materialization experiment.

global print, os, string, io

local db <close> = io.sqlite(":memory:")
db:exec("CREATE TABLE values_h4 (id INTEGER PRIMARY KEY, value INTEGER)")
local iterations = 300000
local checksum = 0

local start = os.clock()
db:exec("BEGIN")
for i = 1, iterations do
    db:run("INSERT INTO values_h4 (id, value) VALUES (?, ?)", i, i * 3)
end
db:exec("COMMIT")
for row in db:query("SELECT value FROM values_h4 ORDER BY id") do
    checksum = checksum + row.value
end
local elapsed = os.clock() - start

print(string.format("TIME %.9f", elapsed))
print("CHECK " .. checksum)

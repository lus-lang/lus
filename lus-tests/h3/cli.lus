global print, require, assert, type, os, fs, io, string, table, arg, tostring, collectgarbage, package, pledge, ipairs

pledge("load", "fs", "exec", "seal")

local framework = require("lus-tests.framework")
local tests = framework.new("cli")

local lus_bin = "lus" -- start with assumption
local windows = package.config:sub(1, 1) == "\\"
local path_separator = package.config:sub(1, 1)
local fixture_number = 0

if arg and arg[-1] then
    -- Try to deduce binary from how we were called
    lus_bin = arg[-1]
end

local function run_lus(args)
    local cmd = lus_bin .. " " .. args
    local h = io.popen(cmd)
    local out = h:read("*a")
    h:close()
    return out
end

local function run_command(command)
    local h = io.popen(command .. " 2>&1")
    assert(h, "could not start command: " .. command)
    local out = h:read("*a")
    local ok = h:close()
    return ok == true or ok == 0, out
end

local function path(...)
    return fs.path.join(...)
end

local function write_file(filename, contents)
    local file = assert(io.open(filename, "wb"))
    assert(file:write(contents))
    assert(file:close())
end

local function new_fixture()
    fixture_number = fixture_number + 1
    local root = "h3c" .. tostring(fixture_number)
    local entry_base = "h3e" .. tostring(fixture_number)
    local entry = path(root, entry_base .. ".lus")
    local output = entry_base .. (windows and ".exe" or "")
    catch fs.remove(root, true)
    catch fs.remove(output)
    fs.createdirectory(root)
    return root, entry, output
end

local function clean_fixture(root, output)
    catch fs.remove(root, true)
    if output then
        catch fs.remove(output)
    end
end

local function path_exists(filename)
    local ok = catch fs.type(filename)
    return ok
end

local function build_standalone(entry, includes)
    local parts = {lus_bin, "--standalone", entry}
    for i = 1, #includes do
        parts[#parts + 1] = "--include"
        parts[#parts + 1] = includes[i]
    end
    return run_command(table.concat(parts, " "))
end

local function run_standalone(output)
    local executable = "." .. path_separator .. output
    return run_command(executable)
end

local function lusc_binary()
    if windows then
        return (lus_bin:gsub("lus%.exe$", "lusc.exe"))
    end
    return (lus_bin:gsub("lus$", "lusc"))
end

tests:it("version check (-v)", function()
    local out = run_lus("-v")
    assert(string.find(out, "Lus") or string.find(out, "Lua")) -- Depending on branding
end)

tests:it("execute string (-e)", function()
    local quote = (package.config:sub(1,1) == "\\") and '"' or "'"
    local out = run_lus("-e " .. quote .. "print(10*10)" .. quote)
    -- popen output trailing newline often
    assert(string.find(out, "100"))
end)

tests:it("script execution", function()
    local tmp = os.tmpname()
    local f = io.open(tmp, "w")
    f:write("print('hello from file')")
    f:close()
    
    local out = run_lus(tmp)
    assert(string.find(out, "hello from file"))
    fs.remove(tmp)
end)

tests:it("stdin execution (-)", function()
    -- echo "print(123)" | lus -
    local sep = (package.config:sub(1,1) == "\\") and "&" or ";"
    local cmd
    if package.config:sub(1,1) == "\\" then 
        -- Windows cmd.exe: echo print(123) | lus -
        cmd = "echo print(123) | " .. lus_bin .. " -"
    else
        cmd = "echo \"print(123)\" | " .. lus_bin .. " -"
    end
    
    local h = io.popen(cmd)
    local out = h:read("*a")
    h:close()
    assert(string.find(out, "123"))
end)

tests:it("scoped AST outputs cannot follow a link outside their write grant", function()
    local root, entry = new_fixture()
    local allowed = path(root, "allowed")
    local outside = path(root, "outside.json")
    local output = path(allowed, "ast.json")
    fs.createdirectory(allowed)
    write_file(entry, "local answer = 42\n")
    write_file(outside, "outside sentinel\n")
    fs.createlink(output, "../outside.json")

    for _, option in ipairs({"--ast-json", "--ast-graph"}) do
        local ok, command_out = run_command(table.concat({
            lus_bin,
            "-Pload",
            "-Pfs:read=" .. entry,
            "-Pfs:write=" .. allowed .. "/*",
            option,
            output,
            entry,
        }, " "))
        assert(not ok, "linked AST output escaped its grant: " .. command_out)
        local escaped = assert(io.open(outside, "rb"))
        assert(escaped:read("a") == "outside sentinel\n",
            "AST output changed the link target outside its grant")
        assert(escaped:close())
    end
    clean_fixture(root)
end)

tests:it("unpledged AST JSON output remains available", function()
    local root, entry = new_fixture()
    local output = path(root, "ast.json")
    write_file(entry, "local answer = 42\n")
    local ok, command_out = run_command(table.concat({
        lus_bin,
        "--ast-json",
        output,
        entry,
    }, " "))
    assert(ok, command_out)
    local generated = assert(io.open(output, "rb"))
    local contents = assert(generated:read("a"))
    assert(generated:close())
    assert(contents:find('"type"', 1, true), contents)
    clean_fixture(root)
end)

tests:it("link metadata and deletion authorize the link object", function()
    local root, script = new_fixture()
    local target = path(root, "target.txt")
    local allowed_link = path(root, "allowed-link")
    local blocked_link = path(root, "blocked-link")
    write_file(target, "target\n")
    write_file(script, [[
global fs, arg, assert, print
if arg[1] == "inspect" then
    local kind, linked = fs.type(arg[2])
    assert(kind == "file" and linked == true)
    assert(fs.follow(arg[2]) == "target.txt")
    fs.remove(arg[2])
    print("link-object-ok")
else
    fs.remove(arg[2])
end
]])
    fs.createlink(allowed_link, "target.txt")
    local inspected, inspect_out = run_command(table.concat({
        lus_bin,
        "-Pload",
        "-Pfs:read=" .. script,
        "-Pfs:read=" .. allowed_link,
        "-Pfs:write=" .. allowed_link,
        script,
        "inspect",
        allowed_link,
    }, " "))
    assert(inspected and inspect_out:find("link-object-ok", 1, true),
        inspect_out)
    assert(not path_exists(allowed_link), "authorized link was not removed")
    assert(path_exists(target), "link deletion removed its target")

    fs.createlink(blocked_link, "target.txt")
    local removed, remove_out = run_command(table.concat({
        lus_bin,
        "-Pload",
        "-Pfs:read=" .. script,
        "-Pfs:write=" .. target,
        script,
        "remove",
        blocked_link,
    }, " "))
    assert(not removed, "target authority removed an ungranted link: " ..
        remove_out)
    assert(path_exists(blocked_link), "ungranted link was removed")
    clean_fixture(root)
end)

tests:it("scoped standalone output stays within its write grant", function()
    local root, entry, output = new_fixture()
    local outside = path(root, "outside.bin")
    local command = table.concat({
        lus_bin,
        "--standalone",
        entry,
        "-Pload",
        "-Pfs:read=" .. entry,
        "-Pfs:write=./" .. output .. "*",
    }, " ")
    write_file(entry, "print('scoped-standalone-ok')\n")
    write_file(outside, "outside sentinel\n")
    fs.createlink(output, outside)

    local escaped, escape_out = run_command(command)
    assert(not escaped,
        "linked standalone output escaped its grant: " .. escape_out)
    local untouched = assert(io.open(outside, "rb"))
    assert(untouched:read("a") == "outside sentinel\n",
        "standalone output changed the link target outside its grant")
    assert(untouched:close())

    fs.remove(output)
    local built, build_out = run_command(command)
    assert(built, build_out)
    local ran, run_out = run_standalone(output)
    assert(ran and run_out:find("scoped-standalone-ok", 1, true), run_out)
    clean_fixture(root, output)
end)

tests:it("standalone owns mixed direct and recursive include specs", function()
    local root, entry, output = new_fixture()
    local modules = path(root, "mods")
    local nested = path(modules, "nested")
    fs.createdirectory(nested, true)
    write_file(path(root, "direct.lus"), "return 'direct'\n")
    write_file(path(modules, "alpha.lus"), "return 'alpha'\n")
    write_file(path(nested, "beta.lus"), "return 'beta'\n")
    write_file(entry, [[
local direct = require("direct")
local alpha = require("mods.alpha")
local beta = require("mods.nested.beta")
print(direct .. ":" .. alpha .. ":" .. beta)
]])

    local ok, out = build_standalone(entry, {
        path(root, "direct.lus"),
        modules,
    })
    assert(ok, out)
    local ran, run_out = run_standalone(output)
    assert(ran, run_out)
    assert(run_out:find("direct:alpha:beta", 1, true), run_out)
    clean_fixture(root, output)
end)

tests:it("standalone fails closed after a partially compiled include list", function()
    local root, entry, output = new_fixture()
    local broken = path(root, "broken")
    fs.createdirectory(broken)
    write_file(entry, "print('entry')\n")
    write_file(path(root, "direct.lus"), "return 'compiled first'\n")
    write_file(path(broken, "bad.lus"), "local = broken\n")

    local ok, out = build_standalone(entry, {
        path(root, "direct.lus"),
        broken,
    })
    assert(not ok, "invalid include unexpectedly built: " .. out)
    assert(out:find("bad.lus", 1, true), out)
    assert(not path_exists(output), "failed build left an executable")
    clean_fixture(root, output)
end)

tests:it("standalone accepts 256 and 257 direct include arguments", function()
    local root, entry, output = new_fixture()
    local includes = {}
    write_file(entry, "print('direct-count-ok')\n")
    for i = 1, 257 do
        local filename = path(root, string.format("m%03d.lus", i))
        write_file(filename, "return " .. tostring(i) .. "\n")
        includes[i] = filename
    end

    local first_ok, first_out = build_standalone(entry,
        {table.unpack(includes, 1, 256)})
    assert(first_ok, first_out)
    catch fs.remove(output)
    local second_ok, second_out = build_standalone(entry, includes)
    assert(second_ok, second_out)
    local ran, run_out = run_standalone(output)
    assert(ran and run_out:find("direct-count-ok", 1, true), run_out)
    clean_fixture(root, output)
end)

tests:it("standalone permits 1024 final files and rejects 1025", function()
    local root, entry, output = new_fixture()
    local modules = path(root, "many")
    fs.createdirectory(modules)
    write_file(entry, "print('expanded-count-ok')\n")
    for i = 1, 1023 do
        write_file(path(modules, string.format("m%04d.lus", i)),
            "return " .. tostring(i) .. "\n")
    end

    local exact_ok, exact_out = build_standalone(entry, {modules})
    assert(exact_ok, exact_out)
    local ran, run_out = run_standalone(output)
    assert(ran and run_out:find("expanded-count-ok", 1, true), run_out)
    catch fs.remove(output)

    write_file(path(modules, "m1024.lus"), "return 1024\n")
    local excess_ok, excess_out = build_standalone(entry, {modules})
    assert(not excess_ok, "1025 final files unexpectedly built")
    assert(excess_out:find("too many include files", 1, true), excess_out)
    assert(not path_exists(output), "over-limit build left an executable")
    clean_fixture(root, output)
end)

tests:it("same-build compiler chunks round trip and reject header damage", function()
    local root, entry = new_fixture()
    local chunk = path(root, "entry.lusc")
    local corrupt = path(root, "corrupt.lusc")
    write_file(entry, "print('binary-round-trip')\n")

    local compiled, compile_out = run_command(lusc_binary() .. " -o " ..
        chunk .. " " .. entry)
    assert(compiled, compile_out)
    local ran, run_out = run_command(lus_bin .. " " .. chunk)
    assert(ran, run_out)
    assert(run_out:find("binary-round-trip", 1, true), run_out)

    local input = assert(io.open(chunk, "rb"))
    local bytes = assert(input:read("*a"))
    assert(input:close())
    assert(#bytes > 5, "compiler emitted a short chunk")
    local bad_version = (string.byte(bytes, 5) + 1) & 0xff
    write_file(corrupt, bytes:sub(1, 4) .. string.char(bad_version) ..
        bytes:sub(6))
    local accepted, damage_out = run_command(lus_bin .. " " .. corrupt)
    assert(not accepted, "damaged binary header was accepted")
    assert(damage_out:find("version mismatch", 1, true) or
        damage_out:find("binary", 1, true), damage_out)
    clean_fixture(root)
end)

tests:finish()

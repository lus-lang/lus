global assert, network, os, pledge, require, tostring, type

pledge("load", "fs", "network", "env", "seal")

local framework = require("lus-tests.framework")
local tests = framework.new("network-tls")
local port = assert(os.getenv("LUS_H3_TLS_PORT"), "missing TLS fixture port")
local base = "https://127.0.0.1:" .. port

tests:it("local HTTPS GET returns content and headers", function()
    local status, body, headers = network.fetch(base .. "/status/200")
    assert(status == 200, "status should be 200, got " .. tostring(status))
    assert(body == "release-ready\n", "unexpected response body")
    assert(type(headers) == "table", "headers should be a table")
end)

tests:it("local HTTPS reports successful status variants", function()
    local created = network.fetch(base .. "/status/201")
    local empty = network.fetch(base .. "/status/204")
    assert(created == 201, "status should be 201")
    assert(empty == 204, "status should be 204")
end)

tests:it("local HTTPS exposes redirects without following them", function()
    local status, _, headers = network.fetch(base .. "/redirect")
    assert(status == 301, "redirect status should be 301")
    assert(headers.location == "/status/200", "location should be exposed")
end)

tests:it("local HTTPS reports client error statuses", function()
    assert(network.fetch(base .. "/status/400") == 400)
    assert(network.fetch(base .. "/status/404") == 404)
end)

tests:it("local HTTPS reports server error status", function()
    assert(network.fetch(base .. "/status/500") == 500)
end)

tests:finish()

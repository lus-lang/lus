#!/bin/sh
# Checks a commit before git records it: the format of the staged Zig
# files, the repository lint, the generated files when their sources are
# staged, that every new file belongs to an area of tools/ci/areas.json,
# and that .github/CODEOWNERS agrees with that map.
# `mise run setup` points git at this directory. `git commit --no-verify`
# skips the hook, and CI runs the same checks.

set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

fail=0

zig_files=$(printf '%s\n' "$staged" | grep -E '\.zig$' || true)
if [ -n "$zig_files" ]; then
  if command -v zig > /dev/null 2>&1; then
    # shellcheck disable=SC2086
    if ! zig fmt --check $zig_files; then
      echo "pre-commit: run zig fmt on the files above" >&2
      fail=1
    fi
  else
    echo "pre-commit: run mise install to put zig on the PATH, so the hook can check the format of your Zig files" >&2
  fi
fi

if ! node tools/lint-repo.js > /dev/null; then
  node tools/lint-repo.js >&2 || true
  fail=1
fi

if printf '%s\n' "$staged" | grep -qE '^(spec/|tools/build-(lsp|grammar)\.js|packages/textmate/|packages/language-server/analysis/stdlib_data\.lus)'; then
  if ! node tools/build-lsp.js --check > /dev/null || ! node tools/build-grammar.js --check > /dev/null; then
    echo "pre-commit: run mise run gen to bring the generated files up to date" >&2
    fail=1
  fi
fi

if [ -n "$(git diff --cached --name-only --diff-filter=A)" ]; then
  if ! missing=$(node tools/ci/areas.mjs unmatched); then
    echo "pre-commit: add these files to an area of tools/ci/areas.json:" >&2
    printf '%s\n' "$missing" >&2
    fail=1
  fi
fi

if printf '%s\n' "$staged" | grep -qE '^(tools/ci/areas\.json|\.github/CODEOWNERS)$' || [ -n "$(git diff --cached --name-only --diff-filter=AD)" ]; then
  if ! node tools/ci/areas.mjs codeowners; then fail=1; fi
fi

exit "$fail"

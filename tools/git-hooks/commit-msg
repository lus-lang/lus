#!/bin/sh
# Checks the message of a commit against the format of CONTRIBUTING.md:
# a first line `type(area): subject` of at most 72 characters, and a body
# that follows the prose rules of the repository (tools/ci/commits.mjs).
# CI checks every commit of a pull request the same way.

set -eu
root=$(git rev-parse --show-toplevel)
exec node "$root/tools/ci/commits.mjs" message "$1"

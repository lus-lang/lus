      "checks": ["syntax", "web"]
    },
    {
      "name": "installer",
      "paths": ["packaging/install/**"],
      "labels": ["packaging"],
      "checks": ["install"],
      "platforms": ["linux", "macos"],
      "contributor": "egregious"
    },
    {
      "name": "release",
      "paths": [".github/workflows/ship.yml", ".github/workflows/release.yml", ".github/workflows/release-index.yml", ".github/workflows/publish-vscode.yml", "tools/release-version.mjs", "tools/release-version.test.mjs", "packaging/release/**"],
      "labels": ["release"],
      "checks": ["ci"],
      "contributor": "egregious"
    },
    {
      "name": "packaging",
      "paths": ["packaging/**"],
      "labels": ["packaging"],
      "contributor": "denied"
    },
    {
      "name": "workflows",
      "paths": [".github/**", "tools/ci/**", "tools/git-hooks/**", "tools/with-build-lock.sh", "tools/wait-for-memory.sh", "tools/prune-zig-cache.sh", "tools/security-review.sh", "tools/land-contribution.sh", "mise.toml"],
      "labels": ["ci"],
      "checks": ["ci"],
      "contributor": "egregious"
    },
    {
      "name": "generators",
      "paths": ["tools/build-*.js", "tools/lint-repo.js", "tools/gen-*.js", "tools/op-ngrams.js", "tools/tsan.sh", "tools/test-linux.sh", "tools/post-x.js", "tools/post-x.test.js"],
      "labels": ["tools"],
      "checks": ["web"],
      "contributor": "denied"
    },
    {
      "name": "workspace",
      "paths": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", ".npmrc", ".gitignore", ".gitattributes"],
      "labels": ["ci"],
      "checks": ["web"],
      "contributor": "denied"
    },
    {
      "name": "changelog",
      "paths": ["CHANGELOG.md"],
      "labels": ["docs"]
    },
    {
      "name": "front-page",
      "paths": ["README.md", "CONTRIBUTING.md", "SECURITY.md"],
      "labels": ["docs"],
      "contributor": "denied"
    },
    {
      "name": "license",
      "paths": ["LICENSE.md"],
      "labels": ["packaging"],
      "contributor": "egregious"
    }
  ]
}

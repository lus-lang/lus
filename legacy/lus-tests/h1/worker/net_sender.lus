global worker, network, string, math

local config = worker.peek()
local socket <close> = network.tcp.connect("127.0.0.1", config.port)
local chunk = string.rep("x", 64 * 1024)
local remaining = config.bytes
while remaining > 0 do
    local count = math.min(remaining, #chunk)
    socket:send(string.sub(chunk, 1, count))
    remaining = remaining - count
end
if config.suffix then
    socket:send(config.suffix)
end
socket:close()
worker.message("done")

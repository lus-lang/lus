-- Cleanup with Close: Release resources at the end of a block with `<close>` and `__close`.
-- playground: true
global error, print, setmetatable

-- `__close` runs when a `<close>` variable goes out of scope. Its second
-- argument is the error that ended the block, or nil.
local Resource = {}
Resource.__index = Resource

function Resource.__close(resource, err)
    if err then
        print(`release $(resource.name) after error`)
    else
        print(`release $(resource.name)`)
    end
end

local function acquire(name)
    print(`acquire $name`)
    return setmetatable({ name = name }, Resource)
end

do
    local lock <close> = acquire("lock")
    print("work")
end

--> acquire lock
--> work
--> release lock

-- Several `<close>` variables close in reverse order, so a resource is
-- released before the resources it depends on.
do
    local db <close> = acquire("database")
    local tx <close> = acquire("transaction")
end

--> acquire database
--> acquire transaction
--> release transaction
--> release database

-- Cleanup also runs when an error or a `return` ends the block.
local function import(rows)
    local file <close> = acquire("import.csv")

    if rows == 0 then
        error("nothing to import", 0)
    end

    return `imported $rows rows`
end

print(import(3))
--> acquire import.csv
--> release import.csv
--> imported 3 rows
print(catch import(0))

--> acquire import.csv
--> release import.csv after error
--> false nothing to import

-- The `defer` statement of Go schedules a call for the end of a function.
-- In Lus, a `<close>` variable whose value has the action as `__close`
-- runs it at the end of the block.
local function defer(action)
    return setmetatable({}, { __close = action })
end

local function handle_request(path)
    local _ <close> = defer(function()
        print(`done $path`)
    end)

    print(`serving $path`)
end

handle_request("/index.html")
--> serving /index.html
--> done /index.html

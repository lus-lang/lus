-- Slices: `t[i, j]` copies the part of a list or a string from one position to another.
-- playground: true
global print, table, setmetatable, math

-- Both positions are included. An omitted position extends to the start or the end.
local letters = ("a b c d e"):split(" ")
print(table.concat(letters[2, 4], " "))  --> b c d
print(table.concat(letters[, 2], " "))  --> a b
print(table.concat(letters[4,], " "))  --> d e

-- A slice is a new list, so changing it leaves the original as it was.
local head = letters[1, 2]
head[1] = "z"
print(head[1], letters[1])  --> z  a

-- A first position larger than the second runs backward.
print(table.concat(letters[5, 3], " "))  --> e d c

-- Strings slice by character.
local title = "Café au lait"
print(title[1, 4], title[6,])  --> Café  au lait

-- Slices split a list into pages of three.
local readings = ("10 20 30 40 50 60 70"):split(" ")

for first = 1, #readings, 3 do
    local last = math.min(first + 2, #readings)
    print(table.concat(readings[first, last], ","))
end
--> 10,20,30
--> 40,50,60
--> 70

-- A `__slice` metamethod gives a table its own slices.
local Squares = {}

function Squares.__slice(_, first, last)
    local result = {}
    for n = first or 1, last or 5 do
        result[#result + 1] = n * n
    end
    return result
end

local squares = setmetatable({}, Squares)
print(table.concat(squares[2, 4], " "))  --> 4 9 16
print(table.concat(squares[, 3], " "))  --> 1 4 9

-- Do-Expressions: A `do ... end` block computes a value, which `provide` returns.
-- playground: true
global print, ipairs, math

-- The block can hold temporary variables that end with it.
local radius = 5

local area = do
    local squared = radius * radius
    provide math.floor(math.pi * squared)
end

print(area)  --> 78

-- Each `provide` ends the block, so a chain of `if` needs no `else`.
-- The result can be `<const>`, because the declaration itself computes it.
local score = 750

local level <const> = do
    if score >= 1000 then
        provide "expert"
    end

    if score >= 500 then
        provide "intermediate"
    end

    provide "beginner"
end

print(level)  --> intermediate

-- A `provide` inside a loop is a search that stops at the first match.
-- A block that ends without a `provide` gives `nil`.
local users = { { name = "ada", admin = false }, { name = "grace", admin = true } }

local admin = do
    for _, user in ipairs(users) do
        if user.admin then
            provide user
        end
    end
end

print(admin.name)  --> grace

-- `provide` can give several values, here the lowest and the highest reading.
local readings = { 3, 9, 1 }

local low, high = do
    local lo, hi = math.huge, -math.huge

    for _, value in ipairs(readings) do
        lo = math.min(lo, value)
        hi = math.max(hi, value)
    end

    provide lo, hi
end

print(low, high)  --> 1  9

-- A do expression fits wherever an expression does, such as a table field.
local hour = 14

local banner = {
    user = "ada",
    unread = 3,
    theme = "dark",
    greeting = do
        if hour < 12 then
            provide "Good morning"
        end

        provide "Good afternoon"
    end,
}

print(`$(banner.greeting), $(banner.user)`)  --> Good afternoon, ada

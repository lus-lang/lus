-- Walking a Directory Tree: Visit every file below a directory, depth first and in sorted order.
-- playground: false
global print, io, fs, pledge, ipairs

pledge("fs")

-- The program builds a small project to walk.
for _, dir in ipairs({ "project/src/util", "project/docs", "project/vendor/json" }) do
    fs.createdirectory(dir, true)
end

local files = {
    "project/main.lus",
    "project/src/parser.lus",
    "project/src/util/strings.lus",
    "project/docs/guide.md",
    "project/vendor/json/json.lus",
}

for _, path in ipairs(files) do
    io.open(path, "w"):write("-- source\n"):close()
end

-- Each step gives the path, its kind, and whether it is a link. A directory
-- comes before its entries and names are sorted, so the order is the same on
-- every system. The loop prints the name of each entry, indented under its
-- parent, so the output holds no path separator.
for path, kind in fs.walk("project") do
    local depth = #fs.path.split(path) - 1
    print(`$(("    "):rep(depth - 1))$kind $(fs.path.name(path))`)
end

--> directory docs
-->     file guide.md
--> file main.lus
--> directory src
-->     file parser.lus
-->     directory util
-->         file strings.lus
--> directory vendor
-->     directory json
-->         file json.lus

-- A filter in the loop keeps the Lus files and skips the vendor directory.
local count = 0

for path, kind in fs.walk("project") do
    local top = fs.path.split(path)[2]

    if kind == "file" and path:match("%.lus$") and top ~= "vendor" then
        count = count + 1
    end
end

print(`$count Lus files`)  --> 3 Lus files

-- The glob and exclude options do the same filtering inside the walk, and
-- the walk never enters an excluded directory. depth limits how far it goes.
for path in fs.walk("project", { glob = "*.lus", exclude = "vendor" }) do
    print(fs.path.name(path))
end

--> main.lus
--> parser.lus
--> strings.lus

for path in fs.walk("project", { depth = 1 }) do
    print(fs.path.name(path))
end

--> docs
--> main.lus
--> src
--> vendor

fs.remove("project", true)

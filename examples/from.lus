-- Destructuring: `from` copies the fields of a table into variables of the same names.
-- playground: true
global print, table

-- Each name receives the field with that name.
local config = { host = "example.org", port = 8080, debug = false }
local host, port from config
print(host, port)  --> example.org  8080

-- A missing field gives `nil`.
local user, timeout from config
print(user, timeout)  --> nil  nil

-- `from` takes functions out of a library or a module.
local insert, concat from table
local tags = {}
insert(tags, "draft")
insert(tags, "urgent")
print(concat(tags, ", "))  --> draft, urgent

-- Without `local`, `from` assigns to variables that already exist.
local x, y from { x = 0, y = 0 }
x, y from { x = 3, y = 4 }
print(x, y)  --> 3  4

-- In a condition, the branch runs when every field is truthy.
local response = { ok = true, body = "accepted" }

if ok, body from response then
    print(`response: $body`)  --> response: accepted
end

-- `for ... from` destructures each item that an iterator produces.
local products = { { name = "kettle", price = 30 }, { name = "mug", price = 8 } }

local function each(list)
    local i = 0

    return function()
        i = i + 1
        return list[i]
    end
end

for name, price from each(products) do
    print(name, price)
end
--> kettle  30
--> mug  8

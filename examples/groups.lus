-- Local Groups: A `<group>` declares related locals under one name and creates no table.
-- playground: true
global print, ipairs

-- Each field of a group is a local variable, read and written with the dot.
local function centroid(points)
    local sum <group> = { x = 0, y = 0 }

    for _, point in ipairs(points) do
        sum.x = sum.x + point.x
        sum.y = sum.y + point.y
    end

    return sum.x / #points, sum.y / #points
end

local triangle = { { x = 0, y = 0 }, { x = 4, y = 2 }, { x = 2, y = 4 } }
print(centroid(triangle))  --> 2.0  2.0

-- Assigning a constructor sets the listed fields and keeps the others.
local stats <group> = { count = 4, sum = 22, max = 9 }
stats = { count = 0, sum = 0 }
print(stats.count, stats.sum, stats.max)  --> 0  0  9

-- Assigning one group to another copies the fields with the same names.
local start <group> = { x = 0, y = 0 }
local cursor <group> = { x = 5, y = 7 }
cursor = start
print(cursor.x, cursor.y)  --> 0  0

-- Fields take attributes, so a group can hold a constant and nested groups.
local body <group> = {
    name <const> = "probe",
    mass <const> = 2,
    position <group> = { x = 0, y = 0 },
    velocity <group> = { x = 1, y = 3 },
}

for _ = 1, 3 do
    body.position.x = body.position.x + body.velocity.x
    body.position.y = body.position.y + body.velocity.y
end

print(body.name, body.mass, body.position.x, body.position.y)  --> probe  2  3  9
-- A group is a set of variables, so it cannot be passed or printed whole.
-- Its fields can be, as `centroid` returns them.
-- Reading a field the declaration does not list, such as `stats.average`, is a compile error.

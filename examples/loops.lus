-- Loops: Numeric `for`, `while`, and `repeat` run a block many times.
-- playground: true
global print

-- A numeric `for` counts from a start to a stop, both included.
for day = 1, 3 do
    print(`day $day`)
end

--> day 1
--> day 2
--> day 3

-- A third number is the step. A negative step counts down.
for seconds = 6, 0, -3 do
    print(seconds)
end

--> 6
--> 3
--> 0

-- `while` tests its condition before each pass, so the body may never run.
local width = 4000

while width > 1000 do
    width = width // 2
end

print(width)  --> 1000

-- `repeat` runs its body first, so even 0 counts as one digit.
local n = 0
local digits = 0

repeat
    n = n // 10
    digits = digits + 1
until n == 0

print(digits)  --> 1

-- `continue` skips to the next pass. `break` leaves the loop.
local sold = 0

for seat = 1, 20 do
    if seat == 13 then
        continue
    end

    sold = sold + 1

    if sold == 15 then
        print(`last seat sold: $seat`)  --> last seat sold: 16
        break
    end
end

-- `goto` leaves several nested loops at once.
for row = 1, 9 do
    for column = 1, 9 do
        if row * column == 12 then
            print(`$row x $column`)  --> 2 x 6
            goto found
        end
    end
end

::found::

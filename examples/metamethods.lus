-- Operator Overloading: Metamethods give tables arithmetic, comparison, length, calls, and text.
-- playground: true
global print, setmetatable, table, tostring

-- A vector keeps its components in the list `items`.
local Vector = {}
Vector.__index = Vector

local function vector(...items)
    return setmetatable({ items = items }, Vector)
end

-- `__len` defines `#`, here the number of components.
function Vector.__len(v)
    return v.items.n
end

-- `__add` defines `+`. Lus calls it with the two operands.
function Vector.__add(a, b)
    local sum = {}
    for i = 1, #a do
        sum[i] = a.items[i] + b.items[i]
    end
    return vector(table.unpack(sum))
end

-- `__eq` defines `==` and `__lt` defines `<`, which also gives `>`.
function Vector.__eq(a, b)
    if #a ~= #b then
        return false
    end
    for i = 1, #a do
        if a.items[i] ~= b.items[i] then
            return false
        end
    end
    return true
end

function Vector.__lt(a, b)
    return a:magnitude() < b:magnitude()
end

function Vector:magnitude()
    local total = 0
    for i = 1, #self do
        total = total + self.items[i] ^ 2
    end
    return total ^ 0.5
end

-- `__tostring` gives the text that `print`, `tostring`, and interpolation use.
function Vector.__tostring(v)
    return `($(table.concat(v.items, ", ")))`
end

-- `__call` makes the table callable. Here a call reads one component.
function Vector.__call(v, i)
    return v.items[i]
end

-- `__concat` defines `..`, which joins two vectors into a longer one.
function Vector.__concat(a, b)
    local joined = table.move(b.items, 1, #b, #a + 1, table.clone(a.items))
    return vector(table.unpack(joined, 1, #a + #b))
end

local a = vector(1, 2)
local b = vector(3, 4)
print(a + b)  --> (4, 6)
print(a == vector(1, 2), a == b)  --> true false
print(a < b, a > b)  --> true false
print(#(a .. b), tostring(a .. b))  --> 4 (1, 2, 3, 4)
print(b(2), b:magnitude())  --> 4 5.0
print(`from $a to $b`)  --> from (1, 2) to (3, 4)

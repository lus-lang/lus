-- If-Assignment: A condition can declare variables, which hold the values it tests.
-- playground: true
global print, tonumber, string, ipairs, table

-- `if name = expr then` declares `name` and runs the branch when it is truthy.
for _, input in ipairs({ "42", "forty" }) do
    if n = tonumber(input) then
        print(`$input doubled is $(n * 2)`)
    else
        print(`$input is not a number`)
    end
end

--> 42 doubled is 84
--> forty is not a number

-- With several variables, the branch runs only when every one is truthy.
local line = "level=warn"

if first, last = string.find(line, "warn") then
    print(`found at $first to $last`)  --> found at 7 to 10
end

-- An `elseif` can declare variables too. A later branch also sees the earlier variables.
local settings = { port = "8080" }

if host = settings.host then
    print(`host $host`)
elseif port = tonumber(settings.port) then
    print(`port $port, host $host`)  --> port 8080, host nil
end

-- `while name = expr do` repeats until the expression gives `nil` or `false`.
local csv = "tea,4.50,3,shelf 2"
local fields = 1
local start = 1

while comma = string.find(csv, ",", start) do
    fields = fields + 1
    start = comma + 1
end

print(fields)  --> 4

-- A queue drains with the same form, taking the first job on each pass.
local jobs = { "build", "test", "deploy" }
local finished = {}

while job = table.remove(jobs, 1) do
    finished[#finished + 1] = job
end

print(#jobs, #finished, finished[3])  --> 0  3  deploy

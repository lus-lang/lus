-- Optional Chaining: Read fields, index, and call through values that may be nil.
-- playground: true
global print

local database = { host = "db1.internal", port = 5432 }
local config = { database = database, replicas = { "db2.internal", "db3.internal" } }

-- `?.` stops at a nil or false value and produces that value, so a
-- missing table in the middle of a path reads as nil.
print(config?.database?.host)  --> db1.internal
print(config?.cache?.ttl)  --> nil

-- `or` after the chain gives a default.
local ttl = config?.cache?.ttl or 300
print(ttl)  --> 300

-- `?[` indexes the same way.
print(config.replicas?[2])  --> db3.internal
print(config.backups?[1])  --> nil

-- `?(` calls a function only when it exists. `?:` calls a method the same way.
local hooks = {}

function hooks.on_start(name)
    return `starting $name`
end

print(hooks.on_start?("web"))  --> starting web
print(hooks.on_stop?("web"))  --> nil

local logger = { prefix = "app" }

function logger:format(message)
    return `[$(self.prefix)] $message`
end

local no_logger = nil
print(logger?:format("ready"))  --> [app] ready
print(no_logger?:format("ready"))  --> nil

-- A skipped chain evaluates none of the later arguments.
local calls = 0

local function next_id()
    calls = calls + 1
    return calls
end

local _ = no_logger?:format(next_id())
print(calls)  --> 0

-- A trailing `?` yields the value unchanged, which marks a chain whose
-- last step may be nil.
print(config.database?.user?)  --> nil

-- `?` protects only the steps after it. Here `config.cache` is nil, so
-- indexing it raises an error.
print((catch config.cache.ttl))  --> false

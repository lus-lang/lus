-- Password Hashing: Store passwords as Argon2id hashes and check login attempts against them.
-- playground: true
global print, crypto

-- `hashpassword` draws a fresh salt on every call and returns one string to store.
-- The string records the algorithm and its costs, so it is all that verification needs.
local stored = crypto.hashpassword("correct horse battery staple")
print(stored:sub(1, 30))  --> $argon2id$v=19$m=19456,t=2,p=1

-- The same password hashes to a different string each time, because the salt differs.
local again = crypto.hashpassword("correct horse battery staple")
print(stored == again)  --> false

-- `verifypassword` reads the salt and costs from the stored string.
print(crypto.verifypassword("correct horse battery staple", stored))  --> true
print(crypto.verifypassword("correct horse battery stapler", stored))  --> false
print(crypto.verifypassword("correct horse battery staple", again))  --> true

-- A login check returns the same answer for an unknown user and a wrong password.
local users = { ada = stored }

local function login(name, password)
    if hash = users[name] then
        return crypto.verifypassword(password, hash)
    end

    return false
end

print(login("ada", "correct horse battery staple"))  --> true
print(login("ada", "hunter2"))  --> false
print(login("grace", "hunter2"))  --> false

-- Higher costs slow down every guess an attacker makes. The options set them per hash.
local strong = crypto.hashpassword("correct horse battery staple", { memory = 65536, time = 3 })
print(strong:sub(1, 30))  --> $argon2id$v=19$m=65536,t=3,p=1

-- A stored string that is not a valid hash raises an error, since it points to corrupt storage.
local ok = catch crypto.verifypassword("hunter2", "not a hash")
print(ok)  --> false

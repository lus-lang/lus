-- Vectors: Build and read byte buffers, binary records, and hex dumps.
-- playground: true
global print, vector, string, io

-- A vector is a mutable buffer of bytes. Offsets in the vector functions start at 0.
-- The bytes 202 and 254 are 0xCA and 0xFE in hexadecimal.
local buf = vector.create(4)
vector.set(buf, 0, 202)
vector.set(buf, 1, 254)
print(#buf, vector.get(buf, 0), vector.get(buf, 3), vector.get(buf, 4))  --> 4 202 0 nil

-- `string.transcode` writes the bytes as hex and reads hex back into a vector.
local function hex(v)
    return string.transcode(v, "binary", "hex")
end

print(hex(buf))  --> cafe0000
print(#string.transcode("deadbeef", "hex", "binary"))  --> 4

-- `vector.pack` writes numbers in a binary layout: `<` is little-endian, `c4` four
-- raw characters, `I2` and `I4` unsigned integers, and `d` a 64-bit float.
local header = vector.create(18)
local after = vector.pack(header, 0, "<c4I2I4d", "SNSR", 2, 1500, 21.5)
print(after, hex(header))  --> 18 534e53520200dc0500000000000000803540

-- `vector.unpack` reads the same layout and returns the next offset last.
local magic, version, count, reading, next_offset = vector.unpack(header, 0, "<c4I2I4d")
print(magic, version, count, reading, next_offset)  --> SNSR 2 1500 21.5 18

-- `unpackmany` reads the same record again and again until the end of the vector.
local samples = vector.create(12)
vector.pack(samples, 0, ">i2i2i2i2i2i2", 210, 215, -40, 0, 1023, 7)

for value in vector.unpackmany(samples, 0, ">i2") do
    io.write(value, " ")
end

print()  --> 210 215 -40 0 1023 7

-- A string converts to its UTF-8 bytes and back.
local text = vector.fromstring("Grüße")
print(#text, hex(text))  --> 7 4772c3bcc39f65
print(vector.tostring(text))  --> Grüße

-- A slice copies a range of bytes. Slice positions count from 1, as for strings.
local middle = text[2, 5]
print(hex(middle))  --> 72c3bcc3

-- `vector.find` returns the offset of a byte sequence. `vector.tostring` decodes a range.
local packet = vector.fromstring("GET /index.html HTTP/1.1\r\nHost: lus.dev\r\n")
local line_end = vector.find(packet, "\r\n")
print(line_end, vector.tostring(packet, 0, line_end))  --> 24 GET /index.html HTTP/1.1

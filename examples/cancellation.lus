-- Cancellation: Stop a running task and release what it holds.
-- playground: true
global coroutine, error, print, setmetatable, table

-- A resource with a `__close` metamethod releases itself when its `<close>`
-- variable goes out of scope, which also happens when the task is cancelled.
local log = {}

local function open_connection(name)
    log[#log + 1] = `open $name`
    return setmetatable({ name = name }, {
        __close = function(conn)
            log[#log + 1] = `close $(conn.name)`
        end,
    })
end

-- This task copies rows in batches and sleeps between them, as a job that
-- waits for a database would.
local function copy_rows(table_name)
    local conn <close> = open_connection(table_name)
    for batch = 1, 100 do
        log[#log + 1] = `batch $batch`
        coroutine.resume(coroutine.sleep(0.01))
    end
    return "copied"
end

local job = coroutine.detach(coroutine.create(copy_rows), "orders")

-- `coroutine.close` cancels the detached task. Its pending `<close>`
-- variable runs at once. The sleep that the task waited in ends with it.
coroutine.resume(coroutine.sleep(0.025))
print(coroutine.close(job))  --> true
print(coroutine.status(job))  --> dead
print(log[1], log[#log])  --> open orders  close orders

-- A resume that waits for a cancelled task finds it dead.
print(coroutine.resume(job))  --> false  cannot resume dead coroutine

-- Closing a task that failed returns its error, which counts as collecting it.
local broken = coroutine.detach(coroutine.create(function()
    local conn <close> = open_connection("users")
    error("disk full", 0)
end))

coroutine.resume(coroutine.sleep(0.01))
print(coroutine.close(broken))  --> false  disk full
print(table.concat(log, ", ", #log - 1))  --> open users, close users

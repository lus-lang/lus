-- Permissions: Pledge only the access a program needs, then seal it so nothing can widen it.
-- playground: false
global print, io, fs, os, coroutine, pledge, ipairs

-- A coroutine starts with a copy of the permissions of its creator. This one
-- is made before the main program pledges anything, so it can take "fs" for
-- itself to set up the data directory and to remove it at the end.
local setup = coroutine.wrap(function()
    pledge("fs")
    fs.createdirectory("data")
    io.open("data/prices.csv", "w"):write("apples,3\npears,4\n"):close()
    coroutine.yield()
    fs.remove("data", true)
end)

setup()

-- The main program may read the data directory and its files, and nothing
-- else. "~exec" rejects running programs for good. "seal" makes every later
-- pledge return false.
print(pledge("fs:read=./data", "fs:read=./data/**", "~exec", "seal"))  --> true  true  true  true

-- The error of a denied call names the permission, so the example keeps
-- that part and drops the path, which differs between machines.
local function reason(err)
    return err:match('permission "[^"]+" denied') or err
end

for line in io.lines("data/prices.csv") do
    print(line)
end

--> apples,3
--> pears,4

print(#fs.list("data"))  --> 1

-- Everything outside the grants raises an error at the call, which catch
-- captures like any other error.
local denied = {
    function()
        return fs.list(".")
    end,
    function()
        return io.open("data/prices.csv", "w")
    end,
    function()
        return os.execute("ls")
    end,
    function()
        return os.getenv("HOME")
    end,
}

for _, attempt in ipairs(denied) do
    local ok, err = catch attempt()
    print(ok, reason(err))
end

--> false  permission "fs:read" denied
--> false  permission "fs:write" denied
--> false  permission "exec" denied
--> false  permission "env:read" denied

-- After the seal, a pledge for more access is refused.
print(pledge("fs:write"), pledge("env"))  --> false  false

setup()

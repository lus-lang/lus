-- String Interpolation: Backtick strings insert variables and expressions into text.
-- playground: true
global print, string, setmetatable

-- `$name` inserts the value of a variable.
local name = "Ada"
local unread = 3
print(`Hello, $name! You have $unread new messages.`)
--> Hello, Ada! You have 3 new messages.

-- `$(expr)` inserts the result of any expression, including calls and fields.
local order = { item = "tea", quantity = 4, price = 4.5 }
print(`$(order.quantity) x $(order.item) = $(order.quantity * order.price)`)
--> 4 x tea = 18.0
print(`Total: $(string.format("%.2f", order.quantity * order.price))`)
--> Total: 18.00

-- `$$` writes a literal dollar sign.
print(`Price: $$$(order.price)`)  --> Price: $4.5

-- A value of any type is converted as `tostring` converts it.
print(`flag: $(unread > 5), missing: $(order.discount)`)  --> flag: false, missing: nil

-- A table with `__tostring` prints with its own text.
local Point = {}

Point.__tostring = function(point)
    return `($(point.x), $(point.y))`
end

local origin = setmetatable({ x = 0, y = 0 }, Point)
print(`start at $origin`)  --> start at (0, 0)

-- A backtick string can contain another one inside `$( )`.
local label = `$(`[$name]`) has $unread`
print(label)  --> [Ada] has 3

-- A backtick string can span several lines and keeps its line breaks.
local receipt = `Customer: $name
Items: $(order.quantity)
Paid: $(order.quantity * order.price)`
print(receipt)
--> Customer: Ada
--> Items: 4
--> Paid: 18.0

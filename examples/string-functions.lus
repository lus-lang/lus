-- String Functions: Search, slice, split, and reshape text with the string library.
-- playground: true
global print, string, table

local title = "  The Hitchhiker's Guide  "

-- Every string function is also a method, so `s:upper()` calls `string.upper(s)`.
-- Trimming without arguments removes whitespace at both ends.
local clean = title:trim()
print(`[$clean]`)  --> [The Hitchhiker's Guide]
print(clean:upper())  --> THE HITCHHIKER'S GUIDE
print(clean:lower())  --> the hitchhiker's guide
print(#clean)  --> 22

-- Positions count characters from 1. Negative positions count from the end.
print(clean:sub(5, 15))  --> Hitchhiker'
print(clean:sub(-5))  --> Guide
print(clean[1, 3])  --> The

-- `find` returns the first and last position of a match, or nil.
print(clean:find("Guide"))  --> 18 22
print(clean:find("Towel"))  --> nil

-- A fourth argument of true searches for plain text, so `.` has no special meaning.
print(("v2.1.0"):find(".", 1, true))  --> 3 3

-- Start and end checks compare a slice of the string with the prefix or suffix.
local function starts_with(s, prefix)
    return s:sub(1, #prefix) == prefix
end

local function ends_with(s, suffix)
    return suffix == "" or s:sub(-#suffix) == suffix
end

print(starts_with("report.csv", "report"), ends_with("report.csv", ".csv"))  --> true true
print(starts_with("report.csv", "summary"), ends_with("report.csv", ".json"))  --> false false

-- `split` cuts at a literal delimiter and `table.concat` puts the pieces back together.
local tags = string.split("lua,lus,,zig", ",")
print(#tags, tags[3] == "")  --> 4 true
print(table.concat(tags, " | "))  --> lua | lus |  | zig

-- `rep` repeats a string with an optional separator. `reverse` reverses characters.
print(string.rep("ab", 3, "-"))  --> ab-ab-ab
print(("stressed"):reverse())  --> desserts
print(("héllo"):reverse())  --> olléh

-- `trim` also takes a set of characters to strip from both ends.
print(("--== Chapter 1 ==--"):trim("-= "))  --> Chapter 1
print(("0042"):ltrim("0"), ("1.500"):rtrim("0"))  --> 42 1.5

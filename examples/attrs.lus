-- Runtime Attributes: Check or convert every value assigned to a variable with a function.
-- playground: true
global error, math, print, type

-- Lus calls the attribute with the name and the new value at the
-- initialization and at every assignment. An error rejects the value.
local function positive(name, value)
    if value <= 0 then
        error(`$name must be positive, got $value`, 0)
    end
end

local width <positive> = 80
width = 120

local ok, message = catch do
    width = -5
end

print(ok, message)  --> false width must be positive, got -5
print(width)  --> 120

-- A call in the brackets builds a configured attribute. `only "number"`
-- calls `only` with one string argument.
local function only(kind)
    return function(name, value)
        if type(value) ~= kind then
            error(`$name must be a $kind, got a $(type(value))`, 0)
        end
    end
end

local retries <only "number"> = 0
retries = retries + 1

ok, message = catch do
    retries = "three"
end

print(ok, message)  --> false retries must be a number, got a string
print(retries)  --> 1

-- A result other than nil replaces the value. Attributes in a list run
-- from left to right, each on the result of the previous one.
local function clamped(low, high)
    return function(_, value)
        return math.max(low, math.min(high, value))
    end
end

local function rounded(_, value)
    return math.floor(value + 0.5)
end

local volume <only "number", clamped(0, 10), rounded> = 4.6
print(volume)  --> 5
volume = 42
print(volume)  --> 10
volume = -3
print(volume)  --> 0

-- An attribute on a function variable can wrap the function.
local function logged(name, fn)
    return function(...)
        print(`calling $name`)
        return fn(...)
    end
end

local greet <logged> = function(who)
    return `Hello, $who`
end

print(greet("Ada"))
--> calling greet
--> Hello, Ada

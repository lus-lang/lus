-- Catch: Capture errors as values with catch expressions, catch statements, and handlers.
-- playground: true
global error, ipairs, math, print, tonumber, tostring, type

local function parse_port(text)
    local port = math.tointeger(tonumber(text))
    if not port or port < 1 or port > 65535 then
        error(`invalid port: $text`, 0)
    end
    return port
end

-- A catch expression produces `true` and the values of its operand, or
-- `false` and the error object.
print(catch parse_port("8080"))  --> true 8080
print(catch parse_port("http"))  --> false invalid port: http

-- The operand can be any expression, such as an operation.
local ok, err = catch 10 // 0
print(ok, err:match("attempt to .*$"))  --> false attempt to divide by zero

-- A condition that declares variables tests the status and keeps the result.
for _, text in ipairs({ "443", "99999" }) do
    if ok, port = catch parse_port(text) then
        print(`listening on $port`)
    else
        print(`skipped: $port`)
    end
end
--> listening on 443
--> skipped: invalid port: 99999

-- In parentheses, a catch produces only its status.
print((catch parse_port("80")))  --> true

-- A handler in brackets receives the error object. The result of the
-- handler replaces the error object.
local function as_table(e)
    if type(e) == "table" then
        return e
    end
    return { code = "internal", message = tostring(e) }
end

local ok2, problem = catch[as_table] parse_port("-1")
print(ok2, problem.code, problem.message)  --> false internal invalid port: -1

local _, timeout = catch[as_table] error({ code = "timeout" })
print(timeout.code)  --> timeout

-- A catch statement runs its operand and discards both the results and
-- any error, so the loop reaches the third listener.
local function save(event)
    print("saved", event)
end

local function index(event)
    error(`search index offline, $event not indexed`)
end

local function audit(event)
    print("logged", event)
end

for _, listener in ipairs({ save, index, audit }) do
    catch listener("upload")
end
--> saved upload
--> logged upload

---
interface Props {
  href?: string
  variant?: "solid" | "outline"
  color?: "lime" | "red"
  size?: "sm" | "md"
  disabled?: boolean
  type?: "button" | "submit"
  id?: string
  class?: string
  target?: string
  rel?: string
  ariaLabel?: string
}

const {
  href,
  variant = "solid",
  color = "lime",
  size = "md",
  disabled = false,
  type = "button",
  id,
  target,
  rel,
  ariaLabel,
} = Astro.props

const Tag = href && !disabled ? "a" : "button"
---

<Tag
  class:list={["btn", Astro.props.class]}
  data-variant={variant}
  data-color={color}
  data-size={size}
  id={id}
  href={href && !disabled ? href : undefined}
  type={Tag === "button" ? type : undefined}
  disabled={Tag === "button" && disabled ? true : undefined}
  target={target}
  rel={rel}
  aria-label={ariaLabel}
>
  <slot />
</Tag>

<style>
  @reference "../styles/global.css";

  .btn {
    @apply inline-flex items-center gap-2 rounded-md bg-accent text-ink font-semibold no-underline cursor-pointer select-none;

    &:hover,
    &:active {
      @apply bg-accent-strong no-underline;
    }

    &[data-variant="outline"] {
      @apply bg-paper border border-ink/25;

      &:hover,
      &:active {
        @apply bg-accent-soft border-ink/40 text-ink;
      }
    }

    &[data-size="sm"] {
      @apply px-2 py-1 text-sm;
    }

    &[data-size="md"] {
      @apply px-3 py-1.5;
    }

    &[data-color="red"] {
      @apply bg-accent-red text-ink-red;

      &:hover,
      &:active {
        @apply bg-accent-strong-red;
      }

      &[data-variant="outline"] {
        @apply bg-paper border-ink-red/25;

        &:hover,
        &:active {
          @apply bg-accent-soft-red border-ink-red/40 text-ink-red;
        }
      }
    }

    &:disabled,
    &[aria-disabled="true"] {
      @apply bg-tint text-ink/40 border-ink/15 cursor-not-allowed pointer-events-none;
    }

    &[data-color="red"]:disabled {
      @apply bg-tint-red text-ink-red/40 border-ink-red/15;
    }
  }
</style>

---
interface Props {
  class?: string
  color?: "lime" | "red"
  variant?: "default" | "feature"
}

const { color = "lime", variant = "default" } = Astro.props
---

<div
  class:list={["card", Astro.props.class]}
  data-color={color}
  data-variant={variant}
>
  <slot name="eyebrow" />
  <slot name="title" />
  <div class="card-body"><slot /></div>
  <slot name="footer" />
</div>

<style>
  @reference "../styles/global.css";

  .card {
    @apply border border-ink/15 rounded-lg overflow-hidden bg-paper text-ink;

    h2 {
      @apply font-semibold text-base lowercase px-3 py-1.5 border-b border-ink/10 bg-tint text-ink;
    }

    .card-body {
      @apply p-3;
    }

    &[data-color="red"] {
      @apply border-ink-red/15 text-ink-red;

      h2 {
        @apply border-ink-red/10 bg-tint-red text-ink-red;
      }
    }
  }
</style>

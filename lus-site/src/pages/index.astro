---
import { getCollection } from "astro:content"
import { Code } from "astro:components"
// @ts-ignore
import lusGrammar from "../../../lus-textmate/lus.tmLanguage.json"
import { Image } from "astro:assets"

import Layout from "../components/Layout.astro"
import Button from "../components/Button.astro"
import Card from "../components/Card.astro"
import ReleaseStrip from "../components/ReleaseStrip.astro"
import Icon from "../components/Icon.astro"
import logo from "../assets/logo.svg"

import { INSTALL_SH, WINDOWS_INSTALLER_URL } from "../lib/install"
import { fmtDate } from "../lib/date"

const allNews = await getCollection("news")
const news = allNews
  .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5)

// six facets of the language, each linking into the guide; blurbs are
// factual descriptions (see the copy rules in the site memory: objective,
// standalone, distinctive facets only)
const features = [
  {
    name: "permissions",
    href: "/manual/guide#permissions",
    unstable: false,
    blurb:
      "Scripts run under deny-by-default permissions. pledge grants capabilities at runtime and can seal the set.",
    code: `pledge("fs:read=/var/log/*")   -- read access to logs only
pledge("network:http")
pledge("seal")                 -- lock the permission set

local ok = catch fs.list("/home")
-- ok == false: outside the pledged set`,
  },
  {
    name: "queries",
    href: "/manual/guide#query",
    unstable: true,
    blurb:
      "An @ expression builds a first-class query with a fixed logical pipeline. It is evaluated each time it is iterated.",
    code: `local adults =
    @people as p
     where p.age > 18
     select p.name, p.age
     order by p.age desc

for row in query(adults) do
    print(row.name, row.age)
end`,
  },
  {
    name: "sqlite",
    href: "/manual/guide#sqlite",
    unstable: true,
    blurb:
      "io.sqlite opens file-backed or in-memory databases. A database table serves as a query source and receives the query as parameterized SQL.",
    code: `local db <close> = io.sqlite("app.db")

db:run("INSERT INTO users (name, age) VALUES (?, ?)", "Alice", 30)

for u in query(@db.users as u where u.age >= 18 select u.name) do
    print(u.name)
end`,
  },
  {
    name: "concurrency",
    href: "/manual/guide#workers",
    unstable: false,
    blurb:
      "A worker runs a script in a separate interpreter state on the thread pool and exchanges messages with its parent.",
    code: `local w = worker.create("crunch.lus", { data = "input" })
worker.send(w, "start")

while result = worker.receive(w) do
    print(result)
end`,
  },
  {
    name: "time",
    href: "/manual/guide#time",
    unstable: true,
    blurb:
      "The time library separates absolute instants, civil datetimes, and durations. Named zones resolve from tzdata embedded in the runtime.",
    code: `local now = time.now()                    -- instant
local later = now + time.hours(72)
local ny = time.zone("America/New_York")

print(later:at(ny):iso())                 -- wall clock in New York`,
  },
  {
    name: "binary data",
    href: "/manual/guide#vector",
    unstable: false,
    blurb:
      "A vector is a mutable byte buffer. vector.archive reads and writes gzip, zstd, brotli, and lz4.",
    code: `local v = vector.create(16)
vector.pack(v, 0, "I4I4I4I4", 1, 2, 3, 4)

local packed = vector.archive.zstd.compress(v)
local restored = vector.archive.zstd.decompress(packed)`,
  },
]

// deep-links into the generated API reference (section ids are slugs of
// the section titles in lib/api.ts)
const stdlibMap = [
  {
    name: "base",
    desc: "core globals · JSON · CSV",
    href: "/manual/api#environment-functions",
  },
  {
    name: "string",
    desc: "patterns, formatting",
    href: "/manual/api#string-library",
  },
  {
    name: "table",
    desc: "manipulation, clone, sort",
    href: "/manual/api#table-library",
  },
  { name: "math", desc: "numerics", href: "/manual/api#math-library" },
  {
    name: "fs",
    desc: "filesystem & paths",
    href: "/manual/api#filesystem-library",
  },
  {
    name: "network",
    desc: "HTTP, TCP, UDP",
    href: "/manual/api#network-library",
  },
  {
    name: "worker",
    desc: "threads & messages",
    href: "/manual/api#worker-library",
  },
  {
    name: "vector",
    desc: "mutable byte buffers",
    href: "/manual/api#vector-library",
  },
  {
    name: "vector.archive",
    desc: "gzip, zstd, brotli, lz4",
    href: "/manual/api#archive-library",
  },
  { name: "io", desc: "streams & files", href: "/manual/api#io-library" },
  { name: "os", desc: "environment, time", href: "/manual/api#os-library" },
  { name: "utf8", desc: "Unicode helpers", href: "/manual/api#utf-8-library" },
  {
    name: "coroutine",
    desc: "cooperative threads",
    href: "/manual/api#coroutine-library",
  },
  {
    name: "debug",
    desc: "introspection, AST",
    href: "/manual/api#debug-library",
  },
  {
    name: "package",
    desc: "module loading",
    href: "/manual/api#package-library",
  },
  { name: "C API", desc: "embedding interface", href: "/manual/api/c" },
]
---

<Layout>
  <main id="main">
    <section class="hp-hero">
      <Image
        src={logo}
        alt=""
        aria-hidden="true"
        class="hp-hero-mark"
        width={352}
        height={402}
      />
      <div class="hp-hero-grid">
        <div class="hero-pitch">
          <h1 class="hero-title">Lus</h1>
          <p class="hero-sub">
            A small, productive programming language designed to be
            picked up easily by programmers and put to good use right away.
          </p>
          <div class="hp-install-panel">
            <div class="hero-install-meta">
              <span id="install-platform">linux x64</span>
              <a href="/manual/getting-started">other platforms</a>
              <a href="/manual/compiling">build from source</a>
            </div>
            <pre id="install-shell"><code>{INSTALL_SH}</code></pre>
            <p id="install-windows" hidden>
              <a class="install-win-btn" href={WINDOWS_INSTALLER_URL}>
                <Icon name="download" size={16} /> Download lus-setup.exe
              </a>
            </p>
          </div>
          <div class="hero-ctas">
            <Button href="/manual/getting-started">
              Get started <Icon name="arrow-right" size={16} />
            </Button>
            <Button variant="outline" href="/playground">
              <Icon name="terminal" size={16} /> Open the playground
            </Button>
          </div>
        </div>

        <aside class="hero-news mt-auto">
          <Card variant="default" class="flex flex-col">
            <h2 slot="title">
              <Icon name="newspaper" size={16} class="inline-block" /> news
            </h2>
            <ul class="news-list">
              {
                news.map((item) => (
                  <li>
                    <time class="news-date" datetime={fmtDate(item.data.date)}>
                      {fmtDate(item.data.date)}
                    </time>
                    <a href={`/news/${item.id}`}>{item.data.title}</a>
                  </li>
                ))
              }
            </ul>
            <div slot="footer" class="px-3 pb-2 mt-auto">
              <a href="/news" class="text-sm">All news →</a>
            </div>
          </Card>
        </aside>
      </div>
    </section>

        <section>
      <ReleaseStrip />
    </section>

    <section>
      <nav class="hp-stdlib" aria-label="Standard library modules">
        {
          stdlibMap.map((mod) => (
            <a href={mod.href}>
              <span class="mod-name">{mod.name}</span>
              <span class="mod-desc">{mod.desc}</span>
            </a>
          ))
        }
      </nav>
    </section>

    <section>
      <h2>Lus at a glance</h2>
      <div class="hp-features">
        {
          features.map((f) => (
            <article class="hp-feature">
              <header class="hp-feature-head">
                <a href={f.href} class="hp-feature-name">
                  {f.name}
                </a>
                {f.unstable && <span class="hp-feature-chip">unstable</span>}
              </header>
              <p class="hp-feature-blurb">{f.blurb}</p>
              <div class="hp-feature-code">
                <Code lang={lusGrammar as any} theme="github-light" code={f.code} />
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  // adjust the server-rendered linux install for the visitor's platform:
  // macOS shares the same curl|sh line (label change only), Windows swaps
  // the shell line for the installer download; no-JS readers keep the
  // linux default plus the "other platforms" link
  const plat = (
    navigator.userAgentData?.platform ??
    navigator.platform ??
    ""
  ).toLowerCase()
  if (plat.includes("mac")) {
    document.getElementById("install-platform").textContent =
      "macos (apple silicon)"
  } else if (plat.includes("win")) {
    document.getElementById("install-platform").textContent = "windows x64"
    document.getElementById("install-shell").hidden = true
    document.getElementById("install-windows").hidden = false
  }
</script>

<style>
  @reference "../styles/global.css";

  /*
  ** HOMEPAGE DEPTH EXCEPTION (sanctioned): the hp-* classes below are the
  ** ONLY place in the site allowed gradients, background patterns, and
  ** layered panels, a deliberate softening of the flat grammar scoped to
  ** this file. Do not promote hp-* into global.css or imitate elsewhere.
  ** Everything else here still obeys the grammar: hairlines, tint
  ** surfaces, instant-repaint hovers, ZERO MOTION.
  */

  .hp-hero {
    @apply relative overflow-hidden rounded-lg border border-ink/15 p-4 md:p-6;
    /* dot grid (ink at 5%) layered over the identity gradient */
    background-image:
      radial-gradient(
        color-mix(in oklab, var(--color-ink) 5%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        135deg,
        var(--color-accent-soft) 0%,
        var(--color-tint) 45%,
        var(--color-paper) 100%
      );
    background-size:
      16px 16px,
      100% 100%;
  }

  .hp-hero-mark {
    @apply hidden md:block absolute pointer-events-none select-none;
    right: -3rem;
    bottom: -4rem;
    width: 22rem;
    height: auto;
    opacity: 0.08;
    z-index: 0;
  }

  .hp-hero-grid {
    @apply relative z-10 flex flex-col gap-6 lg:grid lg:grid-cols-[1fr_minmax(280px,340px)] lg:gap-x-8 lg:items-start;
  }

  .hero-title {
    @apply font-display text-4xl sm:text-5xl font-bold tracking-tight max-w-3xl text-balance;
  }

  .hero-sub {
    @apply text-lg md:text-xl text-ink/80 max-w-2xl mt-3 lg:mb-25;
  }

  .hp-install-panel {
    @apply border border-ink/15 rounded-lg bg-paper p-3 mt-3 max-w-2xl space-y-1;

    .hero-install-meta {
      @apply flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-xs mb-1;

      #install-platform {
        @apply font-semibold uppercase bg-accent-soft text-ink rounded-sm px-1.5 py-0.5;
      }

      a {
        @apply font-normal no-underline text-link hover:bg-accent-soft;
      }
    }

    pre {
      @apply my-0;

      code {
        @apply text-[13px];
      }
    }

    #install-windows {
      @apply my-0;

      .install-win-btn {
        @apply inline-flex items-center gap-2 rounded-md bg-accent text-ink font-semibold no-underline px-3 py-1.5 hover:bg-accent-strong active:bg-accent-strong;
      }
    }
  }

  .hero-ctas {
    @apply flex flex-wrap gap-3 mt-4;
  }

  .news-list {
    @apply list-none pl-0 space-y-1.5;

    li {
      @apply flex items-baseline gap-3;
    }

    .news-date {
      @apply text-xs text-ink/70 font-mono shrink-0;
    }

    a {
      @apply font-normal;
    }
  }

  .hp-features {
    @apply grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3 items-stretch;
  }

  .hp-feature {
    @apply flex flex-col border border-ink/15 rounded-lg overflow-hidden bg-paper;
  }

  .hp-feature-head {
    @apply flex items-baseline gap-2 px-3 py-1.5 border-b border-ink/10;
    background: linear-gradient(
      to right,
      var(--color-accent-soft),
      var(--color-tint)
    );
  }

  .hp-feature-name {
    @apply font-mono font-semibold text-sm lowercase no-underline text-ink hover:bg-accent-soft;
  }

  .hp-feature-chip {
    @apply font-mono text-[10px] font-bold uppercase px-1.5 py-0.5 rounded-sm bg-accent-soft-red text-ink-red ml-auto;
  }

  .hp-feature-blurb {
    @apply text-sm text-ink/70 px-3 py-2;
  }

  .hp-feature-code {
    @apply mt-auto;
  }

  .hp-feature-code :global(pre) {
    @apply my-0;
  }

  .hp-feature-code :global(pre code) {
    @apply rounded-none text-[13px];
  }

  /* stdlib board: gap-px over an ink/10 backdrop = hairline seams */
  .hp-stdlib {
    @apply grid grid-cols-2 md:grid-cols-4 gap-px bg-ink/10 border border-ink/15 rounded-lg overflow-hidden;

    a {
      @apply flex flex-col gap-0.5 bg-paper p-2 no-underline hover:bg-accent-soft active:bg-accent-soft;

      .mod-name {
        @apply font-mono font-semibold text-sm text-ink;
      }

      .mod-desc {
        @apply text-xs text-ink/70 font-normal;
      }
    }
  }

  .release-note {
    @apply text-sm text-ink/80;
  }
</style>

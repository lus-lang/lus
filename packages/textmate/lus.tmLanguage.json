{
  "name": "lus",
  "scopeName": "source.lus",
  "patterns": [
    {
      "begin": "\\b(?:(local)\\s+)?(function)\\b(?![,:])",
      "beginCaptures": {
        "1": {
          "name": "keyword.local.lus"
        },
        "2": {
          "name": "keyword.control.lus"
        }
      },
      "end": "(?<=[\\)\\-{}\\[\\]\"'])",
      "name": "meta.function.lus",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": "(\\()",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.begin.lus"
            }
          },
          "end": "(\\))|(?=[\\-{}\\[\\]\"'])|(?<!\\.)\\.(?!\\.)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.finish.lus"
            }
          },
          "name": "meta.parameter.lus",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "match": "(\\.{3})\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
              "captures": {
                "1": {
                  "name": "constant.language.lus"
                },
                "2": {
                  "name": "variable.parameter.function.lus"
                }
              }
            },
            {
              "match": "[a-zA-Z_][a-zA-Z0-9_]*",
              "name": "variable.parameter.function.lus"
            },
            {
              "match": ",",
              "name": "punctuation.separator.arguments.lus"
            }
          ]
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b\\s*(?=:)",
          "name": "entity.name.class.lus"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "name": "entity.name.function.lus"
        }
      ]
    },
    {
      "begin": "(@)(?=[a-zA-Z_(])",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.query.lus"
        }
      },
      "end": "(?=[;)\\]}])|(?=^\\s*$)|(?=\\b(?:local|global|function|return|if|elseif|else|for|while|repeat|until|do|end|then|break|continue|goto|catch|provide)\\b)",
      "name": "meta.query.lus",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "match": "\\b(where|select|distinct|group|having|order|by|limit|offset|as|asc|desc)\\b",
          "name": "keyword.control.query.lus"
        },
        {
          "match": "\\b(count|sum|avg|min|max)\\b(?=\\s*\\()",
          "name": "support.function.query.lus"
        },
        {
          "match": "(?<![\\w\\d.])\\d+(\\.\\d*)?([eE]-?\\d*)?",
          "name": "constant.numeric.float.lus"
        },
        {
          "match": "\\b(and|or|not|nil|true|false)\\b",
          "name": "keyword.operator.query.lus"
        }
      ]
    },
    {
      "match": "(?<![\\w\\d.])(?:0[xX][0-9A-Fa-f]+|\\d+)n\\b",
      "name": "constant.numeric.integer.bigint.lus"
    },
    {
      "match": "(?<![\\w\\d.])(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][-+]?\\d+)?d\\b",
      "name": "constant.numeric.decimal.lus"
    },
    {
      "match": "(?<![\\w\\d.])0[xX][0-9A-Fa-f]+(\\.[0-9A-Fa-f]*)?([eE]-?\\d*)?([pP][-+]\\d+)?",
      "name": "constant.numeric.float.hexadecimal.lus"
    },
    {
      "match": "(?<![\\w\\d.])0[xX]\\.[0-9A-Fa-f]+([eE]-?\\d*)?([pP][-+]\\d+)?",
      "name": "constant.numeric.float.hexadecimal.lus"
    },
    {
      "match": "(?<![\\w\\d.])0[xX][0-9A-Fa-f]+(?![pPeE.0-9])",
      "name": "constant.numeric.integer.hexadecimal.lus"
    },
    {
      "match": "(?<![\\w\\d.])\\d+(\\.\\d*)?([eE]-?\\d*)?",
      "name": "constant.numeric.float.lus"
    },
    {
      "match": "(?<![\\w\\d.])\\.\\d+([eE]-?\\d*)?",
      "name": "constant.numeric.float.lus"
    },
    {
      "match": "(?<![\\w\\d.])\\d+(?![pPeE.0-9])",
      "name": "constant.numeric.integer.lus"
    },
    {
      "include": "#string"
    },
    {
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.lus"
        }
      },
      "match": "\\A(#!).*$\\n?",
      "name": "comment.line.shebang.lus"
    },
    {
      "include": "#comment"
    },
    {
      "captures": {
        "1": {
          "name": "keyword.control.goto.lus"
        },
        "2": {
          "name": "string.tag.lus"
        }
      },
      "match": "\\b(goto)\\s+([a-zA-Z_][a-zA-Z0-9_]*)"
    },
    {
      "captures": {
        "1": {
          "name": "punctuation.section.embedded.begin.lus"
        },
        "2": {
          "name": "punctuation.section.embedded.end.lus"
        }
      },
      "match": "(::)\\s*[a-zA-Z_][a-zA-Z0-9_]*\\s*(::)",
      "name": "string.tag.lus"
    },
    {
      "match": "<\\s*(const|close|group)\\s*>",
      "name": "storage.type.attribute.lus"
    },
    {
      "begin": "<(?![=<\\s])",
      "beginCaptures": {
        "0": {
          "name": "storage.type.attribute.lus"
        }
      },
      "end": ">",
      "endCaptures": {
        "0": {
          "name": "storage.type.attribute.lus"
        }
      },
      "name": "meta.attribute.lus",
      "patterns": [
        {
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
          "name": "storage.type.attribute.lus"
        },
        {
          "include": "$self"
        }
      ]
    },
    {
      "begin": "\\b(catch)\\s*(\\[)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.lus"
        },
        "2": {
          "name": "punctuation.section.brackets.begin.lus"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.lus"
        }
      },
      "name": "meta.catch-handler.lus",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    {
      "match": "\\b(break|catch|continue|do|else|end|enum|for|from|if|elseif|goto|in|provide|repeat|return|then|until|while)\\b",
      "name": "keyword.control.lus"
    },
    {
      "match": "\\b(local)\\b",
      "name": "keyword.local.lus"
    },
    {
      "match": "^\\s*(global)\\b(?!\\s*=)",
      "captures": {
        "1": {
          "name": "keyword.global.lus"
        }
      }
    },
    {
      "match": "\\b(function)\\b(?![,:])",
      "name": "keyword.control.lus"
    },
    {
      "match": "(?<![^.]\\.|:)\\b(?:fs\\.path\\.delimiter|fs\\.path\\.separator|package\\.searchers|utf8\\.charpattern|math\\.maxinteger|math\\.mininteger|package\\.preload|package\\.config|package\\.loaded|package\\.cpath|package\\.path|time\\.weekday|time\\.month|io\\.stderr|io\\.stdout|math\\.huge|_VERSION|io\\.stdin|math\\.pi|false|flags|_ENV|true|_G|nil(?!:))\\b|(?<![.])\\.{3}(?!\\.)",
      "name": "constant.language.lus"
    },
    {
      "match": "(?<![^.]\\.|:)\\b(self)\\b",
      "name": "variable.language.self.lus"
    },
    {
      "match": "(?<![^.]\\.|:)\\b(?:collectgarbage|getmetatable|setmetatable|fromjson|loadfile|rawequal|tonumber|tostring|decimal|fromcsv|require|assert|bigint|dofile|ipairs|pledge|rawget|rawlen|rawset|select|tojson|error|pairs|print|query|tocsv|load|next|type|warn)\\b(?!\\s*=(?!=))",
      "name": "support.function.lus"
    },
    {
      "match": "(?<![^.]\\.|:)\\b(async)\\b(?!\\s*=(?!=))",
      "name": "entity.name.tag.lus"
    },
    {
      "match": "(?<![^.]\\.|:)\\b(?:vector\\.archive\\.deflate\\.decompress|vector\\.archive\\.brotli\\.decompress|vector\\.archive\\.lz4\\.decompress_hc|vector\\.archive\\.deflate\\.compress|vector\\.archive\\.brotli\\.compress|vector\\.archive\\.gzip\\.decompress|vector\\.archive\\.zstd\\.decompress|vector\\.archive\\.lz4\\.decompress|vector\\.archive\\.gzip\\.compress|vector\\.archive\\.zstd\\.compress|vector\\.archive\\.lz4\\.compress|tcp_server:getsockname|udp_socket:getsockname|coroutine\\.isyieldable|crypto\\.verifypassword|crypto\\.hashpassword|network\\.tcp\\.connect|time\\.tzdata_version|debug\\.getmetatable|debug\\.getuservalue|debug\\.setmetatable|debug\\.setuservalue|fs\\.createdirectory|package\\.searchpath|tcp_socket:receive|udp_socket:receive|coroutine\\.running|debug\\.getregistry|debug\\.upvaluejoin|vector\\.fromstring|vector\\.unpackmany|coroutine\\.create|coroutine\\.detach|coroutine\\.resume|coroutine\\.status|debug\\.getupvalue|debug\\.setupvalue|network\\.tcp\\.bind|network\\.udp\\.open|string\\.transcode|coroutine\\.close|coroutine\\.yield|debug\\.queryplan|debug\\.traceback|debug\\.upvalueid|math\\.randomseed|package\\.loadlib|string\\.packsize|table\\.transpose|vector\\.tostring|coroutine\\.wrap|crypto\\.keypair|debug\\.getlocal|debug\\.setlocal|fs\\.path\\.parent|math\\.tointeger|string\\.reverse|time\\.localzone|time\\.monotonic|utf8\\.codepoint|worker\\.message|worker\\.receive|crypto\\.hasher|crypto\\.random|crypto\\.verify|debug\\.gethook|debug\\.getinfo|debug\\.sethook|fs\\.createlink|fs\\.path\\.split|network\\.fetch|network\\.serve|string\\.format|string\\.gmatch|string\\.unpack|table\\.compact|table\\.groupby|table\\.reshape|time\\.duration|vector\\.create|vector\\.resize|vector\\.unpack|worker\\.create|worker\\.status|crypto\\.equal|debug\\.format|fs\\.path\\.join|fs\\.path\\.name|os\\.setlocale|string\\.lower|string\\.ltrim|string\\.match|string\\.rtrim|string\\.split|string\\.upper|table\\.concat|table\\.create|table\\.filter|table\\.insert|table\\.median|table\\.reduce|table\\.remove|table\\.sortby|table\\.unpack|time\\.instant|time\\.minutes|time\\.seconds|vector\\.clone|crypto\\.hash|crypto\\.hmac|crypto\\.sign|crypto\\.ulid|crypto\\.uuid|debug\\.debug|debug\\.parse|math\\.random|os\\.difftime|os\\.platform|string\\.byte|string\\.char|string\\.dump|string\\.find|string\\.gsub|string\\.join|string\\.pack|string\\.trim|table\\.clone|table\\.stdev|table\\.unzip|time\\.millis|time\\.offset|utf8\\.offset|vector\\.pack|vector\\.size|worker\\.peek|worker\\.send|io\\.tmpfile|math\\.floor|math\\.frexp|math\\.ldexp|os\\.execute|os\\.tmpname|string\\.len|string\\.rep|string\\.sub|table\\.mean|table\\.move|table\\.pack|table\\.sort|time\\.hours|time\\.parse|time\\.zoned|utf8\\.codes|vector\\.get|vector\\.set|debug\\.jit|fs\\.follow|fs\\.remove|io\\.output|io\\.sqlite|math\\.acos|math\\.asin|math\\.atan|math\\.ceil|math\\.fmod|math\\.modf|math\\.sqrt|math\\.type|os\\.getenv|table\\.map|table\\.sum|table\\.zip|time\\.days|time\\.zone|utf8\\.char|io\\.close|io\\.flush|io\\.input|io\\.lines|io\\.popen|io\\.write|math\\.abs|math\\.cos|math\\.deg|math\\.exp|math\\.log|math\\.max|math\\.min|math\\.rad|math\\.sin|math\\.tan|math\\.ult|os\\.clock|time\\.now|utf8\\.len|fs\\.copy|fs\\.list|fs\\.move|fs\\.type|io\\.open|io\\.read|io\\.type|os\\.date|os\\.exit|os\\.time)\\b(?!\\s*=(?!=))",
      "name": "support.function.library.lus"
    },
    {
      "match": "\\b(\\|\\||\\&\\&|\\!)\\b",
      "name": "keyword.operator.lus"
    },
    {
      "match": "\\b(and|or|not)\\b",
      "name": "keyword.operator.logical.lus"
    },
    {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=\\s*(?:[({\"']|\\[\\[))",
      "name": "support.function.any-method.lus"
    },
    {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=\\s*\\??:)",
      "name": "entity.name.class.lus"
    },
    {
      "match": "(?<=[^.]\\.|:)\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?!\\s*=\\s*\\b(function)\\b)",
      "name": "entity.other.attribute.lus"
    },
    {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?!\\s*=\\s*\\b(function)\\b)",
      "name": "variable.other.lus"
    },
    {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=\\s*=\\s*\\b(function)\\b)",
      "name": "entity.name.function.lus"
    },
    {
      "match": "\\+|-|%|#|\\*|\\/|\\^|==?|~=|!=|<=?|>=?|(?<!\\.)\\.{2}(?!\\.)|\\?\\.|\\?:|\\?",
      "name": "keyword.operator.lus"
    }
  ],
  "repository": {
    "escaped_char": {
      "patterns": [
        {
          "match": "\\\\[abfnrtv\\\\\"'\\n]",
          "name": "constant.character.escape.lus"
        },
        {
          "match": "\\\\z[\\n\\t ]*",
          "name": "constant.character.escape.lus"
        },
        {
          "match": "\\\\\\d{1,3}",
          "name": "constant.character.escape.byte.lus"
        },
        {
          "match": "\\\\x[0-9A-Fa-f][0-9A-Fa-f]",
          "name": "constant.character.escape.byte.lus"
        },
        {
          "match": "\\\\u\\{[0-9A-Fa-f]+\\}",
          "name": "constant.character.escape.unicode.lus"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.character.escape.lus"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lus"
            }
          },
          "end": "'[ \\t]*|(?=\\n)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lus"
            }
          },
          "name": "string.quoted.single.lus",
          "patterns": [
            {
              "include": "#escaped_char"
            }
          ]
        },
        {
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lus"
            }
          },
          "end": "\"[ \\t]*|(?=\\n)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lus"
            }
          },
          "name": "string.quoted.double.lus",
          "patterns": [
            {
              "include": "#escaped_char"
            }
          ]
        },
        {
          "begin": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lus"
            }
          },
          "end": "`[ \\t]*",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lus"
            }
          },
          "name": "string.quoted.template.lus",
          "patterns": [
            {
              "match": "\\$\\$",
              "name": "constant.character.escape.lus"
            },
            {
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
              "name": "variable.other.interpolated.lus"
            },
            {
              "begin": "\\$\\(",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.lus"
                }
              },
              "end": "\\)",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.lus"
                }
              },
              "name": "meta.embedded.expression.lus",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "begin": "(?<!--)\\[(=*)\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lus"
            }
          },
          "end": "\\]\\1\\][ \\t]*",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lus"
            }
          },
          "name": "string.quoted.other.multiline.lus"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "begin": "(^[ \\t]+)?(?=--)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.lus"
            }
          },
          "end": "(?!\\G)((?!^)[ \\t]+\\n)?",
          "endCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.trailing.lus"
            }
          },
          "patterns": [
            {
              "begin": "--\\[(=*)\\[",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.comment.begin.lus"
                }
              },
              "end": "(--)?\\]\\1\\]",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.comment.end.lus"
                }
              },
              "name": "comment.block.lus"
            },
            {
              "begin": "--",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.comment.lus"
                }
              },
              "end": "\\n",
              "name": "comment.line.double-dash.lus"
            }
          ]
        },
        {
          "begin": "\\/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.lus"
            }
          },
          "end": "\\*\\/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.lus"
            }
          },
          "name": "comment.block.lus"
        }
      ]
    }
  }
}

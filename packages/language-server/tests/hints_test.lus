-- The language server shows the hints of `lus check` (spec/design/hints.md)
-- as diagnostics of severity Hint.
local LANG_DIR = string.match(TEST_DIR, "^(.*)[/\\][^/\\]*$")

pledge("load", `fs:read=$LANG_DIR/**`)

table.insert(package.searchers, 2, function(name)
    if rest = string.match(name, "^lus%-language%.(.+)$") then
        if path = package.searchpath(rest, `$LANG_DIR/?.lus`) then
            return assert(loadfile(path)), path
        end
    end

    return nil
end)

local document = require("lus-language.document")
local ast_mod = require("lus-language.analysis.ast")
local linting = require("lus-language.analysis.linting")

local function diagnostics_of(source)
    local uri = "file:///hints/sample.lus"
    document.open(uri, 1, source)
    ast_mod.parse(uri)
    local list = linting.compute(uri)
    document.close(uri)
    return list
end

local function hints_appear_with_their_code_test()
    local list = diagnostics_of('local s = ""\nfor i = 1, 3 do s = s .. i end\nprint(s)\n')
    local found

    for _, d in ipairs(list) do
        if d.code == "concat-in-loop" then
            found = d
        end
    end

    assert(found ~= nil)
    assert(found.severity == 4)
    assert(found.range.start.line == 1)
end

local function warnings_of_check_are_not_duplicated_test()
    local list = diagnostics_of("local unused = 1\n")

    for _, d in ipairs(list) do
        assert(d.code ~= "unused-local")
    end
end

-- The language server modules are required under the name `lus-language`. A searcher maps
-- that name onto the package directory next to the tests.
local LANG_DIR = string.match(TEST_DIR, "^(.*)/[^/]*$")

-- The linted corpus is the frozen H1 suite under legacy/lus-tests/h1 in the repository root.
local ROOT = string.match(LANG_DIR, "^(.*)/packages/[^/]*$")

pledge("load", "fs:read=" .. LANG_DIR .. "/*", "fs:read=" .. ROOT .. "/legacy/lus-tests/h1/*")

table.insert(package.searchers, 2, function(name)
    local rest = string.match(name, "^lus%-language%.(.+)$")
    if rest == nil then
        return nil
    end
    local path = package.searchpath(rest, LANG_DIR .. "/?.lus")
    if path == nil then
        return nil
    end
    return assert(loadfile(path)), path
end)

local document = require("lus-language.document")
local ast_mod = require("lus-language.analysis.ast")
local linting = require("lus-language.analysis.linting")

-- The H1 suite files that the linter must accept without false 'Undefined global' warnings.
local h1_files = {
  "enum", "errors", "from", "ifassign", "whileassign", "optchain",
  "bitwise", "math", "strings", "attrib", "calls", "catchstat",
  "closure", "constructs", "coroutine", "events", "gc", "goto",
  "literals", "locals", "nextvar", "pm", "sort", "tpack",
  "transcode", "utf8", "vararg", "db", "big", "bwcoercion",
  "cstack", "gengc", "memerr", "json", "network", "worker",
  "parse", "slices", "groups", "vectors", "cloning", "pledge",
  "runtime-attrs", "doexpr", "interp", "lsp-unit", "lsp-integration",
  "sqlite", "sqlite_fs", "query_syntax", "query", "query_sqlite",
}

-- Group: no false 'Undefined global' warnings

local no_false_undefined_global_warnings_cases = {}
for _, name in ipairs(h1_files) do
  no_false_undefined_global_warnings_cases[#no_false_undefined_global_warnings_cases + 1] = { name }
end

local function no_false_undefined_global_warnings_test(name)
  local path = ROOT .. "/legacy/lus-tests/h1/" .. name .. ".lus"
  local f = assert(io.open(path, "r"))
  local source = f:read("a")
  f:close()

  local uri = "file:///lint-test/" .. name .. ".lus"
  document.open(uri, 1, source)
  ast_mod.parse(uri)
  local diagnostics = linting.compute(uri)
  document.close(uri)

  -- Collect "Undefined global" warnings
  local false_positives = {}
  for _, d in ipairs(diagnostics) do
    if string.find(d.message, "Undefined global") then
      false_positives[#false_positives + 1] = d.message
          .. " (line " .. tostring(d.range.start.line + 1) .. ")"
    end
  end

  assert(#false_positives == 0)
end

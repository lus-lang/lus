-- =========================================================================
-- G. Completion after incremental edits
-- =========================================================================

-- Group: completion after incremental edits

local function completions_work_after_opening_a_file_test()
  local uri = "file:///test/e2e-comp-1.lus"
  open_doc(uri, "local greeting = 'hello'\nlocal x = gre")
  local raw = send_request("textDocument/completion", {
    textDocument = {uri = uri},
    position = {line = 1, character = 13},
  })
  local resp = parse_response(raw)
  assert(resp ~= nil)
  assert(resp.result ~= nil)
  close_doc(uri)
end

local function completions_update_after_editing_code_test()
  local uri = "file:///test/e2e-comp-2.lus"
  open_doc(uri, "local myVar = 1\nlocal x = my")

  -- Edit to add another variable
  insert_at(uri, 0, 15, "\nlocal myOther = 2")

  -- Request completions for "my" prefix
  local raw, id = send_request("textDocument/completion", {
    textDocument = {uri = uri},
    position = {line = 2, character = 12},
  })
  local resp = parse_response(raw, id)
  assert(resp ~= nil)
  assert(resp.result ~= nil)

  local items = resp.result.items or resp.result
  local found_var = false
  local found_other = false
  for _, item in ipairs(items) do
    if item.label == "myVar" then found_var = true end
    if item.label == "myOther" then found_other = true end
  end
  assert(found_var)
  assert(found_other)
  close_doc(uri)
end

local function table_field_completions_return_results_test()
  local uri = "file:///test/e2e-comp-3.lus"
  open_doc(uri, "local user = {name = 'Alice', age = 30}\nlocal x = user.")
  local raw = send_request("textDocument/completion", {
    textDocument = {uri = uri},
    position = {line = 1, character = 15},
  })
  local resp = parse_response(raw)
  assert(resp ~= nil)
  assert(resp.result ~= nil)
  close_doc(uri)
end

-- =========================================================================
-- H. Rapid edits (stress)
-- =========================================================================

-- Group: rapid incremental edits

local function many_single_char_inserts_produce_valid_final_state_test()
  local uri = "file:///test/e2e-rapid-1.lus"
  open_doc(uri, "")

  -- Type a valid statement character by character, keeping the
  -- diagnostics each keystroke produced
  local text = "local abc = 123"
  local col = 0
  local diags = {}
  for i = 1, #text do
    local ch = string.sub(text, i, i)
    diags = insert_at(uri, 0, col, ch)
    col = col + 1
  end

  -- Judge the state the keystrokes actually built: the last insert's
  -- diagnostics describe the incrementally typed document itself, with
  -- no repair edit in between
  local errors = get_errors(diags)
  assert(#errors == 0)

  -- Cross-check with a reference to the typed local: a garbled document
  -- surfaces here as a syntax error or an undefined-global warning, and
  -- a crashed server surfaces as a missing diagnostics notification
  local raw = send_notification("textDocument/didChange", {
    textDocument = {uri = uri, version = next_version(uri)},
    contentChanges = {{
      range = make_range(0, #text, 0, #text),
      text = "\nlocal use = abc",
    }},
  })
  assert(string.find(raw, "publishDiagnostics"))
  local vdiags = get_diagnostics(raw)
  assert(#get_errors(vdiags) == 0)
  assert_no_var_not_declared(vdiags, "char-by-char verify: ")
  close_doc(uri)
end

local function rapid_edits_across_multiple_lines_test()
  local uri = "file:///test/e2e-rapid-2.lus"
  -- Open with a valid multi-line document, then do rapid single-char edits
  open_doc(uri, "local a = 1\nlocal b = 2")
  -- Type a third line character by character
  local line, col = 1, 11
  local _, _, results = type_chars(uri, line, col, "\nlocal c = 3")
  -- Final char should produce clean diagnostics
  local last = results[#results]
  local errors = get_errors(last.diagnostics)
  assert(#errors == 0)
  close_doc(uri)
end

local function interleaved_insert_and_delete_operations_test()
  local uri = "file:///test/e2e-rapid-3.lus"
  open_doc(uri, "local x = 1")

  -- Replace the value a few times (stay within single-digit to keep ranges simple)
  local diags = {}
  for i = 2, 5 do
    delete_range(uri, 0, 10, 0, 11)
    diags = insert_at(uri, 0, 10, tostring(i))
  end

  -- The last insert's diagnostics describe the interleaved-edit state
  -- itself ("local x = 5"), with no repair edit in between
  local errors = get_errors(diags)
  assert(#errors == 0)

  -- Cross-check by appending a reference to x at the exact column the
  -- edits should have produced; a corrupted line surfaces here, and a
  -- crashed server surfaces as a missing diagnostics notification
  local raw = send_notification("textDocument/didChange", {
    textDocument = {uri = uri, version = next_version(uri)},
    contentChanges = {{
      range = make_range(0, 11, 0, 11),
      text = "\nlocal use = x",
    }},
  })
  assert(string.find(raw, "publishDiagnostics"))
  local vdiags = get_diagnostics(raw)
  assert(#get_errors(vdiags) == 0)
  assert_no_var_not_declared(vdiags, "interleaved verify: ")
  close_doc(uri)
end

-- =========================================================================
-- I. Non-ASCII content (UTF-16/UTF-8 encoding)
-- =========================================================================

-- Group: non-ASCII content

local function file_with_multi_byte_chars_opens_without_errors_test()
  local uri = "file:///test/e2e-utf8-1.lus"
  -- café contains 2-byte UTF-8 for 'é'
  local diags = open_doc(uri, "local greeting = 'caf\xC3\xA9'")
  local errors = get_errors(diags)
  assert(#errors == 0)
  close_doc(uri)
end

local function edit_after_multi_byte_char_applies_correctly_test()
  local uri = "file:///test/e2e-utf8-2.lus"
  -- "local x = 'é'\nlocal y = 1": 'é' is 2 bytes but 1 UTF-16 code unit
  open_doc(uri, "local x = '\xC3\xA9'\nlocal y = 1")
  -- Edit line 1: replace "1" with "2" (position should be correct despite
  -- line 0 having multi-byte chars)
  local diags = edit_doc(uri, make_range(1, 10, 1, 11), "2")
  local errors = get_errors(diags)
  assert(#errors == 0)
  close_doc(uri)
end

local function edit_on_same_line_after_multi_byte_string_test()
  local uri = "file:///test/e2e-utf8-3.lus"
  -- local x = 'café' has é (2 bytes) inside the string.
  -- Bytes:  l(1)o(2)c(3)a(4)l(5) (6)x(7) (8)=(9) (10)'(11)c(12)a(13)f(14)é(15-16)'(17)
  -- UTF-16: l(0)o(1)c(2)a(3)l(4) (5)x(6) (7)=(8) (9)'(10)c(11)a(12)f(13)é(14)'(15)
  open_doc(uri, "local x = 'caf\xC3\xA9'\nlocal y = 1")
  -- Edit "1" on line 1; line 1 is ASCII-only so no encoding issue
  local diags = edit_doc(uri, make_range(1, 10, 1, 11), "42")
  local errors = get_errors(diags)
  assert(#errors == 0)
  close_doc(uri)
end

local function comment_with_non_ascii_does_not_produce_var_not_declared_test()
  local uri = "file:///test/e2e-utf8-4.lus"
  -- naïve has a 2-byte ï
  local diags = open_doc(uri, "-- na\xC3\xAFve approach\nlocal x = 1")
  assert_no_var_not_declared(diags, "non-ASCII comment: ")
  local errors = get_errors(diags)
  assert(#errors == 0)
  close_doc(uri)
end

-- =========================================================================

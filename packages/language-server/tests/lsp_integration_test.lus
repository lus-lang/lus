-- The language server modules are required under the name `lus-language`. A searcher maps
-- that name onto the package directory next to the tests.
local LANG_DIR = string.match(TEST_DIR, "^(.*)[/\\][^/\\]*$")

pledge("load", `fs:read=$LANG_DIR/**`)

table.insert(package.searchers, 2, function(name)
    if rest = string.match(name, "^lus%-language%.(.+)$") then
        if path = package.searchpath(rest, `$LANG_DIR/?.lus`) then
            return assert(loadfile(path)), path
        end
    end

    return nil
end)

-- Override io.write to capture output BEFORE loading wasm.lus
local capture_buffer = ""

local _original_write = io.write

io.write = function(...)
    local parts = table.pack(...)

    for i = 1, parts.n do
        parts[i] = tostring(parts[i])
    end

    capture_buffer = capture_buffer .. table.concat(parts)
    return io  -- match io.write chaining
end

-- Now require wasm.lus which will define _lsp_handle and call pledge("seal")
require("lus-language.wasm")

local transport = require("lus-language.transport")
local modules = require("lus-language.analysis.modules")
local uri_util = require("lus-language.util.uri")
local server_core = require("lus-language.server")

-- ---------------------------------------------------------------------------
-- Test helpers
-- ---------------------------------------------------------------------------

-- Helper to build an LSP range without inline ["end"] (formatter bug workaround)
local function make_range(sl, sc, el, ec)
    local r = { start = { line = sl, character = sc } }
    r["end"] = { line = el, character = ec }
    return r
end

local msg_id = 0

local function next_id()
    msg_id = msg_id + 1
    return msg_id
end

local function send(msg)
    capture_buffer = ""
    _lsp_handle(tojson(msg))  -- lus: allow(undefined-global)
    return capture_buffer
end

local function send_request(method, params)
    local id = next_id()
    return send({
        jsonrpc = "2.0",
        id = id,
        method = method,
        params = params or {},
    }), id
end

local function send_notification(method, params)
    return send({
        jsonrpc = "2.0",
        method = method,
        params = params or {},
    })
end

-- Parse the first LSP response from the captured output
local function parse_response(raw)
    if not raw or raw == "" then
        return nil
    end

    -- Find Content-Length header
    local len_str = string.match(raw, "Content%-Length: (%d+)")

    if not len_str then
        return nil
    end

    -- Find the JSON body after the header
    local body_start = string.find(raw, "\r\n\r\n")

    if not body_start then
        return nil
    end

    local body = string.sub(raw, body_start + 4)
    local ok, result = catch fromjson(body)

    if ok then
        return result
    end

    return nil
end

-- Parse all LSP messages from captured output
local function parse_all_responses(raw)
    if not raw or raw == "" then
        return {}
    end

    local results = {}
    local pos = 1

    while pos <= #raw do
        local len_start, len_end = string.find(raw, "Content%-Length: (%d+)", pos)

        if not len_start then
            break
        end

        local len_str = string.match(raw, "Content%-Length: (%d+)", pos)
        local len = tonumber(len_str)
        local header_end = string.find(raw, "\r\n\r\n", len_end)

        if not header_end then
            break
        end

        local body_start = header_end + 4
        local body = string.sub(raw, body_start, body_start + len - 1)

        if ok, msg = catch fromjson(body) then
            results[#results + 1] = msg
        end

        pos = body_start + len
    end

    return results
end

-- =========================================================================
-- Tests
-- =========================================================================

-- Group: LSP protocol integration

-- Initialize handshake
local function returns_capabilities_on_initialize_test()
    local raw = send_request("initialize", {
        processId = 1,
        rootUri = "file:///test",
        capabilities = {},
    })
    local resp = parse_response(raw)
    assert(resp ~= nil)
    assert(resp.result ~= nil)
    assert(resp.result.capabilities ~= nil)
    assert(resp.result.capabilities.hoverProvider == true)
    assert(resp.result.capabilities.definitionProvider == true)
    assert(resp.result.capabilities.documentHighlightProvider == true)
    assert(resp.result.capabilities.selectionRangeProvider == true)
    assert(resp.result.capabilities.workspace.workspaceFolders.supported == true)
    assert(resp.result.serverInfo.version == require("lus-language.version"))
end

-- Initialized notification
local function accepts_initialized_notification_without_error_test()
    local raw = send_notification("initialized", {})
    -- Should produce no response (it's a notification)
    assert(raw == "")
end

-- Open document triggers diagnostics
local function publishes_diagnostics_on_didopen_test()
    local raw = send_notification("textDocument/didOpen", {
        textDocument = {
            uri = "file:///test/integration.lus",
            languageId = "lus",
            version = 1,
            text = "local x = 1",
        },
    })
    -- Should publish diagnostics notification
    local msgs = parse_all_responses(raw)
    assert(#msgs >= 1)
    local diag_msg = msgs[1]
    assert(diag_msg.method == "textDocument/publishDiagnostics")
    assert(diag_msg.params ~= nil)
    assert(diag_msg.params.uri == "file:///test/integration.lus")
end

-- Change document triggers updated diagnostics with errors
local function publishes_error_diagnostics_on_didchange_with_broken_code_test()
    local raw = send_notification("textDocument/didChange", {
        textDocument = {
            uri = "file:///test/integration.lus",
            version = 2,
        },
        contentChanges = {
            {
                range = make_range(0, 0, 0, 11),
                text = "local = = =",
            },
        },
    })
    local msgs = parse_all_responses(raw)
    assert(#msgs >= 1)
    local diag_msg = msgs[1]
    assert(diag_msg.method == "textDocument/publishDiagnostics")
    assert(#diag_msg.params.diagnostics > 0)
end

-- Fix the doc back to valid code for subsequent tests
local function clears_diagnostics_on_valid_code_change_test()
    local raw = send_notification("textDocument/didChange", {
        textDocument = {
            uri = "file:///test/integration.lus",
            version = 3,
        },
        contentChanges = {
            {
                range = make_range(0, 0, 0, 11),
                text = "local x = 1\nlocal y = x + 1",
            },
        },
    })
    local msgs = parse_all_responses(raw)
    assert(#msgs >= 1)
    local diag_msg = nil

    for _, m in ipairs(msgs) do
        if m.method == "textDocument/publishDiagnostics" then
            diag_msg = m
        end
    end

    assert(diag_msg ~= nil)
    assert(diag_msg.params.uri == "file:///test/integration.lus")
    -- the syntax error must be gone: no error-severity diagnostics remain
    -- (lint hints like unused-local may still ride along)
    local error_count = 0

    for _, d in ipairs(diag_msg.params.diagnostics) do
        if d.severity == 1 then
            error_count = error_count + 1
        end

        assert(not string.find(d.message, "expected"))
    end

    assert(error_count == 0)
end

-- Document symbols
local function returns_document_symbols_test()
    local raw = send_request("textDocument/documentSymbol", {
        textDocument = { uri = "file:///test/integration.lus" },
    })
    local resp = parse_response(raw)
    assert(resp ~= nil)
    assert(resp.result ~= nil)
    assert(type(resp.result) == "table")
end

-- Hover
local function returns_hover_information_test()
    -- position (0, 6) sits on the x of "local x = 1", so hover must
    -- resolve to real content, not null
    local raw = send_request("textDocument/hover", {
        textDocument = { uri = "file:///test/integration.lus" },
        position = { line = 0, character = 6 },
    })
    local resp = parse_response(raw)
    assert(resp ~= nil)
    assert(type(resp.result) == "table")
    assert(resp.result.contents ~= nil)
    assert(string.find(resp.result.contents.value, "local x"))
end

-- Completion
local function returns_completions_test()
    local raw = send_request("textDocument/completion", {
        textDocument = { uri = "file:///test/integration.lus" },
        position = { line = 1, character = 10 },
    })
    local resp = parse_response(raw)
    assert(resp ~= nil)
    assert(resp.result ~= nil)
end

-- Unknown method returns MethodNotFound
local function returns_methodnotfound_for_unknown_methods_test()

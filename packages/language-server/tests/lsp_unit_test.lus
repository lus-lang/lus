-- =========================================================================
-- Selection Range (new)
-- =========================================================================
-- Group: operations/selection_range

local function returns_selection_ranges_for_positions_test()
  local uri = open_doc("local function foo()\n  local x = 1\nend")
  local result = selection_range.compute(uri, {{line = 1, character = 8}})
  assert(#result >= 1)
  assert(result[1].range ~= nil)
  close_doc(uri)
end

local function chains_parent_ranges_test()
  local uri = open_doc("local function foo()\n  local x = 1\nend")
  local result = selection_range.compute(uri, {{line = 1, character = 8}})
  -- The innermost range must chain through .parent to progressively larger
  -- ranges, and every parent must fully contain its child (LSP 3.17 contract).
  assert(result[1] ~= nil)
  assert(result[1].parent ~= nil)

  local function pos_leq(a, b)
    return a.line < b.line or (a.line == b.line and a.character <= b.character)
  end

  local node = result[1]
  while node.parent do
    local child = node.range
    local parent = node.parent.range
    assert(pos_leq(parent.start, child.start))
    assert(pos_leq(child["end"], parent["end"]))
    node = node.parent
  end
  close_doc(uri)
end


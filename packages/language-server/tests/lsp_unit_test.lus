    message = "Undefined global 'unknown_var'",
  }
  local result = code_action.compute(uri, diag.range, {diagnostics = {diag}})
  assert(#result >= 1)
  assert(string.find(result[1].title, "global"))
  close_doc(uri)
end

local function suggests_prefixing_unused_local_with_test()

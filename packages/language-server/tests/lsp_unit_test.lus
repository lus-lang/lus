  local result = format_mod.compute(uri, {tabSize = 2})
  assert(result ~= nil)
  assert(#result == 1)
  assert(string.find(result[1].newText, "  x = 1"))
  close_doc(uri)
end

local function returns_nil_with_error_for_broken_code_test()
  local uri = open_doc("if then then then")
  local result, err = format_mod.compute(uri, {tabSize = 4})
  assert(result == nil)
  assert(err ~= nil)
  close_doc(uri)
end

local function respects_tabsize_option_test()
  local uri = open_doc("if true then\nx=1\nend")
  local r4 = format_mod.compute(uri, {tabSize = 4})
  assert(string.find(r4[1].newText, "    x = 1"))
  local r2 = format_mod.compute(uri, {tabSize = 2})
  assert(string.find(r2[1].newText, "  x = 1"))
  close_doc(uri)
end

local function returns_empty_array_for_already_formatted_code_test()
  local uri = open_doc("local x = 1\n")
  local first = format_mod.compute(uri, {tabSize = 4})
  if first and #first > 0 then
    close_doc(uri)
    uri = open_doc(first[1].newText)
  end
  local second = format_mod.compute(uri, {tabSize = 4})
  assert(second ~= nil)
  assert(#second == 0)
  close_doc(uri)
end

local function range_formatting_returns_edits_test()
  local uri = open_doc("if true then\nx=1\nend")
  local range = make_range(0, 0, 2, 3)
  local result, err = format_mod.compute_range(uri, range, {tabSize = 4})
  assert(result ~= nil)
  assert(#result > 0)
  close_doc(uri)
end

local function preserves_trailing_comments_inline_test()
  local uri = open_doc("local a = 1 -- test here\n")
  local result = format_mod.compute(uri, {tabSize = 4})
  if #result > 0 then
    -- The comment should be on the same line as the code
    local first_line = string.match(result[1].newText, "[^\n]+")
    assert(string.find(first_line, "local a = 1"))
    assert(string.find(first_line, "-- test here"))
  end
  close_doc(uri)
end

-- =========================================================================

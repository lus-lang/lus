-- The language server modules are required under the name `lus-language`. A searcher maps
-- that name onto the package directory next to the tests.
local LANG_DIR = string.match(TEST_DIR, "^(.*)[/\\][^/\\]*$")

pledge("load", "fs:read=" .. LANG_DIR .. "/*")

table.insert(package.searchers, 2, function(name)
    local rest = string.match(name, "^lus%-language%.(.+)$")
    if rest == nil then
        return nil
    end
    local path = package.searchpath(rest, LANG_DIR .. "/?.lus")
    if path == nil then
        return nil
    end
    return assert(loadfile(path)), path
end)

-- Load LS modules
local document = require("lus-language.document")
local ast_mod = require("lus-language.analysis.ast")
local scope_mod = require("lus-language.analysis.scope")
local types_mod = require("lus-language.analysis.types")
local stdlib_data = require("lus-language.analysis.stdlib_data")
local diagnostics = require("lus-language.analysis.diagnostics")
local linting = require("lus-language.analysis.linting")
local symbols = require("lus-language.operations.symbols")
local completion = require("lus-language.operations.completion")
local hover = require("lus-language.operations.hover")
local definition = require("lus-language.operations.definition")
local references = require("lus-language.operations.references")
local rename = require("lus-language.operations.rename")
local sem_tokens = require("lus-language.operations.semantic_tokens")
local signature = require("lus-language.operations.signature")
local folding = require("lus-language.operations.folding")
local inlay_hints = require("lus-language.operations.inlay_hints")
local format_mod = require("lus-language.operations.format")
local highlight = require("lus-language.operations.highlight")
local prepare_rename = require("lus-language.operations.prepare_rename")
local selection_range = require("lus-language.operations.selection_range")
local code_action = require("lus-language.operations.code_action")

-- ---------------------------------------------------------------------------
-- Test helpers
-- ---------------------------------------------------------------------------

local doc_counter = 0

local function open_doc(source)
  doc_counter = doc_counter + 1
  local uri = "file:///test/doc_" .. doc_counter .. ".lus"
  document.open(uri, 1, source)
  ast_mod.parse(uri)
  return uri
end

local function close_doc(uri)
  document.close(uri)
end

-- Helper to build an LSP range without using ["end"] literal in table constructor
-- (the Lus formatter converts ["end"] to unquoted end which breaks parsing)
local function make_range(sl, sc, el, ec)
  local r = {start = {line = sl, character = sc}}
  r["end"] = {line = el, character = ec}
  return r
end

-- =========================================================================
-- Document module
-- =========================================================================
-- Group: document

local function opens_and_retrieves_a_document_test()
  local uri = open_doc("local x = 1")
  local doc = document.get(uri)
  assert(doc ~= nil)
  assert(doc.text == "local x = 1")
  close_doc(uri)
end

local function returns_text_via_get_text_test()
  local uri = open_doc("local y = 2")
  assert(document.get_text(uri) == "local y = 2")
  close_doc(uri)
end

local function returns_nil_for_unknown_uri_test()
  assert(document.get("file:///nonexistent") == nil)
end

local function closes_a_document_test()
  local uri = open_doc("local z = 3")
  close_doc(uri)
  assert(document.get(uri) == nil)
end

local function lists_all_open_documents_test()
  local u1 = open_doc("local a = 1")
  local u2 = open_doc("local b = 2")
  local all = document.all()
  assert(#all >= 2)
  close_doc(u1)
  close_doc(u2)
end

local function applies_incremental_changes_test()
  local uri = open_doc("local x = 1")
  document.change(uri, 2, {
    {range = make_range(0, 10, 0, 11), text = "42"},
  })
  assert(document.get_text(uri) == "local x = 42")
  close_doc(uri)
end

-- =========================================================================
-- AST module
-- =========================================================================
-- Group: analysis/ast

local function parses_valid_code_test()
  local uri = open_doc("local x = 1\nlocal y = 2")
  local tree = ast_mod.get(uri)
  assert(tree ~= nil)
  assert(type(tree) == "table")
  close_doc(uri)
end

local function returns_errors_for_invalid_code_test()
  local uri = open_doc("local = = =")
  local tree, errors = ast_mod.parse(uri)
  assert(errors ~= nil and #errors > 0)
  close_doc(uri)
end

local function caches_ast_between_calls_test()
  local uri = open_doc("local x = 1")
  local tree1 = ast_mod.get(uri)
  local tree2 = ast_mod.get(uri)
  assert(tree1 == tree2)
  close_doc(uri)
end

local function invalidates_ast_on_content_change_test()
  local uri = open_doc("local x = 1")
  local tree1 = ast_mod.get(uri)
  assert(#tree1.children == 1)
  document.change(uri, 2, {
    {range = make_range(0, 11, 0, 11), text = "\nlocal y = 2"},
  })
  ast_mod.parse(uri)
  -- The stale pre-edit tree must not be served back, and the fresh tree
  -- must reflect the edited content
  local tree2 = ast_mod.get(uri)
  assert(tree2 ~= nil)
  assert(tree1 ~= tree2)
  assert(#tree2.children == 2)
  close_doc(uri)
end

local function falls_back_to_last_good_ast_on_error_test()
  local uri = open_doc("local x = 1")
  local good_tree = ast_mod.get(uri)
  assert(good_tree ~= nil)
  -- Now introduce a parse error
  document.change(uri, 2, {
    {range = make_range(0, 0, 0, 11), text = "local = = ="},
  })
  ast_mod.parse(uri)
  local fallback = ast_mod.get(uri)
  -- Should still return the last good AST
  assert(fallback ~= nil)
  close_doc(uri)
end

-- =========================================================================
-- Scope module
-- =========================================================================
-- Group: analysis/scope

local function finds_local_declarations_test()
  local uri = open_doc("local x = 1\nlocal y = x + 1")
  local analysis = scope_mod.analyze(uri)
  assert(analysis ~= nil)
  assert(#analysis.declarations >= 2)
  close_doc(uri)
end

local function finds_references_to_locals_test()
  local uri = open_doc("local x = 1\nlocal y = x + 1")
  local analysis = scope_mod.analyze(uri)
  -- Find declaration of x
  local decl = scope_mod.get_declaration(analysis, 1, 7)
  assert(decl ~= nil)
  assert(decl.name == "x")
  -- x should have at least 1 reference (on line 2)
  local refs = scope_mod.get_references(analysis, decl)
  assert(#refs >= 1)
  close_doc(uri)
end

local function handles_shadowing_correctly_test()
  local uri = open_doc("local x = 1\ndo\n  local x = 2\n  local y = x\nend")
  local analysis = scope_mod.analyze(uri)
  -- The reference to x on line 4 should resolve to the inner x (line 3)
  -- "  local y = x" -> x is at column 13
  local ref = scope_mod.find_at(analysis, 4, 13)
  if ref then
    assert(ref.declaration ~= nil)
    if ref.declaration then
      assert(ref.declaration.line == 3)
    end
  else
    -- If find_at didn't match at column 13, try the reference list
    local found_inner = false
    for _, r in ipairs(analysis.references) do
      if r.line == 4 and r.name == "x" and r.declaration then
        found_inner = r.declaration.line == 3
      end
    end
    assert(found_inner)
  end
  close_doc(uri)
end

local function scopes_for_loop_variables_test()
  local uri = open_doc("for i = 1, 10 do\n  local y = i\nend")
  local analysis = scope_mod.analyze(uri)
  assert(analysis ~= nil)
  -- i should be declared as a for variable
  local found = false
  for _, decl in ipairs(analysis.declarations) do
    if decl.name == "i" and decl.kind == "for" then
      found = true
    end
  end
  assert(found)
  close_doc(uri)
end

local function tracks_function_parameters_test()
  local uri = open_doc("local function foo(a, b)\n  return a + b\nend")
  local analysis = scope_mod.analyze(uri)
  local param_found = false
  for _, decl in ipairs(analysis.declarations) do
    if decl.name == "a" and decl.kind == "param" then
      param_found = true
    end
  end
  assert(param_found)
  close_doc(uri)
end

local function get_visible_returns_all_visible_names_test()
  local uri = open_doc("local x = 1\nlocal y = 2\nlocal z = x + y")
  local analysis = scope_mod.analyze(uri)
  local s = scope_mod.get_scope_at(analysis.root, 3)
  assert(s ~= nil)
  local visible = scope_mod.get_visible(s)
  assert(visible["x"] ~= nil)
  assert(visible["y"] ~= nil)
  close_doc(uri)
end

-- =========================================================================
-- Types module
-- =========================================================================
-- Group: analysis/types

local function infers_integer_literals_test()
  local t = types_mod.infer_expr({type = "number", value = 42})
  assert(t.tag == "integer")
end

local function infers_float_literals_test()
  local t = types_mod.infer_expr({type = "number", value = 3.14})
  assert(t.tag == "float")
end

local function infers_string_literals_test()
  local t = types_mod.infer_expr({type = "string", value = "hello"})
  assert(t.tag == "string")
end

local function infers_boolean_true_test()
  local t = types_mod.infer_expr({type = "true"})
  assert(t.tag == "boolean")
end

local function infers_boolean_false_test()
  local t = types_mod.infer_expr({type = "false"})
  assert(t.tag == "boolean")
end

local function infers_nil_test()
  local t = types_mod.infer_expr({type = "nil"})
  assert(t.tag == "nil")
end

local function infers_require_as_module_test()
  local t = types_mod.infer_expr({
    type = "callexpr",
    func = {type = "name", value = "require"},
    args = {{type = "string", value = "foo.bar"}},
  })
  assert(t.tag == "module")
  assert(t.module_name == "foo.bar")
end

local function infers_tostring_as_string_test()
  local t = types_mod.infer_expr({
    type = "callexpr",
    func = {type = "name", value = "tostring"},
    args = {{type = "number", value = 1}},
  })
  assert(t.tag == "string")
end

local function infers_nominal_standard_library_return_types_test()
  local instant = types_mod.infer_expr({
    type = "callexpr",
    func = {type = "field",
      table = {type = "name", value = "time"},
      key = {value = "now"}},
    args = {},
  })
  assert(instant.tag == "nominal")
  assert(instant.name == "instant")

  local database = types_mod.infer_expr({
    type = "callexpr",
    func = {type = "field",
      table = {type = "name", value = "io"},
      key = {value = "sqlite"}},
    args = {{type = "string", value = ":memory:"}},
  })
  assert(database.tag == "nominal")
  assert(database.name == "database")
end

local function infers_arbitrary_depth_standard_library_constants_test()
  local t = types_mod.infer_expr({
    type = "field",
    table = {type = "field",
      table = {type = "name", value = "fs"},
      key = {value = "path"}},
    key = {value = "separator"},
  })
  assert(t.tag == "string")
end

local function infers_standard_library_receiver_method_returns_test()
  local uri = open_doc("local s = 'value'\nlocal tail = s:sub(2)")
  local analysis = scope_mod.analyze(uri)
  local tail
  for _, decl in ipairs(analysis.declarations) do
    if decl.name == "tail" then tail = decl end
  end
  assert(tail ~= nil)
  assert(tail.type_info ~= nil)
  assert(tail.type_info.tag == "string")
  close_doc(uri)
end

local function infers_nominal_receiver_method_returns_through_the_symbol_graph_test()
  local uri = open_doc(table.concat({
    "local socket = network.tcp.connect('127.0.0.1', 80)",
    "local line = socket:receive('*l')",
  }, "\n"))
  local analysis = scope_mod.analyze(uri)
  local line_decl
  for _, decl in ipairs(analysis.declarations) do
    if decl.name == "line" then line_decl = decl end
  end
  assert(line_decl ~= nil)
  assert(line_decl.type_info ~= nil)
  assert(line_decl.type_info.tag == "vector")
  close_doc(uri)
end

local function keeps_one_qualified_standard_library_symbol_graph_test()
  local path_module = stdlib_data.resolve("fs.path")
  assert(path_module ~= nil)
  assert(path_module.source == "stdlib/fs/path/_module.md")
  assert(string.find(path_module.description, "path strings", 1, true))

  local unzip = stdlib_data.resolve("table.unzip")
  assert(#unzip.returns == 1)
  assert(unzip.returns[1].name == "...")
  assert(unzip.returns[1].type == "table")

  local pi = stdlib_data.resolve("math.pi")
  assert(pi.kind == "constant")
  assert(pi.type == "number")
end

local function displays_union_types_test()
  local u = types_mod.union({types_mod.str(), types_mod.null()})
  local display = types_mod.display(u)
  assert(string.find(display, "string"))
  assert(string.find(display, "nil"))
  assert(string.find(display, "|"))
end

local function deduplicates_union_members_test()
  local u = types_mod.union({types_mod.str(), types_mod.str()})
  -- Should collapse to just string
  assert(u.tag == "string")
end

local function displays_function_return_type_test()
  local ft = types_mod.func({"a", "b"}, types_mod.str())
  local display = types_mod.display(ft)
  assert(string.find(display, "->"))
  assert(string.find(display, "string"))
end

local function concat_operator_produces_string_test()
  local t = types_mod.infer_expr({
    type = "binop", op = "..",
    left = {type = "string", value = "a"},
    right = {type = "string", value = "b"},
  })
  assert(t.tag == "string")
end

local function comparison_produces_boolean_test()
  local t = types_mod.infer_expr({
    type = "binop", op = "==",
    left = {type = "number", value = 1},
    right = {type = "number", value = 2},
  })
  assert(t.tag == "boolean")
end

local function length_operator_produces_integer_test()
  local t = types_mod.infer_expr({type = "unop", op = "#", operand = {type = "string", value = "x"}})
  assert(t.tag == "integer")
end

local function or_operator_produces_union_test()
  local t = types_mod.infer_expr({
    type = "binop", op = "or",
    left = {type = "string", value = "a"},
    right = {type = "nil"},
  })
  assert(t.tag == "union")
end

-- =========================================================================
-- Diagnostics module
-- =========================================================================
-- Group: analysis/diagnostics

local function returns_empty_for_valid_code_test()
  local uri = open_doc("local x = 1")
  local diags = diagnostics.compute(uri)
  assert(#diags == 0)
  close_doc(uri)
end

local function returns_errors_for_syntax_errors_test()
  local uri = open_doc("local = = =")
  local diags = diagnostics.compute(uri)
  assert(#diags > 0)
  close_doc(uri)
end

local function uses_0_based_ranges_test()
  -- the syntax error sits on the SECOND line, so a 0-based range reports
  -- line 1 and a 1-based implementation reports line 2
  local uri = open_doc("local x = 1\nlocal = = =")
  local diags = diagnostics.compute(uri)
  assert(#diags > 0)
  assert(diags[1].range.start.line == 1)
  assert(diags[1].range.start.character >= 0)
  close_doc(uri)
end

-- =========================================================================
-- Linting module
-- =========================================================================
-- Group: analysis/linting

local function detects_unused_locals_test()
  local uri = open_doc("local unused = 1")
  local diags = linting.compute(uri)
  local found = false
  for _, d in ipairs(diags) do
    if string.find(d.message, "Unused") and string.find(d.message, "unused") then
      found = true
    end
  end
  assert(found)
  close_doc(uri)
end

local function does_not_flag_used_locals_test()
  local uri = open_doc("local x = 1\nlocal y = x + 1\nlocal z = y")
  local diags = linting.compute(uri)
  for _, d in ipairs(diags) do
    assert(not (string.find(d.message, "'x'") and string.find(d.message, "Unused")))
  end
  close_doc(uri)
end

local function allows_prefixed_unused_locals_test()
  local uri = open_doc("local _unused = 1")
  local diags = linting.compute(uri)
  for _, d in ipairs(diags) do
    assert(not string.find(d.message, "_unused"))
  end
  close_doc(uri)
end

local function detects_undefined_globals_test()
  local uri = open_doc("local x = undefined_var")
  local diags = linting.compute(uri)
  local found = false
  for _, d in ipairs(diags) do
    if string.find(d.message, "Undefined global") and string.find(d.message, "undefined_var") then
      found = true
    end
  end
  assert(found)
  close_doc(uri)
end

local function does_not_flag_stdlib_names_test()
  local uri = open_doc("local x = print")
  local diags = linting.compute(uri)
  for _, d in ipairs(diags) do
    assert(not (string.find(d.message, "Undefined") and string.find(d.message, "'print'")))
  end
  close_doc(uri)
end

-- =========================================================================
-- Symbols
-- =========================================================================
-- Group: operations/symbols

local function finds_function_symbols_test()
  local uri = open_doc("local function foo()\nend\nlocal function bar()\nend")
  local syms = symbols.compute(uri)
  assert(#syms >= 2)
  close_doc(uri)
end

local function finds_variable_symbols_test()
  local uri = open_doc("local x = 1\nlocal y = 'hello'")
  local syms = symbols.compute(uri)
  assert(#syms >= 2)
  close_doc(uri)
end

local function returns_empty_for_empty_document_test()
  local uri = open_doc("")
  local syms = symbols.compute(uri)
  assert(#syms == 0)
  close_doc(uri)
end

-- =========================================================================
-- Completion
-- =========================================================================
-- Group: operations/completion

local function returns_scope_variables_test()
  local uri = open_doc("local myVar = 1\nlocal x = my")
  local result = completion.compute(uri, {line = 1, character = 12})
  assert(result ~= nil)
  assert(type(result) == "table")
  -- the in-scope variable matching the typed prefix must be offered
  local items = result.items or result
  local found = false
  for _, item in ipairs(items) do
    if item.label == "myVar" then found = true end
  end
  assert(found)
  close_doc(uri)
end

local function returns_keywords_test()
  local uri = open_doc("lo")
  local result = completion.compute(uri, {line = 0, character = 2})
  assert(result ~= nil)
  -- the keyword matching the typed prefix must be offered
  local items = result.items or result
  local found = false
  for _, item in ipairs(items) do
    if item.label == "local" then found = true end
  end
  assert(found)
  close_doc(uri)
end

local function completes_arbitrary_depth_standard_library_modules_test()
  local uri = open_doc("vector.archive.gzip.")
  local result = completion.compute(uri, {line = 0, character = 20})
  local found = false
  for _, item in ipairs(result.items or result) do
    if item.label == "compress" then found = true end
  end
  assert(found)
  close_doc(uri)
end

local function completes_standard_library_receiver_methods_test()
  local uri = open_doc("local s = 'value'\ns:")
  local result = completion.compute(uri, {line = 1, character = 2})
  local found = false
  for _, item in ipairs(result.items or result) do
    if item.label == "sub" then found = true end
  end
  assert(found)
  close_doc(uri)
end

local function completes_nominal_receiver_methods_test()
  local uri = open_doc(table.concat({
    "local socket = network.tcp.connect('127.0.0.1', 80)",
    "socket:",
  }, "\n"))
  local result = completion.compute(uri, {line = 1, character = 7})
  local found = false
  for _, item in ipairs(result.items or result) do
    if item.label == "receive" and item.detail == "tcp_socket:receive" then
      found = true
    end
  end
  assert(found)
  close_doc(uri)
end

local function includes_flags_and_from_in_their_language_contexts_test()
  local flags_uri = open_doc("fl")
  local flags_result = completion.compute(flags_uri, {line = 0, character = 2})
  local found_flags = false
  for _, item in ipairs(flags_result.items or flags_result) do
    if item.label == "flags" and item.kind == 6 then found_flags = true end
  end
  assert(found_flags)
  close_doc(flags_uri)

  local from_uri = open_doc("fr")
  local from_result = completion.compute(from_uri, {line = 0, character = 2})
  local found_from = false
  for _, item in ipairs(from_result.items or from_result) do
    if item.label == "from" and item.kind == 14 then found_from = true end
  end
  assert(found_from)
  close_doc(from_uri)
end

-- =========================================================================
-- Hover
-- =========================================================================
-- Group: operations/hover

local function shows_hover_for_local_variables_test()
  local uri = open_doc("local myVar = 'hello'\nlocal x = myVar")
  local result = hover.compute(uri, {line = 0, character = 6})
  assert(result ~= nil)
  assert(result.contents ~= nil)
  assert(string.find(result.contents.value, "myVar"))
  close_doc(uri)
end

local function shows_hover_for_functions_test()
  local uri = open_doc("local function foo(a, b)\n  return a + b\nend\nfoo(1, 2)")
  -- foo() call on line 4 (0-based: line 3, char 0)
  local result = hover.compute(uri, {line = 3, character = 0})
  assert(result ~= nil)
  assert(string.find(result.contents.value, "foo"))
  close_doc(uri)
end

local function shows_hover_for_arbitrary_depth_standard_library_symbols_test()
  local uri = open_doc("local join = fs.path.join")
  local result = hover.compute(uri, {line = 0, character = 23})
  assert(result ~= nil)
  assert(string.find(result.contents.value, "function fs.path.join"))
  assert(string.find(result.contents.value, "%.%.%.%)"))
  close_doc(uri)
end

local function returns_nil_for_empty_position_test()
  local uri = open_doc("-- just a comment")
  local result = hover.compute(uri, {line = 0, character = 0})
  assert(result == nil)
  close_doc(uri)
end

-- =========================================================================
-- Definition
-- =========================================================================
-- Group: operations/definition

local function jumps_from_reference_to_declaration_test()
  local uri = open_doc("local x = 1\nlocal y = x")
  local result = definition.compute(uri, {line = 1, character = 10})
  assert(result ~= nil)
  assert(result.range.start.line == 0)
  close_doc(uri)
end

local function jumps_to_function_definition_test()
  local uri = open_doc("local function foo()\nend\nfoo()")
  local result = definition.compute(uri, {line = 2, character = 0})
  assert(result ~= nil)
  assert(result.range.start.line == 0)
  close_doc(uri)
end

local function returns_nil_for_unresolved_names_test()
  local uri = open_doc("local x = unknown_thing")
  local result = definition.compute(uri, {line = 0, character = 10})
  -- unknown_thing is not declared, so definition should be nil
  assert(result == nil)
  close_doc(uri)
end

-- =========================================================================
-- References
-- =========================================================================
-- Group: operations/references

local function finds_all_references_with_declaration_test()
  local uri = open_doc("local x = 1\nlocal y = x\nlocal z = x")
  local result = references.compute(uri, {line = 0, character = 6}, true)
  -- x is declared on line 1, referenced on lines 2 and 3
  assert(#result >= 3)
  close_doc(uri)
end

local function finds_references_without_declaration_test()
  local uri = open_doc("local x = 1\nlocal y = x\nlocal z = x")
  local result = references.compute(uri, {line = 0, character = 6}, false)
  -- Without declaration, just the 2 references
  assert(#result >= 2)
  close_doc(uri)
end

-- =========================================================================
-- Rename
-- =========================================================================
-- Group: operations/rename

local function renames_a_local_and_its_references_test()
  local uri = open_doc("local x = 1\nlocal y = x")
  local result = rename.compute(uri, {line = 0, character = 6}, "newName")
  assert(result ~= nil)
  assert(result.changes ~= nil)
  assert(result.changes[uri] ~= nil)
  -- Should have edits for declaration and reference
  assert(#result.changes[uri] >= 2)
  close_doc(uri)
end

local function refuses_to_rename_stdlib_names_test()
  local uri = open_doc("local x = print")
  local result = rename.compute(uri, {line = 0, character = 10})
  -- print is stdlib, should return nil
  assert(result == nil)
  close_doc(uri)
end


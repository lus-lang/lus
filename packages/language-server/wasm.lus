-- WASM entry points share dispatch and framing with the native server.

global require, pledge, _lsp_handle, _lsp_handle_frame

pledge("load", "fs:read", "seal")

local transport = require("lus-language.transport")
local protocol = require("lus-language.protocol")
local server = require("lus-language.server")

local instance = server.new()

local function write_parse_error(reason)
    transport.write_message(protocol.make_error(protocol.JSON_NULL, protocol.PARSE_ERROR, reason))
end

local function handle_message(msg)
    if response = instance.dispatch(msg) then
        transport.write_message(response)
    end
end

-- The JavaScript host passes one UTF-8 JSON-RPC body per call.
global function _lsp_handle(json_body)
    local msg, reason = transport.decode_json(json_body)

    if reason then
        write_parse_error(reason)
        return
    end

    handle_message(msg)
end

-- Tests and native-compatible hosts may pass one complete canonical frame.
global function _lsp_handle_frame(frame)
    local msg, reason = transport.parse_frame(frame)

    if reason then
        write_parse_error(reason)
        return
    end

    handle_message(msg)
end

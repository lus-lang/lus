global string, tonumber

local uri = {}

local function percent_decode(s)
    return (string.gsub(s, "%%(%x%x)", function(hex)
        return string.char(tonumber(hex, 16))
    end))
end

local function percent_encode(s)
    return (string.gsub(s, "([^%w%-%.%_%~/])", function(c)
        return string.format("%%%02X", string.byte(c))
    end))
end

local function normalize_path(path)
    path = string.gsub(path or "", "\\", "/")

    if #path > 1 then
        path = string.gsub(path, "/+$", "")
    end

    return path
end

-- Parse hierarchical and non-hierarchical URIs without changing their bytes.
function uri.parse(uri_string)
    local scheme, rest = string.match(uri_string or "", "^([%a][%w%+%.%-]*):(.*)$")

    if not scheme then
        return nil
    end

    local authority = nil
    local raw_path = rest

    if string.sub(rest, 1, 2) == "//" then
        local after_slashes = string.sub(rest, 3)

        if slash = string.find(after_slashes, "/", 1, true) then
            authority = string.sub(after_slashes, 1, slash - 1)
            raw_path = string.sub(after_slashes, slash)
        else
            authority = after_slashes
            raw_path = ""
        end
    end

    return {
        scheme = scheme,
        authority = authority,
        path = percent_decode(raw_path),
        raw_path = raw_path,
    }
end

function uri.to_path(uri_string)
    local parts = uri.parse(uri_string)

    if not parts or string.lower(parts.scheme) ~= "file" then
        return nil
    end

    local path = string.gsub(parts.path, "\\", "/")

    if parts.authority and parts.authority ~= "" then
        return `//$(parts.authority)$path`
    end

    if string.match(path, "^/[A-Za-z]:/") then
        return string.sub(path, 2)
    end

    return path
end

function uri.from_path(path)
    path = string.gsub(path, "\\", "/")

    if string.sub(path, 1, 2) == "//" then
        local authority, rest = string.match(path, "^//([^/]+)(/.*)$")

        if authority then
            return `file://$authority$(percent_encode(rest))`
        end
    end

    if string.match(path, "^[A-Za-z]:/") then
        path = "/" .. path
    end

    if string.sub(path, 1, 1) ~= "/" then
        return "file:" .. percent_encode(path)
    end

    return "file://" .. percent_encode(path)
end

function uri.join(root_uri, relative_path)
    local rel = string.gsub(relative_path, "\\", "/")
    rel = string.gsub(rel, "^/+", "")
    local parts = uri.parse(root_uri)

    if parts and parts.path == "/" then
        local prefix = parts.scheme .. ":"

        if parts.authority ~= nil then
            prefix = `$prefix//$(parts.authority)`
        end

        return `$prefix/$(percent_encode(rel))`
    end

    local root = string.gsub(root_uri, "/+$", "")
    return `$root/$(percent_encode(rel))`
end

function uri.within(root_uri, document_uri)
    local root = uri.parse(root_uri)
    local doc = uri.parse(document_uri)

    if not root or not doc then
        return false
    end

    if string.lower(root.scheme) ~= string.lower(doc.scheme) then
        return false
    end

    if string.lower(root.authority or "") ~= string.lower(doc.authority or "") then
        return false
    end

    local root_path = normalize_path(root.path)
    local doc_path = normalize_path(doc.path)

    if string.lower(root.scheme) == "file"
        and (string.match(root_path, "^/[A-Za-z]:")
            or (root.authority and root.authority ~= "")) then
        root_path = string.lower(root_path)
        doc_path = string.lower(doc_path)
    end

    if doc_path == root_path then
        return true
    end

    return string.sub(doc_path, 1, #root_path + 1) == root_path .. "/"
end

function uri.relative(root_uri, document_uri)
    if not uri.within(root_uri, document_uri) then
        return nil
    end

    local root = uri.parse(root_uri)
    local doc = uri.parse(document_uri)
    local root_path = normalize_path(root.path)
    local doc_path = normalize_path(doc.path)

    if doc_path == root_path then
        return ""
    end

    return string.sub(doc_path, #root_path + 2)
end

return uri

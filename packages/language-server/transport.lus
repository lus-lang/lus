global io, fromjson, tojson, string, tonumber, tostring, table, type, vector

local transport = {}

transport.MAX_FRAME_BYTES = 16 * 1024 * 1024
local MAX_HEADER_BYTES = 8 * 1024

function transport.log(...)
    local args = table.pack(...)

    for i = 1, args.n do
        args[i] = tostring(args[i])
    end

    io.stderr:write(`[lus-language] $(table.concat(args, " "))\n`)
    io.stderr:flush()
end

local function parse_headers(block)
    if #block == 0 or #block > MAX_HEADER_BYTES then
        return nil, "invalid LSP header size"
    end

    local headers = {}
    local content_length = nil
    local pos = 1

    while pos <= #block do
        local ending = string.find(block, "\r\n", pos, true)
        local line

        if ending then
            line = string.sub(block, pos, ending - 1)
            pos = ending + 2
        else
            line = string.sub(block, pos)
            pos = #block + 1
        end

        if line == "" or string.find(line, "[\r\n]") then
            return nil, "invalid LSP header line"
        end

        local name, value = string.match(line, "^([%w%-]+): (.*)$")

        if not name then
            return nil, "invalid LSP header syntax"
        end

        name = string.lower(name)

        if headers[name] then
            return nil, `duplicate LSP header: $name`
        end

        headers[name] = value

        if name == "content-length" then
            if value ~= "0" and not string.match(value, "^[1-9]%d*$") then
                return nil, "invalid Content-Length"
            end

            if #value > 16 then
                return nil, "Content-Length exceeds 16 MiB"
            end

            content_length = tonumber(value)

            if not content_length or content_length > transport.MAX_FRAME_BYTES then
                return nil, "Content-Length exceeds 16 MiB"
            end
        end
    end

    if content_length == nil then
        return nil, "missing Content-Length"
    end

    local content_type = headers["content-type"]

    if content_type
        and not string.match(
            string.lower(content_type),
            "^application/vscode%-jsonrpc;[ \t]*charset=utf%-8$"
        ) then
        return nil, "JSON-RPC content must use UTF-8"
    end

    return content_length
end

function transport.decode_json(body)
    if type(body) ~= "string" then
        return nil, "JSON-RPC body must be text"
    end

    if string.bytelen(body) > transport.MAX_FRAME_BYTES then
        return nil, "JSON-RPC body exceeds 16 MiB"
    end

    -- Strict decoding rejects a lone surrogate, which valid UTF-8 never holds.
    if not catch string.transcode(body, "utf-8", "utf-8") then
        return nil, "JSON-RPC body is not valid UTF-8"
    end

    local ok, message = catch fromjson(body)

    if not ok then
        return nil, `invalid JSON: $message`
    end

    -- JSON null and false decode to false-valued Lus results. An empty object
    -- sentinel carries them to dispatch, which returns Invalid Request.
    if message == nil or message == false then
        message = {}
    end

    return message, nil
end

-- Parse one complete frame. Extra bytes after the declared body are rejected.
function transport.parse_frame(frame)
    if type(frame) ~= "string" then
        return nil, "LSP frame must be text"
    end

    local header_end = string.find(frame, "\r\n\r\n", 1, true)

    if not header_end then
        return nil, "missing canonical LSP header terminator"
    end

    local content_length, header_error = parse_headers(string.sub(frame, 1, header_end - 1))

    if not content_length then
        return nil, header_error
    end

    local body = string.sub(frame, header_end + 4)

    -- Content-Length counts the bytes of the body, as the protocol says.
    local size = string.bytelen(body)

    if size ~= content_length then
        if size > content_length then
            return nil, "trailing data after LSP frame"
        end

        return nil, "short LSP frame body"
    end

    return transport.decode_json(body)
end

local function read_header_line(limit)
    local bytes = {}

    for _ = 1, limit + 1 do
        local byte = io.read(1)

        if not byte then
            if #bytes == 0 then
                return nil, "eof"
            end

            return nil, "unexpected EOF in LSP headers"
        end

        bytes[#bytes + 1] = byte

        if byte == "\n" then
            return table.concat(bytes), nil
        end
    end

    return nil, "LSP headers exceed 8 KiB"
end

-- Read one canonical Content-Length frame from stdin.
-- The third result is "eof", "framing", or "json" when no message is returned.
function transport.read_message()
    local lines = {}
    local total = 0

    while true do
        local line, line_error = read_header_line(MAX_HEADER_BYTES - total)

        if not line then
            if line_error == "eof" and #lines == 0 then
                return nil, nil, "eof"
            end

            return nil, line_error, "framing"
        end

        total = total + #line

        if total > MAX_HEADER_BYTES then
            return nil, "LSP headers exceed 8 KiB", "framing"
        end

        if string.sub(line, -2) ~= "\r\n" then
            return nil, "LSP headers require CRLF", "framing"
        end

        if line == "\r\n" then
            break
        end

        lines[#lines + 1] = line
    end

    local header_block = table.concat(lines)

    if #header_block >= 2 then
        header_block = string.sub(header_block, 1, -3)
    end

    local content_length, header_error = parse_headers(header_block)

    if not content_length then
        return nil, header_error, "framing"
    end

    -- The header counts bytes, and a text read counts characters, so the
    -- body is read as bytes and then made a string.
    local bytes = content_length > 0 and io.input():readbytes(content_length) or vector.create(0)

    if not bytes or #bytes ~= content_length then
        return nil, "short LSP frame body", "framing"
    end

    local valid, body = catch vector.tostring(bytes)

    if not valid then
        return nil, "LSP frame body is not valid UTF-8", "json"
    end

    local message, json_error = transport.decode_json(body)

    if json_error then
        return nil, json_error, "json"
    end

    return message, nil, nil
end

function transport.encode_message(msg)
    local ok, body = catch tojson(msg)

    if not ok then
        return nil, "failed to encode JSON-RPC message"
    end

    if not catch string.transcode(body, "utf-8", "utf-8") then
        return nil, "JSON-RPC response is not valid UTF-8"
    end

    local size = string.bytelen(body)

    if size > transport.MAX_FRAME_BYTES then
        return nil, "JSON-RPC response exceeds 16 MiB"
    end

    return `Content-Length: $size\r\n\r\n$body`
end

function transport.write_message(msg)
    local frame, encode_error = transport.encode_message(msg)

    if not frame and msg and msg.id ~= nil then
        frame = transport.encode_message({
            jsonrpc = "2.0",
            id = msg.id,
            error = { code = -32603, message = encode_error },
        })
    end

    if not frame then
        transport.log("ERROR:", encode_error)
        return false
    end

    io.write(frame)
    io.flush()
    return true
end

return transport

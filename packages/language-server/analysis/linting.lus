global require, ipairs, string, debug

local ast_mod = require("lus-language.analysis.ast")
local scope_mod = require("lus-language.analysis.scope")
local document = require("lus-language.document")
local stdlib_data = require("lus-language.analysis.stdlib_data")

local linting = {}

-- LSP DiagnosticSeverity
local SEVERITY_WARNING = 2
local SEVERITY_HINT = 4

-- Standard library / built-in names that are always defined (from lus-spec)
local STDLIB = {}
for _, name in ipairs(stdlib_data.globals) do
  STDLIB[name] = true
end
for _, name in ipairs(stdlib_data.tables) do
  STDLIB[name] = true
end

-- Names that `lus test` defines in every `*_test.lus` file
local TEST_GLOBALS = {
  raises = true, same = true, skip = true, snapshot = true, TEST_DIR = true,
}

local function is_test_file(uri)
  return string.find(uri, "_test%.lus$") ~= nil
end

-- Names that start with _ are conventionally unused (e.g., _)
local function is_intentionally_unused(name)
  return string.sub(name, 1, 1) == "_"
end

-- Compute lint diagnostics for a document.
-- Returns an array of LSP Diagnostic objects (warnings).
function linting.compute(uri)
  ast_mod.parse(uri)
  local analysis = scope_mod.analyze(uri)
  if not analysis then return {} end

  local diagnostics = {}

  -- Unused variable warnings
  for _, decl in ipairs(analysis.declarations) do
    if not is_intentionally_unused(decl.name) then
      -- Check if the declaration has any references
      if #decl.references == 0 then
        -- Skip globals (they might be used in other files)
        if decl.kind ~= "global" then
          diagnostics[#diagnostics + 1] = {
            range = {
              start = {line = decl.line - 1, character = decl.column - 1},
              ["end"] = {line = decl.line - 1, character = decl.column - 1 + #decl.name},
            },
            severity = SEVERITY_HINT,
            source = "lus",
            message = "Unused " .. decl.kind .. " '" .. decl.name .. "'",
            tags = {1}, -- Unnecessary (faded)
          }
        end
      end
    end
  end

  -- Undefined global warnings
  local test_file = is_test_file(uri)
  for _, ref in ipairs(analysis.references) do
    if not ref.declaration and not STDLIB[ref.name]
        and not (test_file and TEST_GLOBALS[ref.name]) then
      diagnostics[#diagnostics + 1] = {
        range = {
          start = {line = ref.line - 1, character = ref.column - 1},
          ["end"] = {line = ref.line - 1, character = ref.column - 1 + #ref.name},
        },
        severity = SEVERITY_WARNING,
        source = "lus",
        message = "Undefined global '" .. ref.name .. "'",
      }
    end
  end

  -- Hints of `lus check`: faster or shorter forms of correct code
  -- (spec/design/hints.md). The other checks of `lus check` overlap the
  -- warnings above, so only its hints are added.
  local doc = document.get(uri)
  if doc and debug.check then
    local name = string.match(uri, "([^/]+)$") or uri
    local ok, list = catch debug.check(doc.text, "@" .. name)
    if ok then
      for _, d in ipairs(list) do
        if d.severity == "hint" then
          diagnostics[#diagnostics + 1] = {
            range = {
              start = {line = d.line - 1, character = d.column - 1},
              ["end"] = {line = d.endline - 1, character = d.endcolumn - 1},
            },
            severity = SEVERITY_HINT,
            source = "lus",
            code = d.code,
            message = d.message,
          }
        end
      end
    end
  end

  return diagnostics
end

return linting

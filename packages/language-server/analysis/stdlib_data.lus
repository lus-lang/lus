        type = "vector",
      },
    },
    short_name = "receive",
    since = "0.1.0",
    source = "stdlib/network/tcp/receive.md",
    stability = "stable",
  },
  ["time"] = {
    children = {
      "time.days",
      "time.duration",
      "time.hours",
      "time.instant",
      "time.localzone",

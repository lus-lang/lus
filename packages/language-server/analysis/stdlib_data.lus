function M.resolve(name)
  if type(name) ~= "string" then return nil end
  return M.symbols[name]
end

function M.resolve_member(parent, child)
  if type(parent) ~= "string" or type(child) ~= "string" then
    return nil
  end
  local direct = M.symbols[parent .. "." .. child]
  if direct then return direct end
  local parent_symbol = M.symbols[parent]
  for _, child_name in ipairs(parent_symbol and parent_symbol.children or {}) do
    local symbol = M.symbols[child_name]
    if symbol and symbol.short_name == child then return symbol end
  end
  return nil
end

function M.children(name)
  local parent = M.resolve(name)
  local result = {}
  if not parent then return result end
  for _, child_name in ipairs(parent.children or {}) do
    result[#result + 1] = M.symbols[child_name]
  end
  return result
end

function M.expression_name(node)
  if not node or type(node) ~= "table" then return nil end
  if node.type == "name" then return node.value end
  if node.type ~= "field" or not node.key then return nil end
  local parent = M.expression_name(node.table)
  local child = node.key.value or node.key.name
  if not parent or not child then return nil end
  return parent .. "." .. child
end

function M.first_return(symbol_or_name)
  local symbol = symbol_or_name
  if type(symbol) == "string" then symbol = M.resolve(symbol) end
  local result = symbol and symbol.returns and symbol.returns[1]
  return result and result.type or nil
end

function M.format_returns(symbol_or_name)
  local symbol = symbol_or_name
  if type(symbol) == "string" then symbol = M.resolve(symbol) end
  local result = {}
  for _, value in ipairs(symbol and symbol.returns or {}) do
    result[#result + 1] = value.type or "any"
  end
  return table.concat(result, ", ")
end

M.globals = {}
M.tables = {}
for name, symbol in pairs(M.symbols) do
  if not symbol.parent and symbol.module == "base"
     and not symbol.receiver_type then
    M.globals[#M.globals + 1] = name
  elseif not symbol.parent and symbol.kind == "module" then
    M.tables[#M.tables + 1] = name
  end
end
table.sort(M.globals)
table.sort(M.tables)

return M

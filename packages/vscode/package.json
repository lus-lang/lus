{
  "name": "lus",
  "displayName": "Lus",
  "description": "Language support for Lus with syntax highlighting, diagnostics, completion, and formatting.",
  "version": "2.0.0",
  "publisher": "lus",
  "icon": "icon.png",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/lus-lang/lus"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:lus",
    "workspaceContains:**/*.lus",
    "onDebugResolve:lus"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "files": [
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "icon.png",
    "language-configuration.json",
    "licenses/LICENSE.BROTLI.txt",
    "licenses/LICENSE.LUALS.txt",
    "licenses/LICENSE.SQLITE.txt",
    "licenses/LICENSE.TZDATA.txt",
    "licenses/LICENSE.WASI-LIBC.txt",
    "licenses/LICENSE.ZIG.txt",
    "licenses/LICENSE.ZSTD.txt",
    "out/extension.js",
    "syntaxes/lus.tmLanguage.json",
    "language-server/**/*.lus",
    "wasm/lus.wasm"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lus",
        "aliases": [
          "Lus",
          "lus"
        ],
        "extensions": [
          ".lus"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lus",
        "scopeName": "source.lus",
        "path": "./syntaxes/lus.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "lus.restartLanguageServer",
        "title": "Lus: Restart Language Server"
      }
    ],
    "breakpoints": [
      {
        "language": "lus"
      }
    ],
    "configuration": {
      "title": "Lus",
      "properties": {
        "lus.executablePath": {
          "type": "string",
          "default": "lus",
          "markdownDescription": "The `lus` command used to debug programs. A relative path with a directory part is relative to the workspace folder."
        }
      }
    },
    "debuggers": [
      {
        "type": "lus",
        "label": "Lus",
        "languages": [
          "lus"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The Lus script to run.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments passed to the script.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "The working directory of the program.",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first line of the program.",
                "default": false
              },
              "pledges": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Permissions granted to the program, as with `lus -P`.",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "lus",
            "request": "launch",
            "name": "Debug Lus File",
            "program": "${file}",
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Lus: Launch File",
            "description": "Debug the active Lus file.",
            "body": {
              "type": "lus",
              "request": "launch",
              "name": "Debug Lus File",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          },
          {
            "label": "Lus: Launch Program",
            "description": "Debug a Lus script with arguments.",
            "body": {
              "type": "lus",
              "request": "launch",
              "name": "Debug ${1:program}",
              "program": "^\"\\${workspaceFolder}/${1:main.lus}\"",
              "args": [],
              "stopOnEntry": false
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "check:generated": "node ../../tools/build-grammar.test.js && node ../../tools/build-grammar.js --check && node scripts/check-generated.mjs",
    "prebuild": "pnpm check:generated",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test test/*.test.cjs scripts/open-vsx-publisher.test.mjs",
    "test:wasm": "node scripts/smoke-wasm.mjs",
    "test:devcontainer": "node scripts/smoke-devcontainer.mjs",
    "check:package": "node scripts/check-package.mjs",
    "package": "pnpm build && vsce package --no-dependencies",
    "publish": "ovsx publish",
    "ci": "pnpm typecheck && pnpm test && pnpm build"
  },
  "packageManager": "pnpm@10.18.0",
  "devDependencies": {
    "@devcontainers/cli": "0.88.0",
    "@shikijs/engine-javascript": "4.2.0",
    "@shikijs/vscode-textmate": "10.0.2",
    "@types/node": "20.19.43",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.27.3",
    "lus-wasm": "workspace:*",
    "ovsx": "0.10.9",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}

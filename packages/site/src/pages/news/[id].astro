---
import Layout from "../../components/Layout.astro"
import { getCollection, render } from "astro:content"
import { fmtDate } from "../../lib/date"
import CubeField from "../../components/CubeField.astro"

export async function getStaticPaths() {
  const news = await getCollection("news")
  return news.map((page) => ({
    params: { id: page.id },
    props: { page },
  }))
}

const { page } = Astro.props
const rendered = await render(page)

// each article gets its own cover: a field seeded by its id, the way a
// print run gets its own plate
let seed = 0
for (const ch of page.id) seed = (seed * 31 + ch.charCodeAt(0)) % 997
const peakAt = 0.25 + (seed % 50) / 100
---

<Layout
  title={page.data.title}
  description={`Release notes for ${page.data.title}, published ${fmtDate(page.data.date)}.`}
>
  <main id="main">
    <section>
      <a href="/news" class="back-link">← Back to news</a>
      <CubeField class="cover" cols={44} at={peakAt} amp={2.8} seed={seed} />
      <article class="prose">
        <h1 class="page-title">{page.data.title}</h1>
        <p class="date">
          <time datetime={fmtDate(page.data.date)}>{fmtDate(page.data.date)}</time>
        </p>
        <rendered.Content />
      </article>
    </section>
  </main>
</Layout>

<style>
  @reference "../../styles/global.css";

  :global(svg.cover) {
    @apply max-w-[48.5rem] mt-6 mb-2;
  }

  .back-link {
    @apply font-mono text-[11px] font-semibold uppercase tracking-[0.1em] text-link no-underline hover:text-ink inline-block pt-2;
  }

  article .date {
    @apply font-mono text-xs text-ink-3 pb-2.5 ruled mb-4;
  }
</style>

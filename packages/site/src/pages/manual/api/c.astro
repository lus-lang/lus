---
import ManualLayout from "../../../components/ManualLayout.astro"
import ApiReference from "../../../components/ApiReference.astro"
import CubeField from "../../../components/CubeField.astro"
import { skyline } from "../../../lib/skyline"
import { getCapiSections } from "../../../lib/api"

const sections = await getCapiSections()

// the reference readout: one bar per module, sized by its entries
const moduleHeights = skyline(sections.map((s) => s.entries.length))
---

<ManualLayout title="C API">
  <div class="title-row">
    <h1>C API reference</h1>
    <CubeField rows={1} heights={moduleHeights} glow={false} scale={0.7} />
  </div>

  <ApiReference sections={sections} />

  <script is:inline>
    // forward stdlib deep links that landed on the C page
    if (
      location.hash &&
      !document.getElementById(decodeURIComponent(location.hash.slice(1))) &&
      !/^#(lus_|LUS_)/.test(location.hash)
    ) {
      location.replace("/manual/api" + location.search + location.hash)
    }
  </script>
</ManualLayout>

<style>
  @reference "../../../styles/global.css";

  .api-crossnote {
    @apply text-ink-2 mb-4 max-w-3xl;
  }
</style>

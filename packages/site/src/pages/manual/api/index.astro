---
import ManualLayout from "../../../components/ManualLayout.astro"
import ApiReference from "../../../components/ApiReference.astro"
import CubeField from "../../../components/CubeField.astro"
import { skyline } from "../../../lib/skyline"
import { getStdlibSections } from "../../../lib/api"

const sections = await getStdlibSections()

// the reference readout: one bar per module, sized by its entries
const moduleHeights = skyline(sections.map((s) => s.entries.length))
---

<ManualLayout title="API" markdown="/manual/api.md">
  <div class="title-row">
    <h1>API reference</h1>
    <CubeField rows={1} heights={moduleHeights} glow={false} scale={0.7} links={sections.map((s) => `#${s.id}`)} />
  </div>

  <ApiReference sections={sections} />

  <script is:inline>
    // stale deep links to C symbols predate the C API page split
    if (
      location.hash &&
      !document.getElementById(decodeURIComponent(location.hash.slice(1))) &&
      /^#(lua_|luaL_|lus_|LUA_|LUAL_)/.test(location.hash)
    ) {
      location.replace("/manual/api/c" + location.search + location.hash)
    }
  </script>
</ManualLayout>

<style>
  @reference "../../../styles/global.css";

  .api-crossnote {
    @apply text-ink-2 mb-4 max-w-3xl;
  }
</style>

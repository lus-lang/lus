---
import ManualLayout from "../../components/ManualLayout.astro"
import { getCollection, render } from "astro:content"
import CubeField from "../../components/CubeField.astro"
import { skyline } from "../../lib/skyline"

export async function getStaticPaths() {
  const manual = await getCollection("manual")
  return manual.map((page) => ({
    params: { id: page.id },
    props: { page },
  }))
}

const manual = await getCollection("manual")
const { page } = Astro.props
const rendered = await render(page)

// prev/next follows the sidebar's visible order: group rank first
// (learn → use → library → reference), then frontmatter `order`
const rank: Record<string, number> = { learn: 0, use: 1, library: 2, reference: 3 }
const all = manual.toSorted(
  (a, b) =>
    (rank[a.data.group ?? "reference"] - rank[b.data.group ?? "reference"]) ||
    a.data.order - b.data.order,
)
const index = all.findIndex((p) => p.id === page.id)
const prev = index > 0 ? all[index - 1] : null
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : null

// fold h2/h3 headings into a tree for the contents box
interface TocEntry {
  slug: string
  text: string
  children: { slug: string; text: string }[]
}
// heading text carries the appended "#" self-link, which the outlines drop
const headings = rendered.headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ ...h, text: h.text.replace(/#$/, "").trim() }))
const toc: TocEntry[] = []
for (const h of headings) {
  if (h.depth === 2 || toc.length === 0) {
    toc.push({ slug: h.slug, text: h.text, children: [] })
  }
  else {
    toc[toc.length - 1].children.push({ slug: h.slug, text: h.text })
  }
}

// h2-level outline for the sticky sidebar (survives scrolling, unlike
// the collapsible contents box)

// the chapter's readout: one bar per h2 section, sized by its length
const sections = (page.body ?? "").split(/^## /m).slice(1)
// h2 headings in order, to link each section bar to its section
const h2Slugs = rendered.headings.filter((h) => h.depth === 2).map((h) => `#${h.slug}`)
const sectionLinks = h2Slugs.length === sections.length ? h2Slugs : undefined
const sectionHeights = sections.length >= 4 ? skyline(sections.map((t) => t.length)) : null

// the outline pairs each h2 with its readout bar when the readout reads
// this page's own sections
const barsAreSections = sectionHeights !== null && sectionLinks === h2Slugs
const sidebarToc = headings
  .filter((h) => h.depth === 2)
  .map((h, i) => ({
    slug: h.slug,
    text: h.text,
    bar: barsAreSections ? i : undefined,
  }))
---

<ManualLayout
  title={page.data.title}
  unstable={page.data.draft}
  measure
  toc={sidebarToc}
  markdown={`/manual/${page.id}.md`}
>
  {
    sectionHeights ? (
      <div class="title-row">
        <h1>{page.data.title}</h1>
        <CubeField rows={1} heights={sectionHeights} glow={false} scale={0.7} links={sectionLinks} />
      </div>
    ) : (
      <h1>{page.data.title}</h1>
    )
  }
  {
    headings.length > 2 && (
      <nav class="toc" aria-label="Contents" data-toc>
        <p class="toc-label">
          Contents
          <button type="button" class="toc-toggle" data-toc-toggle aria-expanded="false" aria-label="Show all contents" hidden>
            <svg viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </button>
        </p>
        <div class="toc-body">
          <ol>
            {toc.map((section) => (
              <li class="toc-h2">
                <a
                  href={`#${section.slug}`}
                  data-bar={barsAreSections && h2Slugs.includes(`#${section.slug}`) ? h2Slugs.indexOf(`#${section.slug}`) : undefined}
                >{section.text}</a>
                {section.children.length > 0 && (
                  <ol>
                    {section.children.map((child) => (
                      <li class="toc-h3">
                        <a href={`#${child.slug}`}>{child.text}</a>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))}
          </ol>
        </div>
      </nav>
    )
  }
  {
    page.data.draft && (
      <div class="draft-notice">
        This manual page documents the <a href="/manual/releases">unstable
        channel</a> and its contents may change at any time.
      </div>
    )
  }
  <rendered.Content />
  <a class="twin" href={`/manual/${page.id}.md`}>This page as Markdown</a>
  {
    (prev || next) && (
      <nav class="pager" aria-label="Manual pages">
        {prev ? (
          <a rel="prev" href={`/manual/${prev.id}`} class="pager-link">
            <span aria-hidden="true">←</span> {prev.data.title}
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a rel="next" href={`/manual/${next.id}`} class="pager-link pager-right">
            {next.data.title} <span aria-hidden="true">→</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</ManualLayout>

<style>
  @reference "../../styles/global.css";

  /* the Markdown twin is for agents and tools: hidden like the skip link,
     shown only when keyboard focus reaches it */
  .twin {
    @apply sr-only focus:not-sr-only focus:inline-block focus:mt-10 focus:font-mono focus:text-xs focus:text-ink focus:bg-accent-soft focus:px-2 focus:py-1;
  }

  .draft-notice {
    @apply bg-tint-red text-ink-red font-semibold px-3 py-1.5 mb-3 text-sm;

    a {
      @apply text-link-red;
    }
  }

  .toc {
    @apply mb-6;

    .toc-label {
      @apply flex items-center gap-1.5 font-mono text-[11px] font-semibold uppercase tracking-[0.1em] text-ink-3 py-2 m-0;
    }

    ol {
      @apply list-none pl-0 mt-0 mb-2 sm:columns-2 xl:columns-3 gap-x-6 space-y-0;
    }

    ol ol {
      @apply mt-0 mb-0 columns-1;
    }

    li {
      @apply break-inside-avoid py-px text-sm;
    }

    .toc-h2 > a {
      @apply font-semibold text-ink;
    }

    .toc-h3 {
      @apply pl-3;
    }

    a {
      @apply text-ink-2 font-normal no-underline hover:bg-accent-soft hover:text-ink;
    }

    /* a long outline shows its first lines and fades to transparent, as
       the agent prompt on the homepage does */
    &.long:not(.open) .toc-body {
      @apply max-h-[11rem] overflow-hidden;
      mask-image: linear-gradient(to bottom, black 55%, transparent);
    }

    /* the chevron opens a long outline and closes it again */
    .toc-toggle {
      @apply inline-flex items-center justify-center w-5 h-5 bg-transparent border-0 p-0 rounded-[3px] cursor-pointer text-ink-3 hover:text-ink hover:bg-accent-soft;

      &[hidden] {
        display: none;
      }
    }

    &.open .toc-toggle svg {
      rotate: 180deg;
    }
  }

  /* previous and next: the titles, an arrow pointing the way */
  .pager {
    @apply grid grid-cols-1 sm:grid-cols-2 gap-x-6 mt-14;

    .pager-link {
      @apply self-start justify-self-start py-2 no-underline font-display font-bold text-lg tracking-[-0.02em] text-ink hover:bg-accent-soft hover:text-ink;
    }

    .pager-right {
      @apply sm:justify-self-end;
    }
  }

  :global(html.unstable) {
    .toc {
      .toc-label {
        @apply text-ink-red/70;
      }

      .toc-h2 > a,
      a {
        @apply text-ink-red;
      }
    }

    .pager {
      .pager-link {
        @apply text-ink-red hover:bg-accent-soft-red;
      }
    }
  }
</style>

<script>
  // an outline taller than about ten lines shows its start and fades, and
  // the chevron beside the label opens and closes it. Readers without
  // scripts see the whole outline.
  for (const toc of document.querySelectorAll<HTMLElement>("[data-toc]")) {
    const body = toc.querySelector<HTMLElement>(".toc-body")
    const toggle = toc.querySelector<HTMLButtonElement>("[data-toc-toggle]")
    if (!body || !toggle || body.scrollHeight <= 240) continue
    toc.classList.add("long")
    toggle.hidden = false
    toggle.addEventListener("click", () => {
      const open = toc.classList.toggle("open")
      toggle.setAttribute("aria-expanded", String(open))
      toggle.setAttribute("aria-label", open ? "Show fewer contents" : "Show all contents")
    })
  }
</script>

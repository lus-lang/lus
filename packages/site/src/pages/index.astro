---
import { getCollection } from "astro:content"
import { Code } from "astro:components"
// @ts-ignore
import lusGrammar from "../../../textmate/lus.tmLanguage.json"
import codeThemes from "../lib/code-themes.mjs"

import Layout from "../components/Layout.astro"
import ReleaseStrip from "../components/ReleaseStrip.astro"
import Benchmarks from "../components/Benchmarks.astro"

import { INSTALL_SH, WINDOWS_INSTALLER_URL, RELEASE_TAG } from "../lib/install"
import { fmtDate } from "../lib/date"
import { playgroundHref } from "../lib/playground-link"

const allNews = await getCollection("news")
const news = allNews
  .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5)

// six facets of the language, each linking into the guide; blurbs are
// factual descriptions (see the copy rules in the site memory: objective,
// standalone, distinctive facets only)
const features = [
  {
    name: "permissions",
    file: "sandbox.lus",
    href: "/manual/guide#permissions",
    unstable: false,
    blurb:
      "Scripts run under deny-by-default permissions. pledge grants capabilities at runtime and can seal the set.",
    code: `pledge("fs:read=/var/log/*")   -- read access to logs only
pledge("network:http")
pledge("seal")                 -- lock the permission set

local ok = catch fs.list("/home")
-- ok == false: outside the pledged set`,
  },
  {
    name: "queries",
    file: "adults.lus",
    href: "/manual/guide#query",
    unstable: true,
    blurb:
      "An @ expression builds a first-class query with a fixed logical pipeline. It is evaluated each time it is iterated.",
    code: `local adults =
    @people as p
     where p.age > 18
     select p.name, p.age
     order by p.age desc

for row in query(adults) do
    print(row.name, row.age)
end`,
  },
  {
    name: "sqlite",
    file: "users.lus",
    href: "/manual/guide#sqlite",
    unstable: true,
    blurb:
      "io.sqlite opens file-backed or in-memory databases. A database table serves as a query source and receives the query as parameterized SQL.",
    code: `local db <close> = io.sqlite("app.db")

db:run("INSERT INTO users (name, age) VALUES (?, ?)", "Alice", 30)

for u in query(@db.users as u where u.age >= 18 select u.name) do
    print(u.name)
end`,
  },
  {
    name: "concurrency",
    file: "pool.lus",
    href: "/manual/guide#workers",
    unstable: false,
    blurb:
      "A worker runs a script in a separate interpreter state on the thread pool and exchanges messages with its parent.",
    code: `local w = worker.create("crunch.lus", { data = "input" })
worker.send(w, "start")

while result = worker.receive(w) do
    print(result)
end`,
  },
  {
    name: "time",
    file: "zones.lus",
    href: "/manual/guide#time",
    unstable: true,
    blurb:
      "The time library separates absolute instants, civil datetimes, and durations. Named zones resolve from tzdata embedded in the runtime.",
    code: `local now = time.now()                    -- instant
local later = now + time.hours(72)
local ny = time.zone("America/New_York")

print(later:at(ny):iso())                 -- wall clock in New York`,
  },
  {
    name: "binary data",
    file: "pack.lus",
    href: "/manual/guide#vector",
    unstable: false,
    blurb:
      "A vector is a mutable byte buffer. vector.archive reads and writes gzip, zstd, brotli, and lz4.",
    code: `local v = vector.create(16)
vector.pack(v, 0, "I4I4I4I4", 1, 2, 3, 4)

local packed = vector.archive.zstd.compress(v)
local restored = vector.archive.zstd.decompress(packed)`,
  },
]

// deep-links into the generated API reference (section ids are slugs of
// the section titles in lib/api.ts)
const stdlibMap = [
  {
    name: "base",
    desc: "core globals · JSON · CSV",
    href: "/manual/api#environment-functions",
  },
  {
    name: "string",
    desc: "patterns, formatting",
    href: "/manual/api#string-library",
  },
  {
    name: "table",
    desc: "manipulation, clone, sort",
    href: "/manual/api#table-library",
  },
  { name: "math", desc: "numerics", href: "/manual/api#math-library" },
  {
    name: "fs",
    desc: "filesystem & paths",
    href: "/manual/api#filesystem-library",
  },
  {
    name: "network",
    desc: "HTTP, TCP, UDP",
    href: "/manual/api#network-library",
  },
  {
    name: "worker",
    desc: "threads & messages",
    href: "/manual/api#worker-library",
  },
  {
    name: "vector",
    desc: "mutable byte buffers",
    href: "/manual/api#vector-library",
  },
  {
    name: "vector.archive",
    desc: "gzip, zstd, brotli, lz4",
    href: "/manual/api#archive-library",
  },
  { name: "io", desc: "streams & files", href: "/manual/api#io-library" },
  { name: "os", desc: "environment, time", href: "/manual/api#os-library" },
  { name: "utf8", desc: "Unicode helpers", href: "/manual/api#utf-8-library" },
  {
    name: "coroutine",
    desc: "cooperative threads",
    href: "/manual/api#coroutine-library",
  },
  {
    name: "debug",
    desc: "introspection, AST",
    href: "/manual/api#debug-library",
  },
  {
    name: "package",
    desc: "module loading",
    href: "/manual/api#package-library",
  },
  { name: "C API", desc: "embedding interface", href: "/manual/api/c" },
]

// the version chip beside the wordmark: major.minor of the documented runtime
const versionChip = RELEASE_TAG.slice(1).split(".").slice(0, 2).join(".")
---

<Layout>
  <main id="main" class="home">
    <section class="mast">
      <div class="pitch">
        <h1>Lus<span class="chip">{versionChip}</span></h1>
        <p class="sub">
          A small, productive programming language designed to be picked up
          easily by programmers and put to good use right away.
        </p>
        <div class="install" id="install-unix">
          <span class="plat" id="install-platform">linux · x64</span>
          <code id="install-shell">{INSTALL_SH}</code>
          <button type="button" id="install-copy">copy</button>
        </div>
        <div class="install" id="install-windows" hidden>
          <span class="plat">windows · x64</span>
          <a href={WINDOWS_INSTALLER_URL}>lus-setup.exe</a>
        </div>
        <div class="row">
          <a class="btn solid" href="/manual/getting-started">Get started →</a>
          <a class="btn" href="/playground">Open the playground</a>
          <span class="alt">
            <a href="/manual/getting-started">other platforms</a> ·
            <a href="/manual/compiling">build from source</a>
          </span>
        </div>
      </div>

      <aside class="rail">
        <div class="label rail-head">
          <span>news</span><a href="/news">all →</a>
        </div>
        <ol class="ledger">
          {
            news.map((item) => (
              <li>
                <time datetime={fmtDate(item.data.date)}>
                  {fmtDate(item.data.date)}
                </time>
                <a href={`/news/${item.id}`}>{item.data.title}</a>
              </li>
            ))
          }
        </ol>
      </aside>
    </section>

    <section class="part">
      <div class="sech"><h2>Download</h2></div>
      <ReleaseStrip />
    </section>

    <section class="part">
      <div class="sech">
        <h2>Documentation</h2><span class="label">standard library</span>
      </div>
      <nav class="index" aria-label="Standard library modules">
        {
          stdlibMap.map((mod) => (
            <a href={mod.href}>
              <b>{mod.name}</b>
              <i aria-hidden="true" />
              <span>{mod.desc}</span>
            </a>
          ))
        }
      </nav>
    </section>

    <section class="part">
      <div class="sech"><h2>Lus at a glance</h2></div>
      <div class="chapters">
        {
          features.map((f, i) => (
            <article class="chap">
              <div class="no">{String(i + 1).padStart(2, "0")}</div>
              <h3>
                <a href={f.href}>{f.name}</a>
                {f.unstable && <span class="tag red">unstable</span>}
              </h3>
              <p>{f.blurb}</p>
              <figure class="figure">
                <figcaption>
                  <span>
                    fig. {i + 1} · {f.file}
                  </span>
                  <a href={playgroundHref(f.code)}>▶ run</a>
                </figcaption>
                <Code lang={lusGrammar as any} themes={codeThemes as any} code={f.code} />
              </figure>
            </article>
          ))
        }
      </div>
    </section>

    <Benchmarks />
  </main>
</Layout>

<script is:inline>
  // adjust the server-rendered linux install for the visitor's platform:
  // macOS shares the same curl|sh line (label change only), Windows swaps
  // the shell line for the installer download; no-JS readers keep the
  // linux default plus the "other platforms" link
  const plat = (
    navigator.userAgentData?.platform ??
    navigator.platform ??
    ""
  ).toLowerCase()
  if (plat.includes("mac")) {
    document.getElementById("install-platform").textContent =
      "macos · arm64"
  } else if (plat.includes("win")) {
    document.getElementById("install-unix").hidden = true
    document.getElementById("install-windows").hidden = false
  }
  const copy = document.getElementById("install-copy")
  copy.addEventListener("click", () => {
    navigator.clipboard
      .writeText(document.getElementById("install-shell").textContent)
      .then(() => {
        copy.textContent = "copied"
      })
  })
</script>

<style>
  @reference "../styles/global.css";

  .home {
    @apply pt-0 pb-12 space-y-0;
  }

  .home > section {
    @apply space-y-0;
  }

  /* masthead: pitch on 8 columns, news rail on 4 */
  .mast {
    @apply grid gap-0 pt-10 pb-4;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
  }

  .pitch {
    @apply pr-8;
  }

  h1 {
    @apply font-display font-extrabold flex items-start gap-3 m-0 -ml-[0.03em];
    font-size: clamp(96px, 13vw, 168px);
    line-height: 0.8;
    letter-spacing: -0.065em;
    font-variation-settings: "opsz" 96;

    .chip {
      @apply font-mono text-base font-semibold tracking-normal leading-normal mt-2.5 px-2 py-0.5 rounded-[3px] bg-accent text-on-accent;
    }
  }

  .sub {
    @apply text-xl leading-[1.4] text-ink-2 max-w-[44ch] mt-5;
  }

  .install {
    @apply flex mt-[22px] max-w-[620px] border border-ink rounded-md overflow-hidden bg-field;

    &[hidden] {
      display: none;
    }

    .plat {
      @apply font-mono text-[11px] font-semibold uppercase bg-accent-soft px-2.5 flex items-center border-r border-ink/30 whitespace-nowrap;
    }

    code {
      @apply flex-1 font-mono text-sm bg-transparent rounded-none px-3 py-2.5 whitespace-nowrap overflow-x-auto;
      scrollbar-width: none;
    }

    :is(button, > a, code):focus-visible {
      outline-offset: -2px;
    }

    > a {
      @apply flex-1 font-mono text-sm px-3 py-2.5 no-underline text-link hover:bg-accent-soft;
    }

    button {
      @apply font-mono text-xs font-semibold border-l border-ink/30 bg-field px-3 cursor-pointer hover:bg-accent-soft;
    }
  }

  .row {
    @apply flex flex-wrap items-center gap-2 mt-3;

    .alt {
      @apply font-mono text-xs text-ink-3 ml-2;

      a {
        @apply font-normal text-ink-2 no-underline hover:text-ink hover:underline;
      }
    }
  }

  .btn {
    @apply inline-flex gap-1.5 font-semibold text-sm px-3.5 py-[7px] rounded-md no-underline border border-ink text-ink hover:bg-accent-soft hover:text-ink;

    &.solid {
      @apply bg-solid border-solid text-on-solid hover:bg-solid/85 hover:text-on-solid;
    }
  }

  /* news rail, set as a ledger */
  .rail {
    @apply flex flex-col justify-end pl-5;

    .rail-head {
      @apply flex justify-between mb-1.5;

      a {
        @apply normal-case tracking-normal font-normal text-ink-2 no-underline py-1 -my-1 hover:text-ink;
      }
    }
  }

  .ledger {
    @apply list-none p-0 m-0 space-y-0;

    li {
      @apply flex gap-2.5 items-baseline py-1 text-sm;
    }

    time {
      @apply font-mono text-xs text-ink-3 shrink-0;
    }

    a {
      @apply no-underline font-normal text-ink hover:bg-accent-soft;
    }
  }

  /* standard library index, set like the index of a book: four columns
     on the measure, filled top to bottom */
  .index {
    @apply grid grid-cols-1;

    a {
      @apply flex items-baseline gap-1.5 py-1 no-underline font-normal text-[13px] text-ink hover:bg-accent-soft hover:text-ink;
    }

    b {
      @apply font-mono font-semibold whitespace-nowrap;
    }

    i {
      @apply flex-1 min-w-3;
    }

    span {
      @apply text-ink-3 text-right;
    }
  }

  @media (min-width: 521px) {
    .index {
      @apply grid-cols-2 gap-x-6;
    }
  }

  @media (min-width: 900px) {
    .index {
      @apply gap-x-0;
      grid-auto-flow: column;
      grid-template-rows: repeat(4, auto);
      grid-template-columns: repeat(4, minmax(0, 1fr));

      a {
        @apply pr-6;
      }

      a:nth-child(n + 13) {
        @apply pr-0;
      }
    }
  }

  /* chapters: two-up spreads of number, text, and figure */
  .chapters {
    @apply grid grid-cols-1 gap-x-12 gap-y-2;
  }

  /* each chapter spans three rows of the spread and shares them with its
     neighbour through subgrid, so paired figures start on one line */
  .chap {
    @apply grid gap-x-3.5 pt-4 pb-[18px];
    grid-template-columns: 44px minmax(0, 1fr);
    grid-row: span 3;
    grid-template-rows: subgrid;

    .no {
      @apply font-display font-extrabold text-[30px] leading-none tracking-[-0.05em] row-span-3;
      align-self: baseline;
    }

    h3 {
      @apply font-display font-bold text-lg tracking-[-0.02em] flex items-center gap-2 m-0;
      align-self: baseline;

      a {
        @apply no-underline font-bold text-ink hover:bg-accent-soft;
      }

      .tag {
        @apply ml-auto;
      }
    }

    p {
      @apply text-sm text-ink-2 mt-0.5 mb-2.5;
    }

  }

  @media (min-width: 900px) {
    .chapters {
      @apply grid-cols-2;
    }
  }

  @media (max-width: 900px) {
    .mast {
      grid-template-columns: minmax(0, 1fr);
    }

    .rail {
      @apply border-l-0 pl-0 pt-7;
    }
  }

  @media (max-width: 520px) {
    .row .alt {
      @apply ml-0 basis-full pt-1;
    }

    .install code {
      @apply text-[13px];
      overscroll-behavior-x: contain;
    }

    .chap {
      @apply gap-x-2.5;
      grid-template-columns: auto minmax(0, 1fr);

      grid-row: auto;
      grid-template-rows: auto;

      .no {
        @apply row-span-1 text-lg leading-[1.4];
      }

      p,
      .figure {
        @apply col-span-2;
      }
    }

    .install .plat {
      @apply hidden;
    }
  }
</style>

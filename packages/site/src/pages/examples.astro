---
import codeThemes from "../lib/code-themes.mjs"
import CubeField from "../components/CubeField.astro"
import { skyline } from "../lib/skyline"
import { Code } from "astro:components"
// @ts-ignore
import lusGrammar from "../../../textmate/lus.tmLanguage.json"

import Layout from "../components/Layout.astro"
import { playgroundHref } from "../lib/playground-link"
import index from "../../../../examples/index.json"

const exampleFiles = import.meta.glob("../../../../examples/*.lus", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>

interface Example {
  name: string
  number: number
  title: string
  blurb: string
  content: string
  unstable: boolean
  playground: boolean
}

const byName = new Map<string, Example>()
for (const [path, content] of Object.entries(exampleFiles)) {
  const name = path.split("/").pop()!.replace(".lus", "")
  const first = content.split("\n", 1)[0] ?? ""
  const m = first.match(/^--\s*([^:]+):\s*(.+)$/)
  byName.set(name, {
    name,
    number: 0,
    title: m?.[1]?.trim() ?? name,
    blurb: m?.[2]?.trim() ?? "",
    // strip the marker comment lines, and the title line the heading
    // already shows, from the displayed source
    content: content
      .split("\n")
      .filter(
        (l, i) =>
          !(i === 0 && m) &&
          !/^--\s*(playground|unstable|posix):\s*(true|false)\s*$/.test(l),
      )
      .join("\n")
      .trim(),
    unstable: content.includes("unstable: true"),
    playground: content.includes("playground: true"),
  })
}

// examples/index.json orders the examples and groups them into sections.
let number = 0
const sections = index.sections.map((section) => ({
  title: section.title,
  id: section.title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
  examples: section.examples.map((name) => {
    const ex = byName.get(name)
    if (!ex) throw new Error(`examples/index.json names ${name}, which has no file`)
    ex.number = ++number
    return ex
  }),
}))
const examples = sections.flatMap((section) => section.examples)

const skylineHeights = skyline(examples.map((ex) => ex.content.split("\n").length))
---

<Layout
  title="Examples"
  description="Short, idiomatic Lus programs: errors as values, string interpolation, workers, permissions, JSON, CSV, and more."
>
  <main id="main">
    <section>
      <div class="title-row">
        <h1 class="page-title">Examples</h1>
        <CubeField rows={1} heights={skylineHeights} glow={false} scale={0.7} links={examples.map((ex) => `#${ex.name}`)} />
      </div>
      <div class="intro">
        <p>
          Each example is a short, complete Lus program.{" "}
          {
            examples.some((ex) => ex.unstable) && (
              <>
                <span class="tag red">unstable</span> examples
                need the unstable release channel.
              </>
            )
          }
        </p>
      </div>
      <nav class="jump" aria-label="Examples">
        {
          sections.map((section) => (
            <div class="group">
              <a class="group-title" href={`#${section.id}`}>{section.title}</a>
              {section.examples.map((ex) => (
                <a href={`#${ex.name}`} data-bar={ex.number - 1}>
                  <span class="k">{String(ex.number).padStart(2, "0")}</span>
                  {ex.title}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
    </section>

    {
      sections.map((section) => (
    <section class="part" id={section.id}>
      <div class="sech"><h2>{section.title}</h2></div>
      <div class="examples">
        {
          section.examples.map((ex) => (
            <article class="example" id={ex.name}>
              <div class="side">
                <div class="no">{String(ex.number).padStart(2, "0")}</div>
                <div class="head">
                  <h3>
                    <a href={`#${ex.name}`}>{ex.title}</a>
                    {ex.unstable && <span class="tag red">unstable</span>}
                  </h3>
                  {ex.blurb && <p>{ex.blurb}</p>}
                </div>
              </div>
              <figure class="figure">
                <figcaption>
                  {ex.playground ? (
                    <a
                      href={playgroundHref(
                        ex.content,
                        ex.unstable ? "unstable" : "stable",
                      )}
                    >
                      ▶ Open in playground
                    </a>
                  ) : (
                    <span class="local">
                      runs locally: needs real network, files, or threads
                    </span>
                  )}
                </figcaption>
                <Code lang={lusGrammar as any} themes={codeThemes as any} code={ex.content} />
              </figure>
            </article>
          ))
        }
      </div>
    </section>
      ))
    }
  </main>
</Layout>

<style>
  @reference "../styles/global.css";

  main {
    @apply pb-12;
  }

  .part {
    @apply pt-6;
  }

  .intro {
    @apply grid gap-x-12 gap-y-2 md:grid-cols-2 text-ink-2;

    .tag {
      @apply align-[1px];
    }
  }

  /* contents, set like the homepage index: four columns, no rules */
  .jump {
    @apply grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-4 pt-6;

    .group {
      @apply flex flex-col;
    }

    a.group-title {
      @apply font-display font-bold text-ink pb-1;
    }

    a {
      @apply flex gap-2.5 items-baseline py-1 text-sm no-underline font-normal text-ink hover:bg-accent-soft;
    }

    .k {
      @apply font-mono text-xs text-ink-3;
    }
  }

  /* each example is a spread: its name, note, and run link stay in view
     on the left while the code runs down the right */
  .examples {
    @apply grid grid-cols-1 gap-y-10;
  }

  .example {
    @apply grid gap-x-3.5 min-w-0 scroll-mt-4;
    grid-template-columns: 68px minmax(0, 1fr);

    /* ghost numerals, as on the homepage chapters */
    .no {
      @apply font-display font-extrabold text-[56px] leading-[0.8] tracking-[-0.06em] tabular-nums;
      color: color-mix(in oklab, var(--color-ink) 16%, transparent);
      align-self: start;
    }

    .head {
      @apply min-w-0;
      align-self: baseline;
    }

    h3 {
      @apply font-display font-bold text-lg tracking-[-0.02em] flex items-center gap-2 m-0;

      a {
        @apply no-underline font-bold text-ink hover:bg-accent-soft;
      }
    }

    p {
      @apply text-sm text-ink-2 mt-0.5 mb-2.5;
    }

    .figure {
      @apply col-span-2 mt-1;
    }

    .local {
      @apply normal-case tracking-normal whitespace-normal;
    }
  }

  /* the example under the pointer, or the one linked to, lights its
     numeral */
  .example:hover .no,
  .example:target .no {
    color: color-mix(in oklab, var(--color-accent) 70%, transparent);
  }

  .example:target h3 a {
    @apply bg-accent-soft;
  }

  @media (min-width: 1024px) {
    .example {
      @apply gap-x-6;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);

      .side {
        @apply sticky top-4 self-start grid gap-x-3.5;
        grid-template-columns: 68px minmax(0, 1fr);
      }

      .figure {
        @apply col-span-1 mt-0;
      }
    }
  }

  @media (max-width: 1023px) {
    .example .side {
      @apply contents;
    }
  }
</style>

---
import Layout from "../components/Layout.astro"
import CubeField from "../components/CubeField.astro"
---

<Layout
  title="Page not found"
  description="The page you requested does not exist."
>
  <main id="main">
    <section>
      <h1 class="page-title">404: page not found</h1>
      <p class="lead">This page doesn't exist.</p>
      <ul class="ways">
        <li><a href="/manual">Manual</a>: every documentation page</li>
        <li>
          <a href="/manual/api">API reference</a>: the standard library, filterable
          (press <code>/</code>)
        </li>
        <li>
          <a href="/manual/api/c">C API reference</a>: the embedding interface
        </li>
        <li><a href="/examples">Examples</a>: short, runnable programs</li>
        <li><a href="/">Home</a></li>
      </ul>
    </section>
    <CubeField class="lost" cols={44} at={0.5} amp={3} seed={3} signal="fallen" />
  </main>
</Layout>

<style>
  @reference "../styles/global.css";

  :global(.lost) {
    @apply mt-16;
  }

  .lead {
    @apply text-xl text-ink-2 mb-3 max-w-[48.5rem];
  }

  .ways {
    @apply list-none pl-0 space-y-0 text-ink-2;

    li {
      @apply py-1;
    }

    a {
      @apply font-semibold text-ink no-underline hover:bg-accent-soft;
    }
  }
</style>

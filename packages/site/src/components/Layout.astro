---
import "@fontsource-variable/atkinson-hyperlegible-next"
import "@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css"
import "@fontsource-variable/bricolage-grotesque/opsz.css"
import "@fontsource-variable/intel-one-mono"
import "@fontsource-variable/intel-one-mono/wght-italic.css"

import "../styles/global.css"
import SiteHeader from "./SiteHeader.astro"

interface Props {
  title?: string
  description?: string
  unstable?: boolean
  /** the page's Markdown twin, announced to agents and fetch tools */
  markdown?: string
}


const fullTitle = `Lus${Astro.props.title ? ` - ${Astro.props.title}` : ""}`
const description =
  Astro.props.description ??
  "A small, fast, and productive language to build programs."
const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://lus.dev",
)

---

<html lang="en" class:list={[{ unstable: Astro.props.unstable }]}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/mask-icon.svg" color="#101c05" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Louka Ménard Blondin" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {Astro.props.markdown && <link rel="alternate" type="text/markdown" href={Astro.props.markdown} />}
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <meta property="og:image" content="https://lus.dev/banner.png" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="418" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Lus" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://lus.dev/banner.png" />

    <title>{fullTitle}</title>
    <script src="../scripts/copy-code.ts"></script>
    <script src="../scripts/readout-hover.ts"></script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader unstable={Astro.props.unstable} />
    <slot />
    <footer>
      <div class="footer-wrap">
        <div class="footer-inner">
          <a href="/" class="footer-wordmark"><span class="mark" aria-hidden="true"></span>lus.dev</a>
          <a href="/manual/license">0BSD</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  @reference "../styles/global.css";

  footer {
    @apply mt-auto pt-8;

    .footer-wrap {
      @apply max-w-[1240px] mx-auto px-4 md:px-6;
    }

    /* the maker's mark: a small plain cube before the name */
    .mark {
      @apply inline-block w-[10px] h-[11px] mr-1.5 align-[-1px];
      background: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20width%3D%2710%27%20height%3D%2711%27%20viewBox%3D%270%200%2010%2011%27%3E%3Cpath%20d%3D%27M5%20.5%209.5%203%205%205.5%20.5%203Z%27%20fill%3D%27%23f9f9f2%27%20stroke%3D%27%23737b68%27%20stroke-width%3D%27.6%27%20stroke-linejoin%3D%27round%27/%3E%3Cpath%20d%3D%27M.5%203%205%205.5V10.5L.5%208Z%27%20fill%3D%27%23d9ddcc%27%20stroke%3D%27%23737b68%27%20stroke-width%3D%27.6%27%20stroke-linejoin%3D%27round%27/%3E%3Cpath%20d%3D%27M9.5%203%205%205.5V10.5L9.5%208Z%27%20fill%3D%27%23b8bfa8%27%20stroke%3D%27%23737b68%27%20stroke-width%3D%27.6%27%20stroke-linejoin%3D%27round%27/%3E%3C/svg%3E") no-repeat;
    }

    @media (prefers-color-scheme: dark) {
      .mark {
        background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20width%3D%2710%27%20height%3D%2711%27%20viewBox%3D%270%200%2010%2011%27%3E%3Cpath%20d%3D%27M5%20.5%209.5%203%205%205.5%20.5%203Z%27%20fill%3D%27%232a3520%27%20stroke%3D%27%23949c88%27%20stroke-width%3D%27.6%27%20stroke-linejoin%3D%27round%27/%3E%3Cpath%20d%3D%27M.5%203%205%205.5V10.5L.5%208Z%27%20fill%3D%27%231d2715%27%20stroke%3D%27%23949c88%27%20stroke-width%3D%27.6%27%20stroke-linejoin%3D%27round%27/%3E%3Cpath%20d%3D%27M9.5%203%205%205.5V10.5L9.5%208Z%27%20fill%3D%27%23141c0d%27%20stroke%3D%27%23949c88%27%20stroke-width%3D%27.6%27%20stroke-linejoin%3D%27round%27/%3E%3C/svg%3E");
      }
    }

    /* the closing rule carries the same ruler ticks as section rules */
    .footer-inner {
      @apply border-t border-rule pt-2.5 pb-10 flex justify-between font-mono text-xs text-ink-3;
      background:
        repeating-linear-gradient(
            to right,
            var(--color-rule) 0 1px,
            transparent 1px calc(100% / 12)
          )
          left top / 100% 5px no-repeat,
        linear-gradient(var(--color-rule), var(--color-rule)) right top / 1px
          5px no-repeat;
    }

    a {
      @apply no-underline font-normal text-ink-3 hover:text-ink;
    }
  }

  :global(html.unstable) {
    footer {
      @apply border-ink-red text-ink-red/70;

      a {
        @apply text-ink-red/70;
      }
    }
  }
</style>

---
import { Image } from "astro:assets"
import "@fontsource-variable/atkinson-hyperlegible-next"
import "@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css"
import "@fontsource-variable/bricolage-grotesque/opsz.css"
import "@fontsource-variable/intel-one-mono"
import "@fontsource-variable/intel-one-mono/wght-italic.css"

import "../styles/global.css"
import "../styles/looks.css"
import logo from "../assets/logo.svg"
import logoUnstable from "../assets/logo-unstable.svg"

interface Props {
  title?: string
  description?: string
  unstable?: boolean
}

const currentLogo = Astro.props.unstable ? logoUnstable : logo
const path = Astro.url.pathname.replace(/\/$/, "") || "/"

const fullTitle = `Lus${Astro.props.title ? ` - ${Astro.props.title}` : ""}`
const description =
  Astro.props.description ??
  "Lus is a small, fast, and reliable programming language that is sovereign."
const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://lus.dev",
)

const navLinks = [
  { href: "/playground", label: "playground" },
  { href: "/examples", label: "examples" },
  { href: "/manual", label: "manual" },
  { href: "/news", label: "news" },
]

function isActive(href: string) {
  return path === href || path.startsWith(href + "/")
}
---

<html lang="en" class:list={[{ unstable: Astro.props.unstable }]}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Louka Ménard Blondin" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://lus.dev/banner.png" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="418" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Lus" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://lus.dev/banner.png" />

    <title>{fullTitle}</title>
    {
      import.meta.env.DEV && (
        <script is:inline set:html={`try{const q=new URLSearchParams(location.search).get("look");const l=q||localStorage.getItem("look");if(q)localStorage.setItem("look",q);if(l&&l!=="field")document.documentElement.dataset.look=l}catch{}`} />
      )
    }
    <script src="../scripts/copy-code.ts"></script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="cols-bg" aria-hidden="true"></div>
    <header>
      <div class="header-inner">
        <a href="/" class="brand" aria-label="Lus, home">
          <Image
            src={currentLogo}
            alt=""
            class="lus-logo"
            width={18}
            height={20}
          />
          <span class="wordmark">Lus</span>
        </a>

        <nav aria-label="Main">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class:list={[{ active: isActive(link.href) }]}
                aria-current={
                  path === link.href
                    ? "page"
                    : isActive(link.href)
                      ? "true"
                      : undefined
                }
              >
                {link.label}
              </a>
            ))
          }
          <a
            href="https://github.com/lus-lang/lus"
            target="_blank"
            rel="noopener">github</a
          >
        </nav>
      </div>
    </header>
    <slot />
    <footer>
      <div class="footer-inner">
        <a href="/" class="footer-wordmark">lus.dev</a>
        <a href="/manual/license">0BSD</a>
      </div>
    </footer>
    {
      import.meta.env.DEV && (
        <div class="look-switch" aria-label="Workshop look">
          {["field", "quiet", "margin", "soft", "night"].map((l) => (
            <button type="button" data-look-set={l}>{l}</button>
          ))}
          <script is:inline set:html={`for(const b of document.querySelectorAll("[data-look-set]")){const cur=document.documentElement.dataset.look||"field";b.toggleAttribute("data-on",b.dataset.lookSet===cur);b.onclick=()=>{localStorage.setItem("look",b.dataset.lookSet);location.reload()}}`} />
        </div>
      )
    }
  </body>
</html>

<style>
  @reference "../styles/global.css";

  header {
    @apply bg-paper border-b-2 border-ink;

    .header-inner {
      @apply max-w-[1240px] mx-auto px-4 md:px-6 h-12 flex items-center gap-4;
    }

    .brand {
      @apply flex items-center gap-2 no-underline shrink-0 text-ink hover:text-ink;

      .lus-logo {
        @apply w-[18px] h-auto;
      }

      .wordmark {
        @apply font-display font-extrabold text-[22px] tracking-[-0.045em] leading-none;
      }
    }

    nav {
      @apply ml-auto flex flex-wrap items-center justify-end gap-0.5 font-mono text-[13px];

      a {
        @apply no-underline font-normal text-ink-2 px-2.5 py-1.5 rounded-[4px] hover:bg-accent-soft hover:text-ink;

        &.active {
          @apply bg-ink text-accent hover:bg-ink hover:text-accent;
        }
      }
    }
  }

  footer {
    @apply mt-auto border-t-2 border-ink;

    .footer-inner {
      @apply max-w-[1240px] mx-auto px-4 md:px-6 pt-2.5 pb-10 flex justify-between font-mono text-xs text-ink-3;
    }

    a {
      @apply no-underline font-normal text-ink-3 hover:text-ink;
    }
  }

  @media (max-width: 520px) {
    header .header-inner {
      @apply gap-2;
    }

    header .brand .wordmark {
      @apply sr-only;
    }

    header nav {
      @apply text-xs flex-nowrap gap-0;

      a {
        @apply px-1;
      }
    }
  }

  .look-switch {
    @apply fixed bottom-3 left-3 z-50 flex font-mono text-xs bg-white border border-ink rounded-md overflow-hidden;

    button {
      @apply px-2 py-1 cursor-pointer text-ink;
    }

    button[data-on] {
      @apply bg-ink text-accent;
    }
  }

  :global(html.unstable) {
    header {
      @apply border-ink-red;

      .brand,
      .brand:hover {
        @apply text-ink-red;
      }

      nav a {
        @apply text-ink-red/80 hover:bg-accent-soft-red hover:text-ink-red;

        &.active {
          @apply bg-ink-red text-accent-red;
        }
      }
    }

    footer {
      @apply border-ink-red text-ink-red/70;

      a {
        @apply text-ink-red/70;
      }
    }
  }
</style>

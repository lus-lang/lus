---
import { Image } from "astro:assets"
import Napoleon from "../assets/napoleon.jpg"
---

<aside class="dedication">
  <span class="plate">
  <Image
    src={Napoleon}
    alt="Napoléon Bonaparte"
    width={160}
    densities={[1, 2]}
    loading="lazy"
    class="dedication-image"
  />
  </span>
  <div class="dedication-body">
    <slot />
  </div>
</aside>

<style>
  @reference "../styles/global.css";

  .dedication {
    @apply bg-tint p-5 my-8 max-w-3xl;

    /* the engraving is set as a plate */
    .plate {
      @apply float-right ml-6 mb-3 mt-1 mr-1 block max-sm:float-none max-sm:ml-0 max-sm:mb-4 max-sm:inline-block;
    }

    .dedication-image {
      @apply block;
    }

    .dedication-eyebrow {
      @apply block font-mono text-[11px] font-semibold tracking-[0.1em] uppercase text-ink-3 mb-2;
    }

    .dedication-body :global(p) {
      @apply text-lg leading-relaxed;
    }

    &::after {
      content: "";
      display: block;
      clear: both;
    }
  }
</style>

---

export interface NavLink {
  href: string
  title: string
  icon?: string
  /** highlight as the section the reader is in */
  active: boolean
  /** exactly this page (drives aria-current="page") */
  current: boolean
}

export interface TocItem {
  slug: string
  text: string
}

export interface NavGroup {
  key: string
  label: string
  links: NavLink[]
}

interface Props {
  groups: NavGroup[]
  /** current page h2 headings; rendered under the active link */
  toc?: TocItem[]
}

const { groups, toc } = Astro.props
---

<div class="manual-nav">
  {
    groups.map(
      (group) =>
        group.links.length > 0 && (
          <>
            <span class="sidebar-label">{group.label}</span>
            {group.links.map((link) => (
              <>
                <a
                  class:list={["sidebar-link", { active: link.active }]}
                  href={link.href}
                  aria-current={
                    link.current ? "page" : link.active ? "true" : undefined
                  }
                >
                  {link.title}
                </a>
                {link.current && toc && toc.length > 0 && (
                  <ol class="sidebar-toc">
                    {toc.map((item) => (
                      <li>
                        <a href={`#${item.slug}`}>{item.text}</a>
                      </li>
                    ))}
                  </ol>
                )}
              </>
            ))}
          </>
        ),
    )
  }
</div>

<style>
  @reference "../styles/global.css";

  .manual-nav {
    @apply flex flex-col;
  }

  .sidebar-label {
    @apply font-mono text-[11px] font-semibold uppercase tracking-[0.1em] text-ink-3 mt-5 mb-1 first:mt-0;
  }

  .sidebar-link {
    @apply block self-start px-2 py-[3px] -mx-2 no-underline text-ink-2 font-normal text-sm rounded-[4px] hover:bg-accent-soft hover:text-ink;

    &.active {
      @apply bg-solid text-on-solid font-semibold hover:bg-solid hover:text-on-solid;
    }
  }

  /* in-page contents of the current chapter: instant jumps, no JS */
  .sidebar-toc {
    @apply list-none pl-0 my-1 ml-2 space-y-0;

    a {
      @apply block font-mono text-xs font-normal no-underline text-ink-3 pl-2 py-[3px] hover:bg-accent-soft hover:text-ink;
    }
  }

  :global(html.unstable) {
    .sidebar-label {
      @apply text-ink-red/70 border-ink-red;
    }

    .sidebar-link {
      @apply text-ink-red/80 hover:bg-accent-soft-red hover:text-ink-red;

      &.active {
        @apply bg-ink-red text-tint-red;
      }
    }

    .sidebar-toc {
      a {
        @apply text-ink-red/70 hover:bg-accent-soft-red hover:text-ink-red;
      }
    }
  }
</style>

---

export interface NavLink {
  href: string
  title: string
  icon?: string
  /** highlight as the section the reader is in */
  active: boolean
  /** exactly this page (drives aria-current="page") */
  current: boolean
}

export interface TocItem {
  slug: string
  text: string
  /** the section's column in the title readout, when the page has one */
  bar?: number
}

export interface NavGroup {
  key: string
  label: string
  links: NavLink[]
}

interface Props {
  groups: NavGroup[]
  /** current page h2 headings; rendered under the active link */
  toc?: TocItem[]
}

const { groups, toc } = Astro.props
---

<div class="manual-nav">
  {
    groups.map(
      (group) =>
        group.links.length > 0 && (
          <>
            <span class="sidebar-label">{group.label}</span>
            {group.links.map((link) => (
              <>
                <a
                  class:list={["sidebar-link", { active: link.active }]}
                  href={link.href}
                  aria-current={
                    link.current ? "page" : link.active ? "true" : undefined
                  }
                >
                  {link.title}
                </a>
                {link.current && toc && toc.length > 0 && (
                  <ol class="sidebar-toc">
                    {toc.map((item) => (
                      <li>
                        <a href={`#${item.slug}`} data-bar={item.bar}>{item.text}</a>
                      </li>
                    ))}
                  </ol>
                )}
              </>
            ))}
          </>
        ),
    )
  }
</div>

<style>
  @reference "../styles/global.css";

  .manual-nav {
    @apply flex flex-col;
  }

  .sidebar-label {
    @apply font-mono text-[11px] font-semibold uppercase tracking-[0.1em] text-ink-3 mt-5 mb-1 first:mt-0;
  }

  .sidebar-link {
    @apply relative block self-start px-2 py-[3px] -mx-2 no-underline text-ink-2 font-normal text-sm rounded-[4px] hover:bg-accent-soft hover:text-ink;

    /* the current page: ink text followed by the lime cube, the same cube
       that marks a hovered row elsewhere */
    &.active {
      @apply text-ink font-semibold;

      &::after {
        content: "";
        display: inline-block;
        margin-left: 0.5em;
        vertical-align: -1px;
        width: 10px;
        height: 11px;
        background: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20width%3D%2710%27%20height%3D%2711%27%20viewBox%3D%270%200%2010%2011%27%3E%3Cpath%20d%3D%27M5%20.5%209.5%203%205%205.5%20.5%203Z%27%20fill%3D%27%23e4f7a8%27%20stroke%3D%27%233a4a1a%27%20stroke-width%3D%27.6%27%20stroke-linejoin%3D%27round%27/%3E%3Cpath%20d%3D%27M.5%203%205%205.5V10.5L.5%208Z%27%20fill%3D%27%23b6ec3c%27%20stroke%3D%27%233a4a1a%27%20stroke-width%3D%27.6%27%20stroke-linejoin%3D%27round%27/%3E%3Cpath%20d%3D%27M9.5%203%205%205.5V10.5L9.5%208Z%27%20fill%3D%27%238fd122%27%20stroke%3D%27%233a4a1a%27%20stroke-width%3D%27.6%27%20stroke-linejoin%3D%27round%27/%3E%3C/svg%3E") no-repeat;
      }
    }
  }

  /* in-page contents of the current chapter: instant jumps, no JS */
  .sidebar-toc {
    @apply list-none pl-0 my-1 ml-2 space-y-0;

    a {
      @apply block font-mono text-xs font-normal no-underline text-ink-3 pl-2 py-[3px] hover:bg-accent-soft hover:text-ink;
    }
  }

  :global(html.unstable) {
    .sidebar-label {
      @apply text-ink-red/70 border-ink-red;
    }

    .sidebar-link {
      @apply text-ink-red/80 hover:bg-accent-soft-red hover:text-ink-red;

      &.active {
        @apply text-ink-red;
      }
    }

    .sidebar-toc {
      a {
        @apply text-ink-red/70 hover:bg-accent-soft-red hover:text-ink-red;
      }
    }
  }
</style>

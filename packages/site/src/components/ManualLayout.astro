---
import Layout from "./Layout.astro"
import { getCollection } from "astro:content"
import ManualNav from "./ManualNav.astro"
import type { NavGroup, TocItem } from "./ManualNav.astro"

interface Props {
  title: string
  unstable?: boolean
  /** cap long-form prose at 80ch; API pages omit it for full width */
  measure?: boolean
  /** current page h2 headings, rendered under the active sidebar link */
  toc?: TocItem[]
  /** the page's Markdown twin */
  markdown?: string
}
const { title, unstable, measure, toc, markdown } = Astro.props

const manual = await getCollection("manual")

const currentPath = Astro.url.pathname.replace(/\/$/, "")

const groups: NavGroup[] = [
  { key: "learn", label: "learn", links: [] },
  { key: "use", label: "use", links: [] },
  { key: "library", label: "library", links: [] },
  { key: "reference", label: "reference", links: [] },
]

for (const group of groups) {
  group.links = manual
    .filter((page) => page.data.group === group.key)
    .toSorted((a, b) => a.data.order - b.data.order)
    .map((page) => ({
      href: `/manual/${page.id}`,
      title: page.data.title,
      icon: page.data.icon,
      active: currentPath === `/manual/${page.id}`,
      current: currentPath === `/manual/${page.id}`,
    }))
}

// the API reference pages live outside the content collection; they lead
// the reference group (most-consulted first)
groups
  .find((group) => group.key === "reference")!
  .links.unshift(
    {
      href: "/manual/api",
      title: "API",
      icon: "library",
      active: currentPath === "/manual/api",
      current: currentPath === "/manual/api",
    },
    {
      href: "/manual/api/c",
      title: "C API",
      icon: "braces",
      active: currentPath === "/manual/api/c",
      current: currentPath === "/manual/api/c",
    },
  )
---

<Layout title={title} unstable={unstable} markdown={markdown}>
  <main id="main">
    <section class="manual-shell">
      <article class:list={["flex-1 min-w-0", { measured: measure }]}>
        <nav class="lg:hidden" aria-label="Manual">
          <details class="manual-nav-mobile">
            <summary>Manual: {title}</summary>
            <div class="manual-nav-mobile-body">
              <ManualNav groups={groups} />
            </div>
          </details>
        </nav>
        <slot />
      </article>
      <aside class="hidden lg:block">
        <nav class="sidebar" aria-label="Manual">
          <ManualNav groups={groups} toc={toc} />
        </nav>
      </aside>
    </section>
  </main>
</Layout>

<style>
  @reference "../styles/global.css";

  :global(hr) {
    @apply my-4 border-t border-ink/30;
  }

  .manual-shell {
    @apply flex flex-col lg:flex-row-reverse gap-8 pt-2;
  }

  article {
    @apply space-y-2;
  }

  /* dense-reference measure: cap the children, not the article box, so
     the flex layout keeps its width and wide elements can opt out */
  /* 48.5rem is 80ch of the body face, fixed in rem so headings and
     rules share the edge of the prose */
  article.measured > :global(*) {
    max-width: 48.5rem;
  }

  article :global(h1) {
    @apply page-title;
  }

  /* chapters open on one 2px rule under the title, like the homepage */
  article :global(h2) {
    @apply font-display text-[26px] leading-tight font-bold tracking-[-0.035em] ruled pb-2.5 mt-14 mb-3;
  }

  article :global(h3) {
    @apply font-display text-lg font-bold tracking-[-0.02em];
  }

  .manual-nav-mobile {
    @apply bg-tint rounded-md px-3 mb-4;

    summary {
      @apply font-mono text-[11px] font-semibold uppercase tracking-[0.1em] text-ink-3 py-2 cursor-pointer select-none;
    }

    .manual-nav-mobile-body {
      @apply pb-3;
    }
  }

  aside {
    /* the scroll area reaches 8px left of the column, so the wash of a
       link, which extends 8px left of its text, is never clipped */
    @apply min-w-52 w-1/6 sticky top-4 self-start pl-2 -ml-2 pr-4 max-h-[calc(100vh-2rem)] overflow-y-auto;
    /* a quiet scrollbar where the outline is longer than the screen */
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklab, var(--color-ink) 25%, transparent)
      transparent;
  }

  :global(html.unstable) {
    article :global(h2) {
      @apply border-ink-red;
    }

    aside {
      @apply border-ink-red/30;
    }

    .manual-nav-mobile {
      @apply bg-tint-red;

      summary {
        @apply text-ink-red/70;
      }
    }
  }
</style>

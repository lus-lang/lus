---
/*
** The site header: logo and main navigation. Layout uses it with the
** page shell's width, and the playground spans it across the viewport.
*/
import { Image } from "astro:assets"
import project from "../../../../packaging/project.json"
import logo from "../assets/logo.svg"
import logoDark from "../assets/logo-dark.svg"
import logoUnstable from "../assets/logo-unstable.svg"

interface Props {
  unstable?: boolean
  /** span the viewport instead of the 1240px page shell */
  wide?: boolean
}

const { unstable, wide } = Astro.props
const currentLogo = unstable ? logoUnstable : logo
// the dark scheme gets lighter walls so the mark holds on dark paper
const nightLogo = unstable ? logoUnstable : logoDark
const path = Astro.url.pathname.replace(/\/$/, "") || "/"

const navLinks = [
  { href: "/playground", label: "playground" },
  { href: "/examples", label: "examples" },
  { href: "/manual", label: "manual" },
  { href: "/agents", label: "agents" },
  { href: "/news", label: "news" },
]

function isActive(href: string) {
  return path === href || path.startsWith(href + "/")
}
---

<header class="site-header">
  <div class:list={["header-inner", { wide }]}>
    <a href="/" class="brand" aria-label="Lus, home">
      <Image
        src={currentLogo}
        alt=""
        class="lus-logo day-logo"
        width={22}
        height={25}
      />
      <Image
        src={nightLogo}
        alt=""
        class="lus-logo night-logo"
        width={22}
        height={25}
      />
    </a>

    <nav aria-label="Main">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[{ active: isActive(link.href) }]}
            aria-current={
              path === link.href
                ? "page"
                : isActive(link.href)
                  ? "true"
                  : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={project.repository}
        target="_blank"
        rel="noopener">github</a
      >
    </nav>
  </div>
</header>

<style>
  @reference "../styles/global.css";

  /* one of the two marks shows: the dark one in the dark scheme and inside
     .night, which the playground sets on html */
  .night-logo {
    display: none;
  }

  :global(.night) .day-logo {
    display: none;
  }

  :global(.night) .night-logo {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    .day-logo {
      display: none;
    }

    .night-logo {
      display: block;
    }
  }

  .site-header {
    @apply bg-paper shrink-0;

    .header-inner {
      @apply max-w-[1240px] mx-auto px-4 md:px-6 h-12 flex items-center gap-4;

      &.wide {
        @apply max-w-none px-4;
      }
    }

    .brand {
      @apply flex items-center gap-2 no-underline shrink-0 text-ink hover:text-ink;

      .lus-logo {
        @apply w-[22px] h-auto;
      }
    }

    nav {
      @apply ml-auto flex flex-wrap items-center justify-end gap-0.5 font-mono text-[13px];

      a {
        @apply no-underline font-normal text-ink-2 px-2.5 py-1.5 hover:bg-accent-soft hover:text-ink;

        &.active {
          @apply bg-solid text-on-solid hover:bg-solid hover:text-on-solid;
        }
      }
    }
  }

  @media (max-width: 520px) {
    .site-header {
      .header-inner {
        @apply gap-2;
      }

      nav {
        @apply text-[11px] flex-nowrap gap-0;

        a {
          @apply px-1 py-2.5;
        }
      }
    }
  }

  /* the smallest phones keep all six links on one line */
  @media (max-width: 360px) {
    .site-header {
      .header-inner {
        @apply px-3 gap-1;
      }

      nav a {
        @apply px-[2px] text-[10.5px];
      }
    }
  }

  :global(html.unstable) .site-header {
    .brand,
    .brand:hover {
      @apply text-ink-red;
    }

    nav a {
      @apply text-ink-red/80 hover:bg-accent-soft-red hover:text-ink-red;

      &.active {
        @apply bg-ink-red text-tint-red;
      }
    }
  }
</style>

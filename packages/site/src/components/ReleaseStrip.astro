---
/*
** Dense two-row release surface: one row per channel with version,
** date, and per-platform download links. Self-contained (fetches the
** release data itself) so the homepage and /manual/releases cannot
** drift. Renders a graceful row when a channel has no release.
*/
import { getAllReleases, type ReleaseInfo } from "../lib/release"

const { stable, unstable } = await getAllReleases()

const channels: { name: string; release: ReleaseInfo | null }[] = [
  { name: "stable", release: stable },
  { name: "unstable", release: unstable },
]

function downloads(release: ReleaseInfo) {
  // Releases list only the assets they publish, and the filter drops
  // every link a release does not have.
  return [
    { label: "installer", href: release.links.windowsInstaller },
    { label: "windows-x64", href: release.links.windowsX64 },
    { label: "windows-arm64", href: release.links.windowsArm64 },
    { label: "macos-arm64", href: release.links.macosArm64 },
    { label: "macos-x64", href: release.links.macosX64 },
    { label: "linux-x64", href: release.links.linuxX64 },
    { label: "linux-arm64", href: release.links.linuxArm64 },
    { label: "wasm", href: release.links.wasm },
    { label: "source", href: release.links.sourceTarball },
    { label: "checksums", href: release.links.checksums },
    { label: "notes", href: release.htmlUrl },
  ].filter((d): d is { label: string; href: string } => !!d.href)
}
---

<div class="release-strip">
  {
    channels.map(({ name, release }) => (
      <div class="release-row" data-channel={name}>
        <span class:list={["tag", { red: name === "unstable" }]}>{name}</span>
        {release ? (
          <>
            <span class="rel-version">{release.version}</span>
            <time class="rel-date" datetime={release.releaseDate}>
              {release.releaseDate}
            </time>
            <span class="rel-links">
              {downloads(release).map((d) => (
                <a href={d.href}>{d.label}</a>
              ))}
            </span>
          </>
        ) : (
          <span class="rel-none">no release available yet</span>
        )}
      </div>
    ))
  }
</div>

<style>
  @reference "../styles/global.css";

  /* the rows set their columns by the strip's own width, so the strip
     fits the homepage and the narrower manual column alike */
  .release-strip {
    @apply font-mono text-xs;
    container-type: inline-size;
  }

  .release-row {
    @apply flex flex-wrap items-center gap-x-3 gap-y-1 py-1.5;

    .tag {
      @apply min-w-[62px];
    }

    .rel-version {
      @apply font-semibold text-[13px] text-ink;
    }

    .rel-date {
      @apply text-ink-3;
    }

    .rel-none {
      @apply text-ink-3;
    }

    .rel-links {
      @apply flex flex-wrap gap-x-3 gap-y-0 sm:ml-auto;

      a {
        @apply font-normal no-underline text-link py-1 hover:text-ink hover:underline;
      }
    }

    /* on the measure: tag, version over two columns, date, links */
    @container (min-width: 960px) {
      display: grid;
      grid-template-columns: 1fr 2fr 1fr 8fr;
      column-gap: 0;

      .tag {
        justify-self: start;
      }

      .rel-links {
        justify-self: end;
      }

      .rel-none {
        grid-column: 2 / -1;
      }
    }

    &[data-channel="unstable"] .rel-links a {
      @apply text-link-red hover:text-ink-red;
    }
  }
</style>

  "description": "The Lus 2.0 runtime as a WASI module, with a small JavaScript host for browsers, workers, and Node",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/lus-lang/lus",
    "directory": "packages/wasm"
  },
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "types": "./src/node.d.ts",

{
  "name": "lus-wasm",
  "version": "2.0.0-dev",
  "description": "The Lus runtime as a WASI module, with a small JavaScript host for browsers, workers, and Node",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "types": "./src/node.d.ts",
        "default": "./src/node.js"
      },
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./browser": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./lus.wasm": "./dist/lus.wasm"
  },
  "files": [
    "src",
    "dist/lus.wasm"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  }
}

      "default": "./src/index.js"
    },
    "./lus.wasm": "./dist/lus.wasm"
  },
  "files": [
    "src",
    "dist/lus.wasm",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],

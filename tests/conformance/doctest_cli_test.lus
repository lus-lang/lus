--[[
    `lus test --doc` runs the ```lus code blocks inside the doc comments of
    .lus files, like those of Markdown files. The directory of the file
    comes first on package.path, so an example can require its own module.
    A source file with no example stays out of the report.
]]

pledge("exec", "env=LUS_EXE", "fs:read", "fs:write")

local LUS = os.getenv("LUS_EXE")

local MODULE = [=[
--- Arithmetic helpers.
local mathx = {}

--- Doubles a number.
---
--- ```lus
--- local mathx = require("mathx")
--- assert(mathx.double(21) == 42)
--- ```
---
--- ```lus
--- local mathx = require("mathx")
--- assert(mathx.double(1) == 3, "wrong on purpose")
--- ```
function mathx.double(x)
    return 2 * x
end

--[[- Halves a number.

```lus nocheck
mathx.half(oops
```
]]
function mathx.half(x)
    return x / 2
end

return mathx
]=]

local function write(path, text)
    local f = assert(io.open(path, "w"))
    f:write(text)
    f:close()
end

local function run(args)
    if LUS == nil then
        skip("the interpreter is not reachable, set LUS_EXE")
    end

    local p = io.popen(`"$LUS" test $args 2>&1`)
    local out = p:read("a")
    local ok = p:close()
    return (ok == true or ok == 0), out
end

local function doc_comment_examples_run_test()
    write("mathx.lus", MODULE)
    local ok, out = run("--doc mathx.lus")
    assert(not ok, out)
    assert(out:find("mathx.lus (1 passed, 1 failed, 1 skipped", 1, true), out)
    -- Each example is named after the line where its code starts.
    assert(out:find("FAIL line 12", 1, true), out)
    assert(out:find("wrong on purpose", 1, true), out)
end

local function a_source_file_without_examples_stays_quiet_test()
    fs.createdirectory("lib")
    write("lib/plain.lus", "--- A module.\nreturn {}\n")
    write("lib/guide.md", "Text.\n\n```lus\nassert(true)\n```\n")
    local ok, out = run("--doc lib")
    assert(ok, out)
    assert(not out:find("plain.lus", 1, true), out)
    assert(out:find("guide.md (1 passed", 1, true), out)
end

-- Each `-->` comment of a block names a line that the block prints, to
-- standard output or standard error. Whitespace runs compare equal and
-- `...` matches any text.
local OUTPUT = [=[
Text.

```lus
print("total", 6)        --> total  6
print(catch error("x"))  --> false  ...: x
for i = 1, 2 do print(i * 10) end
--> 10
--> 20
warn("@on")
warn("low disk")         --> Lus warning: low disk
```

More.

```lus
print(1 + 1)   --> 3
```
]=]

local function output_comments_are_compared_with_what_a_block_prints_test()
    write("output.md", OUTPUT)
    local ok, out = run("--doc output.md")
    assert(not ok, out)
    assert(out:find("output.md (1 passed, 1 failed", 1, true), out)
    assert(out:find("FAIL line 16", 1, true), out)
    assert(out:find('expects the output "3"', 1, true), out)
end

-- A block that pledges starts with no permissions, so the denial that its
-- comment names happens. Any other block holds every permission.
local PLEDGED = [=[
Text.

```lus
pledge("fs:read=./*")
print((catch io.open("/etc/hosts")))   --> false
```

```lus
print((catch io.open("/etc/hosts")))   --> true
```
]=]

local function a_block_that_pledges_starts_without_permissions_test()
    write("pledged.md", PLEDGED)
    local ok, out = run("--doc pledged.md")
    assert(ok, out)
    assert(out:find("pledged.md (2 passed", 1, true), out)
end

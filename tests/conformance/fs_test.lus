-- fs.remove tests
-- ============================================================================

-- Group: fs.remove.

local function removes_regular_file_test()
    setup_sandbox()
    local file = sandbox_path("to_remove.txt")
    write_file(file, "content")

    assert(fs.remove(file) == nil)
    assert(not file_exists(file))
    cleanup_sandbox()
end

local function removes_empty_directory_test()
    setup_sandbox()
    local dir = sandbox_path("empty_to_remove")
    fs.createdirectory(dir)

    assert(fs.remove(dir) == nil)
    assert(not file_exists(dir))
    cleanup_sandbox()
end

local function fails_to_remove_non_empty_directory_without_recursive_flag_test()
    setup_sandbox()
    local dir = sandbox_path("nonempty")
    fs.createdirectory(dir)
    write_file(fs.path.join(dir, "file.txt"), "content")

    local ok, _err = catch fs.remove(dir)
    assert(ok == false)
    assert(file_exists(dir), "Directory should still exist")
    cleanup_sandbox()
end

local function removes_directory_recursively_test()
    setup_sandbox()
    local dir = sandbox_path("recursive_remove")
    fs.createdirectory(dir)
    fs.createdirectory(fs.path.join(dir, "sub1"))
    fs.createdirectory(fs.path.join(dir, "sub2"))
    fs.createdirectory(fs.path.join(dir, "sub1", "subsub"))
    write_file(fs.path.join(dir, "file1.txt"), "1")
    write_file(fs.path.join(dir, "sub1", "file2.txt"), "2")
    write_file(fs.path.join(dir, "sub1", "subsub", "file3.txt"), "3")

    assert(fs.remove(dir, true) == nil)
    assert(not file_exists(dir), "Directory should be completely removed")
    cleanup_sandbox()
end

local function fails_on_non_existent_path_test()
    local ok, _err = catch fs.remove("this_does_not_exist_xyz")
    assert(ok == false)
end

local function removes_hidden_file_test()
    setup_sandbox()
    local file = sandbox_path(".hidden_file")
    write_file(file, "secret")

    fs.remove(file)
    assert(not file_exists(file))
    cleanup_sandbox()
end

local function recursive_remove_handles_deep_nesting_test()
    setup_sandbox()
    local base = sandbox_path("deep")
    local current = base

    -- Create deeply nested structure
    for i = 1, 10 do
        fs.createdirectory(current)
        write_file(fs.path.join(current, `file$i.txt`), tostring(i))
        current = fs.path.join(current, "level" .. i)
    end

    fs.createdirectory(current)

    fs.remove(base, true)
    assert(not file_exists(base))
    cleanup_sandbox()
end

-- ============================================================================
-- fs.createlink and fs.follow tests
-- ============================================================================

-- Group: fs.createlink.

local function creates_symbolic_link_to_file_test()
    setup_sandbox()
    local target = sandbox_path("link_target.txt")
    local link = sandbox_path("link.txt")

    write_file(target, "target content")

    local ok, err = catch fs.createlink(link, target)
    assert(ok, "Could not create symlink: " .. tostring(err))
    assert(file_exists(link))
    local _t, is_link = fs.type(link)
    assert(is_link == true)
    cleanup_sandbox()
end

local function creates_symbolic_link_to_directory_test()
    setup_sandbox()
    local target = sandbox_path("link_dir_target")
    local link = sandbox_path("link_dir")

    fs.createdirectory(target)
    write_file(fs.path.join(target, "inside.txt"), "inside")

    local ok, err = catch fs.createlink(link, target)
    assert(ok, "Could not create symlink: " .. tostring(err))
    local _t, is_link = fs.type(link)
    assert(is_link == true)
    cleanup_sandbox()
end

-- Group: fs.follow.

local function resolves_symbolic_link_test()
    setup_sandbox()
    local target = sandbox_path("follow_target.txt")
    local link = sandbox_path("follow_link.txt")

    write_file(target, "content")

    -- Use simple filename for symlink target (relative to symlink's directory)
    local ok, err = catch fs.createlink(link, "follow_target.txt")
    assert(ok, "Could not create symlink: " .. tostring(err))
    local resolved = fs.follow(link)
    assert(type(resolved) == "string")
    assert(resolved:find("follow_target"), "Resolved path should reference target")
    cleanup_sandbox()
end

local function errors_on_non_symlink_test()
    setup_sandbox()
    local file = sandbox_path("not_a_link.txt")
    write_file(file, "regular file")

    local ok, result = catch fs.follow(file)
    -- On POSIX, readlink on non-symlink should error
    -- On Windows, GetFinalPathNameByHandle works on any file, returning canonical path
    assert(ok == false or type(result) == "string")
    cleanup_sandbox()
end

local function errors_on_non_existent_path_2_test()
    local ok, _err = catch fs.follow("nonexistent_link_xyz")
    assert(ok == false)
end

-- ============================================================================
-- Edge cases and error handling
-- ============================================================================

-- Group: Edge cases.

local function handles_current_directory_path_test()
    setup_sandbox()
    local entries = fs.list(".")
    assert(type(entries) == "table")
    cleanup_sandbox()
end

local function handles_parent_directory_traversal_test()
    setup_sandbox()
    local sub = sandbox_path("subdir_traverse")
    fs.createdirectory(sub)

    local up = fs.path.join(sub, "..")
    local entries = fs.list(up)

    local found = false

    for i = 1, #entries do
        if entries[i] == "subdir_traverse" then
            found = true
        end
    end

    assert(found, "Should be able to list parent via ..")
    cleanup_sandbox()
end

local function handles_file_with_only_extension_test()
    setup_sandbox()
    local file = sandbox_path(".gitignore")
    write_file(file, "*.o\n")

    local name = fs.path.name(file)
    assert(name == ".gitignore")

    fs.remove(file)
    assert(not file_exists(file))
    cleanup_sandbox()
end

local function handles_path_with_special_characters_test()
    setup_sandbox()
    -- Test with safe special characters
    local file = sandbox_path("file-with_special.chars")
    write_file(file, "content")

    assert(fs.type(file) == "file")
    fs.remove(file)
    cleanup_sandbox()
end

local function handles_very_long_filename_test()
    setup_sandbox()
    -- Create a long but valid filename
    local long_name = string.rep("a", 100) .. ".txt"
    local file = sandbox_path(long_name)

    if ok = catch write_file(file, "content") then
        assert(fs.type(file) == "file")
        fs.remove(file)
    end

    cleanup_sandbox()
end

local function copy_doesn_t_affect_original_on_target_write_fail_test()
    setup_sandbox()
    local src = sandbox_path("src_safe.txt")
    local content = "precious content"
    write_file(src, content)

    -- Try to copy to invalid destination
    local _ok = catch fs.copy(src, sandbox_path("nonexistent_dir", "file.txt"))

    -- Source should be intact
    assert(read_file(src) == content)
    cleanup_sandbox()
end

local function operations_on_sandbox_don_t_affect_parent_test()
    setup_sandbox()
    local parent_file = "parent_test_marker_xyz.txt"

    -- Ensure parent file doesn't exist
    catch fs.remove(parent_file)

    -- Do operations in sandbox
    local test = sandbox_path("test.txt")
    write_file(test, "test")
    fs.remove(test)

    -- Parent directory should not have been affected
    local ok = catch fs.type(parent_file)
    assert(ok == false)
    cleanup_sandbox()
end

-- ============================================================================
-- Error message quality
-- ============================================================================

-- Group: Error messages.

local function list_error_includes_directory_name_test()
    local ok, err = catch fs.list("nonexistent_dir_error_test")
    assert(ok == false)
    assert(
        err:find("nonexistent_dir_error_test") or err:find("cannot") or err:find("directory"),
        "Error should be descriptive: " .. tostring(err)
    )
end

local function type_error_for_non_existent_path_test()
    local ok, err = catch fs.type("nonexistent_file_error_test")
    assert(ok == false)
    assert(type(err) == "string" and #err > 0)
end

local function copy_error_for_missing_source_test()
    setup_sandbox()
    local ok, err = catch fs.copy("missing_source_xyz", sandbox_path("dst"))
    assert(ok == false)
    assert(type(err) == "string")
    cleanup_sandbox()
end

-- ============================================================================
-- fs.list with relative paths  
-- ============================================================================

-- Group: Relative paths.

local function fs_list_with_relative_path_works_test()
    setup_sandbox()
    local dir = sandbox_path("reltest")
    fs.createdirectory(dir)
    write_file(fs.path.join(dir, "a.txt"), "a")

    local entries = fs.list(dir)
    assert(#entries == 1)
    cleanup_sandbox()
end

local function operations_work_with_in_path_test()
    setup_sandbox()
    local dir = sandbox_path("dotpath")
    fs.createdirectory(dir)

    local with_dot = fs.path.join(SANDBOX, ".", "dotpath")
    local t = fs.type(with_dot)
    assert(t == "directory")
    cleanup_sandbox()
end

-- ============================================================================
-- Cleanup at end of all tests
-- ============================================================================

local function final_cleanup_test()
    cleanup_sandbox()
    assert(not file_exists(SANDBOX), "Sandbox should be cleaned up")
end

-- ============================================================================
-- Durable writes: fs.move with replace, fs.sync, and file:sync
-- ============================================================================

local function move_with_replace_replaces_an_existing_file_test()
    setup_sandbox()
    local src = sandbox_path("new.txt")
    local dst = sandbox_path("current.txt")
    write_file(src, "new contents")
    write_file(dst, "old contents")
    assert(fs.move(src, dst, { replace = true }) == nil)
    assert(read_file(dst) == "new contents")
    assert(not file_exists(src))
    cleanup_sandbox()
end

local function move_with_replace_creates_a_missing_target_test()
    setup_sandbox()
    write_file(sandbox_path("a.txt"), "a")
    fs.move(sandbox_path("a.txt"), sandbox_path("b.txt"), { replace = true })
    assert(read_file(sandbox_path("b.txt")) == "a")
    cleanup_sandbox()
end

local function move_with_replace_keeps_a_directory_target_test()
    setup_sandbox()
    write_file(sandbox_path("f.txt"), "f")
    fs.createdirectory(sandbox_path("d"))
    write_file(sandbox_path("d", "inside.txt"), "x")

    raises(function()
        fs.move(sandbox_path("f.txt"), sandbox_path("d"), { replace = true })
    end, "cannot move")

    assert(read_file(sandbox_path("d", "inside.txt")) == "x")
    assert(read_file(sandbox_path("f.txt")) == "f")
    cleanup_sandbox()
end

local function move_with_replace_false_keeps_the_target_test()
    setup_sandbox()
    write_file(sandbox_path("s.txt"), "s")
    write_file(sandbox_path("t.txt"), "t")

    raises(function()
        fs.move(sandbox_path("s.txt"), sandbox_path("t.txt"), { replace = false })
    end, "target already exists")

    assert(read_file(sandbox_path("t.txt")) == "t")
    cleanup_sandbox()
end

local function move_checks_its_options_test()
    setup_sandbox()
    write_file(sandbox_path("s.txt"), "s")

    raises(function()
        fs.move(sandbox_path("s.txt"), sandbox_path("t.txt"), "replace")
    end, "bad argument #3 to 'move'")

    cleanup_sandbox()
end

local function sync_accepts_a_directory_and_a_file_test()
    setup_sandbox()
    write_file(sandbox_path("f.txt"), "f")
    assert(fs.sync(SANDBOX) == nil)
    assert(fs.sync(sandbox_path("f.txt")) == nil)

    raises(function()
        fs.sync(sandbox_path("missing"))
    end, "cannot sync '.*missing': path does not exist")

    cleanup_sandbox()
end

local function file_sync_returns_the_handle_test()
    setup_sandbox()
    local f = assert(io.open(sandbox_path("s.txt"), "w"))
    f:write("data")
    assert(f:sync() == f)
    f:close()

    raises(function()
        f:sync()
    end, "attempt to use a closed file")

    assert(io.stdout:sync() == io.stdout)
    assert(io.stderr:sync() == io.stderr)
    local r = assert(io.open(sandbox_path("s.txt"), "r"))
    assert(r:sync() == r)
    r:close()
    cleanup_sandbox()
end

local function the_replace_sequence_leaves_the_new_contents_test()
    setup_sandbox()
    local target = sandbox_path("config.json")
    write_file(target, "{}")
    local tmp = target .. ".tmp"
    local f = assert(io.open(tmp, "w"))
    f:write('{"version": 2}')
    f:sync()
    f:close()
    fs.move(tmp, target, { replace = true })
    fs.sync(fs.path.parent(target))
    assert(read_file(target) == '{"version": 2}')
    cleanup_sandbox()
end

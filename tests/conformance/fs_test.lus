-- fs.type tests
-- ============================================================================

-- Group: fs.type.

local function returns_file_for_regular_file_test()
    setup_sandbox()
    local file = sandbox_path("regular.txt")
    write_file(file, "content")
    local t, is_link = fs.type(file)
    assert(t == "file", "Expected 'file', got " .. tostring(t))
    assert(is_link == false)
    cleanup_sandbox()
end

local function returns_directory_for_directory_test()
    setup_sandbox()
    local dir = sandbox_path("subdir")
    fs.createdirectory(dir)
    local t, is_link = fs.type(dir)
    assert(t == "directory")
    assert(is_link == false)
    cleanup_sandbox()
end

local function errors_on_non_existent_path_test()
    local ok, err = catch fs.type("this_path_does_not_exist_12345")
    assert(ok == false)
    assert(type(err) == "string")
end

local function identifies_symlinks_test()
    setup_sandbox()
    local target = sandbox_path("link_target.txt")
    local link = sandbox_path("link.txt")
    write_file(target, "target content")

    local ok, err = catch fs.createlink(link, target)
    assert(ok, "Could not create symlink: " .. tostring(err))
    local _t, is_link = fs.type(link)
    assert(is_link == true)
    cleanup_sandbox()
end

local function handles_empty_filename_component_test()
    setup_sandbox()
    -- Path with trailing separator
    local dir = sandbox_path("test_trailing")
    fs.createdirectory(dir)
    local t = fs.type(dir .. SEP)
    assert(t == "directory")
    cleanup_sandbox()
end

-- ============================================================================
-- fs.list tests
-- ============================================================================

-- Group: fs.list.

local function lists_directory_contents_test()
    setup_sandbox()
    local dir = sandbox_path("listtest")
    fs.createdirectory(dir)
    write_file(fs.path.join(dir, "a.txt"), "a")
    write_file(fs.path.join(dir, "b.txt"), "b")
    write_file(fs.path.join(dir, "c.lua"), "c")

    local entries = fs.list(dir)
    assert(#entries == 3, "Expected 3 entries, got " .. #entries)
    cleanup_sandbox()
end

local function excludes_and_test()
    setup_sandbox()
    local entries = fs.list(SANDBOX)

    for i = 1, #entries do
        assert(entries[i] ~= ".")
        assert(entries[i] ~= "..")
    end

    cleanup_sandbox()
end

local function returns_empty_table_for_empty_directory_test()
    setup_sandbox()
    local dir = sandbox_path("empty")
    fs.createdirectory(dir)
    local entries = fs.list(dir)
    assert(#entries == 0)
    cleanup_sandbox()
end

local function errors_on_non_existent_directory_test()
    local ok, err = catch fs.list("nonexistent_dir_xyz")
    assert(ok == false)
    assert(type(err) == "string")
end

local function errors_when_path_is_a_file_test()
    setup_sandbox()
    local file = sandbox_path("not_a_dir.txt")
    write_file(file, "content")
    local ok, _err = catch fs.list(file)
    assert(ok == false)
    cleanup_sandbox()
end

local function supports_glob_pattern_test()
    setup_sandbox()
    local dir = sandbox_path("globtest")
    fs.createdirectory(dir)
    write_file(fs.path.join(dir, "file1.txt"), "1")
    write_file(fs.path.join(dir, "file2.txt"), "2")
    write_file(fs.path.join(dir, "file3.lua"), "3")
    write_file(fs.path.join(dir, "other.md"), "4")

    local txt_files = fs.list(dir, "*.txt")
    assert(#txt_files == 2, "Expected 2 .txt files, got " .. #txt_files)

    local lua_files = fs.list(dir, "*.lua")
    assert(#lua_files == 1)

    local no_match = fs.list(dir, "*.rs")
    assert(#no_match == 0)
    cleanup_sandbox()
end

local function supports_glob_pattern_2_test()
    setup_sandbox()
    local dir = sandbox_path("globtest2")
    fs.createdirectory(dir)
    write_file(fs.path.join(dir, "a1.txt"), "")
    write_file(fs.path.join(dir, "a2.txt"), "")
    write_file(fs.path.join(dir, "ab.txt"), "")
    write_file(fs.path.join(dir, "a12.txt"), "")

    local matches = fs.list(dir, "a?.txt")
    assert(#matches == 3, "Expected 3 matches for a?.txt, got " .. #matches)
    cleanup_sandbox()
end

local function glob_matches_all_with_test()
    setup_sandbox()
    local dir = sandbox_path("globtest3")
    fs.createdirectory(dir)
    write_file(fs.path.join(dir, "file1.txt"), "")
    write_file(fs.path.join(dir, "file2.txt"), "")

    local all = fs.list(dir, "*")
    assert(#all == 2)
    cleanup_sandbox()
end

local function handles_directory_with_many_files_test()
    setup_sandbox()
    local dir = sandbox_path("manyfiles")
    fs.createdirectory(dir)

    for i = 1, 100 do
        write_file(fs.path.join(dir, `file$i.txt`), tostring(i))
    end

    local entries = fs.list(dir)
    assert(#entries == 100, "Expected 100 entries, got " .. #entries)
    cleanup_sandbox()
end

local function lists_hidden_files_dotfiles_test()
    setup_sandbox()
    local dir = sandbox_path("dotfiles")
    fs.createdirectory(dir)
    write_file(fs.path.join(dir, ".hidden"), "secret")
    write_file(fs.path.join(dir, "visible.txt"), "public")

    local entries = fs.list(dir)
    local found_hidden = false

    for i = 1, #entries do
        if entries[i] == ".hidden" then
            found_hidden = true
        end
    end

    assert(found_hidden, "Should list dotfiles")
    cleanup_sandbox()
end

-- ============================================================================
-- fs.copy tests
-- ============================================================================

-- Group: fs.copy.

local function copies_file_content_correctly_test()
    setup_sandbox()
    local src = sandbox_path("copy_src.txt")
    local dst = sandbox_path("copy_dst.txt")
    local content = "Hello, this is test content!\nLine 2\n"

    write_file(src, content)
    assert(fs.copy(src, dst) == nil)

    local copied = read_file(dst)
    assert(copied == content)
    cleanup_sandbox()
end

local function copies_binary_file_correctly_test()
    setup_sandbox()
    local src = sandbox_path("binary_src.bin")
    local dst = sandbox_path("binary_dst.bin")
    -- Binary content with null bytes and high bytes
    local content = vector.create(8)

    for i, byte in ipairs({ 0x00, 0x01, 0x02, 0xFF, 0xFE, 0xFD, 0x00, 0x00 }) do
        vector.set(content, i - 1, byte)
    end

    write_file(src, content)
    fs.copy(src, dst)

    local copied = read_bytes(dst)
    assert(hex(copied) == hex(content))
    cleanup_sandbox()
end

local function fails_when_source_does_not_exist_test()
    setup_sandbox()
    local ok, _err = catch fs.copy(sandbox_path("nonexistent"), sandbox_path("dst"))
    assert(ok == false)
    cleanup_sandbox()
end

local function fails_when_destination_already_exists_test()
    setup_sandbox()
    local src = sandbox_path("src.txt")
    local dst = sandbox_path("dst.txt")
    write_file(src, "source")
    write_file(dst, "destination")

    local ok, _err = catch fs.copy(src, dst)
    assert(ok == false)
    cleanup_sandbox()
end

local function preserves_source_file_after_copy_test()
    setup_sandbox()
    local src = sandbox_path("preserve_src.txt")
    local dst = sandbox_path("preserve_dst.txt")
    local content = "original content"

    write_file(src, content)
    fs.copy(src, dst)

    local original = read_file(src)
    assert(original == content)
    cleanup_sandbox()
end

local function handles_empty_file_test()
    setup_sandbox()
    local src = sandbox_path("empty_src.txt")
    local dst = sandbox_path("empty_dst.txt")

    write_file(src, "")
    fs.copy(src, dst)

    local copied = read_file(dst)
    assert(copied == "")
    cleanup_sandbox()
end

local function handles_large_file_test()
    setup_sandbox()
    local src = sandbox_path("large_src.bin")
    local dst = sandbox_path("large_dst.bin")

    -- Create ~100KB file
    local chunk = string.rep("X", 1024)

    if f = io.open(src, "wb") then
        for _i = 1, 100 do
            f:write(chunk)
        end

        f:close()
    end

    fs.copy(src, dst)

    local src_type = fs.type(src)
    local dst_type = fs.type(dst)
    assert(src_type == "file" and dst_type == "file")
    cleanup_sandbox()
end

local function fails_when_destination_parent_does_not_exist_test()
    setup_sandbox()
    local src = sandbox_path("src_noparent.txt")
    local dst = sandbox_path("nonexistent_dir", "dst.txt")
    write_file(src, "content")

    local ok, _err = catch fs.copy(src, dst)
    assert(ok == false)
    cleanup_sandbox()
end

local function handles_file_with_unicode_name_test()
    setup_sandbox()
    local src = sandbox_path("源文件.txt")
    local dst = sandbox_path("目标文件.txt")

    write_file(src, "unicode content")
    local ok = catch fs.copy(src, dst)

    if ok ~= false then
        assert(read_file(dst) == "unicode content")
    end

    cleanup_sandbox()
end

-- ============================================================================
-- fs.move tests
-- ============================================================================

-- Group: fs.move.

local function moves_file_to_new_location_test()
    setup_sandbox()
    local src = sandbox_path("move_src.txt")
    local dst = sandbox_path("move_dst.txt")
    local content = "content to move"

    write_file(src, content)
    assert(fs.move(src, dst) == nil)

    assert(file_exists(dst), "Destination should exist")
    assert(not file_exists(src), "Source should not exist")
    assert(read_file(dst) == content)
    cleanup_sandbox()
end

local function fails_when_source_does_not_exist_2_test()
    setup_sandbox()
    local ok, _err = catch fs.move(sandbox_path("nonexistent"), sandbox_path("dst"))
    assert(ok == false)
    cleanup_sandbox()
end

local function fails_when_destination_already_exists_2_test()
    setup_sandbox()
    local src = sandbox_path("move_src2.txt")
    local dst = sandbox_path("move_dst2.txt")
    write_file(src, "source")
    write_file(dst, "dest")

    local ok, _err = catch fs.move(src, dst)
    assert(ok == false)

    -- Source should still exist
    assert(file_exists(src), "Source should remain on failed move")
    cleanup_sandbox()
end

local function moves_directory_test()
    setup_sandbox()
    local src = sandbox_path("move_dir_src")
    local dst = sandbox_path("move_dir_dst")

    fs.createdirectory(src)
    write_file(fs.path.join(src, "file.txt"), "inside")

    fs.move(src, dst)

    assert(fs.type(dst) == "directory")
    assert(not file_exists(src))
    assert(read_file(fs.path.join(dst, "file.txt")) == "inside")
    cleanup_sandbox()
end

local function handles_rename_in_same_directory_test()
    setup_sandbox()
    local src = sandbox_path("old_name.txt")
    local dst = sandbox_path("new_name.txt")
    write_file(src, "content")

    fs.move(src, dst)

    assert(file_exists(dst))
    assert(not file_exists(src))
    cleanup_sandbox()
end


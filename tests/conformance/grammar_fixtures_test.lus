-- The fixtures of the TextMate grammar test are Lus programs, so each one
-- compiles. packages/vscode/test/grammar.test.cjs checks the scope of
-- their tokens.
pledge("fs:read", "load")

local fixtures = `$TEST_DIR/../../packages/textmate/test/fixtures`

local function the_syntax_fixture_compiles_test()
    local chunk, err = loadfile(`$fixtures/syntax.lus`)
    assert(chunk, err)
end

local function the_builtins_fixture_compiles_test()
    local chunk, err = loadfile(`$fixtures/builtins.lus`)
    assert(chunk, err)
end

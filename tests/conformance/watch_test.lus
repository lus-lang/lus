-- `fs.watch`: a coroutine that hands over changes to files
-- (spec/stdlib/fs/watch.md). A detached coroutine changes files while the
-- test resumes the watch. Some sandboxes refuse file notifications, and
-- WASI has none, so fs.watch is nil there. The tests skip in both cases.
pledge("fs", "env")

-- The directories of the tests take their names from a file that
-- os.tmpname created exclusively, so two runs at once never share one.
-- A system without a temporary directory, such as WASI, falls back to the
-- time, and its tests skip in setup.
local BASE = do
    local ok, name = catch os.tmpname()

    if ok then
        fs.remove(name)
        provide name .. "-watch"
    end

    provide fs.path.join(
        os.getenv("TMPDIR") or os.getenv("TEMP") or "/tmp",
        "lus-watch-test-" .. time.now():epoch()
    )
end

local ROOT
local count = 0

local function pause(seconds)
    coroutine.resume(coroutine.sleep(seconds))
end

local function write(path, text)
    local f = io.open(path, "w")
    f:write(text)
    f:close()
end

-- Every test watches a directory of its own, so that a late event of an
-- earlier test never reaches it.
local function setup()
    if fs.watch == nil then
        skip("fs.watch is nil on a system without file notifications")
    end

    count = count + 1
    ROOT = `$BASE-$count`
    fs.createdirectory(fs.path.join(ROOT, "sub"), true)
end

local function watching(options)
    local ok, w = catch fs.watch(ROOT, options)

    if not ok then
        if tostring(w):find("refused", 1, true) or tostring(w):find("unavailable", 1, true) then
            skip("file notifications unavailable")
        end

        error(w, 0)
    end

    return w
end

-- Resumes the watch `n` times and returns "kind name" for each event.
local function collect(w, n)
    local out = {}

    for i = 1, n do
        local ok, ev = coroutine.resume(w)
        assert(ok, ev)
        out[i] = `$(ev.kind) $(ev.path:sub(#ROOT + 2):gsub("\\", "/"))`
    end

    return table.concat(out, ", ")
end

local function in_background(f)
    return coroutine.detach(coroutine.create(function()
        pause(0.2)
        f()
    end))
end

-- Resumes the watch until an event other than a change of `name`
-- arrives, and returns it as "kind name".
local function past_changes(w, name)
    while true do
        local event = collect(w, 1)

        if event ~= "modify " .. name then
            return event
        end
    end
end

-- Each step waits for the watch to hand over the one before it. The steps
-- of one write may reach the program in more than one notification when
-- the machine is busy, so a step can bring more than one change, and only
-- the order of the kinds is fixed.
local function reports_creation_change_and_removal_test()
    setup()
    local w = watching()
    local a = fs.path.join(ROOT, "a.txt")
    write(a, "one")
    assert(collect(w, 1) == "create a.txt")
    write(a, "two")
    assert(collect(w, 1) == "modify a.txt")
    fs.remove(a)
    assert(past_changes(w, "a.txt") == "remove a.txt")
    coroutine.close(w)
    fs.remove(ROOT, true)
end

-- The merge of events in time is a unit test of the queue in watch.zig,
-- which sets the clock itself. Here the writes only have to arrive in
-- order, with the creation first.
local function quick_changes_of_one_path_start_with_the_creation_test()
    setup()
    local w = watching()
    local a = fs.path.join(ROOT, "a.txt")

    local actions = in_background(function()
        write(a, "one")
        write(a, "two")
        write(a, "three")
        write(fs.path.join(ROOT, "marker"), "")
    end)

    assert(collect(w, 1) == "create a.txt")
    assert(past_changes(w, "a.txt") == "create marker")
    coroutine.resume(actions)
    coroutine.close(w)
    fs.remove(ROOT, true)
end

local function recursive_watches_reach_subdirectories_test()
    setup()
    local w = watching({ recursive = true })

    local actions = in_background(function()
        write(fs.path.join(ROOT, "sub", "deep.txt"), "x")
    end)

    assert(collect(w, 1) == "create sub/deep.txt")
    coroutine.resume(actions)
    coroutine.close(w)
    fs.remove(ROOT, true)
end

local function a_plain_watch_stays_in_its_directory_test()
    setup()
    local w = watching()

    local actions = in_background(function()
        write(fs.path.join(ROOT, "sub", "deep.txt"), "x")
        pause(0.2)
        write(fs.path.join(ROOT, "top.txt"), "x")
    end)

    assert(collect(w, 1) == "create top.txt")
    coroutine.resume(actions)
    coroutine.close(w)
    fs.remove(ROOT, true)
end

local function the_glob_filters_events_test()
    setup()
    local w = watching({ glob = "*.lus", recursive = true })

    local actions = in_background(function()
        write(fs.path.join(ROOT, "skip.txt"), "x")
        write(fs.path.join(ROOT, "sub", "keep.lus"), "x")
    end)

    assert(collect(w, 1) == "create sub/keep.lus")
    coroutine.resume(actions)
    coroutine.close(w)
    fs.remove(ROOT, true)
end

local function a_file_can_be_watched_test()
    setup()
    local a = fs.path.join(ROOT, "a.txt")
    write(a, "one")
    local ok, w = catch fs.watch(a)

    if not ok then
        skip("file notifications unavailable")
    end

    local actions = in_background(function()
        write(fs.path.join(ROOT, "other.txt"), "x")
        pause(0.2)
        write(a, "two")
    end)

    assert(collect(w, 1) == "modify a.txt")
    coroutine.resume(actions)
    coroutine.close(w)
    fs.remove(ROOT, true)
end

local function a_closed_watch_cannot_be_resumed_test()
    setup()
    local w = watching()
    assert(coroutine.status(w) == "suspended")
    coroutine.close(w)
    assert(coroutine.status(w) == "dead")
    assert(not coroutine.resume(w))
    fs.remove(ROOT, true)
end

local function bad_arguments_raise_test()
    setup()
    assert(not catch fs.watch(ROOT .. "-missing"))
    assert(not catch fs.watch(ROOT, { recursive = "yes" }))
    assert(not catch fs.watch(ROOT, { glob = 1 }))
    fs.remove(ROOT, true)
end

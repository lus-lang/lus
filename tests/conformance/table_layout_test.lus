--[[
    Tables at the edges of their layouts.

    A table keeps small parts in its own cell, grows a large list by half
    of its length, moves integer keys between its hash part and its array
    part, and compares long string keys by content. Each test below puts a
    table at one of those edges and checks that every value stays where a
    lookup finds it.
]]

local function float_keys_outside_the_integers_stay_floats_test()
    local t = {}
    t[-1e19] = "low"
    t[1e19] = "high"
    t[-9.223372036854775808e18] = "min"
    t[2.0] = "two"
    assert(t[-1e19] == "low" and t[1e19] == "high")
    assert(t[math.mininteger] == "min" and t[2] == "two")
    assert(math.type(next({ [1e19] = true })) == "float")
end

local function appends_skip_integer_keys_in_the_hash_part_test()
    local t = { 1, 2, 3 }
    t[10] = "ten"
    t[5] = "five"
    t[5] = nil
    for i = 4, 12 do
        if t[i] == nil then t[i] = i end
    end
    assert(t[10] == "ten" and t[5] == 5 and #t == 12)
    local u = { 1, 2 }
    u[100] = "far"
    u[#u + 1] = 3
    assert(u[3] == 3 and u[100] == "far")
end

local function long_string_keys_compare_by_content_test()
    local t = {}
    local parts = {}
    for i = 1, 40 do parts[i] = string.char(96 + (i % 26) + 1) end
    local k1 = table.concat(parts)
    local k2 = table.concat(parts)
    t[k1] = "value"
    assert(t[k2] == "value")
    assert(t[k1 .. ""] == "value")
    t[k2 .. "x"] = "other"
    assert(t[k1 .. "x"] == "other" and t[k1] == "value")
end

local function large_lists_grow_by_half_with_holes_test()
    local n = (1 << 16) + 10
    local t = {}
    for i = 1, n do t[i] = i end
    t[n + 5] = "gap"
    assert(#t == n or #t == n + 5)
    assert(t[n + 5] == "gap" and t[n] == n)
    local u = {}
    for i = 1, n, 2 do u[i] = i end
    for i = 2, n, 2 do u[i] = i end
    assert(u[n] == n and u[1] == 1)
end

local function sizes_around_the_inline_limit_keep_their_values_test()
    for _, sizes in ipairs{ { 0, 0 }, { 10, 0 }, { 60, 0 }, { 63, 0 }, { 64, 0 }, { 600, 0 },
            { 0, 10 }, { 0, 31 }, { 0, 32 }, { 0, 600 }, { 20, 20 }, { 40, 40 }, { 600, 600 } } do
        local narr, nhash = sizes[1], sizes[2]
        local t = table.create(narr, nhash)
        for i = 1, narr do t[i] = i * 1.5 end
        for i = 1, nhash do t["k" .. i] = i end
        for i = 1, narr do assert(t[i] == i * 1.5) end
        for i = 1, nhash do assert(t["k" .. i] == i) end
        assert(#t == narr)
        local s = table.create(narr, nhash)
        for i = 1, narr do s[i] = "s" .. i end
        t[narr + 1] = {}
        assert(#s == narr and type(t[narr + 1]) == "table")
    end
end

local function borders_follow_their_hint_test()
    local t = {}
    for i = 1, 100 do t[i] = i end
    for i = 100, 51, -1 do t[i] = nil end
    assert(#t == 50)
    t[51] = 51
    assert(#t == 51)
    t[51] = nil
    t[50] = nil
    assert(#t == 49)
    t[50] = 50
    t[51] = 51
    assert(#t == 51)
end

-- An integer key beyond the indexes of an array part stays in the hash
-- part. Keys from 2^32 to 2^40 count toward an array part on 64-bit
-- targets and lie beyond every index of a 32-bit one, such as lus.wasm.
local function integer_keys_beyond_32_bits_stay_in_the_hash_part_test()
    local keys = { 1 << 32, (1 << 32) + 1, 10737418240, 1 << 40, (1 << 40) + 1, 1 << 62, math.maxinteger }
    local t = {}
    for i, k in ipairs(keys) do
        t[k] = i
    end
    t[2.0 ^ 33] = "float"
    for i, k in ipairs(keys) do
        assert(t[k] == i, k)
    end
    assert(t[1 << 33] == "float" and math.type(next({ [2.0 ^ 33] = true })) == "integer")
    local n = 0
    for _ in pairs(t) do n = n + 1 end
    assert(n == #keys + 1 and #t == 0)
    local list = { 1, 2, 3, [1 << 35] = "far" }
    list[4] = 4
    assert(#list == 4 and list[1 << 35] == "far")
end

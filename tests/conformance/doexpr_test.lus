--[[
    Do Expressions Test Suite
    Tests for do expressions feature
]]


pledge("load")


-- =============================================================================
-- Basic Usage Tests
-- =============================================================================

local function basic_do_expression_with_provide_test()
    local x = do
        provide 42
    end
    assert(x == 42, "x should be 42, got " .. tostring(x))
end

local function do_expression_with_local_variable_test()
    local x = do
        local y = 10
        provide y
    end
    assert(x == 10, "x should be 10, got " .. tostring(x))
end

local function do_expression_without_provide_returns_nil_test()
    local x = do
        local y = 10
    end
    assert(x == nil, "x should be nil, got " .. tostring(x))
end

local function empty_provide_returns_nil_test()
    local x = do
        provide
    end
    assert(x == nil, "x should be nil, got " .. tostring(x))
end

local function do_expression_in_arithmetic_test()
    local w = 5 + do provide 10 end
    assert(w == 15, "5 + do provide 10 end should be 15, got " .. tostring(w))
end

local function do_expression_in_string_concat_test()
    local s = "hello " .. do provide "world" end
    assert(s == "hello world", "string concat failed, got " .. tostring(s))
end

-- =============================================================================
-- Nesting Tests
-- =============================================================================

local function nested_do_expressions_2_levels_test()
    local nested = do
        provide do provide 42 end
    end
    assert(nested == 42, "nested should be 42, got " .. tostring(nested))
end

local function nested_do_expressions_3_levels_test()
    local deep = do
        local a = do
            local b = do
                provide 100
            end
            provide b + 1
        end
        provide a + 1
    end
    assert(deep == 102, "deep should be 102, got " .. tostring(deep))
end

local function nested_do_with_local_variables_test()
    local result = do
        local outer = 10
        local inner_result = do
            local inner = 5
            provide outer + inner
        end
        provide inner_result * 2
    end
    assert(result == 30, "result should be 30, got " .. tostring(result))
end

-- =============================================================================
-- Multiple Values Tests
-- =============================================================================

local function provide_multiple_values_test()
    local x, y = do
        provide 10, 20
    end
    assert(x == 10, "x should be 10, got " .. tostring(x))
    assert(y == 20, "y should be 20, got " .. tostring(y))
end

local function provide_three_values_test()
    local a, b, c = do
        provide 1, 2, 3
    end
    assert(a == 1, "a should be 1, got " .. tostring(a))
    assert(b == 2, "b should be 2, got " .. tostring(b))
    assert(c == 3, "c should be 3, got " .. tostring(c))
end

local function provide_fewer_values_than_expected_test()
    local x, y, z = do
        provide 10
    end
    assert(x == 10, "x should be 10, got " .. tostring(x))
    assert(y == nil, "y should be nil, got " .. tostring(y))
    assert(z == nil, "z should be nil, got " .. tostring(z))
end

local function discard_extra_values_test()
    local x = do
        provide 10, 20, 30
    end
    assert(x == 10, "x should be 10, got " .. tostring(x))
end

-- =============================================================================
-- Control Flow Tests
-- =============================================================================

local function provide_in_conditional_if_branch_test()
    local cond = do
        local n = 10
        if n > 5 then
            provide "big"
        else
            provide "small"
        end
    end
    assert(cond == "big", "cond should be 'big', got " .. tostring(cond))
end

local function provide_in_conditional_else_branch_test()
    local cond = do
        local n = 3
        if n > 5 then
            provide "big"
        else
            provide "small"
        end
    end
    assert(cond == "small", "cond should be 'small', got " .. tostring(cond))
end

local function provide_terminates_block_test()
    -- provide must be the last statement in its block, like return
    local bad, err = load("local x = do provide 42 local y = 1 end return x")
    assert(bad == nil)
    assert(err:find("'end' expected"))
    -- The same block compiles and yields the value once provide is last
    local good = load("local x = do provide 42 end return x")
    assert(good ~= nil)
    assert(good() == 42)
end

local function early_provide_in_loop_test()
    local result = do
        local i = 0
        while true do
            i = i + 1
            if i == 5 then
                provide i
            end
        end
    end
    assert(result == 5, "result should be 5, got " .. tostring(result))
end

-- =============================================================================
-- Scope Tests
-- =============================================================================

local function access_outer_variables_test()
    local outer = 50
    local result = do
        local inner = 5
        provide outer + inner
    end
    assert(result == 55, "result should be 55, got " .. tostring(result))
end

local function inner_variables_don_t_leak_test()
    -- The loaded chunk declares a global, so every undeclared name in it
    -- is a compile error. Reading the block local after the do expression
    -- must therefore fail to compile.
    local bad, err = load(
        "global assert local x = do local iv = 1 provide iv end return iv")
    assert(bad == nil)
    assert(err:find("not declared"))
    -- The same chunk compiles when it reads the do expression result instead
    local good = load(
        "global assert local x = do local iv = 1 provide iv end return x")
    assert(good ~= nil)
    assert(good() == 1)
end

local function shadowing_outer_variable_test()
    local x = 100
    local result = do
        local x = 200  -- shadows outer x
        provide x
    end
    assert(result == 200, "result should be 200, got " .. tostring(result))
    assert(x == 100, "outer x should still be 100, got " .. tostring(x))
end

-- =============================================================================
-- Edge Cases
-- =============================================================================

local function do_expression_as_function_argument_test()
    local function add(a, b)
        return a + b
    end
    local result = add(do provide 10 end, do provide 20 end)
    assert(result == 30, "result should be 30, got " .. tostring(result))
end

local function do_expression_in_table_constructor_test()
    local t = {
        a = do provide 1 end,
        b = do provide 2 end
    }
    assert(t.a == 1, "t.a should be 1, got " .. tostring(t.a))
    assert(t.b == 2, "t.b should be 2, got " .. tostring(t.b))
end

local function chained_do_expressions_test()
    local x = do provide 10 end + do provide 20 end + do provide 30 end
    assert(x == 60, "chained sum should be 60, got " .. tostring(x))
end

local function do_expression_with_function_definition_test()
    local fn = do
        local function inner()
            return 42
        end
        provide inner
    end
    assert(type(fn) == "function")
    assert(fn() == 42, "fn() should return 42, got " .. tostring(fn()))
end

local function do_expression_modifying_upvalue_test()
    local counter = 0
    local increment = do
        local function inc()
            counter = counter + 1
            return counter
        end
        provide inc
    end
    assert(increment() == 1)
    assert(increment() == 2)
    assert(counter == 2)
end

-- =============================================================================
-- Integration with catch
-- =============================================================================

local function catch_with_do_expression_success_test()
    local ok, val = catch do
        provide 10
    end
    assert(ok == true, "ok should be true, got " .. tostring(ok))
    assert(val == 10, "val should be 10, got " .. tostring(val))
end

local function do_expression_inside_catch_test()
    local ok, result = catch do
        local x = do
            provide 42
        end
        provide x * 2
    end
    assert(ok == true)
    assert(result == 84, "result should be 84, got " .. tostring(result))
end

-- =============================================================================
-- Finish
-- =============================================================================


-- a do expression initializes a const local, alone or after other values
local function do_expression_initializes_a_const_local_test()
    local x <const> = do provide 1 end
    local a, b <const> = 5, do local t = 2 provide t * 3 end
    assert(x == 1 and a == 5 and b == 6)
    local _, e = load("local y <const> = do provide 1 end y = 2")
    assert(e and e:find("attempt to assign to const variable 'y'", 1, true), e)
end

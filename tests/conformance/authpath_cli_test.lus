
pledge("load", "fs", "exec", "env")



local lus_bin = os.getenv("LUS_BIN") or (TEST_DIR .. "/../../runtime/zig-out/bin/lus")
local windows = package.config:sub(1, 1) == "\\"

local function shell_quote(value)
    if windows then
        assert(not value:find('"', 1, true), "Windows test path contains a quote")
        return '"' .. value .. '"'
    end
    return "'" .. value:gsub("'", "'\\''") .. "'"
end

local function command_for(reads, script)
    local args = {lus_bin, "-Pload"}
    for i = 1, #reads do
        args[#args + 1] = "-Pfs:read=" .. reads[i]
    end
    args[#args + 1] = script
    for i = 1, #args do
        args[i] = shell_quote(args[i])
    end
    return table.concat(args, " ")
end

local function command_with_init(init, command)
    local value = "@" .. init
    if windows then
        assert(not value:find('"', 1, true), "Windows init path contains a quote")
        return 'set "LUA_INIT_1_7=' .. value .. '"&&set "LUA_INIT=' ..
            value .. '"&&' .. command
    end
    return "LUA_INIT_1_7=" .. shell_quote(value) .. " LUA_INIT=" ..
        shell_quote(value) .. " " .. command
end

local function run(command)
    local pipe = assert(io.popen(command .. " 2>&1"))
    local output = assert(pipe:read("*a"))
    local status = pipe:close()
    return status == true or status == 0, output
end

local function write_file(path, contents)
    local file = assert(io.open(path, "wb"))
    assert(file:write(contents))
    assert(file:close())
end

-- Grants name paths that start with "./", so the fixtures live under the
-- temporary working directory of the test file.
local fixture_number = 0

local function fixture()
    fixture_number = fixture_number + 1
    local root = "./authpath" .. tostring(fixture_number)
    fs.createdirectory(root)
    return root
end

local function a_granted_entry_script_runs_test()
    local root = fixture()
    local allowed = fs.path.join(root, "allowed-entry.lus")
    write_file(allowed, "print('allowed-entry-ran')\n")
    local accepted, accepted_output = run(command_for({allowed}, allowed))
    assert(accepted, accepted_output)
    assert(accepted_output:find("allowed-entry-ran", 1, true), accepted_output)
    fs.remove(root, true)
end

local function sealed_entry_scripts_use_their_authorized_file_object_test()
    local root = fixture()
    local allowed = fs.path.join(root, "allowed-entry.lus")
    local outside = fs.path.join(root, "outside-entry.lus")
    write_file(allowed, "print('allowed-entry-ran')\n")
    write_file(outside, "print('outside-entry-ran')\n")

    local denied, denied_output = run(command_for({allowed}, outside))
    assert(not denied, "entry outside the read grant ran: " .. denied_output)
    assert(denied_output:find('permission "fs:read" denied', 1, true),
        denied_output)
    assert(not denied_output:find("outside-entry-ran", 1, true), denied_output)

    local accepted, accepted_output = run(command_for({allowed}, allowed))
    assert(accepted, accepted_output)
    assert(accepted_output:find("allowed-entry-ran", 1, true), accepted_output)
    fs.remove(root, true)
end

local function sealed_init_files_use_their_authorized_file_object_test()
    skip("2.0 has no init file environment variable, and the entry script read is not checked against the fs:read grant")
    local root = fixture()
    local entry = fs.path.join(root, "entry.lus")
    local allowed = fs.path.join(root, "allowed-init.lus")
    local outside = fs.path.join(root, "outside-init.lus")
    write_file(entry, "print('entry-ran')\n")
    write_file(allowed, "print('allowed-init-ran')\n")
    write_file(outside, "print('outside-init-ran')\n")

    local denied, denied_output = run(command_with_init(outside,
        command_for({entry}, entry)))
    assert(not denied, "init outside the read grant ran: " .. denied_output)
    assert(denied_output:find('permission "fs:read" denied', 1, true),
        denied_output)
    assert(not denied_output:find("outside-init-ran", 1, true), denied_output)
    assert(not denied_output:find("entry-ran", 1, true), denied_output)

    local accepted, accepted_output = run(command_with_init(allowed,
        command_for({entry, allowed}, entry)))
    assert(accepted, accepted_output)
    assert(accepted_output:find("allowed-init-ran", 1, true), accepted_output)
    assert(accepted_output:find("entry-ran", 1, true), accepted_output)
    fs.remove(root, true)
end


-- tostring honors primitive type metatables
local function tostring_honors_primitive_type_metatables_test()
    local old = debug.getmetatable(0)

    debug.setmetatable(0, {
        __tostring = function(n)
            return `number($n)`
        end,
    })

    local okf, rf = catch fast_tostring(7)
    local oks, rs = catch s.tostring(7)
    debug.setmetatable(0, old)
    assert(okf)
    assert(oks)
    assert(rf == rs)
    assert(rf == "number(7)")
end

-- tostring preserves primitive metamethod errors
local function tostring_preserves_primitive_metamethod_errors_test()
    local old = debug.getmetatable(false)
    debug.setmetatable(false, { __tostring = true })
    local okf, rf = catch fast_tostring(false)
    local oks, rs = catch s.tostring(false)
    debug.setmetatable(false, old)
    assert(okf == oks)
    assert(not okf)
    assert(err_core(rf) == err_core(rs))
end


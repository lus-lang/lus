--- These tests cover the deprecated functions themselves.
--- lus: allow(deprecated)

pledge("load", "debug")

-- Builtin parity suite, ported from h1/fastcall-parity.lus.
-- Every builtin must behave identically whether it is called directly through
-- a global name or through a table field alias. This file drives both call
-- positions over a shared corpus of adversarial inputs and asserts identical
-- results, identical result subtypes, and identical error reasons. The fastcall
-- layer no longer exists in 2.0, so the emission proofs are gone and the
-- parity checks stay as plain value checks.

-- Invalid UTF-8 cannot be a string in 2.0, so malformed byte sequences are
-- vectors here. Both call positions must agree on rejecting them
-- (spec/design/strings.md).
local function bytes(...)
    local n = select("#", ...)
    local v = vector.create(n)

    for i = 1, n do
        vector.set(v, i - 1, (select(i, ...)))
    end

    return v
end

local nan = 0 / 0
local inf = math.huge

-- Shared junk values so error messages are identical across the two calls.
local EMPTY_T = {}
local SHARED_T = {}
local VEC = vector.create(4)
local color = enum RED, GREEN, BLUE end

-- ==== Fast-form helpers ====
-- Each helper contains exactly one direct global call with the registered
-- fastcall argument count, so the call inside compiles to OP_FASTCALL.


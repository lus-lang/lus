-- getmetatable parity over values
local function getmetatable_parity_over_values_test()
    local mt = {}
    local plain = setmetatable({}, mt)
    local locked = setmetatable({}, { __metatable = "locked" })
    local falsy = setmetatable({}, { __metatable = false })
    local corpus = {
        { "no metatable", {} },
        { "with metatable", plain },
        { "protected string", locked },
        { "protected false", falsy },
        { "string", "x" },
        { "number", 5 },
        { "nil", nil },
        { "boolean", true },
    }
    parity_over(fast_getmetatable, s.getmetatable, 1, corpus, "getmetatable")
    assert(fast_getmetatable(plain) == mt)
    assert(fast_getmetatable("x") == s.getmetatable("x"))
end

-- setmetatable success behavior matches between paths
local function setmetatable_success_behavior_matches_between_paths_test()
    local mt = {}

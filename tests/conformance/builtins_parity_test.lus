local function math_tointeger_parity_over_the_numeric_corpus_test()
    -- The numeric-string case lives in a dedicated soft test below.
    local corpus = {
        { "int", 5 },
        { "float integral", 5.0 },
        { "float frac", 5.5 },
        { "neg zero", -0.0 },
        { "nan", nan },
        { "inf", inf },
        { "maxinteger", math.maxinteger },
        { "mininteger", math.mininteger },
        { "2^63 float", 2.0 ^ 63 },
        { "junk string", "x" },
        { "boolean", true },
        { "nil", nil },
        { "table", EMPTY_T },
    }
    parity_over(fast_tointeger, s.tointeger, 1, corpus, "tointeger")
end


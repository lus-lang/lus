-- rawset value behavior matches between paths
local function rawset_value_behavior_matches_between_paths_test()
    local t1 = {}
    local t2 = {}
    assert(fast_rawset(t1, "k", "v") == t1)
    assert(s.rawset(t2, "k", "v") == t2)
    fast_rawset(t1, 2.0, "two")
    s.rawset(t2, 2.0, "two")
    assert(t1[2] == "two")
    assert(t2[2] == "two")
    fast_rawset(t1, 1.5, "frac")
    s.rawset(t2, 1.5, "frac")
    assert(t1[1.5] == t2[1.5])
    fast_rawset(t1, "k", nil)
    s.rawset(t2, "k", nil)
    assert(t1.k == nil)
    assert(t2.k == nil)
end


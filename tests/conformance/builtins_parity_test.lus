-- ==== String parity ====
-- string parity.

local LONG_MIXED = string.rep(" Ab\0Yz\u{FF}\u{80}\u{C8} \t", 9)

local str_corpus = {
    { "empty", "" },
    { "single", "a" },
    { "spaces", "  hello  " },
    { "only ws", " \t\r\n " },
    { "vertical ws", "\v\f x \v\f" },
    { "embedded nul", "a\0b" },
    { "leading nul", "\0ab" },
    { "trailing nul", "ab\0" },
    { "high code points", "\u{80}\u{C8}\u{FF}" },
    { "utf8 text", "caf\195\169 \195\128\195\137" },
    { "long mixed", LONG_MIXED },
    { "ws around nul", " \0 " },
    { "number coercion", 42 },
    { "float coercion", 2.5 },
    { "boolean", true },
    { "table", EMPTY_T },
    { "nil", nil },
}


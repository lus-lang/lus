-- ==== Math binary parity ====
-- math binary parity.

-- math.max parity over safe pairs
local function math_max_parity_over_safe_pairs_test()
    -- NaN operands, mixed-subtype winners, and signed-zero ties are known
    -- divergences covered by the soft tests below.
    local corpus = {
        { "int pair", 1, 2 },
        { "int swapped", 9, -3 },
        { "equal ints", 4, 4 },
        { "extremes", math.mininteger, math.maxinteger },
        { "float pair", 1.5, 2.5 },
        { "float negatives", -1.5, -2.5 },
        { "equal floats", 3.5, 3.5 },
        { "inf pair", inf, -inf },
        { "float winner", 1, 2.5 },
        { "string arg", "8", 3 },
        { "boolean", true, 1 },
        { "nil second", 5, nil },
    }
    parity_over(fast_max, s.max, 2, corpus, "max")
end


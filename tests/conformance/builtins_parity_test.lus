-- trig function parity over the numeric corpus
local function trig_function_parity_over_the_numeric_corpus_test()
    local pairs_list = {
        { fast_sin, s.sin, "sin" },
        { fast_cos, s.cos, "cos" },
        { fast_tan, s.tan, "tan" },
        { fast_asin, s.asin, "asin" },
        { fast_acos, s.acos, "acos" },
        { fast_atan, s.atan, "atan" },
    }

    for _, p in ipairs(pairs_list) do
        parity_over(p[1], p[2], 1, unary_math, p[3])
    end
end


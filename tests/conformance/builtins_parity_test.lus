    assert(s.setmetatable(t2, mt) == t2)
    assert(getmetatable(t1) == mt)
    assert(getmetatable(t2) == mt)
    fast_setmetatable(t1, nil)
    s.setmetatable(t2, nil)
    assert(getmetatable(t1) == nil)
    assert(getmetatable(t2) == nil)
end


-- ==== Vector parity ====
-- vector parity.

-- vector.create and vector.size parity
local function vector_create_and_vector_size_parity_test()
    for _, n in ipairs({ 0, 1, 8, 100 }) do
        local vf = fast_vcreate(n)
        local vs = s.vcreate(n)
        assert(fast_vsize(vf) == n)
        assert(s.vsize(vs) == n)
        assert(fast_vsize(vs) == s.vsize(vf))
    end

    local corpus = {
        { "negative", -1 },
        { "float", 2.5 },
        { "junk", "x" },
        { "nil", nil },
        { "table", EMPTY_T },
    }
    parity_over(fast_vcreate, s.vcreate, 1, corpus, "vector.create")
    parity_over(
        fast_vsize,
        s.vsize,
        1,
        { { "non-vector", 42 }, { "table", EMPTY_T }, { "nil", nil } },
        "vector.size"
    )
end

-- vector.clone content parity
local function vector_clone_content_parity_test()
    local src = vector.create(4)
    vector.pack(src, 0, "BBBB", 1, 2, 3, 254)
    local cf = fast_vclone(src)
    local cs = s.vclone(src)
    assert(vector.size(cf) == 4)
    assert(vector.size(cs) == 4)
    local f1, f2, f3, f4 = vector.unpack(cf, 0, "BBBB")
    local s1, s2, s3, s4 = vector.unpack(cs, 0, "BBBB")
    assert(f1 == s1)
    assert(f2 == s2)
    assert(f3 == s3)
    assert(f4 == s4)
    assert(cf ~= src and cs ~= src)
    parity_over(
        fast_vclone,
        s.vclone,
        1,
        { { "non-vector", 42 }, { "string", "x" }, { "nil", nil } },
        "vector.clone"
    )
end

-- vector.resize parity and content preservation
local function vector_resize_parity_and_content_preservation_test()
    local v1 = vector.create(4)
    local v2 = vector.create(4)
    vector.pack(v1, 0, "BBBB", 9, 8, 7, 6)
    vector.pack(v2, 0, "BBBB", 9, 8, 7, 6)
    assert(fast_vresize(v1, 8) == s.vresize(v2, 8))
    assert(vector.size(v1) == 8)
    assert(vector.size(v2) == 8)
    local a1, a2, a3, a4, a5 = vector.unpack(v1, 0, "BBBBB")
    local b1, b2, b3, b4, b5 = vector.unpack(v2, 0, "BBBBB")
    assert(a1 == b1 and a2 == b2 and a3 == b3 and a4 == b4 and a5 == b5)
    fast_vresize(v1, 0)
    s.vresize(v2, 0)
    assert(vector.size(v1) == 0)
    assert(vector.size(v2) == 0)
    local corpus = {
        { "negative", VEC, -1 },
        { "float", VEC, 2.5 },
        { "junk size", VEC, "x" },
        { "non-vector", 42, 4 },
        { "nil size", VEC, nil },
    }
    parity_over(fast_vresize, s.vresize, 2, corpus, "vector.resize")
end

-- The sanitizer qualifier enables allocator_may_return_null so this exercises
-- the same catchable allocation error in normal and instrumented builds.
-- vector allocation failure delivers a string error value
local function vector_allocation_failure_delivers_a_string_error_value_test()
    local ok, err = catch vector.create(math.maxinteger)
    assert(not ok)
    assert(err == "not enough memory")
    local v = vector.create(2)
    local ok2, err2 = catch vector.resize(v, math.maxinteger)
    assert(not ok2)
    assert(err2 == "not enough memory")
end


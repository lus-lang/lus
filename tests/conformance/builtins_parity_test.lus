end

-- utf8.char parity over code points
local function utf8_char_parity_over_code_points_test()
    local corpus = {
        { "zero", 0 },
        { "ascii", 65 },
        { "edge 7F", 0x7F },
        { "edge 80", 0x80 },
        { "edge 7FF", 0x7FF },
        { "edge 800", 0x800 },
        { "edge FFFF", 0xFFFF },
        { "edge 10000", 0x10000 },
        { "max unicode", 0x10FFFF },
        { "surrogate", 0xD800 },
        { "beyond unicode", 0x110000 },
        { "max utf", 0x7FFFFFFF },
        { "one past max", 0x80000000 },
        { "negative", -1 },
        { "mininteger", math.mininteger },
        { "frac", 1.5 },
        { "junk", "x" },
        { "nil", nil },
    }
    parity_over(fast_uchar, s.uchar, 1, corpus, "utf8.char")
end

-- utf8.offset parity over positions
local function utf8_offset_parity_over_positions_test()
    local subject = "h\195\169llo"
    local corpus = {
        { "first", subject, 1 },
        { "second", subject, 2 },
        { "last", subject, 5 },
        { "one past", subject, 6 },
        { "way past", subject, 9 },
        { "zero", subject, 0 },
        { "neg one", subject, -1 },
        { "neg all", subject, -5 },
        { "neg past", subject, -6 },
        { "empty first", "", 1 },
        { "empty neg", "", -1 },
        { "junk subject", true, 1 },
        { "nil n", subject, nil },
    }
    parity_over(fast_uoffset, s.uoffset, 2, corpus, "utf8.offset")
end

-- ==== Regression pins for once-divergent cases ====
-- regression pins for once-divergent cases.

-- math.max NaN operands agree between paths
local function math_max_nan_operands_agree_between_paths_test()
    run_pair(fast_max, s.max, 2, { "nan first", nan, 1 }, "max")
    run_pair(fast_max, s.max, 2, { "nan second", 1, nan }, "max")
end

-- math.min NaN operands agree between paths
local function math_min_nan_operands_agree_between_paths_test()
    run_pair(fast_min, s.min, 2, { "nan first", nan, 1 }, "min")
    run_pair(fast_min, s.min, 2, { "nan second", 1, nan }, "min")
end

-- math.max and math.min preserve subtype and tie choice
local function math_max_and_math_min_preserve_subtype_and_tie_choice_test()
    run_pair(fast_max, s.max, 2, { "int winner", 3, 2.5 }, "max")
    run_pair(fast_min, s.min, 2, { "int winner", 2, 3.5 }, "min")
    run_pair(fast_max, s.max, 2, { "mixed tie", 2, 2.0 }, "max")
    run_pair(fast_max, s.max, 2, { "signed zero tie", -0.0, 0.0 }, "max")
end

-- string.byte start-position clamping agrees between paths
local function string_byte_start_position_clamping_agrees_between_paths_test()
    run_pair(fast_byte, s.byte, 2, { "zero index", "hello", 0 }, "byte")
    run_pair(fast_byte, s.byte, 2, { "mininteger index", "hello", math.mininteger }, "byte")
    run_pair(fast_byte, s.byte, 2, { "below -len", "hello", -100 }, "byte")
end

-- table stats treat numeric strings identically on both paths
local function table_stats_treat_numeric_strings_identically_on_both_paths_test()
    local data = { 1, "10", 2 }
    run_pair(fast_sum, s.sum, 1, { "numeric strings", data }, "sum")
    run_pair(fast_mean, s.mean, 1, { "numeric strings", data }, "mean")
    run_pair(fast_median, s.median, 1, { "numeric strings", data }, "median")
    run_pair(fast_stdev, s.stdev, 1, { "numeric strings", data }, "stdev")
end

-- table.sum reads metamethod-backed tables identically on both paths
local function table_sum_reads_metamethod_backed_tables_identically_on_both_paths_test()
    local backing = { 10, 20, 30 }

    local proxy = setmetatable({}, {
        __index = function(_, k)
            return backing[k]
        end,
        __len = function()
            return 3
        end,
    })

    run_pair(fast_sum, s.sum, 1, { "proxy table", proxy }, "sum")
end

-- math.tointeger numeric string agrees between paths
local function math_tointeger_numeric_string_agrees_between_paths_test()
    run_pair(fast_tointeger, s.tointeger, 1, { "numeric string", "10" }, "tointeger")
end

-- fastcall sites preserve multi-return value counts
local function fastcall_sites_preserve_multi_return_value_counts_test()
    local subject = "h\195\169llo"
    local fast_n = select("#", fast_uoffset(subject, -1))
    local slow_n = select("#", slow_uoffset_wrap(subject, -1))
    assert(fast_n == slow_n)
    local fast_len_n = select("#", catch fast_ulen(bytes(0x61, 0x62, 0x80)))
    local slow_len_n = select("#", catch slow_ulen_wrap(bytes(0x61, 0x62, 0x80)))
    assert(fast_len_n == slow_len_n)
end

-- catch pads missing results with nil
local function catch_pads_missing_results_with_nil_test()
    local ok, r = catch (function()
        return
    end)()

    assert(ok)
    assert(type(r) == "nil")
end

-- ==== Time scalar constructor parity ====
-- time scalar constructor parity.

-- Durations and instants are userdata, so first-result identity cannot be
-- compared structurally. Value parity goes through __eq here and through the
-- accessor methods below. The corpus routes coercions (integral floats and
-- numeric strings), errors, and overflow boundaries through both dispatch
-- paths, which must agree everywhere.
local dur_corpus = {
    { "zero", 0 },
    { "one", 1 },
    { "neg one", -1 },
    { "typical", 37 },
    { "maxinteger", math.maxinteger },
    { "mininteger", math.mininteger },
    { "integral float", 2.0 },
    { "fractional float", 2.5 },
    { "numeric string", "5" },
    { "junk string", "x" },
    { "nil", nil },
    { "false", false },
    { "table", EMPTY_T },
}

-- Appends values around each seconds multiplication boundary. The checked
-- intrinsic accepts representable results and routes range errors through the
-- C implementation.
local function with_boundaries(unit)
    local corpus = {}

    for _, case in ipairs(dur_corpus) do
        corpus[#corpus + 1] = case
    end

    local hi = math.maxinteger // unit
    local lo = math.mininteger // unit
    corpus[#corpus + 1] = { "pos boundary", hi }
    corpus[#corpus + 1] = { "pos boundary + 1", hi + 1 }
    corpus[#corpus + 1] = { "neg boundary", lo }
    corpus[#corpus + 1] = { "neg boundary + 1", lo + 1 }
    return corpus
end

-- time.days agrees across dispatch paths
local function time_days_agrees_across_dispatch_paths_test()
    parity_over(fast_tdays, s.tdays, 1, with_boundaries(86400), "time.days")
end

-- time.hours agrees across dispatch paths
local function time_hours_agrees_across_dispatch_paths_test()
    parity_over(fast_thours, s.thours, 1, with_boundaries(3600), "time.hours")
end

-- time.minutes agrees across dispatch paths
local function time_minutes_agrees_across_dispatch_paths_test()
    parity_over(fast_tminutes, s.tminutes, 1, with_boundaries(60), "time.minutes")
end

-- time.seconds agrees across dispatch paths
local function time_seconds_agrees_across_dispatch_paths_test()
    parity_over(fast_tseconds, s.tseconds, 1, dur_corpus, "time.seconds")
end

-- time.millis agrees across dispatch paths
local function time_millis_agrees_across_dispatch_paths_test()
    parity_over(fast_tmillis, s.tmillis, 1, dur_corpus, "time.millis")
end

-- time.instant agrees across dispatch paths
local function time_instant_agrees_across_dispatch_paths_test()
    parity_over(fast_tinstant, s.tinstant, 1, dur_corpus, "time.instant")
end

-- time scalar constructors return exactly one value
local function time_scalar_constructors_return_exactly_one_value_test()
    local cases = {
        { "days", fast_tdays, s.tdays },
        { "hours", fast_thours, s.thours },
        { "minutes", fast_tminutes, s.tminutes },
        { "seconds", fast_tseconds, s.tseconds },
        { "millis", fast_tmillis, s.tmillis },
        { "instant", fast_tinstant, s.tinstant },
    }

    for _, case in ipairs(cases) do
        assert(select("#", case[2](1)) == 1)
        assert(select("#", case[3](1)) == 1)
    end
end

-- getmetatable over time userdata honors the protection marker
local function getmetatable_over_time_userdata_honors_the_protection_marker_test()
    -- Time metatables set __metatable = false, so both dispatch paths must
    -- return the protection marker, not the metatable and not nil.
    local d = s.tseconds(1)
    assert(fast_getmetatable(d) == false)
    assert(s.getmetatable(d) == false)
end

-- duration accessors and tostring agree across dispatch paths
local function duration_accessors_and_tostring_agree_across_dispatch_paths_test()
    for _, n in ipairs({ 0, 1, -1, 999, -999, 86399, -86401, 123456789 }) do
        local f = fast_tmillis(n)
        local g = s.tmillis(n)
        assert(f == g)
        assert(f:seconds() == g:seconds())
        assert(f:millis() == g:millis())
        assert(tostring(f) == tostring(g))
        local fd = fast_tdays(n)
        local gd = s.tdays(n)
        assert(fd == gd)
        assert(tostring(fd) == tostring(gd))
    end
end

-- instants built fast interoperate with the two argument C form
local function instants_built_fast_interoperate_with_the_two_argument_c_form_test()
    for _, n in ipairs({ 0, 1, -1, 1000000000, -1000000000 }) do
        local f = fast_tinstant(n)
        local g = time.instant(n, 0)
        assert(f == g)
        assert(f:epoch() == g:epoch())
        assert(tostring(f) == tostring(g))
    end
end

-- fast durations compose with duration arithmetic
local function fast_durations_compose_with_duration_arithmetic_test()
    assert(fast_tdays(1) == fast_thours(24))
    assert(fast_thours(1) == fast_tminutes(60))
    assert(fast_tminutes(1) == fast_tseconds(60))
    assert(fast_tseconds(1) == fast_tmillis(1000))
    local sum = fast_tseconds(30) + fast_tseconds(30)
    assert(sum == fast_tminutes(1))
end

-- error-name pinning.

local function caught_name(fn)
    local ok, err = catch fn()

    if ok then
        return nil, nil, "call unexpectedly succeeded"
    end

    local argn, name = string.match(tostring(err), "bad argument #(%d+) to '([^']+)'")
    return name, tonumber(argn), tostring(err)
end

-- A failing module function reports its plain name in every call position.
-- These cases pin that for every module function with adversarial arguments.
-- direct-form fallback errors carry compiler-mode names
local direct_form_fallback_errors_carry_compiler_mode_names_cases = {
    {
        "math.sqrt",
        function()
            return math.sqrt("x")
        end,
        "math.sqrt",
        1,
        "number expected, got string",
    },
    {
        "math.fmod",
        function()
            return math.fmod(7, 0)
        end,
        "math.fmod",
        2,
        "zero",
    },
    {
        "math.ult",
        function()
            return math.ult(1.5, 2)
        end,
        "math.ult",
        1,
        "number has no integer representation",
    },
    {
        "string.len",
        function()
            return string.len(true)
        end,
        "string.len",
        1,
        "string expected, got boolean",
    },
    {
        "string.sub",
        function()
            return string.sub("a", true, 2)
        end,
        "string.sub",
        2,
        "number expected, got boolean",
    },
    {
        "string.byte",
        function()
            return string.byte(true, 1)
        end,
        "string.byte",
        1,
        "string expected, got boolean",
    },
    {
        "string.char",
        function()
            return string.char(0x110000)
        end,
        "string.char",
        1,
        "value out of range",
    },
    {
        "string.split",
        function()
            return string.split(EMPTY_T, ",")
        end,
        "string.split",
        1,
        "string expected, got table",
    },
    {
        "string.join",
        function()
            return string.join("x", ",")
        end,
        "string.join",
        1,
        "table expected, got string",
    },
    {
        "table.sum",
        function()
            return table.sum("x")
        end,
        "table.sum",
        1,
        "table expected, got string",
    },
    {
        "table.transpose",
        function()
            return table.transpose(5)
        end,
        "table.transpose",
        1,
        "table expected, got number",
    },
    {
        "table.reshape",
        function()
            return table.reshape(EMPTY_T, 0, 0)
        end,
        "table.reshape",
        2,
        "rows must be positive",
    },
    {
        "vector.create",
        function()
            return vector.create(-1)
        end,
        "vector.create",
        1,
        "capacity must be non",
    },
    {
        "vector.resize",
        function()
            return vector.resize(VEC, -1)
        end,
        "vector.resize",
        2,
        "size must be non",
    },
    {
        "utf8.char",
        function()
            return utf8.char(-1)
        end,
        "utf8.char",
        1,
        "value out of range",
    },
    {
        "utf8.codepoint",
        function()
            return utf8.codepoint("")
        end,
        "utf8.codepoint",
        3,
        "out of bounds",
    },
    {
        "utf8.offset",
        function()
            return utf8.offset(true, 1)
        end,
        "utf8.offset",
        1,
        "string expected, got boolean",
    },
    {
        "time.seconds",
        function()
            return time.seconds("x")
        end,
        "time.seconds",
        1,
        "number expected, got string",
    },
    {
        "time.millis",
        function()
            return time.millis(2.5)
        end,
        "time.millis",
        1,
        "number has no integer representation",
    },
    {
        "time.instant",
        function()
            return time.instant(false)
        end,
        "time.instant",
        1,
        "number expected, got boolean",
    },
}

local function direct_form_fallback_errors_carry_compiler_mode_names_test(
    _label,
    fn,
    want_name,
    want_argn,
    want_reason
)
    local name, argn, full = caught_name(fn)
    assert(name == want_name)
    assert(argn == want_argn)
    assert(string.find(tostring(full), want_reason))
end

-- Base-library fastcalls resolve to their plain global name because the
-- global table lookup strips the _G prefix.
-- base-library fallback errors carry plain names
local base_library_fallback_errors_carry_plain_names_cases = {
    {
        "setmetatable",
        function()
            return setmetatable(EMPTY_T, "x")
        end,
        "setmetatable",
        2,
    },
    {
        "rawlen",
        function()
            return rawlen(true)
        end,
        "rawlen",
        1,
    },
    {
        "rawget",
        function()
            return rawget(5, 1)
        end,
        "rawget",
        1,
    },
    {
        "rawset",
        function()
            return rawset(5, 1, 1)
        end,
        "rawset",
        1,
    },
}

local function base_library_fallback_errors_carry_plain_names_test(_label, fn, want_name, want_argn)
    local name, argn, _full = caught_name(fn)
    assert(name == want_name)
    assert(argn == want_argn)
end

-- A call whose argument count does not match the old fastcall arity reports
-- the same qualified name, because 2.0 derives the name from the definition.
-- arity variations report the qualified name
local arity_variations_report_the_qualified_name_cases = {
    {
        "sub with two args",
        function()
            return string.sub("a", true)
        end,
        "string.sub",
        2,
    },
    {
        "byte with one arg",
        function()
            return string.byte(true)
        end,
        "string.byte",
        1,
    },
    {
        "log with two args",
        function()
            return math.log(true, 10)
        end,
        "math.log",
        1,
    },
    {
        "instant with two args",
        function()
            return time.instant(5, "x")
        end,
        "time.instant",
        2,
    },
}

local function arity_variations_report_the_qualified_name_test(_label, fn, want_name, want_argn)
    local name, argn, _full = caught_name(fn)
    assert(name == want_name)
    assert(argn == want_argn)
end

-- alias calls report the definition name (2.0 names a builtin from its
-- definition, not from the variable at the call site)
local function alias_calls_report_the_definition_name_test()
    local mysqrt = math.sqrt
    local ok, err = catch mysqrt("x")
    assert(not ok)
    assert(string.find(tostring(err), "bad argument #1 to 'math.sqrt'", 1, true))
end

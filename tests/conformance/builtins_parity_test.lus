-- string.split parity over subjects and delimiters
local function string_split_parity_over_subjects_and_delimiters_test()
    local corpus = {
        { "basic", "a,b,c", "," },
        { "leading delim", ",a", "," },
        { "trailing delim", "a,", "," },
        { "only delim", ",", "," },
        { "empty subject", "", "," },
        { "empty delim", "abc", "" },
        { "both empty", "", "" },
        { "multichar", "a::b::c", "::" },
        { "overlapping", "aaa", "aa" },
        { "nul delim", "a\0b\0c", "\0" },
        { "nul in subject", "a\0b", "," },
        { "delim longer", "x", "xyz" },
        { "delim equals subject", "ab", "ab" },
        { "long subject", LONG_MIXED, "\0" },
        { "table subject", EMPTY_T, "," },
        { "table delim", "a", EMPTY_T },
    }
    parity_over(fast_split, s.split, 2, corpus, "split")
end

-- string.join parity over element lists
local function string_join_parity_over_element_lists_test()
    local corpus = {
        { "empty list", {}, "," },
        { "single", { "a" }, "-" },
        { "basic", { "a", "b", "c" }, "," },
        { "empty sep", { "a", "b" }, "" },
        { "nul sep", { "a", "b" }, "\0" },
        { "nul elements", { "a\0", "\0b" }, "," },
        { "long elements", { LONG_MIXED, LONG_MIXED }, " | " },
        { "numbers", { 1, 2.5, -3 }, "," },
        { "booleans", { true, false }, "," },
        { "nil hole", { 1, nil, 3 }, "," },
        { "string subject", "x", "," },
        { "table sep", {}, EMPTY_T },
    }
    parity_over(fast_join, s.join, 2, corpus, "join")
end

-- string.join honors table length and indexing metamethods
local function string_join_honors_table_length_and_indexing_metamethods_test()
    local computed = setmetatable({}, {
        __len = function()
            return 2
        end,
        __index = function(_, i)
            return `item$i`
        end,
    })

    run_pair(fast_join, s.join, 2, { "computed", computed, "," }, "join")

    local hole = { "a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p" }
    hole[2] = nil

    setmetatable(hole, {
        __index = function(_, i)
            if i == 2 then
                return "b"
            end
        end,
    })

    run_pair(fast_join, s.join, 2, { "indexed hole", hole, "," }, "join")
end

-- string.join honors element tostring metamethods
local function string_join_honors_element_tostring_metamethods_test()
    local old = debug.getmetatable("")

    debug.setmetatable("", {
        __index = string,
        __tostring = function(v)
            return `<$v>`
        end,
    })

    local okf, rf = catch fast_join({ "a", "b" }, ",")
    local oks, rs = catch s.join({ "a", "b" }, ",")
    debug.setmetatable("", old)
    assert(okf)
    assert(oks)
    assert(rf == rs)
    assert(rf == "<a>,<b>")
end

-- method-call syntax matches the fast-form results
local function method_call_syntax_matches_the_fast_form_results_test()
    local str = "Hello"
    assert(str:sub(2, 4) == fast_sub(str, 2, 4))
    assert(str:len() == fast_len(str))
    assert(str:byte(2) == fast_byte(str, 2))
    assert(str:upper() == fast_upper(str))
    assert(str:reverse() == fast_reverse(str))
end


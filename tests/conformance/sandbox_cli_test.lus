--[[
    `lus --sandbox` seals the permissions after the grants of -P, before
    any code runs, so a pledge of the program is refused and only the
    command line grants hold.
]]

pledge("exec", "env=LUS_EXE", "fs:read", "fs:write")

local LUS = os.getenv("LUS_EXE")

local function run(args, script)
    local f = assert(io.open("script.lus", "w"))
    f:write(script)
    f:close()
    local p = io.popen(`"$LUS" $args script.lus 2>&1`)
    local out = p:read("a")
    local ok = p:close()
    return (ok == true or ok == 0), out
end

local function a_sandboxed_pledge_is_refused_test()
    if LUS == nil then skip("the interpreter is not reachable, set LUS_EXE") end
    local ok, out = run("--sandbox", 'print(pledge("fs:read"))\nprint(catch io.open("script.lus"))\n')
    assert(ok, out)
    assert(out:find("^false\n"), out)
    assert(out:find("denied", 1, true), out)
end

local function the_program_runs_without_the_flag_test()
    if LUS == nil then skip("the interpreter is not reachable, set LUS_EXE") end
    local ok, out = run("", 'pledge("fs:read")\nprint(io.open("script.lus") ~= nil)\n')
    assert(ok and out == "true\n", out)
end

local function command_line_grants_survive_the_seal_test()
    if LUS == nil then skip("the interpreter is not reachable, set LUS_EXE") end
    local ok, out = run("--sandbox -P fs:read", 'print(io.open("script.lus") ~= nil)\nprint(pledge("exec"))\n')
    assert(ok, out)
    assert(out == "true\nfalse\n", out)
end

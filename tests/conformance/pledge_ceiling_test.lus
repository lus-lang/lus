-- A pledge without a value under a command line grant limited to values
-- (spec/design/pledge.md, "Host policy"). The grant of `-P` is the
-- ceiling of script pledges, so a script that pledges the whole of a
-- capability the command line granted for some values only gets false
-- while its permissions stay limited to those values. Each case runs a child
-- lus with the grant and prints what the script found.
pledge("exec", "env", "fs")

local lus_bin = os.getenv("LUS_BIN") or (`$TEST_DIR/../../runtime/zig-out/bin/lus`)

local function run(grant, code, more)
    local argv = { lus_bin, `-P$grant` }

    for _, g in ipairs(more or {}) do
        argv[#argv + 1] = `-P$g`
    end

    argv[#argv + 1] = "-e"
    argv[#argv + 1] = code
    local p = os.spawn(argv, { stdout = "pipe", stderr = "stdout" })
    local out = p.stdout:read("a")
    coroutine.resume(p.exit)
    return out
end

local function a_path_grant_is_not_widened_test()
    local out = run("fs:read=./scoped/**", [[
        print(pledge("fs:read"), pledge("fs"), (catch io.open("/etc/hosts")))
    ]])
    assert(out == "false\tfalse\tfalse\n", out)
end

local function a_part_under_a_scoped_base_is_not_widened_test()
    local out = run("fs=./scoped/**", [[
        print(pledge("fs:read"), (catch io.open("/etc/hosts")))
    ]])
    assert(out == "false\tfalse\n", out)
end

local function a_host_grant_is_not_widened_test()
    local out = run("network:http=example.invalid", [[
        print(pledge("network:http"), pledge("network"))
    ]])
    assert(out == "false\tfalse\n", out)
end

local function a_pattern_grant_is_not_widened_test()
    local out = run("env:read=LUS_SCOPED_*", [[
        print(pledge("env:read"), (catch os.getenv("PATH")))
    ]])
    assert(out == "false\tfalse\n", out)
end

local function a_program_grant_is_not_widened_test()
    local out = run("exec=lus-scoped-program", [[
        print(pledge("exec"), (catch os.execute("true")))
    ]])
    assert(out == "false\tfalse\n", out)
end

local function an_unscoped_grant_still_covers_an_unscoped_pledge_test()
    local out = run("fs:read", [[
        print(pledge("fs:read"))
    ]])
    assert(out == "true\n", out)
end

local function a_scoped_pledge_within_the_grant_succeeds_test()
    local out = run("fs:read=./scoped/**", [[
        print(pledge("fs:read=./scoped/a.txt"))
    ]])
    assert(out == "true\n", out)
end

-- A grant names a directory that does not exist yet, under the temporary
-- directory, which is reached through a symbolic link on macOS. The script
-- creates the directory and then writes and reads a file inside it.
local function a_grant_covers_a_directory_created_later_test()
    local base = os.tmpname()
    fs.remove(base)
    local dir = `$(base)_dir`
    local out = run(`fs=$dir`, `
        local dir = $(string.format("%q", dir))
        fs.createdirectory(dir)
        local f = io.open(dir .. "/a.txt", "w")
        f:write("inside")
        f:close()
        print(io.open(dir .. "/a.txt"):read("a"))
    `, { `fs=$dir/**` })

    if fs.type(dir) then
        fs.remove(dir, true)
    end

    assert(out == "inside\n", out)
end

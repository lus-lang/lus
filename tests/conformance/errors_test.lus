--[[
  Comprehensive Error Handling Tests for Lus
  Tests: error(), assert(), and catch expression
  
  Note: pcall and xpcall have been removed from Lus.
  All protected execution is done via the 'catch' expression.
]]

pledge("load")

-- The runner rewrites calls named assert into power asserts, so the tests of
-- the real assert builtin call it through this alias.
local raw_assert = assert

local function error_with_string_message_test()
    local ok, err = catch error("test error")
    assert(not ok)
    assert(err:find("test error"), "Error message should contain 'test error'")
end

local function error_with_number_message_test()
    local ok, err = catch error(42)
    assert(not ok)
    assert(err == 42)
end

local function error_with_table_message_test()
    local t = { code = 500, msg = "Internal error" }
    local ok, err = catch error(t)
    assert(not ok)
    assert(err == t)
end

local function error_with_level_0_test()
    local ok, err = catch error("custom error", 0)
    assert(not ok)
    assert(err:find("custom error"), "Error message should contain the original text")
end

local function assert_with_true_test()
    local result = assert(true)
    assert(result == true)
end

local function assert_with_truthy_value_test()
    local result = assert(42)
    assert(result == 42)
end

local function assert_with_string_test()
    local result = assert("hello")
    assert(result == "hello")
end

local function assert_with_false_raises_error_test()
    local ok, err = catch raw_assert(false)
    assert(not ok)
    assert(err:find("assertion failed"))
end

local function assert_with_nil_raises_error_test()
    local ok = catch raw_assert(nil)
    assert(not ok)
end

local function assert_with_custom_message_test()
    local ok, err = catch raw_assert(false, "custom failure message")
    assert(not ok)
    assert(err:find("custom failure message"))
end

local function assert_preserves_multiple_return_values_test()
    local a, b, c = assert(1, 2, 3)
    assert(a == 1 and b == 2 and c == 3)
end

local function catch_with_successful_expression_test()
    local ok, result = catch 1 + 2
    assert(ok == true)
    assert(result == 3)
end

local function catch_with_failing_expression_nil_arithmetic_test()
    local ok, err = catch 1 + nil
    assert(ok == false)
    assert(type(err) == "string")
    assert(err:find("nil"))
end

local function catch_with_successful_function_call_test()
    local function add(a, b)
        return a + b
    end

    local ok, result = catch add(10, 20)
    assert(ok == true)
    assert(result == 30)
end

local function catch_with_failing_function_call_test()
    local function fail()
        error("function failed")
    end

    local ok, err = catch fail()
    assert(ok == false)
    assert(err:find("function failed"))
end

local function catch_with_error_directly_test()
    -- Default level 1 must prefix the message with the position of the
    -- error() call itself. The two calls sit four lines apart, so the
    -- extracted line numbers must differ by exactly four.
    local function fail_a()
        error("direct error A")
    end

    local function fail_b()
        error("direct error B")
    end

    local ok_a, err_a = catch fail_a()
    local ok_b, err_b = catch fail_b()
    assert(ok_a == false and ok_b == false)
    local line_a = tonumber(err_a:match("errors_test%.lus:(%d+): direct error A"))
    local line_b = tonumber(err_b:match("errors_test%.lus:(%d+): direct error B"))
    assert(line_a, "message must carry a 'file:line:' prefix for the error() call")
    assert(line_b == line_a + 4)
end

local function catch_with_nested_function_error_test()
    local function inner()
        error("from inner")
    end

    local function outer()
        inner()
    end

    local ok, err = catch outer()
    assert(ok == false)
    assert(err:find("from inner"))
end

local function catch_with_multi_return_function_test()
    local function multi()
        return 1, 2, 3
    end

    local ok, a, b, c = catch multi()
    assert(ok == true)
    assert(a == 1 and b == 2 and c == 3)
end

local function catch_with_fewer_returns_than_expected_nil_fill_test()
    local function two()
        return 10, 20
    end

    local ok, a, b, c, d = catch two()
    assert(ok == true)
    assert(a == 10 and b == 20)
    assert(c == nil and d == nil)
end

local function catch_error_with_nil_fill_for_extra_vars_test()
    local function fails()
        error("oops")
    end

    local x, y, z = catch fails()
    assert(x == false)
    assert(type(y) == "string")
    assert(z == nil)
end

local function catch_returned_from_function_preserves_all_values_test()
    local function multi()
        return "a", "b", "c"
    end

    local function wrapper()
        return catch multi()
    end

    local ok, v1, v2, v3 = wrapper()
    assert(ok == true)
    assert(v1 == "a" and v2 == "b" and v3 == "c")
end

local function catch_in_table_constructor_test()
    local function multi()
        return 1, 2, 3
    end

    local t = { catch multi() }
    assert(t[1] == true)
    assert(t[2] == 1 and t[3] == 2 and t[4] == 3)
end

local function catch_with_vararg_function_test()
    local function varfn(...)
        return ...
    end

    local ok, a, b, c = catch varfn(100, 200, 300)
    assert(ok == true)
    assert(a == 100 and b == 200 and c == 300)
end

local function catch_in_local_assignment_test()
    local status, value = catch (100 / 2)
    assert(status == true)
    assert(value == 50)
end

local function catch_in_global_assignment_test()
    _G.test_status, _G.test_value = catch error("global test")
    assert(_G.test_status == false)
    assert(type(_G.test_value) == "string")
    _G.test_status, _G.test_value = nil, nil
end

local function catch_as_function_argument_test()
    local function receive(a, b)
        return a, b
    end

    local x, y = receive(catch (42))
    assert(x == true)
    assert(y == 42)
end

local function catch_in_print_success_test()
    local old_print = print
    local captured = {}

    print = function(...)
        captured = { ... }
    end

    print(catch (999))
    print = old_print
    assert(captured[1] == true)
    assert(captured[2] == 999)
end

local function catch_with_method_call_success_test()
    local obj = {
        value = 21,
        double = function(self)
            return self.value * 2
        end,
    }

    local ok, result = catch obj:double()
    assert(ok == true and result == 42)
end

local function catch_with_method_call_error_test()
    local obj = {
        fail = function(self)
            error("method error")
        end,
    }

    local ok, err = catch obj:fail()
    assert(ok == false)
    assert(err:find("method error"))
end

local function catch_in_loop_test()
    local errors = 0

    for i = 1, 5 do
        local ok = catch error("loop " .. i)

        if not ok then
            errors = errors + 1
        end
    end

    assert(errors == 5)
end

local function catch_with_nil_indexing_test()
    local t = nil
    local ok, err = catch t.field
    assert(ok == false)
    assert(err:find("nil"))
end

local function catch_does_not_affect_outer_scope_on_error_test()
    local x = 100
    local ok = catch error("test")
    assert(ok == false)
    assert(x == 100)
end

local function pcall_is_not_defined_test()
    assert(pcall == nil)
end

local function xpcall_is_not_defined_test()
    assert(xpcall == nil)
end

local function catch_with_very_deep_call_stack_test()
    local function recurse(n)
        if n <= 0 then
            return n
        end

        return recurse(n - 1)
    end

    local ok, result = catch recurse(100)
    assert(ok == true)
    assert(result == 0)
end

local function catch_with_error_in_deeply_nested_call_test()
    local function recurse(n)
        if n <= 0 then
            error("bottom")
        end

        return recurse(n - 1)
    end

    local ok, err = catch recurse(50)
    assert(ok == false)
    assert(err:find("bottom"))
end

local function catch_multiple_times_in_sequence_test()
    for i = 1, 100 do
        local ok = catch error("seq " .. i)
        assert(ok == false)
    end
end

local function catch_handles_table_errors_test()
    local err_obj = { code = 404, message = "not found" }

    local function throw_obj()
        error(err_obj)
    end

    local ok, err = catch throw_obj()
    assert(ok == false)
    assert(err == err_obj)
end

local function catch_with_metamethod_error_add_test()
    local mt = {
        __add = function()
            error("metamethod error")
        end,
    }

    local a = setmetatable({}, mt)
    local ok, err = catch (a + 1)
    assert(ok == false)
    assert(err:find("metamethod error"))
end

local function catch_with_metamethod_error_index_test()
    local mt = {
        __index = function()
            error("index error")
        end,
    }

    local a = setmetatable({}, mt)
    local ok, err = catch a.foo
    assert(ok == false)
    assert(err:find("index error"))
end

local function catch_with_metamethod_error_call_test()
    local mt = {
        __call = function()
            error("call error")
        end,
    }

    local a = setmetatable({}, mt)
    local ok, err = catch a()
    assert(ok == false)
    assert(err:find("call error"))
end

local function catch_with_coroutine_yield_in_main_thread_test()
    local ok, err = catch coroutine.yield()
    assert(ok == false)
end

local function catch_with_assert_failure_test()
    local ok, err = catch raw_assert(false, "assert failed")
    assert(ok == false)
    -- the custom message must be prefixed with the position of the
    -- assert call itself, not appear bare or blame another frame
    assert(
        err:match("errors_test%.lus:%d+: assert failed"),
        "assert message should carry the caller's position prefix, got: " .. err
    )
end

-- ============================================
-- Additional Negative/Edge Case Tests
-- ============================================

local function error_with_level_beyond_stack_depth_test()
    -- Level larger than stack depth should work but adjust line info
    local ok, err = catch error("high level error", 100)
    assert(not ok)
    assert(err:find("high level error"))
end

local function error_with_negative_level_test()
    local ok, err = catch error("negative level", -1)
    assert(not ok)
    assert(err:find("negative level"))
end

local function nested_catch_expressions_test()
    -- catch inside catch
    local outer_ok, outer_result = catch (function()
        local inner_ok, inner_err = catch error("inner error")
        assert(not inner_ok)
        assert(inner_err:find("inner error"))
        return "outer success"
    end)()

    assert(outer_ok)
    assert(outer_result == "outer success")
end

local function catch_propagates_through_multiple_levels_test()
    local function level3()
        error("deep error")
    end

    local function level2()
        level3()
    end

    local function level1()
        level2()
    end

    local ok, err = catch level1()
    assert(not ok)
    assert(err:find("deep error"))
end

local function error_in_gc_finalizer_becomes_warning_test()
    -- In Lua/Lus, __gc errors are caught by the internal pcall that runs
    -- finalizers and converted to warnings. They do NOT propagate to
    -- enclosing catch blocks.
    local finalized = false

    local mt = {
        __gc = function()
            finalized = true
            error("finalizer error")
        end,
    }

    -- Run GC - the finalizer error becomes a warning, not a caught error
    local inner_ok, inner_result = catch (function()
        local obj = setmetatable({}, mt)
        obj = nil
        collectgarbage()
        collectgarbage()
        return "success"
    end)()

    -- The catch succeeds because __gc errors become warnings
    assert(inner_ok, "__gc errors should become warnings, not propagate to catch")
    assert(inner_result == "success")
    assert(finalized, "finalizer should have run")
end

local function catch_with_recursive_error_test()
    local count = 0

    local function recurse()
        count = count + 1

        if count > 5 then
            error("recursion limit")
        end

        recurse()
    end

    local ok, err = catch recurse()
    assert(not ok)
    assert(err:find("recursion limit"))
    assert(count > 5)
end

local function catch_with_nil_error_message_test()
    local ok, err = catch error(nil)
    assert(not ok)
    -- error(nil) should produce some error message
    assert(err ~= nil)
end

local function catch_with_boolean_error_test()
    local ok, err = catch error(true)
    assert(not ok)
    -- catch delivers the error object exactly as raised
    assert(err == true)
end

local function catch_in_coroutine_test()
    local co = coroutine.create(function()
        local ok, err = catch error("coroutine error")
        assert(not ok)
        assert(err:find("coroutine error"))
        return "coro done"
    end)

    local success, result = coroutine.resume(co)
    assert(success)
    assert(result == "coro done")
end

local function an_object_with_a_throwing_tostring_passes_through_untouched_test()
    local mt = {
        __tostring = function()
            error("tostring error")
        end,
    }

    local obj = setmetatable({}, mt)

    -- catch never consults __tostring, so the object is delivered raw and
    -- its throwing metamethod is never invoked.
    local ok, err = catch error(obj)
    assert(not ok, "error should be caught")
    assert(err == obj)
end

local function catch_catches_stack_overflow_test()
    -- NOTE: Must use non-tail-recursive function to actually trigger stack overflow.
    -- A tail-recursive function like `return infinite()` gets optimized to reuse
    -- the same stack frame, so it runs forever without overflowing.
    local function non_tail_infinite(n)
        n = n + 1
        non_tail_infinite(n)
        return n  -- prevents tail call optimization
    end

    local ok, err = catch non_tail_infinite(0)
    assert(not ok, "should have caught stack overflow")
    assert(err:find("stack overflow"), "error should mention stack overflow")
end

local function catch_with_multiple_sequential_errors_test()
    -- Failures interleaved with successes must not leak state between
    -- catches. Each caught error must carry its own message and the
    -- success immediately after it must be unaffected.
    for i = 1, 10 do
        local ok, err = catch error("error " .. i)
        assert(not ok)
        assert(
            err:find("error " .. i, 1, true),
            "iteration " .. i .. " saw the wrong message: " .. err
        )
        local ok2, val = catch (i * 2)
        assert(ok2 == true and val == i * 2)
    end
end

local function error_during_table_construction_test()
    local function throwing()
        error("construction error")
    end

    local ok, err = catch (function()
        local t = { a = 1, b = throwing() }
    end)()

    assert(not ok)
    assert(err:find("construction error"))
end

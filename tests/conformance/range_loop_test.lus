-- A `for` loop that calls `range` directly runs the numeric loop, and a
-- `range` that is not the builtin runs as an ordinary iterator. The loops
-- repeat often enough to reach every tier.

local function collect(f)
    local out = {}
    for _ = 1, 300 do
        out = {}
        f(out)
    end
    return out
end

local function same(got, want)
    assert(#got == #want, `length $(#got), expected $(#want)`)
    for i = 1, #want do
        assert(math.type(got[i]) == math.type(want[i]) and got[i] == want[i], `item $(i): $(got[i]) ~= $(want[i])`)
    end
end

local function counts_like_the_numeric_loop_test()
    same(collect(function(o) for i in range(3) do o[#o + 1] = i end end), { 1, 2, 3 })
    same(collect(function(o) for i in range(2, 4) do o[#o + 1] = i end end), { 2, 3, 4 })
    same(collect(function(o) for i in range(5, 1, -2) do o[#o + 1] = i end end), { 5, 3, 1 })
    same(collect(function(o) for i in range(3, 1) do o[#o + 1] = i end end), {})
    local n = 7
    same(collect(function(o) for i in range(n, n + 2) do o[#o + 1] = i * 2 end end), { 14, 16, 18 })
end

local function a_float_makes_every_value_a_float_test()
    same(collect(function(o) for x in range(0, 1, 0.25) do o[#o + 1] = x end end), { 0.0, 0.25, 0.5, 0.75, 1.0 })
    same(collect(function(o) for x in range(1, 2, 0.5) do o[#o + 1] = x end end), { 1.0, 1.5, 2.0 })
    local direct = {}
    for x = 0, 1, 0.25 do direct[#direct + 1] = x end
    same(collect(function(o) for x in range(0, 1, 0.25) do o[#o + 1] = x end end), direct)
end

local function the_largest_integer_ends_the_loop_test()
    local n = 0
    for i in range(math.maxinteger - 1, math.maxinteger) do n = n + 1 end
    assert(n == 2)
    n = 0
    for i in range(math.mininteger + 1, math.mininteger, -1) do n = n + 1 end
    assert(n == 2)
end

local function break_continue_and_closures_work_test()
    same(collect(function(o)
        for i in range(10) do
            if i > 5 then break end
            if i % 2 == 0 then continue end
            o[#o + 1] = i
        end
    end), { 1, 3, 5 })
    local fs = {}
    for i in range(3) do fs[#fs + 1] = function() return i end end
    assert(fs[1]() == 1 and fs[3]() == 3)
    same(collect(function(o)
        for i in range(2) do
            for j in range(2) do o[#o + 1] = i * 10 + j end
        end
    end), { 11, 12, 21, 22 })
end

local function a_shadowing_range_is_called_as_an_iterator_test()
    local range = function(a, b)
        local i = a - 1
        return function()
            i = i + 1
            if i <= b then return i * 10 end
        end
    end
    same(collect(function(o) for x in range(1, 3) do o[#o + 1] = x end end), { 10, 20, 30 })
end

local function a_replaced_global_range_is_called_as_an_iterator_test()
    local builtin = range
    local seen
    _ENV.range = function(...)
        seen = select("#", ...)
        return builtin(...)
    end
    local out = {}
    for i in range(2, 3) do out[#out + 1] = i end
    _ENV.range = builtin
    same(out, { 2, 3 })
    assert(seen == 2)
end

local function other_numbers_run_the_builtin_iterator_test()
    local out = {}
    for x in range(1n, 3n) do out[#out + 1] = x end
    assert(#out == 3 and out[3] == 3n)
    local ok, e = catch (function() for _ in range(1, 2, 0) do end end)()
    assert(not ok and e:find("step must not be zero", 1, true), e)
    ok, e = catch (function() for _ in range({}) do end end)()
    assert(not ok and e:find("bad argument #1 to 'range'", 1, true), e)
end

-- One loop site that sees the builtin many times and then another
-- function leaves the numeric loop and runs the iterator.
local function a_loop_site_that_changes_callee_test()
    local function sum(range)
        local s = 0
        for x in range(1, 4) do s = s + x end
        return s
    end
    for _ = 1, 500 do assert(sum(range) == 10) end
    local tens = function(a, b)
        local i = a - 1
        return function()
            i = i + 1
            if i <= b then return i * 10 end
        end
    end
    for _ = 1, 50 do assert(sum(tens) == 100) end
    assert(sum(range) == 10)
end

-- A stored range yields the values that the loop does.
local function a_stored_range_follows_the_loop_rules_test()
    local function drain(f)
        local out = {}
        for v in f do out[#out + 1] = v end
        return out
    end
    local r = range
    same(drain(r(0, 1, 0.25)), { 0.0, 0.25, 0.5, 0.75, 1.0 })
    same(drain(r(1, 3.7)), { 1, 2, 3 })
    same(drain(r(math.maxinteger - 1, math.maxinteger)), { math.maxinteger - 1, math.maxinteger })
    same(drain(r(3, 1)), {})
    local f = r(1, 2)
    assert(f() == 1 and f() == 2 and f() == nil and f() == nil)
end

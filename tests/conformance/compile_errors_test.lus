--[[
    Compile-error rejection suite for Lus-specific syntax.

    Every Lus feature suite proves its grammar accepts valid input. This file
    proves the compiler rejects invalid input, and with which diagnostic.
    Each case loads a small source string and pins a stable fragment of the
    error message plus the chunkname prefix, so a regression that swaps a
    clean diagnostic for a generic one (or silently accepts bad input) fails.

    Covered: the global declaration contract, const and close attributes,
    group field checking, malformed enum declarations, provide placement,
    slices as assignment targets, from destructuring, optional chaining on
    the left of assignments, if/while assignment forms, backtick
    interpolation, and reserved words.
]]


pledge("load")


-- Compile src and require failure whose message contains the given fragment.
-- The fragment match is plain text, not a pattern, so quotes and brackets in
-- compiler messages can be pinned verbatim. The chunkname must also appear.
local function checkfail(src, fragment)
    local f, err = load(src, "=cerr")
    if f ~= nil then
        error("expected compile failure but chunk compiled: " .. src)
    end
    if type(err) ~= "string" then
        error("expected a string error message, got " .. type(err))
    end
    if not string.find(err, "cerr:", 1, true) then
        error("error message lacks the chunkname prefix: " .. err)
    end
    if not string.find(err, fragment, 1, true) then
        error("expected fragment '" .. fragment .. "' in message: " .. err)
    end
end

-- Compile src and require success, returning the chunk for optional running.
local function checkok(src)
    local f, err = load(src, "=cerr")
    if not f then
        error("expected chunk to compile but got: " .. tostring(err))
    end
    return f
end

-- =============================================================================
-- Harness sanity
-- =============================================================================

local function helper_accepts_a_valid_chunk_test()
    local f = checkok("return 1")
    assert(f() == 1)
end

local function load_returns_nil_plus_message_rather_than_raising_test()
    local f, err = load("local = 1", "=cerr")
    assert(f == nil)
    assert(type(err) == "string")
end

local function prefixed_chunkname_appears_verbatim_in_the_message_test()
    local _, err = load("local a <const> = 1 a = 2", "=cerrname")
    assert(tostring(err):find("cerrname:1:"))
end

local function plain_chunkname_is_wrapped_in_string_brackets_test()
    local _, err = load("local a <const> = 1 a = 2", "mychunk")
    assert(string.find(tostring(err), '[string "mychunk"]', 1, true) ~= nil)
end

local function error_line_number_tracks_the_offending_line_test()
    local _, err = load("\n\nlocal a <const> = 1\na = 2", "=cerr")
    assert(tostring(err):find("cerr:4:"))
end

-- =============================================================================
-- Global declaration contract
-- =============================================================================

local function chunk_without_global_statement_reads_undeclared_names_freely_test()
    local f = checkok("return ce_never_defined_anywhere")
    assert(f() == nil)
end

local function chunk_without_global_statement_writes_undeclared_names_freel_test()
    local f = checkok("ce_compat_write_1 = 41 return ce_compat_write_1")
    assert(f() == 41)
end

local function global_statement_turns_undeclared_reads_into_compile_errors_test()
    checkfail("global ce_g1 = 1 return someUndeclaredName",
        "variable 'someUndeclaredName' not declared")
end

local function global_statement_turns_undeclared_writes_into_compile_errors_test()
    checkfail("global ce_g2 = 1 someUndeclaredTarget = 5",
        "variable 'someUndeclaredTarget' not declared")
end

local function declared_global_compiles_and_initializes_test()
    local f = checkok("global ce_g3 = 7 return ce_g3")
    assert(f() == 7)
end

local function uses_before_the_global_statement_are_not_checked_test()
    -- Declaration checking is positional. It begins at the global statement,
    -- so earlier code keeps the compatible unchecked behavior while later
    -- references to the same undeclared name would fail.
    local f = checkok("ce_g4_early = 1 global ce_g4 return 1")
    assert(f() == 1)
    local g = checkok("return ce_g4_early")
    assert(g() == 1)
end

local function names_written_before_the_global_statement_stay_checked_after_test()
    checkfail("ce_g4b_early = 1 global ce_g4b return ce_g4b_early",
        "variable 'ce_g4b_early' not declared")
end

local global_statement_rejects_non_name_declarations_cases = {
    {"number instead of name", "global 42", "<name> expected"},
    {"dotted name", "global x.y", "unexpected symbol near '.'"},
    {"string instead of name", "global \"x\"", "<name> expected"},
}

local function global_statement_rejects_non_name_declarations_test(label, src, fragment)
    checkfail(src, fragment)
end

local function global_variables_cannot_be_to_be_closed_test()
    checkfail("global ce_g5 <close> = nil", "global variables cannot be to-be-closed")
end

local function assignment_to_a_const_global_is_a_compile_error_test()
    checkfail("global ce_g6 <const> = 1 ce_g6 = 2",
        "attempt to assign to const variable 'ce_g6'")
end

local function interpolation_of_an_undeclared_name_obeys_strict_mode_test()
    checkfail("global ce_g7 return `value $missingInterpName`",
        "variable 'missingInterpName' not declared")
end

-- =============================================================================
-- Const and close attributes
-- =============================================================================

local function assignment_to_a_const_local_is_a_compile_error_test()
    checkfail("local a <const> = 1 a = 2", "attempt to assign to const variable 'a'")
end

local function assignment_to_a_const_upvalue_is_a_compile_error_test()
    checkfail("local a <const> = 1 local f = function() a = 2 end",
        "attempt to assign to const variable 'a'")
end

local function const_without_initializer_still_rejects_assignment_test()
    checkfail("local x <const> x = 1", "attempt to assign to const variable 'x'")
end

local function attribute_binds_to_its_own_variable_in_a_list_test()
    checkfail("local a, b <const> = 1, 2 b = 3", "attempt to assign to const variable 'b'")
end

local function non_attributed_variable_in_a_list_stays_assignable_test()
    local f = checkok("local a <const>, b = 1, 2 b = 3 return b")
    assert(f() == 3)
end

local duplicate_or_stacked_attributes_are_rejected_cases = {
    {"double const", "local x <const> <const> = 1"},
    {"double close", "local x <close> <close> = nil"},
    {"close then const", "local x <close> <const> = nil"},
}

local function duplicate_or_stacked_attributes_are_rejected_test(label, src)
    checkfail(src, "unexpected symbol near '<'")
end

local function numeric_for_control_variable_is_const_test()
    checkfail("for i = 1, 3 do i = 5 end", "attempt to assign to const variable 'i'")
end

local function generic_for_control_variable_is_const_test()
    checkfail("for k, v in pairs({}) do k = 1 end",
        "attempt to assign to const variable 'k'")
end

-- =============================================================================
-- Groups
-- =============================================================================

local function assignment_to_a_const_group_field_is_a_compile_error_test()
    checkfail("local z <group> = { a = 1, b <const> = 2 } z.b = 3",
        "attempt to assign to const variable 'b'")
end

local function reading_an_undeclared_group_field_is_a_compile_error_test()
    checkfail("local z <group> = { a = 1 } return z.missing",
        "'missing' is not a field of group 'z'")
end

local function writing_an_undeclared_group_field_is_a_compile_error_test()
    checkfail("local z <group> = { a = 1 } z.newfield = 5",
        "'newfield' is not a field of group 'z'")
end

local function group_overwrite_constructor_cannot_invent_fields_test()
    checkfail("local z <group> = { a = 1 } z = { d = 4 }",
        "'d' is not a field of group 'z'")
end

local group_overwrite_must_be_a_constructor_or_group_cases = {
    {"scalar", "local z <group> = { a = 1 } z = 5"},
    {"function call", "local ff = function() return { a = 2 } end local z <group> = { a = 1 } z = ff()"},
}

local function group_overwrite_must_be_a_constructor_or_group_test(label, src)
    checkfail(src, "group can only be assigned a constructor or another group")
end

local group_constructors_require_name_keys_cases = {
    {"bracketed key", "local z <group> = { [1] = 2 }", "<name> expected near '['"},
    {"array part", "local z <group> = { 1, 2 }", "<name> expected near '1'"},
}

local function group_constructors_require_name_keys_test(label, src, fragment)
    checkfail(src, fragment)
end

-- Groups are stack-allocated local constructs, so declaring one with the
-- global statement is rejected at parse time with a clean diagnostic rather
-- than compiling into an unusable variable.
local function global_group_declarations_are_rejected_cleanly_test()
    checkfail("global ce_ggroup <group> = { a = 1 } return ce_ggroup.a",
        "global variables cannot be groups")
end

-- =============================================================================
-- Enum declarations
-- =============================================================================

local malformed_enum_declarations_are_rejected_cases = {
    {"empty enum", "local e = enum end", "<name> expected near 'end'"},
    {"trailing comma", "local e = enum a, b, end", "<name> expected near 'end'"},
    {"lone comma", "local e = enum , end", "<name> expected near ','"},
    {"missing comma", "local e = enum a b end", "'end' expected near 'b'"},
    {"numeric member", "local e = enum 1, 2 end", "<name> expected near '1'"},
    {"string member", "local e = enum \"a\" end", "<name> expected"},
    {"keyword member", "local e = enum while end", "<name> expected near 'while'"},
    {"nil member", "local e = enum nil end", "<name> expected near 'nil'"},
}

local function malformed_enum_declarations_are_rejected_test(label, src, fragment)
    checkfail(src, fragment)
end

local function enum_is_an_expression_and_not_a_statement_test()
    checkfail("enum a, b end", "unexpected symbol near 'enum'")
end

local function enum_expression_compiles_in_return_position_test()
    local f = checkok("return enum a, b end")
    assert(f() ~= nil)
end

-- The guide says values from the same enum with the same name are equal, so a
-- declaration with duplicate member names is rejected at compile time rather
-- than producing two distinct members that share a name.
local function duplicate_enum_member_names_are_rejected_test()
    checkfail("local e = enum a, a end", "duplicate enum member 'a'")
end

-- =============================================================================
-- Provide placement
-- =============================================================================

local provide_outside_a_do_expression_is_rejected_cases = {
    {"top level", "provide 1"},
    {"plain do statement", "do provide 1 end"},
    {"function nested in do expression", "local x = do local f = function() provide 1 end provide 2 end"},
}

local function provide_outside_a_do_expression_is_rejected_test(label, src)
    checkfail(src, "'provide' outside do expression")
end

local function provide_terminates_the_block_so_trailing_statements_fail_test()
    checkfail("local x = do provide 1 local y = 2 end", "'end' expected near 'local'")
end

local function a_second_provide_after_the_first_is_unreachable_test()
    checkfail("local x = do provide 1 provide 2 end", "'end' expected near 'provide'")
end

local function provide_inside_a_loop_inside_the_do_expression_compiles_test()
    local f = checkok("local x = do for i = 1, 2 do provide i end end return x")
    assert(f() == 1)
end

-- =============================================================================
-- Slices as assignment targets
-- =============================================================================

local slices_cannot_be_assigned_to_cases = {
    {"two bounds", "local t = {1, 2, 3} t[1, 2] = {9, 9}", "syntax error near '='"},
    {"empty bounds", "local t = {1} t[,] = 5", "syntax error near '='"},
    {"open end bound in multi-assignment", "local t = {1} t[1,], x = 1, 2", "syntax error near ','"},
    {"slice of a call result", "local f = function() return {1} end f()[1,] = 2", "syntax error near '='"},
}

local function slices_cannot_be_assigned_to_test(label, src, fragment)
    checkfail(src, fragment)
end

local function brackets_take_at_most_two_slice_bounds_test()
    checkfail("local t = {1, 2, 3} return t[1, 2, 3]", "']' expected near ','")
end

-- =============================================================================
-- From destructuring
-- =============================================================================

local function from_requires_simple_variable_names_as_targets_test()
    checkfail("local s = { x = 1 } local t = {} t.x from s",
        "'from' requires simple variable names")
end

local function from_without_a_source_expression_is_rejected_test()
    checkfail("local a from", "unexpected symbol near <eof>")
end

local function local_from_without_names_is_rejected_test()
    checkfail("local from t", "<name> expected near 'from'")
end

local function from_cannot_begin_a_statement_test()
    checkfail("from x", "unexpected symbol near 'from'")
end

local function trailing_comma_in_a_from_name_list_is_rejected_test()
    checkfail("local a, from { a = 1 }", "<name> expected near 'from'")
end

local function from_rejects_to_be_closed_variables_test()
    checkfail("local a <close> from { a = nil }",
        "cannot use 'from' with to-be-closed variables")
end

local function from_with_const_makes_the_target_const_test()
    checkfail("local a <const> from { a = 1 } a = 2",
        "attempt to assign to const variable 'a'")
end

local function bare_from_into_predeclared_locals_compiles_test()
    local f = checkok("local a local b local s = { a = 1, b = 2 } a, b from s return a + b")
    assert(f() == 3)
end

-- =============================================================================
-- Optional chaining on the left of assignments
-- =============================================================================

local optional_chains_are_not_assignment_targets_cases = {
    {"dot form", "local t = {} t?.a = 1"},
    {"bracket form", "local t = {} t?[1] = 1"},
    {"chain continuing after ?", "local t = {} t?.a.b = 1"},
    {"optional call result", "local h = function() return {} end h?() = 1"},
    {"multi-assignment", "local t = {} t?.x = 1, 2"},
}

local function optional_chains_are_not_assignment_targets_test(label, src)
    checkfail(src, "syntax error near '='")
end

local function optional_chain_is_not_an_expression_statement_test()
    checkfail("local t = {} t?.a", "syntax error near <eof>")
end

-- =============================================================================
-- If and while assignment forms
-- =============================================================================

local malformed_if_assignments_are_rejected_cases = {
    {"missing expression", "if x = then end", "unexpected symbol near 'then'"},
    {"missing variable list", "if = f() then end", "unexpected symbol near '='"},
    {"missing then", "if x = 1 end", "'then' expected near 'end'"},
    {"trailing comma in variable list", "if x, = 1 then end", "<name> expected near '='"},
}

local function malformed_if_assignments_are_rejected_test(label, src, fragment)
    checkfail(src, fragment)
end

local function while_assignment_with_missing_expression_consumes_do_as_an_e_test()
    -- The do end after = parses as a do expression value, so the while
    -- statement then reaches end of input still looking for its own do.
    checkfail("while x = do end", "'do' expected near <eof>")
end

local function trailing_comma_in_a_while_assignment_variable_list_is_reject_test()
    checkfail("while x, = f() do end", "<name> expected near '='")
end

local function well_formed_if_assignment_compiles_and_binds_test()
    local f = checkok("if a, b = 1, 2 then return a + b end")
    assert(f() == 3)
end

-- =============================================================================
-- Backtick interpolation
-- =============================================================================

local unterminated_interpolated_strings_are_rejected_cases = {
    {"unclosed backtick", "local s = `abc", "unfinished interpolated string near <eof>"},
    {"unclosed expression at eof", "local s = `abc $(", "unexpected symbol near <eof>"},
    {"backtick inside unclosed expression", "local s = `abc $( 1 + 2`", "unfinished interpolated string near <eof>"},
    {"unbalanced parens in expression", "return `x $( (1 + 2 `", "unfinished interpolated string near <eof>"},
}

local function unterminated_interpolated_strings_are_rejected_test(label, src, fragment)
    checkfail(src, fragment)
end

local function empty_interpolation_expression_is_rejected_test()
    checkfail("return `x $()`", "unexpected symbol near <interp_end>")
end

local dollar_must_introduce_a_name_or_parenthesized_expression_cases = {
    {"dollar at end of string", "return `100$`"},
    {"dollar before space", "return `a $ b`"},
    {"dollar before digit", "return `$1`"},
}

local function dollar_must_introduce_a_name_or_parenthesized_expression_test(label, src)
    checkfail(src, "invalid interpolation after '$'")
end

local function nested_backtick_string_inside_an_interpolation_compiles_test()
    local f = checkok("return `o $( `i` ) o`")
    assert(f() == "o i o")
end

local function doubled_dollar_is_a_literal_dollar_test()
    local f = checkok("return `$$`")
    assert(f() == "$")
end

-- =============================================================================
-- Reserved words
-- =============================================================================

local lus_keywords_cannot_be_local_variable_names_cases = {
    {"from"},
    {"provide"},
    {"enum"},
    {"global"},
    {"catch"},
}

local function lus_keywords_cannot_be_local_variable_names_test(kw)
    checkfail("local " .. kw .. " = 1", "<name> expected near '" .. kw .. "'")
end

-- =============================================================================
-- Catch results used by this harness
-- =============================================================================

local function catch_of_a_zero_result_call_does_not_leak_the_callee_test()
    local function noop() end
    local ok, second = catch noop()
    assert(ok)
    assert(second == nil)
end

local function catch_of_a_one_result_call_returns_the_result_test()
    local function one() return 7 end
    local ok, v = catch one()
    assert(ok)
    assert(v == 7)
end


-- =============================================================================
-- Diagnostics of the code generator
-- =============================================================================

-- Each case reaches a check of the code generator that the parser leaves
-- to it, so the check runs only for a program that gets past the parser.
local code_generator_diagnostics_cases = {
    {"break at top level", "break", "break outside loop"},
    {"continue at top level", "continue", "continue outside loop"},
    {"continue in a function outside its loop", "for i = 1, 2 do local function f() continue end end", "continue outside loop"},
    {"vararg in a fixed function", "local function f() return ... end", "cannot use '...' outside a vararg function"},
    {"two to-be-closed in a condition", "if a <close>, b <close> = nil, nil then end", "multiple to-be-closed variables in condition"},
    {"group and close together", "local g <group, close> = { x = 1 }", "conflicting attributes"},
    {"meta in a group", "local m <meta, group> = {}", "cannot use <meta> in this declaration"},
    {"meta in a group with a constructor", "local m <meta, group> = { x = 1 }", "cannot use <meta> in this declaration"},
    {"lazy in a group", "local z <lazy, group> = { x = 1 }", "cannot use <lazy> in this declaration"},
    {"observe in a group", "local x <group, observe> = { x = 1 }", "cannot use <observe> in this declaration"},
    {"meta and observe", "local m <meta, observe> = {}", "cannot combine <meta> with <observe>"},
    {"observe and a runtime attribute", "local x <observe, fmt> = 1", "cannot combine <observe> with runtime attributes"},
    {"lazy field and a runtime attribute of the group", "local g <group, fmt> = { a <lazy> = 1 }", "cannot combine <lazy> fields with runtime attributes of the group"},
    {"two lazy names", "local x <lazy>, y = 1, 2", "a <lazy> declaration names one variable"},
    {"two lazy initializers", "local x <lazy> = 1, 2", "a <lazy> variable needs one initializer"},
    {"two observed names", "local x <observe>, y = 1, 2", "an <observe> declaration names one variable"},
    {"two observed initializers", "local x <observe> = 1, 2", "an <observe> variable needs one initializer"},
    {"two meta names", "local m <meta>, n = 1, 2", "a <meta> declaration names one variable"},
    {"label defined twice", "::a:: ::a::", "label 'a' already defined on line 1"},
    {"goto without a label", "goto nowhere", "no visible label 'nowhere' for <goto>"},
    {"undeclared name in a nested function", "global none; local function f() return y end", "variable 'y' not declared"},
}

local function code_generator_diagnostics_test(label, src, fragment)
    checkfail(src, fragment)
end

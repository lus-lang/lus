pledge("load", `fs:read=$TEST_DIR`, `fs:read=$TEST_DIR/*`)

-- ===== parse =====
-- serializes deeply nested calls
local function serializes_deeply_nested_calls_test()
    local depth = 64
    local source = `return $(string.rep("f(", depth))31337$(string.rep(")", depth))`
    local ast = debug.parse(source, "nested-calls.lus")
    local node = ast.children[1].values[1]

    for _ = 1, depth do
        assert(node.type == "callexpr", "expected a nested call expression")
        assert(#node.args == 1, "expected one nested call argument")
        node = node.args[1]
    end

    assert(node.type == "number", "expected the innermost literal")
    assert(node.value == 31337, "expected the innermost literal value")
end

-- Helper to read a file
local function readfile(path)
    local f = io.open(path, "r")

    if not f then
        return nil
    end

    local content = f:read("a")
    f:close()
    return content
end

-- The corpus is every Lus file next to this test, so the parser and the
-- formatter are exercised on the whole conformance suite.
local function get_lus_files()
    local list_ok, all_files = catch fs.list(TEST_DIR, "*.lus")

    if not list_ok then
        return {}
    end

    local files = {}

    for idx = 1, #all_files do
        local basename = all_files[idx]

        -- Skip this file to avoid self-reference.
        if basename ~= "parse_test.lus" then
            files[#files + 1] = { fs.path.join(TEST_DIR, basename), basename }
        end
    end

    return files
end

local files = get_lus_files()

-- The corpus must not be silently empty.
local function the_corpus_is_not_empty_test()
    assert(#files > 0)
end

-- every conformance file parses
local every_conformance_file_parses_cases = files

local function every_conformance_file_parses_test(path, name)
    local content = readfile(path)
    assert(content, `Could not read file: $path`)
    local ok, _ast = catch debug.parse(content, name)
    assert(ok, `Failed to parse file: $path`)
end

-- every conformance file formats idempotently
local every_conformance_file_formats_idempotently_cases = files

local function every_conformance_file_formats_idempotently_test(path, name)
    local content = readfile(path)
    assert(content, `Could not read file: $path`)
    -- Format once.
    local formatted, err = debug.format(content, name)
    assert(formatted, `Failed to format file: $path: $err`)
    -- Format again: the result must be identical (idempotent).
    local formatted2, err2 = debug.format(formatted, name)
    assert(formatted2, `Failed to re-format: $path: $err2`)

    if formatted2 ~= formatted then
        local exp_lines = {}

        for line in (`$formatted\n`):gmatch("([^\n]*)\n") do
            exp_lines[#exp_lines + 1] = line
        end

        local got_lines = {}

        for line in (`$formatted2\n`):gmatch("([^\n]*)\n") do
            got_lines[#got_lines + 1] = line
        end

        local diff_line = 0
        local max = #exp_lines > #got_lines and #exp_lines or #got_lines

        for j = 1, max do
            if exp_lines[j] ~= got_lines[j] then
                diff_line = j
                break
            end
        end

        error(
            `Formatter not idempotent for $path at line $diff_line:\n  first:  $(tostring(
                exp_lines[diff_line]
            ))\n  second: $(got_lines[diff_line])`
        )
    end
end

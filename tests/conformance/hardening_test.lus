--[[
    Programs that hand the runtime values and shapes it does not expect.

    Each test must end in its result or in a clean error, in every JIT
    mode. The tests cover calls with fewer arguments than parameters,
    natives reached through a metatable, tables that change while a query
    or a native reads them, stacks that grow inside a callback, and
    permissions at the edge of a grant.
]]

pledge("load", "fs", "exec", "env", "debug")

local function deep(n)
    if n == 0 then
        return 0
    end

    return 1 + deep(n - 1)
end

-- Runs `f` below `n` Lus frames, so the stack is a large block when the
-- callback of the test grows it.
local function at_depth(n, f)
    if n == 0 then
        return f()
    end

    local r = at_depth(n - 1, f)
    return r
end

local function vararg_function_with_many_parameters_test()
    local function v(p1, p2, p3, p4, p5, p6, p7, p8, p9, ...)
        return p1 or p2 or p3 or p4 or p5 or p6 or p7 or p8 or p9, select("#", ...)
    end

    local function nested(n)
        if n == 0 then
            local r = v()
            return r
        end

        local r = nested(n - 1)
        return r
    end

    for d = 0, 300 do
        assert(nested(d) == nil)
    end

    local names = {}

    for i = 1, 190 do
        names[i] = `p$i`
    end

    local wide = load(
        `local function f($(table.concat(names, ", ")), ...) return p190 end return f()`
    )
    assert(wide() == nil)
end

local function enum_metatable_natives_check_their_argument_test()
    local E = enum A, B end

    local mt = getmetatable(E.A)
    assert(mt.__index(E.A, "B") == E.B)
    local ok, err = catch mt.__index(1, "A")
    assert(not ok and tostring(err):find("enum expected", 1, true), tostring(err))
end

local function query_join_sees_a_replaced_row_test()
    local a = { { k = 1, id = "a1" }, { k = 2, id = "a2" }, { k = 3, id = "a3" } }
    local b = { { k = 1, id = "b1" }, { k = 2, id = "b2" }, { k = 3, id = "b3" } }

    local function replace()
        a[2] = 1
        return true
    end

    local ok, err = catch (function()
        for _ in query(@a as x, b as y where x.k == y.k and replace() select x.id, y.id as yid) do
        end
    end)()

    assert(not ok and tostring(err):find("not a record", 1, true), tostring(err))
end

local function query_window_with_huge_limit_test()
    local rows = {}

    for i = 1, 20 do
        rows[i] = { a = i, b = -i }
    end

    local n = 0

    for _ in query(@rows as r order by r.a, r.b limit math.maxinteger offset 1) do
        n = n + 1
    end

    assert(n == 19)
    n = 0

    for _ in query(@rows as r order by r.a limit math.maxinteger offset 1) do
        n = n + 1
    end

    assert(n == 19)
end

local function format_survives_a_stack_that_grows_test()
    local obj = setmetatable({}, {
        __tostring = function()
            deep(60000)
            return "obj"
        end,
    })

    local s = at_depth(5000, function()
        return string.format("%s %d %d %d", obj, 1, 2, 3)
    end)

    assert(s == "obj 1 2 3")
end

local function reduce_survives_a_stack_that_grows_test()
    local sum = at_depth(5000, function()
        return table.reduce({ 1, 2, 3 }, function(acc, x)
            deep(60000)
            return acc + x
        end, 0)
    end)

    assert(sum == 6)
end

local function worker_metatable_is_protected_test()
    if not worker then
        skip("this build has no workers")
    end

    local w = worker.create("/nonexistent/x.lus")
    assert(getmetatable(w) == false)
end

local function debug_keeps_loop_slots_and_native_upvalues_test()
    local wrapped = coroutine.wrap(function()
    end)

    local ok, err = catch debug.setupvalue(wrapped, 1, 42)
    assert(not ok and tostring(err):find("native function", 1, true), tostring(err))
    local refused = false

    for _ = 1, 2 do
        local i = 1

        while true do
            local name = debug.getlocal(1, i)

            if not name then
                break
            end

            if name == "(for state)" then
                refused = not (catch debug.setlocal(1, i, {}))
                break
            end

            i = i + 1
        end
    end

    assert(refused)
    assert(debug.getlocal(1, math.mininteger) == nil)
end

local function many_loop_carried_locals_test()
    local names, inits, sums = {}, {}, {}

    for i = 1, 66 do
        names[i] = `a$i`
        inits[i] = tostring(i)
        sums[i] = `a$i = a$i + 1`
    end

    local src = `local function f(n)
    local $(table.concat(names, ", ")) = $(table.concat(inits, ", "))
    local t = { 5 }
    for i = 1, n do
        $(table.concat(sums, " "))
        t[1] = t[1] + 1
    end
    return a1, a14, a66, t[1]
end
local r
for _ = 1, 400 do r = { f(10) } end
return r`

    local r = load(src)()
    assert(r[1] == 11 and r[2] == 24 and r[3] == 76 and r[4] == 15, table.concat(r, " "))
end

local function loop_range_guard_beside_a_template_test()
    local cur, small

    local function f(n, flag, q1, q2, q3, q4, q5, q6, q7, q8)
        local s = 0

        for i = 1, n do
            local z = q1 + q2 + q3 + q4 + q5 + q6 + q7 + q8
            local v = cur[i]
            s = s + v + z
            cur = small
            local y = flag or z
            s = s + (y == nil and 1 or 0)
        end

        return s
    end

    local big = {}

    for i = 1, 64 do
        big[i] = 1
    end

    small = { 1, 1, 1, 1 }

    for _ = 1, 300 do
        cur = big
        f(0, 5, 0, 0, 0, 0, 0, 0, 0, 0)
    end

    cur = big
    local ok = catch f(64, 5, 0, 0, 0, 0, 0, 0, 0, 0)
    assert(not ok, "the read past the small table must raise")
end

local function sqlite_attach_needs_a_literal_name_test()
    if not io.sqlite then
        skip("this build has no SQLite")
    end

    local db = io.sqlite(":memory:")
    local ok = catch db:run("ATTACH ? AS x", "attached.db")
    assert(not ok)
    ok = catch db:exec("ATTACH ('attached' || '.db') AS x")
    assert(not ok)
    db:exec("CREATE TABLE t (v TEXT)")
    db:exec("VACUUM")
    db:close()
    assert(not (catch fs.stat("attached.db")))
end

-- Runs `body` as a script of its own that holds only the directory `sb`
-- of the working directory, and returns what it printed.
local function in_sandbox(body)
    local exe = os.getenv("LUS_EXE")

    if not exe then
        skip("the interpreter is not reachable, set LUS_EXE")
    end

    local script = io.open("sandboxed.lus", "w")
    script:write(`assert(pledge("fs=./sb/**", "fs=./sb", "seal"))\n$body\n`)
    script:close()
    local p = os.spawn({ exe, "sandboxed.lus" }, { stdout = "pipe" })
    return p.stdout:read("a")
end

local function links_are_checked_where_the_system_resolves_them_test()
    if os.platform() == "windows" then
        skip("needs symbolic links")
    end

    catch fs.createdirectory("sb")

    local out = in_sandbox([[
fs.createdirectory("sb/sb/x/y/z", true)
print((catch fs.createlink("sb/p", "sb/x/y/z")))
fs.createdirectory("sb/sb/p")
print((catch fs.createlink("sb/L", "sb/p/../../../escaped.txt")))
print((catch fs.createlink("sb/inner", "x")))]])

    assert(out == "true\nfalse\ntrue\n", out)
end

local function a_link_name_with_a_separator_names_the_link_test()
    if os.platform() == "windows" then
        skip("needs symbolic links")
    end

    fs.createdirectory("keep")
    io.open("keep/a.txt", "w"):close()
    fs.createdirectory("box")
    fs.createlink("box/L", "../keep")
    fs.remove("box/L/", true)
    assert(fs.stat("keep/a.txt"))
    assert(not (catch fs.stat("box/L", { follow = false })))
end

local function a_dangling_link_is_no_missing_file_test()
    if os.platform() == "windows" then
        skip("needs symbolic links")
    end

    catch fs.createdirectory("sb")
    fs.createlink("sb/dangling", "../outside.txt")

    local out = in_sandbox([[
print((catch io.open("sb/dangling", "w")))
print((catch io.open("sb/new.txt", "w")))
print(fs.stat("sb/dangling", { follow = false }).kind)]])

    assert(out == "false\ntrue\nlink\n", out)
    assert(not (catch fs.stat("outside.txt")))
end

local function pledge_refuses_bytecode_test()
    assert(pledge("bytecode") == false)
end

local function finalizer_runs_with_the_permissions_of_its_thread_test()
    local seen

    local co = coroutine.create(function()
        pledge("~env", "seal")

        setmetatable({}, {
            __gc = function()
                seen = (catch os.getenv("HOME"))
            end,
        })
    end)

    assert(coroutine.resume(co))
    collectgarbage()
    collectgarbage()
    assert(seen == false, "the finalizer must run without the env permission")
    assert(catch os.getenv("HOME"))
end

local function native_close_handler_that_raises_test()
    local function f()
        local x <close> = setmetatable({}, { __close = error })
        error("boom")
    end

    local ok = catch f()
    assert(not ok)
    local t = {}

    for i = 1, 10 do
        t[i] = i
    end

    assert(#t == 10)
end

local function provide_after_a_close_handler_keeps_its_count_test()
    local function fill()
        local a, b, c, d, e, f, g, h = "s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8"
        return a and b and c and d and e and f and g and h
    end

    local function none()
    end

    local function three()
        return 1, 2, 3
    end

    local closer = setmetatable({}, {
        __close = function()
        end,
    })

    local function empty()
        return do
            local x <close> = closer
            provide none()
        end
    end

    local function triple()
        return do
            local x <close> = closer
            provide three()
        end
    end

    fill()
    assert(select("#", empty()) == 0)
    local a, b, c = triple()
    assert(select("#", triple()) == 3 and a == 1 and b == 2 and c == 3)
end

local function extreme_arguments_raise_clean_errors_test()
    local t = { 1, 2, 3 }

    assert(not (catch (function()
        return t[math.mininteger, math.maxinteger]
    end)()))

    assert(not (catch getmetatable(io.stdout).__tostring(1)))
    assert(not (catch string.unpack(string.rep("X", 100000), "a")))
    assert(not (catch string.unpack("!8 b Xi8 c0", "a")))
    assert(not (catch string.packsize(string.rep("i16", 2) .. "c9223372036854775807")))
end

local function repeated_json_key_with_null_test()
    local t = fromjson('{"a":{"K":1},"a":null,"K":2,"b":{"K":3}}')
    assert(t.a == nil and t.K == 2 and t.b.K == 3)
end

local function a_stored_table_is_read_through_its_other_name_test()
    local function f(a, b)
        local t = { k = 1 }
        a.x = t
        local u = b.x
        local v1 = u.k
        t.k = 2
        return v1 + u.k * 10
    end

    local holder = { x = { k = 0 } }
    local last

    for _ = 1, 400 do
        last = f(holder, holder)
    end

    assert(last == 21)
end

local function a_star_stays_inside_one_path_component_test()
    catch fs.createdirectory("sb")
    fs.createdirectory("sb/deep", true)
    io.open("sb/top.txt", "w"):close()
    io.open("sb/deep/in.txt", "w"):close()

    local exe = os.getenv("LUS_EXE")

    if not exe then
        skip("the interpreter is not reachable, set LUS_EXE")
    end

    local script = io.open("globs.lus", "w")

    script:write([[
print(pledge("fs:read=./sb/*", "seal"))
print((catch io.open("sb/top.txt")))
print((catch io.open("sb/deep/in.txt")))]])

    script:close()
    local out = os.spawn({ exe, "globs.lus" }, { stdout = "pipe" }).stdout:read("a")
    assert(out == "true\ttrue\ntrue\nfalse\n", out)
    script = io.open("globs.lus", "w")

    script:write([[
print(pledge("fs:read=./sb/**", "seal"))
print((catch io.open("sb/top.txt")))
print((catch io.open("sb/deep/in.txt")))]])

    script:close()
    out = os.spawn({ exe, "globs.lus" }, { stdout = "pipe" }).stdout:read("a")
    assert(out == "true\ttrue\ntrue\ntrue\n", out)
end

local function an_empty_permission_value_raises_test()
    local ok, err = catch pledge("env:read=")
    assert(not ok and tostring(err):find("empty value", 1, true), tostring(err))
end

local function deep_clone_of_a_weak_table_test()
    for _ = 1, 3000 do
        local src = setmetatable({}, { __mode = "v" })
        local key = { {}, {}, {}, {}, {}, {} }
        src[key] = { marker = 12345, {}, {}, {} }
        local copy = table.clone(src, true)

        for _, v in pairs(copy) do
            assert(type(v) == "table" and v.marker == 12345)
        end
    end

    for _ = 1, 3000 do
        local src = setmetatable({}, { __mode = "k" })
        src[{ {}, {}, {} }] = { marker = 7 }

        for k, v in pairs(table.clone(src, true)) do
            assert(type(k) == "table" and v.marker == 7)
        end
    end
end

local function grouped_query_whose_filter_removes_its_row_test()
    local rows = {}

    for i = 1, 3000 do
        rows[i] = { k = i, id = i }
    end

    local function drop(r)
        rows[r.id] = nil
        return true
    end

    local groups = 0

    for row in query(@rows as r where drop(r) select r.k, count(*) as c group by r.k) do
        assert(type(row.k) == "number" and row.c == 1)
        groups = groups + 1
    end

    assert(groups == 3000, groups)
end

local function grouped_query_with_wide_decimal_keys_test()
    local rows = {}

    for i = 1, 500 do
        rows[i] = { a = 1e29d + i, b = i % 7 }
    end

    local groups = 0

    for row in query(@rows as r select r.a, r.b, count(*) as c group by r.a, r.b) do
        assert(row.c == 1)
        groups = groups + 1
    end

    assert(groups == 500, groups)
end

local function tojson_of_a_table_that_a_function_detaches_test()
    local root = {}
    local victim = {}

    for i = 1, 40 do
        victim[i] = setmetatable({}, {
            __json = function()
                root[1] = nil
                victim = nil
                collectgarbage()

                local junk = {}

                for j = 1, 200 do
                    junk[j] = { j, j, j, j }
                end

                return "x"
            end,
        })
    end

    root[1] = victim
    local _, count = tojson(root):gsub('"x"', "")
    assert(count == 40, count)

    -- A weak table holds its values for nobody while they are written.
    for _ = 1, 300 do
        local weak = setmetatable({}, { __mode = "v" })

        for i = 1, 8 do
            weak[i] = setmetatable({ i }, {
                __json = function(self)
                    return self[1]
                end,
            })
        end

        assert(type(tojson(weak)) == "string")
    end
end

local function require_with_searchers_replaced_by_a_searcher_test()
    local old = package.searchers
    local mine = {}

    mine[1] = function()
        package.searchers = old
        mine = nil
        collectgarbage()

        local junk = {}

        for i = 1, 400 do
            junk[i] = { i, i, i, i }
        end

        return "\n\tfirst searcher"
    end

    for i = 2, 6 do
        mine[i] = function()
            return `\n\tsearcher $i`
        end
    end

    package.searchers = mine
    local ok, err = catch require("no.such.module.anywhere")
    package.searchers = old
    assert(not ok and tostring(err):find("searcher 6", 1, true), tostring(err))
end

local function a_new_table_under_two_names_at_a_join_test()
    local function kind(c)
        local t = { v = 1 }
        local x = t

        if c then
            x = nil
        end

        return type(x), x == t, t.v
    end

    local sink = {}

    local function stored(c)
        local t = { v = 1 }
        local x = t

        if c then
            x = nil
        end

        sink[1] = x
        return t.v
    end

    local function same(n, bad)
        local t = { v = 1 }
        local count = 0

        for i = 1, n do
            local x = t

            if i == bad then
                x = nil
            end

            if rawequal(x, t) then
                count = count + 1
            end
        end

        return count
    end

    for _ = 1, 300 do
        kind(false)
        stored(false)
    end

    local a, b, c = kind(false)
    assert(a == "table" and b == true and c == 1)
    a, b, c = kind(true)
    assert(a == "nil" and b == false and c == 1)
    assert(stored(false) == 1 and sink[1].v == 1)
    assert(stored(true) == 1 and sink[1] == nil)
    assert(same(300, -1) == 300)
    assert(same(300, 180) == 299)
end

local function a_pipe_closed_while_its_reader_waits_test()
    if os.platform() == "windows" then
        skip("POSIX programs")
    end

    local p = os.spawn({ "/bin/sleep", "1" }, { stdout = "pipe" })
    local out = p.stdout

    coroutine.detach(coroutine.create(function()
        out:close()
        local q = os.spawn({ "/bin/echo", "data of another pipe" }, { stdout = "pipe" })
        coroutine.resume(coroutine.sleep(0.1))
        q.stdout:close()
    end))

    local ok, err = catch out:read(5)
    assert(not ok and tostring(err):find("closed file", 1, true), tostring(err))
end

-- Runs `body` as a script of its own with the options `flags` and the
-- `PATH` of this process behind `dir`, and returns what it printed.
local function with_path(dir, flags, body)
    local exe = os.getenv("LUS_EXE")

    if not exe then
        skip("the interpreter is not reachable, set LUS_EXE")
    end

    if os.platform() == "windows" then
        skip("POSIX shell scripts")
    end

    local script = io.open("named.lus", "w")
    script:write(body)
    script:close()
    local argv = { exe }

    for _, f in ipairs(flags) do
        argv[#argv + 1] = "-P"
        argv[#argv + 1] = f
    end

    local here = os.spawn({ "/bin/pwd" }, { stdout = "pipe" }).stdout:read("l")
    argv[#argv + 1] = "named.lus"
    argv[#argv + 1] = here

    local p = os.spawn(argv, {
        stdout = "pipe",
        stderr = "stdout",
        env = { PATH = `$here/$dir:/usr/bin:/bin` },
    })

    return p.stdout:read("a")
end

local function tools(name)
    for _, kind in ipairs({ "good", "evil" }) do
        fs.createdirectory(`$(name)_$kind`, true)
        local f = io.open(`$(name)_$kind/mytool`, "w")
        f:write(`#!/bin/sh\necho $kind\n`)
        f:close()
        os.execute(`chmod +x $(name)_$kind/mytool`)
    end
end

local function a_worker_runs_the_named_program_of_the_startup_path_test()
    if os.platform() == "windows" then
        skip("POSIX shell scripts")
    end

    tools("wp")
    local w = io.open("named_worker.lus", "w")

    w:write([[
local ok, p = catch os.spawn({ "mytool" }, { stdout = "pipe" })
worker.message(ok and p.stdout:read("a") or "denied")]])

    w:close()

    local out = with_path("wp_good", { "exec=mytool", "env", "fs:read", "load" }, [[
local dir = ...
print(os.spawn({ "mytool" }, { stdout = "pipe" }).stdout:read("l"))
os.setenv("PATH", `$dir/wp_evil:/usr/bin:/bin`)
print((catch os.spawn({ "mytool" }, { stdout = "pipe" })))
print(worker.receive(worker.create("named_worker.lus")))]])

    assert(out == "good\nfalse\ndenied\n", out)
end

local function a_named_program_keeps_the_variables_that_load_code_test()
    if os.platform() == "windows" then
        skip("POSIX shell scripts")
    end

    tools("ev")

    local out = with_path("ev_good", { "exec=mytool", "env" }, [[
local dir = ...
local path = `$dir/ev_good:/usr/bin:/bin`
local function run(env)
    local ok, p = catch os.spawn({ "mytool" }, { stdout = "pipe", env = env })
    return ok and p.stdout:read("l") or "denied"
end
print(run({ PATH = path, GREETING = "hello" }))
print(run({ PATH = path, LD_PRELOAD = "/tmp/x.so" }))
print(run({ PATH = path, ["BASH_FUNC_echo%%"] = "() { id; }" }))
print(run({ PATH = `$dir/ev_evil:/usr/bin:/bin` }))
os.setenv("BASH_ENV", "/tmp/x")
print((catch os.spawn({ "mytool" }, { stdout = "pipe" })))]])

    assert(out == "good\ndenied\ndenied\ndenied\nfalse\n", out)

    -- Without the permission to write a variable, the option gives none.
    out = with_path("ev_good", { "exec" }, [[
print((catch os.spawn({ "mytool" }, { stdout = "pipe", env = { GREETING = "hello" } })))
print((catch os.spawn({ "mytool" }, { stdout = "pipe", cwd = "/" })))]])

    assert(out == "false\nfalse\n", out)
end

local function a_new_table_stored_into_another_new_table_test()
    local function build(i)
        local t = { a = 1, b = 2, c = 3, d = 4, e = 5, f = 6, g = 7, h = 8 }
        local n = #t
        local v = { x = i }
        t.h = v
        return t, v, n
    end

    for i = 1, 20000 do
        local t, v = build(i)
        assert(v.x == i and t.h == v and t.a == 1)
    end

    collectgarbage()
end

local function a_protected_metatable_stays_in_compiled_code_test()
    local locked = {
        __metatable = "locked",
        __len = function()
            return 42
        end,
    }

    local other = {}

    local function set()
        local t = { a = 1 }
        local before = #t
        setmetatable(t, locked)
        local n = #t
        local ok = catch setmetatable(t, other)
        return t, n, ok, before
    end

    for _ = 1, 20000 do
        local t, n, ok = set()
        assert(n == 42 and not ok and getmetatable(t) == "locked")
    end

    local function own()
        local t = { x = 1 }
        return setmetatable(t, t)
    end

    for _ = 1, 20000 do
        local t = own()
        assert(getmetatable(t) == t)
    end
end

local function a_close_handler_that_drops_its_error_test()
    -- The handler keeps no reference to the error it receives.
    local function collect()
        collectgarbage()

        local junk = {}

        for i = 1, 2000 do
            junk[i] = `$(string.rep("q", 60))$i`
        end
    end

    local co = coroutine.create(function()
        local x <close> = setmetatable({}, { __close = collect })

        local y <close> = setmetatable({}, {
            __close = function()
                error({ "payload", 1, 2, 3 })
            end,
        })

        coroutine.yield()
    end)

    coroutine.resume(co)
    local ok, e = coroutine.close(co)
    assert(not ok and type(e) == "table" and e[1] == "payload")

    local function fails()
        local x <close> = setmetatable({}, { __close = collect })
        local missing = nil
        return missing[`$(string.rep("w", 100))abc`]
    end

    local caught, message = catch fails()
    assert(not caught and tostring(message):find("index a nil value", 1, true), tostring(message))

    -- A `catch` that succeeds inside a handler leaves the outer error.
    local function inner_catch()
        local x <close> = setmetatable({}, {
            __close = function()
                local _ = catch tostring(1)
            end,
        })

        error("outer")
    end

    caught, message = catch inner_catch()
    assert(not caught and tostring(message):find("outer", 1, true), tostring(message))
end

local function a_closing_condition_variable_closes_each_iteration_test()
    local closed = 0

    local function resource(i)
        return setmetatable({ i = i }, {
            __close = function()
                closed = closed + 1
            end,
        })
    end

    local i = 0

    while x <close> = i < 3 and resource(i + 1) do
        i = i + 1
        assert(closed == i - 1 and x.i == i)
    end

    assert(closed == 3, closed)
end

local function equal_numbers_are_one_key_test()
    local t = {}
    t[1e20] = "float"
    assert(t[100000000000000000000n] == "float")
    t[0.5] = "half"
    assert(t[0.5d] == "half")
    t[0.5d] = "decimal"
    assert(t[0.5] == "decimal")
    t[0.10d] = "tenth"
    assert(t[0.1d] == "tenth" and t[0.100d] == "tenth")
    local count = 0

    for _ in pairs(t) do
        count = count + 1
    end

    assert(count == 3, count)
    local many = {}

    for n = 1, 2000 do
        many[decimal(n) / 7d] = n
    end

    assert(many[decimal(14) / 7d] == 14 and many[decimal(3) / 7d] == 3)
end

local function extreme_sizes_and_paces_raise_no_fault_test()
    local t = table.create(6, 128)

    for n = 1, 6 do
        t[n] = true
    end

    for k = 0, 59 do
        t[7 << k] = true
    end

    assert(#t >= 6)

    for _, name in ipairs({ "pause", "stepmul", "stepsize", "minormul", "minormajor" }) do
        local old = collectgarbage("param", name, math.maxinteger)
        collectgarbage()
        collectgarbage("param", name, old)
    end

    assert(not (catch decimal("0.1e-9223372036854775808")))
    assert(not (catch load("return __lus_builtin_ctxnew(nil, 'a', 'b', 1 << 40)")()))
end

local function too_many_returned_values_are_a_compile_error_test()
    local values = {}

    for n = 1, 255 do
        values[n] = "1"
    end

    local f, err = load(`return $(table.concat(values, ","))`)
    assert(not f and tostring(err):find("too many", 1, true), tostring(err))
    local nested = string.rep("x <group> = {", 300) .. string.rep("}", 300)
    f, err = load(`local $nested`)
    assert(not f)
end

local function runtime_metatables_are_closed_test()
    assert(getmetatable(io.stdout) == false)
    assert(not (catch setmetatable(io.stdout, {})))
    local weak = setmetatable({}, { __mode = "v" })
    weak[1] = io.stdout

    weak[2] = setmetatable({}, {
        __gc = function()
        end,
    })

    local held = weak[2]
    collectgarbage()
    assert(weak[1] == io.stdout and weak[2] == held)
end

local function a_finalizer_registered_again_keeps_its_permissions_test()
    local ran = {}

    local co = coroutine.create(function()
        pledge("~exec", "seal")
        local stage = 0

        setmetatable({}, {
            __gc = function(self)
                if stage == 0 then
                    stage = 1
                    setmetatable(self, getmetatable(self))
                    return
                end

                ran[#ran + 1] = (catch os.execute("true"))
            end,
        })
    end)

    assert(coroutine.resume(co))
    co = nil

    for _ = 1, 4 do
        collectgarbage()
    end

    assert(#ran == 1 and ran[1] == false, #ran)
end

local function rejecting_every_permission_holds_test()
    local exe = os.getenv("LUS_EXE")

    if not exe then
        skip("the interpreter is not reachable, set LUS_EXE")
    end

    local script = io.open("none.lus", "w")
    script:write([[print((catch pledge("fs")))
print((catch io.open("none.lus")))]])
    script:close()
    local p = os.spawn({ exe, "-P", "~all", "none.lus" }, { stdout = "pipe" })
    local out = p.stdout:read("a")
    assert(out == "false\nfalse\n", out)
end

local function stat_of_a_link_with_a_trailing_separator_test()
    if os.platform() == "windows" then
        skip("symbolic links need a POSIX file system")
    end

    catch fs.createdirectory("sb")
    catch fs.createdirectory("outside_dir")
    catch fs.remove("sb/dirlink")
    fs.createlink("sb/dirlink", "../outside_dir")

    local out = in_sandbox([[
print((catch fs.stat("sb/dirlink", { follow = false })))
local ok, st = catch fs.stat("sb/dirlink/", { follow = false })
print(ok and st.kind)
print((catch fs.stat("sb/dirlink/")))]])

    assert(out == "true\nlink\nfalse\n", out)
end

local function a_url_under_a_path_grant_holds_no_other_separator_test()
    local co = coroutine.create(function()
        pledge("network:http=https://api.example.invalid/public/**", "seal")
        local refused = {}

        for _, url in ipairs({
            "https://api.example.invalid/public/a%2f..%2fadmin",
            "https://api.example.invalid/public/a%5C..%5Cadmin",
            "https://api.example.invalid/public/a\\..\\admin",
            "https://api.example.invalid/public/../admin",
            "https://api.example.invalid/admin",
        }) do
            local ok, err = catch network.fetch(url)
            refused[#refused + 1] = not ok and tostring(err):find("denied", 1, true) ~= nil
        end

        return refused
    end)

    local ok, refused = coroutine.resume(co)
    assert(ok, tostring(refused))

    for i, r in ipairs(refused) do
        assert(r, i)
    end
end

local function debug_leaves_runtime_objects_as_they_are_test()
    local db = io.sqlite(":memory:")
    local other = setmetatable({}, {})
    assert(not (catch debug.setmetatable(db, getmetatable(other))))
    assert(not (catch debug.setmetatable(io.stdout, {})))
    assert(not (catch debug.setmetatable(other, debug.getmetatable(io.stdout))))
    assert(not (catch debug.setuservalue(db, {}, 1)))
    db:close()
end

local function debug_is_a_permission_to_pledge_test()
    local exe = os.getenv("LUS_EXE")

    if not exe then
        skip("the interpreter is not reachable, set LUS_EXE")
    end

    local script = io.open("nodebug.lus", "w")

    script:write([[print((catch debug.getregistry()))
print(type(debug.traceback()))
print(pledge("debug"))
print((catch debug.getregistry()))]])

    script:close()
    local out = os.spawn({ exe, "nodebug.lus" }, { stdout = "pipe" }).stdout:read("a")
    assert(out == "false\nstring\ntrue\ntrue\n", out)
end

local function a_catch_handler_runs_above_the_failing_frames_test()
    local function innermost()
        error("boom")
    end

    local function middle()
        local r = innermost()
        return r
    end

    local ok, trace = catch[debug.traceback] middle()
    assert(not ok)
    assert(trace:find("boom", 1, true) and trace:find("innermost", 1, true), trace)
    assert(trace:find("middle", 1, true), trace)
    local order = {}

    local function closing()
        local x <close> = setmetatable({}, {
            __close = function(_, e)
                order[#order + 1] = `close $e`
            end,
        })

        error("first")
    end

    local caught, value = catch[function(e)
        order[#order + 1] = "handler"
        return `seen $(e:match("first"))`
    end] closing()

    assert(not caught and value == "seen first")
    assert(order[1] == "handler" and order[2] == "close seen first", table.concat(order, ","))
end

--[[
    Edges of the interpreter and the code generator.

    Each test reaches one condition of a decision that the other tests
    leave at one value: a to-be-closed variable that holds `false`, a
    finalizer that collects garbage with finalizers of its own, a catch
    handler that is not a function, a float in the immediate form of a
    comparison, a call that spreads its results into a constructor, the
    exact forms of numeric loops, and a hook that runs while another hook
    runs.
]]

local function false_and_nil_need_no_close_test()
    local closed = 0

    do
        local a <close> = false
        local b <close> = nil

        local c <close> = setmetatable({}, {
            __close = function()
                closed = closed + 1
            end,
        })
    end

    assert(closed == 1)
end

local function a_finalizer_may_collect_garbage_with_finalizers_test()
    local ran = {}

    do
        local outer = setmetatable({}, {
            __gc = function()
                local inner = setmetatable({}, {
                    __gc = function()
                        ran[#ran + 1] = "inner"
                    end,
                })

                inner = nil
                collectgarbage()
                ran[#ran + 1] = "outer"
            end,
        })

        outer = nil
    end

    collectgarbage()
    collectgarbage()
    local seen = table.concat(ran, ",")
    assert(seen == "outer,inner" or seen == "inner,outer", seen)
end

local function a_catch_handler_must_be_a_function_test()
    local ok, err = catch (function()
        local h = 5
        return catch[h] error("x")
    end)()

    assert(not ok and err:find("attempt to use a number value as a catch handler", 1, true), err)

    ok, err = catch (function()
        local h = setmetatable({}, {
            __call = function()
                return "handled"
            end,
        })

        return catch[h] error("x")
    end)()

    assert(not ok and err:find("attempt to use a table value as a catch handler", 1, true), err)
end

local function floats_compare_in_immediate_form_test()
    local x = 3
    assert(x + 2.0 == 5.0 and math.type(x + 2.0) == "float")
    assert(x - 1e10 == -9999999997.0)
    assert(not (x < -0.0) and x >= -0.0 and not (x <= 0.5) and x ~= 2.0)
    assert(x * 0.5 == 1.5 and not (x > 1e300) and x < 1e300)
    local z = -0.0
    assert(z == 0 and z >= 0.0 and z <= -0.0 and 1 / (z + 0.0) > 0)
end

local function results_spread_into_constructors_test()
    local function three()
        return 1, 2, 3
    end

    assert(#{ three() } == 3)
    assert(#{ three(), three() } == 4)
    assert(#{ (three()) } == 1)
    assert(#{ three(), nil } == 1)
    local t = { x = 1, three() }
    assert(#t == 3 and t.x == 1)

    local function none()
    end

    assert(#{ none() } == 0 and #{ 1, none() } == 1)
end

local function numeric_loops_take_the_type_of_their_numbers_test()
    local function run(f)
        local out = {}
        f(out)
        return table.concat(out, ",")
    end

    assert(run(function(o)
        for i = 1, 3, 1d do
            o[#o + 1] = math.type(i)
        end
    end) == "decimal,decimal,decimal")

    assert(run(function(o)
        for i = 1n, 2 do
            o[#o + 1] = math.type(i)
        end
    end) == "bigint,bigint")

    assert(run(function(o)
        for i = 0.5, 2, 1n do
            o[#o + 1] = tostring(i)
        end
    end) == "0.5,1.5")

    assert(run(function(o)
        for i = 10n, 1n, -3n do
            o[#o + 1] = tostring(i)
        end
    end) == "10,7,4,1")

    assert(run(function(o)
        for i = 1.5d, 3 do
            o[#o + 1] = tostring(i)
        end
    end) == "1.5,2.5")
end

local function a_hook_does_not_run_inside_a_hook_test()
    local outer, nested = 0, 0

    debug.sethook(function()
        outer = outer + 1
        -- Code inside the hook runs without calling the hook again.
        local s = 0

        for i = 1, 3 do
            s = s + i
        end

        if s ~= 6 then
            nested = nested + 1
        end
    end, "l")

    local x = 0

    for i = 1, 3 do
        x = x + i
    end

    debug.sethook()
    assert(outer > 0 and nested == 0 and x == 6)
end

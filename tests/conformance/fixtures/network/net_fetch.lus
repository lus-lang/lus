local config = worker.peek()
local ok, status, body, headers = catch network.fetch(`http://127.0.0.1:$(config.port)/`, config.method, config.headers)
if ok then
    worker.message({ ok = true, status = status, size = #body, length = headers["content-length"], headers = headers })
else
    worker.message({ ok = false, err = status })
end

-- This script runs under the interpreter with the command line flags
-- debug, version=1.5, count=3, name=alpha, and empty= (see flags_test.lus).
-- It prints one result line per case, which the test file reads back.

local FIXTURE_DIR = string.match(arg[0], "^(.*)/[^/]*$") or "."

local results = {}
local function case(name, fn)
    local ok, err = catch fn()
    if ok then
        print("RESULT\t" .. name .. "\tok")
    else
        print("RESULT\t" .. name .. "\tfail\t" .. tostring(err):gsub("[\r\n]+", " "))
    end
end

-- ============================================
-- Values and types
-- ============================================

-- boolean flag defaults to true
case("boolean_flag_defaults_to_true", function()
    assert(flags.debug == true)
    assert(type(flags.debug) == "boolean")
end)

-- numeric values become numbers
case("numeric_values_become_numbers", function()
    assert(flags.version == 1.5)
    assert(type(flags.version) == "number")
    assert(flags.count == 3)
    assert(flags.count % 1 == 0, "integer text should stay integral")
end)

-- non-numeric values become strings
case("non_numeric_values_become_strings", function()
    assert(flags.name == "alpha")
    assert(type(flags.name) == "string")
end)

-- empty value is the empty string
case("empty_value_is_the_empty_string", function()
    assert(flags.empty == "")
end)

-- absent flags read as nil
case("absent_flags_read_as_nil", function()
    assert(flags.absent == nil)
end)

-- flags is a table and iterable
case("flags_is_a_table_and_iterable", function()
    assert(type(flags) == "table")
    local n = 0
    for k, v in pairs(flags) do n = n + 1 end
    assert(n == 5, "should hold exactly the five CLI flags, got " .. n)
end)

-- ============================================
-- Branch folding
-- ============================================

-- set flag selects then-branch
case("set_flag_selects_then_branch", function()
    local r
    if flags.debug then r = "then" else r = "else" end
    assert(r == "then")
end)

-- absent flag selects else-chain
case("absent_flag_selects_else_chain", function()
    local r
    if flags.absent then r = "then"
    elseif flags.debug then r = "elseif"
    else r = "else" end
    assert(r == "elseif")
end)

-- not-form folds both polarities
case("not_form_folds_both_polarities", function()
    local r
    if not flags.absent then r = "A" end
    assert(r == "A")
    if not flags.debug then r = "B" else r = "C" end
    assert(r == "C")
end)

-- string and number flags are truthy in conditions
case("string_and_number_flags_are_truthy_in_conditions", function()
    local n = 0
    if flags.name then n = n + 1 end
    if flags.version then n = n + 1 end
    if flags.empty then n = n + 1 end -- empty string is truthy
    assert(n == 3)
end)

-- non-foldable shapes still evaluate correctly
case("non_foldable_shapes_still_evaluate_correctly", function()
    local r
    if (flags.debug) then r = "paren" end
    assert(r == "paren")
    if flags.name == "alpha" then r = "eq" end
    assert(r == "eq")
    if flags.debug and flags.absent then r = "and" else r = "noand" end
    assert(r == "noand")
end)

-- shadowed flags does not fold
case("shadowed_flags_does_not_fold", function()
    local flags = {debug = false}
    local r
    if flags.debug then r = "then" else r = "shadow" end
    assert(r == "shadow")
end)

-- folding eliminates the dead branch from generated code
case("folding_eliminates_the_dead_branch_from_generated_code", function()
    local dead = "if flags.debug then return 1 else " ..
                 string.rep("tostring(1) ", 200) .. "end"
    local folded = load(dead)
    local control = load("if NOTAFLAGTABLE then return 1 else " ..
                         string.rep("tostring(1) ", 200) .. "end")
    assert(#string.dump(folded) * 2 < #string.dump(control),
        "folded chunk should be much smaller than unfolded control")
end)

-- dead branches are still syntax-checked
case("dead_branches_are_still_syntax_checked", function()
    local f, err = load("if flags.debug then return 1 else this is nonsense end")
    assert(f == nil and type(err) == "string")
end)

-- ============================================
-- Folding comparisons
-- ============================================

-- a chunk folds when its dump drops the dead branch
local function folds(cond)
    local body = string.rep("tostring(1) ", 200)
    local f = load("if " .. cond .. " then return 'then' else " .. body .. " return 'else' end")
    local g = load("if " .. cond .. " then " .. body .. " return 'then' else return 'else' end")
    return f, g
end

local function assert_folds(cond, expected)
    local f, g = folds(cond)
    assert(f() == expected and g() == expected, cond .. " should be " .. expected)
    local small = expected == "then" and f or g
    local large = expected == "then" and g or f
    assert(#string.dump(small, true) * 4 < #string.dump(large, true), cond .. " should fold")
end

-- comparisons with literals fold
case("comparisons_with_literals_fold", function()
    assert_folds('flags.name == "alpha"', "then")
    assert_folds('flags.name ~= "alpha"', "else")
    assert_folds("flags.count == 3", "then")
    assert_folds("flags.count == 3.0", "then")
    assert_folds("flags.version > 1", "then")
    assert_folds("flags.version >= 1.5", "then")
    assert_folds("flags.version < 1.5", "else")
    assert_folds("flags.count <= 2", "else")
    assert_folds("3 <= flags.count", "then")
    assert_folds("flags.count > -1", "then")
    assert_folds("flags.debug == true", "then")
    assert_folds("flags.debug ~= false", "then")
    assert_folds("flags.absent == nil", "then")
    assert_folds('flags.absent == "alpha"', "else")
    assert_folds('flags.name < "beta"', "then")
    assert_folds('flags["name"] == "alpha"', "then")
    assert_folds("(flags.count) == (3)", "then")
end)

-- and, or and not combine folded conditions
case("and_or_not_combine_folds", function()
    assert_folds('flags.debug and flags.name == "alpha"', "then")
    assert_folds("flags.debug and flags.count > 5", "else")
    assert_folds("flags.absent or flags.count >= 3", "then")
    assert_folds("not (flags.count == 3)", "else")
    assert_folds('not flags.absent and (flags.version < 2 or flags.name == "x")', "then")
end)

-- the left operand of and or or decides alone
case("deciding_left_operand_folds_alone", function()
    local calls = 0
    function bump() calls = calls + 1 return true end
    assert_folds("flags.absent and bump()", "else")
    assert_folds("flags.debug or bump()", "then")
    assert(calls == 0)
end)

-- comparisons that raise or depend on run time do not fold
case("unfoldable_comparisons_keep_run_time_behavior", function()
    local ok, err = catch load("if flags.absent < 3 then return 1 end return 0")()
    assert(ok == false and tostring(err):find("compare") ~= nil)
    ok, err = catch load("if flags.name < 3 then return 1 end return 0")()
    assert(ok == false and tostring(err):find("compare") ~= nil)
    local n = 4
    local f = load("local n = ... if flags.count < n then return 'lt' end return 'ge'")
    assert(f(4) == "lt" and f(2) == "ge")
    local calls = 0
    function bump() calls = calls + 1 return false end
    assert(load("if flags.debug and bump() then return 1 end return 0")() == 0)
    assert(calls == 1)
end)

-- pure library calls with known arguments fold
case("pure_calls_fold", function()
    assert_folds('(flags.name or ""):upper() == "ALPHA"', "then")
    assert_folds('string.find(flags.name, "lp", 1, true) ~= nil', "then")
    assert_folds('(flags.name or ""):find("zz", 1, true)', "else")
    assert_folds("math.floor(flags.version) == 1", "then")
    assert_folds("math.max(flags.count, 10) == 10", "then")
    assert_folds('#flags.name + flags.count == 8', "then")
    assert_folds('flags.name .. "!" == "alpha!"', "then")
    assert_folds('tostring(flags.count) == "3"', "then")
    assert_folds('("a,b,c"):split(",")[2] == "b"', "then")
end)

-- calls outside the pure set do not fold
case("impure_calls_do_not_fold", function()
    local f = load("if math.random(1, 1) == 1 then return 'then' else return 'else' end")
    assert(f() == "then")
    probe = 0
    local g = load("if string.find(flags.name, 'a') and probe == 0 then return 1 end return 2")
    assert(g() == 1)
end)

-- meta locals read flags and feed folded conditions
case("meta_locals_read_flags", function()
    local f = load([[
        local DOUBLE <meta> = flags.count * 2
        local FEATURES <meta> = { sqlite = (flags.name or ""):find("lp") ~= nil }
        if FEATURES.sqlite and DOUBLE == 6 then return DOUBLE end
        return 0
    ]])
    assert(f() == 6)
end)

-- operands skipped by folding still report compile errors
case("skipped_operands_are_still_checked", function()
    local f, err = load("if flags.absent and function() goto nowhere end then end")
    assert(f == nil and tostring(err):find("nowhere") ~= nil)
end)

-- ============================================
-- Rewind integrity
-- ============================================

-- line numbers stay correct after folded branches
case("line_numbers_stay_correct_after_folded_branches", function()
    local g = load("if flags.debug then\nlocal a\nlocal b\nelse\nlocal c\nend\nerror('mark')")
    local ok, err = catch g()
    assert(ok == false)
    assert(tostring(err):find(":7:") ~= nil, "error should be on line 7: " .. tostring(err))
end)

-- break inside dead branch does not leak into the loop
case("break_inside_dead_branch_does_not_leak_into_the_loop", function()
    local n = 0
    for i = 1, 3 do
        if flags.debug then n = n + 1 else break end
    end
    assert(n == 3)
    local m = 0
    for i = 1, 3 do
        if flags.absent then m = m + 100 else m = m + 1 end
    end
    assert(m == 3)
end)

-- closures and to-be-closed locals in dead branches
case("closures_and_to_be_closed_locals_in_dead_branches", function()
    -- the dead branch contains a <close> local and a closure; discarding
    -- it must not disturb the close and upvalue bookkeeping of the LIVE
    -- code sharing the same function
    local closed = false
    local live = 0
    do
        local guard <close> = setmetatable({}, {__close = function()
            closed = true
        end})
        if flags.absent then
            local x <close> = nil
            local fn = function() return x end
            fn()
        end
        local bump = function() live = live + 1 end
        bump()
        assert(not closed, "guard must not close before scope exit")
    end
    assert(live == 1, "live closure should have run")
    assert(closed, "live <close> variable should be closed on scope exit")
end)

-- goto in dead branch
case("goto_in_dead_branch", function()
    local reached = false
    do
        if flags.absent then goto skip end
        reached = true
        ::skip::
    end
    assert(reached)
end)

-- nested folds
case("nested_folds", function()
    local r
    if flags.debug then
        if flags.absent then r = "inner-then" else r = "inner-else" end
    else
        r = "outer-else"
    end
    assert(r == "inner-else")
end)

-- ============================================
-- Reserved-name errors
-- ============================================

-- assigning to flags is a parse error
case("assigning_to_flags_is_a_parse_error", function()
    local f, err = load("flags = 1")
    assert(f == nil)
    assert(tostring(err):find("attempt to assign to const variable 'flags'") ~= nil)
end)

-- function flags() is a parse error
case("function_flags_is_a_parse_error", function()
    local f, err = load("function flags() end")
    assert(f == nil)
    assert(tostring(err):find("const variable 'flags'") ~= nil)
end)

-- declaring global flags is a parse error
case("declaring_global_flags_is_a_parse_error", function()
    local f, err = load("global flags")
    assert(f == nil)
    assert(tostring(err):find("reserved name") ~= nil)
end)

-- writing a field is a runtime readonly error
case("writing_a_field_is_a_runtime_readonly_error", function()
    local ok, err = catch do flags.newfield = 1 end
    assert(ok == false)
    assert(tostring(err):find("readonly") ~= nil)
end)

-- ============================================
-- load() and workers see the same flags
-- ============================================

-- runtime load() folds and reads consistently
case("runtime_load_folds_and_reads_consistently", function()
    local f = load("if flags.debug then return 'folded' else return 'not' end")
    assert(f() == "folded")
    local g = load("return flags.version")
    assert(g() == 1.5)
end)

-- workers see the same flags
case("workers_see_the_same_flags", function()
    local w = worker.create(FIXTURE_DIR .. "/flagscheck.lus")
    local messages = {}
    while true do
        local msg = worker.receive(w)
        if msg == nil then break end
        table.insert(messages, msg)
    end
    assert(messages[1] == true, "worker flags.debug")
    assert(messages[2] == 1.5, "worker flags.version")
    assert(messages[3] == "folded", "worker folding")
end)

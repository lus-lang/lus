-- A file that starts a process in a session of its own, which keeps the
-- output pipes of the file open after the runner kills its process group,
-- and then never ends. The runner leaves its worker behind.
pledge("exec")

-- The perl process forks and returns only once the child has its own
-- session, so the runner never kills the child along with the file.
os.execute("perl -e 'use POSIX; pipe(R, W) or die; if (fork) { close W; <R>; exit } close R; setsid(); close W; sleep 30'")
while true do end

-- Group: create arguments and varargs

local function passes_scalar_varargs_to_the_worker_chunk_test()
    local w = worker.create(gen("myecho"), "hello", 42, 3.14, true)
    local msgs = drain(w)
    assert(msgs[1] == "hello")
    assert(msgs[2] == 42)
    assert(math.type(msgs[2]) == "integer")
    assert(math.abs(msgs[3] - 3.14) <= 0.0000001)
    assert(msgs[4] == true)
end

local function passes_a_table_vararg_to_the_worker_chunk_test()
    local w = worker.create(gen("myecho"), "tag", {x = 1, y = {2, 3}})
    local msgs = drain(w)
    assert(msgs[1] == "tag")
    assert(type(msgs[2]) == "table")
    assert(msgs[2].x == 1)
    assert(msgs[2].y[2] == 3)
end

local function rejects_a_non_serializable_vararg_at_create_time_test()
    raises(function() worker.create(WDIR .. "echo.lus", function() end) end, "cannot serialize")
end

local create_rejects_a_non_string_path_cases = {{nil}, {{}}, {true}}

local function create_rejects_a_non_string_path_test(bad)
        raises(function() worker.create(bad) end, nil)
end

local function create_with_no_arguments_errors_test()
    raises(function() worker.create() end, nil)
end

-- A number path is coerced to a string by luaL_checkstring, so create itself
-- succeeds and the worker instead fails to load the nonexistent file.
local function coerces_a_number_path_and_fails_at_load_test()
    local w = worker.create(42)
    assert(type(w) == "userdata")
    local ok = catch worker.receive(w)
    assert(not ok)
end

------------------------------------------------------------------------------

-- Group: worker-side context guards

-- worker.message and worker.peek are injected only into a running worker's
-- global table. The parent's worker table never exposes them, so referencing
-- them in the main program yields nil and calling that nil raises.
local function worker_message_is_not_exposed_to_the_parent_test()
    assert(worker.message == nil)
    raises(function() worker.message(1) end, nil)
end

local function worker_peek_is_not_exposed_to_the_parent_test()
    assert(worker.peek == nil)
    raises(function() worker.peek() end, nil)
end

------------------------------------------------------------------------------

-- Group: handle surface

local function tostring_of_a_worker_handle_names_the_type_test()
    local w = worker.create(WDIR .. "counter.lus")
    assert(string.find(tostring(w), "worker"))
    drain(w)
end

-- Dropping the only reference to a finished worker handle and collecting must
-- release it without corrupting the pool. A fresh round trip afterward proves
-- the pool still works.
local function collecting_a_finished_worker_handle_leaves_the_pool_usable_test()
    local w = worker.create(WDIR .. "counter.lus")
    drain(w)
    wait_dead(w)
    w = nil
    collectgarbage()
    collectgarbage()
    local w2 = worker.create(WDIR .. "processor.lus")
    worker.send(w2, "again")
    assert(worker.receive(w2) == "GOT: again")
    stop_processor(w2)
end

-- Dropping the only handle to a worker that is still blocked in peek, then
-- collecting, is also safe. The pool keeps its own reference, so the worker
-- keeps running and the pool stays usable. The dropped worker is reclaimed at
-- interpreter shutdown without corrupting the shared pool.
local function collecting_a_still_running_worker_handle_keeps_the_pool_usable_test()
    local w = worker.create(WDIR .. "processor.lus")
    worker.send(w, "ping")
    assert(worker.receive(w) == "GOT: ping")
    w = nil
    collectgarbage()
    collectgarbage()
    local w2 = worker.create(WDIR .. "processor.lus")
    worker.send(w2, "again")
    assert(worker.receive(w2) == "GOT: again")
    stop_processor(w2)
end

------------------------------------------------------------------------------

-- Group: handle lifetime under churn

-- Many workers created and driven to completion, none collected during the
-- loop, must not disturb a freshly created worker. Each worker is fully drained
-- and dead before the next, so this exercises a large backlog of finished
-- handles that ordinary automatic collection reclaims in bursts, with no manual
-- collection at all.
local function a_backlog_of_uncollected_finished_handles_does_not_disturb_a_test()
    local all_ok = true
    for _ = 1, 300 do
        local p = worker.create(WDIR .. "processor.lus")
        worker.send(p, "x")
        if worker.receive(p) ~= "GOT: x" then all_ok = false end
        worker.send(p, "STOP")
        drain(p)
    end
    assert(all_ok)
    local w = worker.create(WDIR .. "processor.lus")
    worker.send(w, "hi")
    assert(worker.receive(w) == "GOT: hi")
    stop_processor(w)
end

------------------------------------------------------------------------------

-- Group: large payloads

local function transports_a_large_message_worker_to_parent_test()
    local w = worker.create(gen("bigmsg"))
    local msgs = drain(w)
    assert(#msgs[1] == 500000)
    assert(msgs[2] == 500000)
end

local function transports_a_large_payload_parent_to_worker_test()
    local w = worker.create(gen("lenecho"))
    worker.send(w, string.rep("z", 300000))
    worker.send(w, "hello" .. string.char(0) .. "world")
    local msgs = stop_processor(w)
    assert(msgs[1] == 300000)
    assert(msgs[2] == 11)
    assert(msgs[3] == "STOPPED")
end

------------------------------------------------------------------------------

-- Group: pledge inheritance boundary

-- The parent granted fs, so a worker inherits it and can read a file.
local function a_worker_inherits_the_parent_s_fs_pledge_test()
    local w = worker.create(gen("wfsread"))
    local msgs = drain(w)
    assert(msgs[1] == true)
end

-- The parent never granted network, so the sealed inherited store denies it.
local function a_worker_is_denied_network_the_parent_never_granted_test()
    local w = worker.create(gen("wnet"))
    local msgs = drain(w)
    assert(msgs[1] == false)
    local err = tostring(msgs[2])
    assert(string.find(err, "permission") ~= nil or string.find(err, "denied") ~= nil)
end

-- A worker cannot escalate its own permissions because its inherited store is
-- sealed, so self-granting network returns false and access stays denied.
local function a_worker_cannot_escalate_to_a_permission_the_parent_lacks_test()
    local w = worker.create(gen("wpledge"))
    local msgs = drain(w)
    assert(msgs[1] == false)
    assert(msgs[2] == false)
    local err = tostring(msgs[3])
    assert(string.find(err, "permission") ~= nil or string.find(err, "denied") ~= nil)
end


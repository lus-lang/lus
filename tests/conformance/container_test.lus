-- ZIP and tar containers in vector.archive (spec/design/archive.md): round
-- trips, archives written by Python's zipfile and tarfile, streaming from
-- open files, and hostile archives that try to write outside the target
-- directory or expand without bound. fixtures/archive/make.py writes the
-- fixtures.

pledge("fs")

local FIXTURES = TEST_DIR .. "/fixtures/archive/"
local SANDBOX = "test_container_sandbox_" .. os.time()
local symlinks = os.platform() ~= "windows" and os.platform() ~= "wasi"

local function fixture(name)
    local f = assert(io.open(FIXTURES .. name, "rb"))
    local v = f:read("a")
    f:close()
    return v
end

local function open_fixture(name)
    return assert(io.open(FIXTURES .. name, "rb"))
end

local function read_text(path)
    local f = io.open(path, "r")

    if not f then
        return nil
    end

    local s = f:read("a")
    f:close()
    return s
end

local function fresh(name)
    local dir = `$SANDBOX/$name`
    catch fs.remove(dir, true)
    return dir
end

local function names(entries)
    local out = {}

    for i, e in ipairs(entries) do
        out[i] = e.name
    end

    return table.concat(out, " ")
end

local function raw_bytes(...)
    local list = { ... }
    local v = vector.create(#list)

    for i, b in ipairs(list) do
        vector.set(v, i - 1, b)
    end

    return v
end

local entries = {
    { name = "docs", kind = "directory" },
    { name = "docs/readme.txt", data = string.rep("hello archive ", 200), mtime = 1700000000 },
    { name = "bin/run.sh", data = "#!/bin/sh\necho hi\n", mode = 493 },
    { name = "link", kind = "symlink", target = "docs/readme.txt" },
    { name = "stored.bin", data = raw_bytes(0, 1, 2, 255), method = "store" },
    { name = string.rep("deep/", 30) .. "file.txt", data = "deep" },
    { name = "café/naïve.txt", data = "unicode" },
    { name = "empty.txt" },
}

local formats = { { "zip" }, { "tar" } }

local function exists(path)
    return (catch fs.type(path))
end

-- ============================================================
-- Round trips
-- ============================================================

local round_trip_cases = formats

local function round_trip_test(format)
    local a = vector.archive[format]
    local packed = a.pack(entries)
    assert(type(packed) == "vector")
    local listed = a.list(packed)
    assert(#listed == #entries)
    assert(
        names(listed)
            == `docs/ docs/readme.txt bin/run.sh link stored.bin $(string.rep("deep/", 30))file.txt café/naïve.txt empty.txt`
    )
    assert(listed[1].kind == "directory" and listed[1].mode == 493)
    assert(
        listed[2].kind == "file"
            and listed[2].size == 2800
            and listed[2].mtime == 1700000000
            and listed[2].mode == 420
    )
    assert(listed[3].mode == 493)
    assert(
        listed[4].kind == "symlink"
            and listed[4].target == "docs/readme.txt"
            and listed[4].size == 0
    )
    assert(listed[8].size == 0)

    if format == "zip" then
        assert(listed[2].method == "deflate" and listed[2].compressed < 100)
        assert(listed[5].method == "store" and listed[5].compressed == 4)
    else
        assert(listed[2].method == nil and listed[2].compressed == nil)
    end

    assert(vector.tostring(a.read(packed, "docs/readme.txt")) == string.rep("hello archive ", 200))
    assert(
        vector.tostring(a.read(packed, "./docs//readme.txt")) == string.rep("hello archive ", 200)
    )
    assert(vector.tostring(a.read(packed, "café/naïve.txt")) == "unicode")
    assert(vector.get(a.read(packed, "stored.bin"), 3) == 255)
    assert(#a.read(packed, "empty.txt") == 0)
    assert(a.read(packed, "missing.txt") == nil)
end

local function pack_store_level_test()
    local data = string.rep("abc", 1000)
    local z = vector.archive.zip
    local stored = z.list(z.pack({ { name = "a", data = data } }, { method = "store" }))
    assert(stored[1].method == "store" and stored[1].compressed == 3000)
    local fast = z.pack({ { name = "a", data = data } }, { level = 1 })
    assert(vector.tostring(z.read(fast, "a")) == data)
    local raw = z.pack({ { name = "a", data = data } }, { level = 0 })
    assert(vector.tostring(z.read(raw, "a")) == data)
end

local pack_errors_cases = formats

local function pack_errors_test(format)
    local a = vector.archive[format]

    raises(function()
        a.pack({ { name = "../x", data = "" } })
    end, "unsafe entry name '%.%./x'")

    raises(function()
        a.pack({ { name = "/abs", data = "" } })
    end, "unsafe entry name '/abs'")

    raises(function()
        a.pack({ { name = "." } })
    end, "unsafe entry name '%.'")

    raises(function()
        a.pack({ { data = "" } })
    end, "bad entry #1 to 'pack' %(field 'name' missing%)")

    raises(function()
        a.pack({ "x" })
    end, "bad entry #1 to 'pack' %(table expected%)")

    raises(function()
        a.pack({ { name = "a", data = {} } })
    end, "field 'data' must be a string or vector")

    raises(function()
        a.pack({ { name = "a", kind = "fifo" } })
    end, "invalid kind 'fifo'")

    raises(function()
        a.pack({ { name = "a", kind = "symlink" } })
    end, "field 'target' missing")

    raises(function()
        a.pack({ { name = "a", mode = 65536 } })
    end, "field 'mode' out of range")

    raises(function()
        a.pack(5)
    end, "bad argument #1 to 'pack' %(table expected")
end

local function zip_method_error_test()
    raises(function()
        vector.archive.zip.pack({ { name = "a", method = "lzma" } })
    end, "invalid method 'lzma'")

    raises(function()
        vector.archive.zip.pack({}, { level = 10 })
    end, "compression level must be 0%-9")
end

-- Long names, long link targets, and times before 1970 or past ustar's
-- range travel in pax records.
local function tar_pax_test()
    local t = vector.archive.tar
    local long = `$(string.rep("x", 150))/$(string.rep("y", 120))`
    local target = string.rep("t/", 80)
    local packed = t.pack({
        { name = long, data = "long" },
        { name = "l", kind = "symlink", target = target },
        { name = "old.txt", data = "old", mtime = -86400 },
    })
    local listed = t.list(packed)
    assert(listed[1].name == long)
    assert(listed[2].target == target)
    assert(listed[3].mtime == -86400)
    assert(vector.tostring(t.read(packed, long)) == "long")
end

-- ============================================================
-- Archives written by Python
-- ============================================================

local python_cases = {
    { "python.zip", "dir/ dir/text.txt dir/run.sh stored.bin café.txt" },
    { "zip64.zip", "big.txt small.txt" },
    { "ustar.tar", "dir/ dir/text.txt dir/run.sh link" },
    {
        "gnu.tar",
        `dir/ dir/text.txt dir/run.sh link long/$(string.rep("x", 120))/name.txt café.txt`,
    },
    {
        "pax.tar",
        `dir/ dir/text.txt dir/run.sh link long/$(string.rep("x", 120))/name.txt café.txt`,
    },
}

local quick_fox = string.rep("The quick brown fox jumps over the lazy dog.\n", 40)

local function python_test(name, want)
    local format = name:match("%.(%a+)$")
    local a = vector.archive[format]
    local data = fixture(name)
    local listed = a.list(data)
    assert(names(listed) == want, names(listed))
    local text = name == "zip64.zip" and "big.txt" or "dir/text.txt"
    assert(vector.tostring(a.read(data, text)) == quick_fox)

    if name ~= "zip64.zip" then
        assert(vector.tostring(a.read(data, "dir/run.sh")) == "#!/bin/sh\necho hi\n")

        for _, e in ipairs(listed) do
            if e.name == "dir/run.sh" then
                assert(e.mode == 493)
            end

            if e.name == "dir/text.txt" then
                assert(e.mtime == 1700000000)
            end
        end
    end

    if format == "tar" then
        assert(listed[4].kind == "symlink" and listed[4].target == "dir/text.txt")
    end
end

-- ============================================================
-- Open files
-- ============================================================

local file_source_cases = formats

local function file_source_test(format)
    local a = vector.archive[format]
    catch fs.createdirectory(SANDBOX)
    local path = `$SANDBOX/source.$format`
    local f = assert(io.open(path, "wb"))
    f:write(a.pack(entries))
    f:close()
    f = assert(io.open(path, "rb"))
    assert(#a.list(f) == #entries)
    assert(vector.tostring(a.read(f, "bin/run.sh")) == "#!/bin/sh\necho hi\n")
    -- Positional reads leave the file position where it was.
    assert(f:seek() == 0)
    f:close()

    raises(function()
        a.list(f)
    end, "attempt to use a closed file")

    raises(function()
        a.list(true)
    end, "bad argument #1 to 'list' %(string, vector, or file expected, got boolean%)")
end

-- ============================================================
-- Unpacking
-- ============================================================

local unpack_cases = formats

local function unpack_test(format)
    if not symlinks then
        skip("symbolic links need a POSIX file system")
    end

    local a = vector.archive[format]
    local dir = fresh("unpack_" .. format)
    local packed = a.pack(entries)
    assert(a.unpack(packed, dir) == #entries)
    assert(read_text(dir .. "/docs/readme.txt") == string.rep("hello archive ", 200))
    assert(read_text(dir .. "/bin/run.sh") == "#!/bin/sh\necho hi\n")
    assert(fs.follow(dir .. "/link") == "docs/readme.txt")
    assert(read_text(dir .. "/link") == string.rep("hello archive ", 200))
    assert(read_text(`$dir/$(string.rep("deep/", 30))file.txt`) == "deep")
    assert(read_text(dir .. "/empty.txt") == "")

    -- A second unpack meets existing files.
    raises(function()
        a.unpack(packed, dir)
    end, `file exists: $(dir:gsub("%p", "%%%0"))/docs/readme.txt`)

    assert(a.unpack(packed, dir, { overwrite = true }) == #entries)
    -- Directories merge with ones already there.
    local more = a.pack({ { name = "docs/more.txt", data = "more" } })
    assert(a.unpack(more, dir) == 1)
    assert(read_text(dir .. "/docs/more.txt") == "more")
    assert(read_text(dir .. "/docs/readme.txt") == string.rep("hello archive ", 200))
end

local unpack_from_file_cases = formats

local function unpack_from_file_test(format)
    local dir = fresh("from_file_" .. format)
    local f = open_fixture(format == "zip" and "python.zip" or "pax.tar")
    vector.archive[format].unpack(f, dir)
    f:close()
    assert(read_text(dir .. "/dir/text.txt") == quick_fox)
end

-- Hostile archives raise before anything is written.
local hostile_cases = {
    { "traversal.tar", "unsafe entry name '%.%./evil%.txt'" },
    { "absolute.tar", "unsafe entry name '/tmp/lus%-evil%.txt'" },
    { "link-escape.tar", "symlink 'sub/esc' points outside the target directory" },
    { "link-absolute.tar", "symlink 'esc' points outside the target directory" },
    { "link-chain.tar", "symlink 'esc' points outside the target directory" },
    { "hardlink.tar", "unsupported entry type 'link' for 'b%.txt'" },
    { "device.tar", "unsupported entry type 'special' for 'null'" },
    { "traversal.zip", "unsafe entry name '%.%./evil%.txt'" },
    { "absolute.zip", "unsafe entry name '/tmp/lus%-evil%.txt'" },
    { "backslash.zip", "unsafe entry name" },
    { "link-escape.zip", "symlink 'esc' points outside the target directory" },
    { "overlap.zip", "invalid ZIP archive %(overlapping entries%)" },
}

local function hostile_test(name, message)
    local format = name:match("%.(%a+)$")
    local dir = fresh("hostile_" .. name)

    raises(function()
        vector.archive[format].unpack(fixture(name), dir)
    end, message)

    assert(not exists(dir), "the target directory was created")
end

-- An entry under a symlink, whether the archive made it or it was there
-- before, is never written through the link.
local function write_through_link_test()
    if not symlinks then
        skip("symbolic links need a POSIX file system")
    end

    local dir = fresh("link_write")

    raises(function()
        vector.archive.tar.unpack(fixture("link-write.tar"), dir)
    end, "cannot write '.-/l/x%.txt' %(a parent is a symlink or a file%)")

    assert(not exists(dir .. "/sub/x.txt"))
    local outside = fresh("outside")
    fs.createdirectory(outside)
    local dir2 = fresh("pre_link")
    fs.createdirectory(dir2)
    fs.createlink(dir2 .. "/pre", "../outside")
    local packed = vector.archive.zip.pack({ { name = "pre/x.txt", data = "evil" } })

    raises(function()
        vector.archive.zip.unpack(packed, dir2)
    end, "a parent is a symlink or a file")

    assert(not exists(outside .. "/x.txt"))
    -- With overwrite, a file replaces a link in its place, never the
    -- file the link points at.
    fs.createlink(dir2 .. "/f.txt", "../outside/target.txt")
    local f = assert(io.open(outside .. "/target.txt", "w"))
    f:write("keep")
    f:close()
    local one = vector.archive.tar.pack({ { name = "f.txt", data = "new" } })

    raises(function()
        vector.archive.tar.unpack(one, dir2)
    end, "file exists")

    vector.archive.tar.unpack(one, dir2, { overwrite = true })
    assert(read_text(dir2 .. "/f.txt") == "new")
    assert(not (catch fs.follow(dir2 .. "/f.txt")))
    assert(read_text(outside .. "/target.txt") == "keep")
end

-- ============================================================
-- Limits and integrity
-- ============================================================

local size_limit_cases = formats

local function size_limit_test(format)
    local a = vector.archive[format]
    -- 64 MiB of zeros deflate to a few dozen kilobytes.
    local big = a.pack({ { name = "zeros", data = string.rep("\0", 64 * 1024 * 1024) } })

    if format == "zip" then
        assert(#big < 200000)
    end

    raises(function()
        a.read(big, "zeros", 1000)
    end, "archive exceeds size limit %(1000 bytes%)")

    local dir = fresh("limit_" .. format)

    raises(function()
        a.unpack(big, dir, { max = 4096 })
    end, "archive exceeds size limit %(4096 bytes%)")

    local many = {}

    for i = 1, 20 do
        many[i] = { name = "f" .. i, data = "x" }
    end

    raises(function()
        a.unpack(a.pack(many), fresh("count_" .. format), { entries = 10 })
    end, "archive exceeds entry limit %(10 entries%)")

    raises(function()
        a.unpack(big, dir, { max = 0 })
    end, "option 'max' out of range")

    raises(function()
        a.unpack(big, dir, { entries = "many" })
    end, "option 'entries' must be an integer")
end

local zip_corrupt_cases = {
    { "crc.zip", "checksum mismatch in 'a%.txt'" },
    { "sizelie.zip", "size of 'a%.txt' does not match its header" },
    { "encrypted.zip", "encrypted entry 'a%.txt' is not supported" },
}

local function zip_corrupt_test(name, message)
    raises(function()
        vector.archive.zip.read(fixture(name), "a.txt")
    end, message)
end

local truncated_cases = formats

local function truncated_test(format)
    local a = vector.archive[format]
    local packed = a.pack(entries)
    -- The two zero blocks that end a tar archive hold no entry, so a cut
    -- inside them loses nothing and the archive still lists.
    local last = format == "tar" and #packed - 1025 or #packed - 1

    for _, n in ipairs({ 0, 10, #packed // 2, last }) do
        local cut = vector.clone(packed)
        vector.resize(cut, n)
        local ok = catch a.list(cut)
        assert(not ok, "a truncated archive listed")
    end
end

local function bad_input_test()
    raises(function()
        vector.archive.zip.list("not a zip archive at all")
    end, "invalid ZIP archive %(no end of central directory%)")

    raises(function()
        vector.archive.tar.list(string.rep("x", 1024))
    end, "invalid tar archive %(bad header checksum%)")

    raises(function()
        vector.archive.tar.read(vector.archive.tar.pack(entries), "docs")
    end, "'docs/' is not a file")
end

local function cleanup_test()
    catch fs.remove(SANDBOX, true)
end

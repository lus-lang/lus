
pledge("load", "fs", "exec", "env=LUS_EXE")


local function io_tempfile_test()
    local f = io.tmpfile()
    assert(io.type(f) == "file")
    f:write("test")
    f:seek("set", 0)
    assert(f:read("*a") == "test")
    f:close()
end

local function os_tmpname_io_open_test()
    local name = os.tmpname()
    local f = io.open(name, "w")
    assert(f)
    f:write("hello")
    f:close()

    f = io.open(name, "r")
    assert(f:read("*a") == "hello")
    f:close()

    fs.remove(name)
end

local function io_popen_test()
    local cmd = "echo hello"
    -- On Windows echo is implicit in cmd.exe.
    local f = io.popen(cmd, "r")
    assert(f)
    local s = f:read("*a")
    -- popen output might contain trailing newline
    assert(string.find(s, "hello"))
    f:close()
end

local windows = package.config:sub(1, 1) == "\\"

local function closing_a_pipe_stops_a_writer_that_never_ends_test()
    -- The writer runs until a write fails. On Windows it is the interpreter
    -- itself, since an endless loop in cmd.exe goes on after its writes fail.
    local cmd = "yes"
    if windows then
        local lus = os.getenv("LUS_EXE")
        if lus == nil then skip("the interpreter is not reachable, set LUS_EXE") end
        cmd = `"$lus" -e "while true do assert(io.write('y\\n')) end"`
    end
    local f = assert(io.popen(cmd, "r"))
    assert(f:read("l") == "y")
    -- Closing returns once the writer has ended on its broken pipe.
    local ok, kind = f:close()
    assert(not ok)
    assert(kind == "exit" or kind == "signal", kind)
end

local function exit_codes_keep_all_their_bits_test()
    if windows then
        local ok, kind, code = os.execute("exit /b 256")
        assert(ok == nil and kind == "exit" and code == 256, code)
        ok, kind, code = io.popen("exit /b 65536"):close()
        assert(ok == nil and kind == "exit" and code == 65536, code)
    else
        local ok, kind, code = os.execute("exit 3")
        assert(ok == nil and kind == "exit" and code == 3, code)
        ok, kind, code = io.popen("exit 7"):close()
        assert(ok == nil and kind == "exit" and code == 7, code)
    end
end

local function file_seek_test()
    local f = io.tmpfile()
    f:write("1234567890")
    f:seek("set", 5)
    assert(f:read(1) == "6")
    f:seek("end", -2) -- 9
    assert(f:read(1) == "9")
    f:close()
end


local function written_text_reads_back_from_a_file_test()
    local path = "files_roundtrip.txt"

    -- Write
    local f = assert(io.open(path, "w"))
    f:write("Hello Container")
    f:close()

    -- Read
    f = assert(io.open(path, "r"))
    local content = f:read("a")
    f:close()

    assert(content == "Hello Container")
    fs.remove(path)
end

-- file:lines leaves the file open at the end of the input and when a loop
-- breaks, as in Lua. Only io.lines(path), which opened the file itself,
-- closes it.
local function file_lines_leaves_the_file_open_test()
    local f = assert(io.open("./lines_open.txt", "w"))
    f:write("a\nb\nc\n")
    f:close()
    local h = assert(io.open("./lines_open.txt"))
    local n = 0
    for _ in h:lines(65536) do n = n + 1 end
    assert(n == 1)
    assert(io.type(h) == "file")
    assert(h:close() == true)
    local g = assert(io.open("./lines_open.txt"))
    for _ in g:lines() do break end
    assert(g:read("l") == "b")
    assert(g:close() == true)
end

-- proc:lines leaves the pipe open, so close returns the status of the
-- program.
local function popen_lines_then_close_returns_the_status_test()
    if not os.execute() then skip("no shell") end
    -- cmd.exe on Windows, /bin/sh elsewhere.
    local windows = package.config:sub(1, 1) == "\\"
    local p = assert(io.popen(windows and "(echo x& echo y& exit 3)" or "printf 'x\\ny\\n'; exit 3"))
    -- cmd.exe ends lines with a carriage return and may print a blank
    -- line of its own, so only lines with a letter count.
    local seen = {}
    for line in p:lines() do
        local word = line:match("%a+")
        if word then seen[#seen + 1] = word end
    end
    assert(table.concat(seen, ",") == "x,y", table.concat(seen, ","))
    local ok, how, code = p:close()
    assert(ok == nil and how == "exit" and code == 3)
end

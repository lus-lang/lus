--[[
  Coverage for the corners of the debug library that db_test.lus, the events tests,
  and closure_test.lus leave open. The focus here is the introspection surface
  that those files touch only lightly: debug.getmetatable and setmetatable on
  non-table values and around __metatable protection, debug.getregistry,
  debug.getuservalue and setuservalue on stdlib userdata, the hook event
  arguments and masks delivered by sethook and reflected by gethook, the field
  completeness of getinfo, the documented return values of getlocal and
  setlocal including negative vararg indices, upvalueid and upvaluejoin
  observable identity, and traceback with message and level arguments.

  Every test either exercises a value the reference Lua 5.5 semantics pin down
  or a Lus stdlib contract from spec/stdlib/debug. The io file handle is
  used as a userdata that carries zero user values, which is the reachable
  pure-Lus fixture for the getuservalue and setuservalue failure paths.
]]

pledge("load", "fs", "debug")

-- The main chunk describes itself as "main" only at file top level, so the
-- observation is captured here rather than inside a nested test closure.
local main_chunk_what = debug.getinfo(1, "S").what

-- A userdata carrying zero user values, reachable from pure Lus.
local fixture_path = "debuglib_fixture.txt"

do
    local f = io.open(fixture_path, "w")
    f:write("fixture")
    f:close()
end

local function open_fixture()
    return io.open(fixture_path, "r")
end

-- ---- debug.getmetatable ----

local function getmetatable_returns_nil_for_a_table_with_no_metatable_test()
    assert(debug.getmetatable({}) == nil)
end

-- The function accepts any type without raising and reports no metatable when
-- the value carries none.
local getmetatable_accepts_a_bare_primitive_without_raising_cases = {
    { true },
    { false },
    { nil },
    { 42 },
    { "" .. math.pi },
}

local function getmetatable_accepts_a_bare_primitive_without_raising_test(v)
    -- The call must not raise. Booleans and nil have no default metatable.
    local ok = catch debug.getmetatable(v)
    assert(ok)
end

local function getmetatable_bypasses_metatable_protection_test()
    local t = setmetatable({}, { __metatable = "locked" })
    -- The public accessor is deflected by the __metatable field.
    assert(getmetatable(t) == "locked")
    -- The debug accessor sees the real metatable table instead.
    local real = debug.getmetatable(t)
    assert(type(real) == "table")
    assert(real.__metatable == "locked")
end

local function all_strings_share_one_metatable_whose_index_is_the_string_li_test()
    local mt = debug.getmetatable("a")
    assert(type(mt) == "table")
    assert(mt == debug.getmetatable("b"))
    assert(mt.__index == string)
end

local function getmetatable_observes_a_metatable_installed_on_a_primitive_b_test()
    local mt = { __name = "num" }
    debug.setmetatable(10, mt)
    -- Numbers share a single metatable across integers and floats.
    assert(debug.getmetatable(7) == mt)
    assert(debug.getmetatable(3.5) == mt)
    debug.setmetatable(10, nil)
    assert(debug.getmetatable(7) == nil)
    assert(debug.getmetatable(3.5) == nil)
end

-- ---- debug.setmetatable ----

local function setmetatable_returns_the_value_it_was_given_table_test()
    local t = {}
    local mt = {}
    assert(debug.setmetatable(t, mt) == t)
    assert(getmetatable(t) == mt)
end

local function setmetatable_returns_the_value_it_was_given_number_test()
    assert(debug.setmetatable(10, {}) == 10)
    debug.setmetatable(10, nil)
end

local function setmetatable_bypasses_metatable_protection_on_a_locked_table_test()
    local t = setmetatable({}, { __metatable = "locked" })

    -- The public setmetatable refuses a protected metatable.
    raises(function()
        setmetatable(t, {})
    end, "protected")

    -- The debug variant replaces it and returns the table.
    local mt2 = { tag = "replaced" }
    assert(debug.setmetatable(t, mt2) == t)
    assert(debug.getmetatable(t) == mt2)
end

local function setmetatable_accepts_a_boolean_value_and_clears_it_again_test()
    local mt = { __name = "boolmt" }
    debug.setmetatable(true, mt)
    -- Both boolean values share the boolean metatable.
    assert(debug.getmetatable(false) == mt)
    debug.setmetatable(true, nil)
    assert(debug.getmetatable(false) == nil)
end

local function setmetatable_accepts_nil_as_the_value_and_clears_it_again_test()
    local mt = { __name = "nilmt" }
    debug.setmetatable(nil, mt)
    assert(debug.getmetatable(nil) == mt)
    debug.setmetatable(nil, nil)
    assert(debug.getmetatable(nil) == nil)
end

local function setmetatable_with_nil_clears_a_table_metatable_test()
    local t = setmetatable({}, {})
    assert(getmetatable(t) ~= nil)
    assert(debug.setmetatable(t, nil) == t)
    assert(getmetatable(t) == nil)
end

local function setmetatable_raises_when_the_second_argument_is_neither_tabl_test()
    raises(function()
        debug.setmetatable({}, 42)
    end)

    raises(function()
        debug.setmetatable({}, "x")
    end)
end

-- ---- debug.getregistry ----

local function getregistry_returns_a_table_test()
    assert(type(debug.getregistry()) == "table")
end

local function getregistry_identity_is_stable_across_calls_test()
    assert(debug.getregistry() == debug.getregistry())
end

local function a_write_into_the_registry_persists_to_a_fresh_getregistry_ca_test()
    local key = "debuglib_probe_key"
    local reg = debug.getregistry()
    assert(reg[key] == nil)
    reg[key] = { marker = 123 }
    local reg2 = debug.getregistry()
    assert(reg2[key].marker == 123)
    -- Clean up so the shared registry is left as it was found.
    reg[key] = nil
    assert(debug.getregistry()[key] == nil)
end

-- ---- debug.getuservalue ----

local function getuservalue_on_a_zero_slot_userdata_reports_no_value_test()
    local f = open_fixture()
    local v, present = debug.getuservalue(f, 1)
    f:close()
    -- An io file allocates no user values, so slot 1 is absent.
    assert(v == nil)
    assert(present == nil or present == false)
end

local getuservalue_returns_fail_for_a_non_userdata_first_argument_cases = {
    { 42 },
    { "hello" },
    { true },
    { {} },
}

local function getuservalue_returns_fail_for_a_non_userdata_first_argument_test(v)
    -- The call reports failure rather than raising.
    local ok, res = catch debug.getuservalue(v, 1)
    assert(ok)
    assert(res == nil)
end

local getuservalue_returns_fail_for_an_out_of_range_slot_index_cases = {
    { 0 },
    { -1 },
    { 100 },
}

local function getuservalue_returns_fail_for_an_out_of_range_slot_index_test(n)
    local f = open_fixture()
    local v = debug.getuservalue(f, n)
    f:close()
    assert(v == nil)
end

local function getuservalue_defaults_the_slot_index_to_1_test()
    local f = open_fixture()
    -- Omitting n behaves like passing 1, which is absent for an io file.
    local a = debug.getuservalue(f)
    local b = debug.getuservalue(f, 1)
    f:close()
    assert(a == nil)
    assert(b == nil)
end

-- ---- debug.setuservalue ----

local function setuservalue_returns_fail_when_the_slot_is_out_of_range_test()
    local f = open_fixture()
    -- The io file has zero slots, so writing slot 1 fails.
    local res = debug.setuservalue(f, "x", 1)
    f:close()
    assert(res == nil)
end

local function setuservalue_raises_when_the_first_argument_is_not_full_user_test()
    raises(function()
        debug.setuservalue({}, 1)
    end)

    raises(function()
        debug.setuservalue(42, 1)
    end)
end

local function setuservalue_raises_when_the_value_argument_is_missing_test()
    local f = open_fixture()
    -- The value is mandatory, so calling with only the userdata raises.
    local ok = catch debug.setuservalue(f)
    f:close()
    assert(not ok)
end

-- ---- debug.sethook / gethook ----

local function gethook_round_trips_the_installed_function_mask_and_count_test()
    local function h()
    end

    debug.sethook(h, "cr")
    local fn, mask, count = debug.gethook()
    debug.sethook()
    assert(fn == h)
    assert(string.find(mask, "c") ~= nil)
    assert(string.find(mask, "r") ~= nil)
    assert(count == 0)
end

local function a_bare_sethook_clears_the_hook_and_gethook_then_reports_nil_test()
    debug.sethook(function()
    end, "l")

    assert(debug.gethook() ~= nil)
    debug.sethook()
    assert(debug.gethook() == nil)
end

local function a_return_mask_hook_fires_and_reports_the_return_event_test()
    local saw = {}

    debug.sethook(function(ev)
        saw[ev] = true
    end, "r")

    local function inner()
        return 1
    end

    inner()
    debug.sethook()
    assert(saw["return"] == true)
end

local function a_call_and_return_mask_delivers_both_event_kinds_test()
    local saw = {}

    debug.sethook(function(ev)
        saw[ev] = true
    end, "cr")

    local function inner()
        return 1
    end

    inner()
    debug.sethook()
    assert(saw.call == true)
    assert(saw["return"] == true)
end

local function a_line_mask_hook_receives_the_current_line_number_as_its_sec_test()
    local kind = nil

    debug.sethook(function(ev, ln)
        if ev == "line" and kind == nil then
            kind = type(ln)
        end
    end, "l")

    local a = 1
    local b = a + 1
    debug.sethook()
    assert(kind == "number")
end

local function a_count_hook_reports_the_count_and_the_count_event_test()
    local n = 0
    local sawcount = false

    debug.sethook(function(ev)
        n = n + 1

        if ev == "count" then
            sawcount = true
        end
    end, "", 1)

    for i = 1, 50 do
    end

    local _, mask, count = debug.gethook()
    debug.sethook()
    assert(count == 1)
    assert(n > 0)
    assert(sawcount)
end

local function a_hook_installed_on_a_coroutine_fires_during_resume_and_leav_test()
    local events = {}

    local co = coroutine.create(function()
        local y = 1
        return y
    end)

    debug.sethook(co, function(ev)
        events[#events + 1] = ev
    end, "c")

    -- The main thread still has no hook of its own.
    assert(debug.gethook() == nil)
    coroutine.resume(co)
    assert(#events > 0)
    -- The coroutine reports its own hook and mask.
    local fn, mask = debug.gethook(co)
    assert(type(fn) == "function")
    assert(string.find(mask, "c") ~= nil)
end

-- ---- debug.getinfo ----

local function getinfo_fills_every_documented_field_for_a_lua_function_test()
    local function subject(a, b)
        return a + b
    end

    local info = debug.getinfo(subject)

    for _, field in ipairs({
        "source",
        "short_src",
        "currentline",
        "what",
        "nups",
        "nparams",
        "isvararg",
        "func",
        "linedefined",
        "lastlinedefined",
    }) do
        assert(info[field] ~= nil)
    end

    assert(info.what == "Lua")
    assert(info.nparams == 2)
    assert(info.isvararg == false)
    assert(info.func == subject)
end

local function getinfo_reports_the_main_chunk_as_what_main_test()
    assert(main_chunk_what == "main")
    -- A nested Lua function at this call site is instead what == 'Lua'.
    assert(debug.getinfo(1, "S").what == "Lua")
end

local function getinfo_names_a_global_call_site_as_namewhat_global_test()
    -- A bare global call site is described by namewhat 'global'.
    function myglobalfn()
        return debug.getinfo(1, "n").namewhat
    end

    assert(myglobalfn() == "global")
    myglobalfn = nil
end

local function getinfo_currentline_tracks_the_executing_line_of_a_running_l_test()
    local first = debug.getinfo(1, "l").currentline
    local second = debug.getinfo(1, "l").currentline
    -- The two probes are on adjacent source lines.
    assert(second == first + 1)
end

local function getinfo_with_l_returns_an_activelines_table_keyed_by_line_nu_test()
    local function subject()
        return 1
    end

    local info = debug.getinfo(subject, "L")
    assert(type(info.activelines) == "table")
    -- The definition body spans real lines, so at least one is active.
    local any = false

    for _ in pairs(info.activelines) do
        any = true
        break
    end

    assert(any)
end

-- ---- debug.getlocal / setlocal ----

local function setlocal_returns_the_name_of_the_variable_it_wrote_test()
    local co = coroutine.create(function()
        local a = 1
        local b = 2
        coroutine.yield()
    end)

    coroutine.resume(co)
    assert(debug.setlocal(co, 1, 1, 10) == "a")
    assert(debug.setlocal(co, 1, 2, 20) == "b")
    local _, v = debug.getlocal(co, 1, 1)
    assert(v == 10)
end

local out_of_range_positive_local_indices_return_nil_cases = {
    { 50 },
    { 99 },
    { 1000 },
}

local function out_of_range_positive_local_indices_return_nil_test(idx)
    local co = coroutine.create(function()
        local a = 1
        coroutine.yield()
    end)

    coroutine.resume(co)
    assert(debug.getlocal(co, 1, idx) == nil)
    assert(debug.setlocal(co, 1, idx, 0) == nil)
end

local function level_based_setlocal_in_the_running_thread_is_observed_by_th_test()
    local x = 5
    -- Rewrite this frame's own first local, then read it back normally.
    local name = debug.setlocal(1, 1, 42)
    assert(name == "x")
    assert(x == 42)
end

local function a_negative_local_index_writes_and_reads_a_vararg_slot_test()
    local function foo(...)
        local before = select(1, ...)
        assert(before == 7)
        local name = debug.setlocal(1, -1, 99)
        assert(name == "(vararg)")
        local rn, rv = debug.getlocal(1, -1)
        assert(rn == "(vararg)")
        assert(rv == 99)
    end

    foo(7, 8, 9)
end

local function type_changing_local_writes_round_trip_through_getlocal_test()
    local function bar()
        local x = 5
        debug.setlocal(1, 1, nil)
        local _, after_nil = debug.getlocal(1, 1)
        assert(after_nil == nil)
        debug.setlocal(1, 1, { tag = "t" })
        local _, after_tab = debug.getlocal(1, 1)
        assert(type(after_tab) == "table")
        assert(after_tab.tag == "t")
    end

    bar()
end

-- ---- debug.upvalueid / upvaluejoin ----

local function upvalueid_returns_a_userdata_identity_distinct_per_upvalue_test()
    local a, b = 1, 2

    local function f()
        return a + b
    end

    local ida = debug.upvalueid(f, 1)
    local idb = debug.upvalueid(f, 2)
    assert(type(ida) == "userdata")
    assert(ida ~= idb)
    -- Repeated queries return the same identity for the same slot.
    assert(debug.upvalueid(f, 1) == ida)
end

local function closures_sharing_an_upvalue_report_the_same_upvalueid_test()
    local shared = 10

    local function f()
        return shared
    end

    local function g()
        shared = shared + 1
        return shared
    end

    assert(debug.upvalueid(f, 1) == debug.upvalueid(g, 1))
end

local function upvaluejoin_makes_one_closure_observe_another_closure_s_upva_test()
    local x, y = 1, 2

    local function f1()
        return x
    end

    local function f2()
        return y
    end

    assert(f1() == 1)
    -- After joining, f1's first upvalue aliases f2's first upvalue.
    debug.upvaluejoin(f1, 1, f2, 1)
    y = 99
    assert(f1() == 99)
    assert(debug.upvalueid(f1, 1) == debug.upvalueid(f2, 1))
end

-- ---- debug.traceback ----

local function traceback_prepends_the_message_and_includes_the_traceback_he_test()
    local tb = debug.traceback("my marker message")
    assert(string.find(tb, "^my marker message\n") ~= nil)
    assert(tb:find("stack traceback"))
end

local function traceback_with_a_deeper_level_starts_higher_up_the_stack_test()
    local function deepest()
        -- Level 2 skips this frame and reports the caller instead.
        return debug.traceback("marker", 2)
    end

    local function caller()
        return deepest()
    end

    local tb = caller()
    assert(string.find(tb, "^marker\n") ~= nil)
    -- The 'deepest' frame is skipped by the level-2 request.
    assert(string.find(tb, "deepest") == nil)
end

local function traceback_returns_a_non_string_message_argument_unchanged_test()
    local marker = {}
    assert(debug.traceback(marker) == marker)
    assert(debug.traceback(marker, 3) == marker)
end

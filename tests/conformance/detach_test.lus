-- Detached coroutines (spec/design/coroutines.md): `coroutine.detach`
-- hands a coroutine to the scheduler of the state, `coroutine.resume`
-- waits for its end, a plain `coroutine.yield` inside it lets the others
-- run, and `coroutine.close` cancels it. Every test collects the
-- coroutines it detaches, so no test leaves one behind.

local create, detach, resume, yield = coroutine.create, coroutine.detach, coroutine.resume, coroutine.yield
local status, close = coroutine.status, coroutine.close

-- Packs every return value with its count, so trailing nils compare too.
local function pack(...)
    return { n = select("#", ...), ... }
end

local function spawn(f, ...)
    return detach(create(f), ...)
end

local function closer(log, name)
    return setmetatable({}, { __close = function()
        log[#log + 1] = name
    end })
end

-- ===== The return values of resume =====

-- Every body below runs once as a plain coroutine and once detached. The
-- two resumes must return exactly the same values.
local function same_results(body, ...)
    local plain = pack(resume(create(body), ...))
    local co = spawn(body, ...)
    local detached = pack(resume(co))
    assert(plain.n == detached.n, `count $(plain.n) vs $(detached.n)`)
    for i = 1, plain.n do
        assert(rawequal(plain[i], detached[i]) or plain[i] == detached[i], `value $(i): $(tostring(plain[i])) vs $(tostring(detached[i]))`)
    end
    return plain, co
end

local function resume_returns_true_and_the_results_test()
    local r = same_results(function(a, b)
        return a + b, "x", nil, false
    end, 2, 3)
    assert(r.n == 5 and r[1] == true and r[2] == 5 and r[3] == "x" and r[4] == nil and r[5] == false)
end

local function resume_returns_true_alone_for_no_results_test()
    local r = same_results(function() end)
    assert(r.n == 1 and r[1] == true)
end

local function resume_keeps_trailing_nils_test()
    local r = same_results(function()
        return nil, nil
    end)
    assert(r.n == 3 and r[1] == true)
end

local function resume_returns_false_and_the_message_test()
    local function body()
        error("broken", 0)
    end
    local r = same_results(body)
    assert(r.n == 2 and r[1] == false and r[2] == "broken")
end

local function resume_returns_the_error_position_test()
    local function body()
        local t = nil
        return t.field
    end
    local r = same_results(body)
    assert(r.n == 2 and r[1] == false and string.find(r[2], "detach_test.lus:%d+: attempt to index a nil value"))
end

local function resume_returns_the_error_object_itself_test()
    local object = { code = 7 }
    local r = same_results(function()
        error(object)
    end)
    assert(r.n == 2 and r[1] == false and rawequal(r[2], object))
end

local function resume_of_a_runtime_error_inside_a_nested_call_test()
    local function deep(n)
        if n == 0 then
            error("bottom", 0)
        end
        return deep(n - 1) + 1
    end
    local r = same_results(deep, 20)
    assert(r[1] == false and r[2] == "bottom")
end

local function resume_of_a_dead_coroutine_test()
    local plain = create(function()
        return 1
    end)
    assert(resume(plain))
    local expected = pack(resume(plain))
    local co = spawn(function()
        return 1
    end)
    assert(resume(co))
    local got = pack(resume(co))
    assert(expected.n == 2 and expected[1] == false and expected[2] == "cannot resume dead coroutine")
    assert(got.n == expected.n and got[1] == expected[1] and got[2] == expected[2])
end

local function a_second_collection_finds_a_dead_coroutine_test()
    local co = spawn(function()
        return "once"
    end)
    local first = pack(resume(co))
    assert(first.n == 2 and first[1] == true and first[2] == "once")
    for _ = 1, 3 do
        local again = pack(resume(co))
        assert(again.n == 2 and again[1] == false and again[2] == "cannot resume dead coroutine")
    end
    assert(status(co) == "dead")
end

local function a_second_collection_of_an_error_finds_a_dead_coroutine_test()
    local co = spawn(function()
        error("first", 0)
    end)
    local first = pack(resume(co))
    assert(first.n == 2 and first[1] == false and first[2] == "first")
    local again = pack(resume(co))
    assert(again.n == 2 and again[1] == false and again[2] == "cannot resume dead coroutine")
end

local function resume_of_a_plain_coroutine_is_unchanged_test()
    local co = create(function(a)
        local b = yield(a + 1)
        local c, d = yield(b * 2, "two")
        return c, d, "end"
    end)
    local r = pack(resume(co, 1))
    assert(r.n == 2 and r[1] == true and r[2] == 2)
    r = pack(resume(co, 10))
    assert(r.n == 3 and r[1] == true and r[2] == 20 and r[3] == "two")
    r = pack(resume(co, "c", nil))
    assert(r.n == 4 and r[1] == true and r[2] == "c" and r[3] == nil and r[4] == "end")
    r = pack(resume(co))
    assert(r.n == 2 and r[1] == false and r[2] == "cannot resume dead coroutine")
end

local function resume_ignores_extra_arguments_for_a_detached_coroutine_test()
    local seen
    local co = spawn(function(...)
        seen = pack(...)
        local back = pack(yield())
        return back.n
    end, "start")
    local r = pack(resume(co, "ignored", "also ignored"))
    assert(r.n == 2 and r[1] == true and r[2] == 0)
    assert(seen.n == 1 and seen[1] == "start")
end

local function resume_rejects_what_is_no_coroutine_test()
    raises(function()
        resume(42)
    end, "thread")
    raises(function()
        detach(42)
    end, "thread")
    raises(function()
        detach()
    end, "thread")
end

-- ===== detach =====

local function detach_returns_the_coroutine_test()
    local co = create(function() end)
    assert(detach(co) == co)
    assert(resume(co))
end

local function detach_passes_the_start_arguments_test()
    local co = spawn(function(...)
        return select("#", ...), ...
    end, 1, nil, "three", nil)
    local r = pack(resume(co))
    assert(r.n == 6 and r[2] == 4 and r[3] == 1 and r[4] == nil and r[5] == "three" and r[6] == nil)
end

local function detach_defers_the_first_run_test()
    local ran = false
    local co = spawn(function()
        ran = true
    end)
    assert(not ran and status(co) == "suspended")
    assert(resume(co))
    assert(ran and status(co) == "dead")
end

local function detach_of_a_resumed_coroutine_finishes_its_yield_test()
    local co = create(function(a)
        local b, c = yield(a * 2)
        return a, b, c
    end)
    local ok, doubled = resume(co, 21)
    assert(ok and doubled == 42)
    assert(detach(co, "x", "y") == co)
    local r = pack(resume(co))
    assert(r.n == 4 and r[1] == true and r[2] == 21 and r[3] == "x" and r[4] == "y")
end

local function detach_of_a_resumed_coroutine_without_arguments_test()
    local co = create(function()
        return select("#", yield("first"))
    end)
    assert(resume(co))
    detach(co)
    local ok, n = resume(co)
    assert(ok and n == 0)
end

local function detach_rejects_a_dead_coroutine_test()
    local co = create(function() end)
    assert(resume(co))
    raises(function()
        detach(co)
    end, "cannot detach a dead coroutine")
    local failed = create(function()
        error("x")
    end)
    assert(not resume(failed))
    raises(function()
        detach(failed)
    end, "cannot detach a dead coroutine")
end

local function detach_rejects_a_running_coroutine_test()
    local message
    local co = create(function()
        local ok, err = catch detach(coroutine.running())
        message = err
        return ok
    end)
    local ok, inner = resume(co)
    assert(ok and inner == false)
    assert(string.find(message, "cannot detach a running coroutine", 1, true))
end

local function detach_rejects_a_normal_coroutine_test()
    local message
    local outer
    outer = create(function()
        local inner = create(function()
            local ok, err = catch detach(outer)
            message = err
        end)
        assert(resume(inner))
    end)
    assert(resume(outer))
    assert(string.find(message, "cannot detach a normal coroutine", 1, true))
end

local function detach_rejects_a_detached_coroutine_test()
    local co = spawn(function() end)
    raises(function()
        detach(co)
    end, "cannot detach a detached coroutine")
    assert(resume(co))
    raises(function()
        detach(co)
    end, "cannot detach a detached coroutine")
end

local function detach_rejects_the_main_thread_test()
    local main = coroutine.running()
    raises(function()
        detach(main)
    end, "cannot detach the main thread")
    local message
    local co = create(function()
        local ok, err = catch detach(main)
        message = err
    end)
    assert(resume(co))
    assert(string.find(message, "cannot detach the main thread", 1, true))
end

local function a_detached_coroutine_is_no_main_thread_test()
    local co = spawn(function()
        local me, ismain = coroutine.running()
        return me, ismain, coroutine.isyieldable(), status(me)
    end)
    local ok, me, ismain, yieldable, st = resume(co)
    assert(ok and me == co and ismain == false and yieldable == true and st == "running")
end

-- ===== yield =====

local function yield_returns_nothing_and_drops_its_values_test()
    local co = spawn(function()
        local back = pack(yield(1, 2, 3))
        return back.n
    end)
    local r = pack(resume(co))
    assert(r.n == 2 and r[1] == true and r[2] == 0)
end

local function yield_takes_turns_in_arrival_order_test()
    local log = {}
    local function body(name, n)
        for i = 1, n do
            log[#log + 1] = name .. i
            yield()
        end
        return name
    end
    local a = spawn(body, "a", 3)
    local b = spawn(body, "b", 3)
    local c = spawn(body, "c", 2)
    assert(select(2, resume(a)) == "a")
    assert(select(2, resume(b)) == "b")
    assert(select(2, resume(c)) == "c")
    assert(table.concat(log, " ") == "a1 b1 c1 a2 b2 c2 a3 b3")
end

local function a_coroutine_detached_later_joins_the_end_of_the_queue_test()
    local log = {}
    local late
    local first = spawn(function()
        log[#log + 1] = "first 1"
        late = spawn(function()
            log[#log + 1] = "late 1"
            yield()
            log[#log + 1] = "late 2"
        end)
        yield()
        log[#log + 1] = "first 2"
        yield()
        log[#log + 1] = "first 3"
    end)
    local second = spawn(function()
        log[#log + 1] = "second 1"
        yield()
        log[#log + 1] = "second 2"
    end)
    assert(resume(first))
    assert(resume(second))
    assert(resume(late))
    assert(table.concat(log, ", ") == "first 1, second 1, late 1, first 2, second 2, late 2, first 3")
end

local function no_coroutine_starves_test()
    local turns = { 0, 0, 0, 0 }
    local stop = false
    local workers = {}
    for i = 1, 4 do
        workers[i] = spawn(function()
            while not stop do
                turns[i] = turns[i] + 1
                yield()
            end
        end)
    end
    local counter = spawn(function()
        for _ = 1, 500 do
            yield()
        end
        stop = true
    end)
    assert(resume(counter))
    for i = 1, 4 do
        assert(resume(workers[i]))
        assert(turns[i] >= 500 and turns[i] <= 502, `worker $(i) took $(turns[i]) turns`)
    end
end

local function yield_in_a_plain_coroutine_inside_a_detached_one_test()
    local co = spawn(function()
        local gen = create(function()
            for i = 1, 3 do
                yield(i * 10)
            end
            return "end"
        end)
        local seen = {}
        while true do
            local ok, v = resume(gen)
            assert(ok)
            seen[#seen + 1] = v
            if status(gen) == "dead" then
                break
            end
            yield()
        end
        return table.concat(seen, " ")
    end)
    local ok, text = resume(co)
    assert(ok and text == "10 20 30 end")
end

local function wrap_works_inside_a_detached_coroutine_test()
    local co = spawn(function()
        local next = coroutine.wrap(function()
            for i = 1, 4 do
                yield(i)
            end
        end)
        local sum = 0
        for i = 1, 4 do
            sum = sum + next()
            yield()
        end
        return sum
    end)
    local ok, sum = resume(co)
    assert(ok and sum == 10)
end

local function yield_across_a_native_call_still_raises_test()
    local co = spawn(function()
        local t = { 3, 1, 2 }
        local ok, err = catch table.sort(t, function(a, b)
            yield()
            return a < b
        end)
        return ok, err
    end)
    local done, ok, err = resume(co)
    assert(done and ok == false and string.find(err, "attempt to yield across a C-call boundary", 1, true))
end

local function many_yields_in_a_hot_loop_test()
    local function body(n)
        local sum = 0
        for i = 1, n do
            sum = sum + i
            if i % 7 == 0 then
                yield()
            end
        end
        return sum
    end
    local a = spawn(body, 20000)
    local b = spawn(body, 30000)
    local ok, sa = resume(a)
    assert(ok and sa == 20000 * 20001 // 2)
    local ok2, sb = resume(b)
    assert(ok2 and sb == 30000 * 30001 // 2)
end

-- ===== status =====

local function status_of_a_detached_coroutine_test()
    local inner_status
    local target = spawn(function()
        yield()
        yield()
        return 1
    end)
    local waiter = spawn(function()
        return resume(target)
    end)
    local observer = spawn(function()
        yield()
        inner_status = status(waiter)
    end)
    assert(status(target) == "suspended")
    assert(resume(observer))
    -- The waiter was waiting for the target while the observer ran.
    assert(inner_status == "suspended")
    local ok, ok2, v = resume(waiter)
    assert(ok and ok2 and v == 1)
    assert(status(target) == "dead" and status(waiter) == "dead")
end

local function the_thread_that_runs_the_scheduler_is_normal_test()
    local main = coroutine.running()
    local co = spawn(function()
        return status(main)
    end)
    local ok, st = resume(co)
    assert(ok and st == "normal")
end

-- ===== Waiting for the end of a coroutine =====

local function results_wait_for_the_first_resume_test()
    local finished = false
    local early = spawn(function()
        finished = true
        return "kept", 2
    end)
    local other = spawn(function()
        yield()
        yield()
    end)
    assert(resume(other))
    assert(finished and status(early) == "dead")
    collectgarbage()
    local r = pack(resume(early))
    assert(r.n == 3 and r[1] == true and r[2] == "kept" and r[3] == 2)
end

local function an_error_waits_for_the_first_resume_test()
    local early = spawn(function()
        error("kept error", 0)
    end)
    local other = spawn(function()
        yield()
    end)
    assert(resume(other))
    assert(status(early) == "dead")
    collectgarbage()
    local r = pack(resume(early))
    assert(r.n == 2 and r[1] == false and r[2] == "kept error")
end

local function several_waiters_all_receive_the_results_test()
    local target = spawn(function()
        for _ = 1, 5 do
            yield()
        end
        return "shared", 99
    end)
    local waiters = {}
    for i = 1, 4 do
        waiters[i] = spawn(function()
            return resume(target)
        end)
    end
    for i = 1, 4 do
        local r = pack(resume(waiters[i]))
        assert(r.n == 4 and r[1] == true and r[2] == true and r[3] == "shared" and r[4] == 99, `waiter $(i)`)
    end
    -- Every waiter collected the results, so a new resume finds it dead.
    local late = pack(resume(target))
    assert(late.n == 2 and late[1] == false and late[2] == "cannot resume dead coroutine")
end

local function several_waiters_all_receive_the_error_test()
    local object = {}
    local target = spawn(function()
        yield()
        error(object)
    end)
    local waiters = {}
    for i = 1, 3 do
        waiters[i] = spawn(function()
            return resume(target)
        end)
    end
    for i = 1, 3 do
        local r = pack(resume(waiters[i]))
        assert(r.n == 3 and r[1] == true and r[2] == false and rawequal(r[3], object))
    end
end

local function the_main_chunk_and_a_coroutine_wait_together_test()
    local target = spawn(function()
        for _ = 1, 3 do
            yield()
        end
        return "both"
    end)
    local waiter = spawn(function()
        return resume(target)
    end)
    -- The waiter is already waiting when the main chunk resumes.
    local warm = spawn(function()
        yield()
    end)
    assert(resume(warm))
    local ok, v = resume(target)
    assert(ok and v == "both")
    local ok2, ok3, v2 = resume(waiter)
    assert(ok2 and ok3 and v2 == "both")
end

local function a_detached_coroutine_waits_for_another_test()
    local log = {}
    local inner = spawn(function()
        log[#log + 1] = "inner start"
        yield()
        log[#log + 1] = "inner end"
        return 5
    end)
    local outer = spawn(function()
        log[#log + 1] = "outer start"
        local ok, v = resume(inner)
        log[#log + 1] = "outer end"
        return ok, v * 2
    end)
    local bystander = spawn(function()
        log[#log + 1] = "bystander"
    end)
    local ok, ok2, v = resume(outer)
    assert(ok and ok2 and v == 10)
    assert(resume(bystander))
    assert(table.concat(log, ", ") == "inner start, outer start, bystander, inner end, outer end")
end

local function a_chain_of_waiters_test()
    local function link(depth)
        if depth == 0 then
            yield()
            return 0
        end
        local below = spawn(link, depth - 1)
        local ok, v = resume(below)
        assert(ok)
        return v + 1
    end
    local top = spawn(link, 50)
    local ok, v = resume(top)
    assert(ok and v == 50)
end

local function a_plain_coroutine_inside_a_detached_one_waits_test()
    local target = spawn(function()
        yield()
        yield()
        return "through"
    end)
    local outer = spawn(function()
        local plain = create(function(prefix)
            local ok, v = resume(target)
            local again = yield(prefix .. v)
            return again, ok
        end)
        local ok, v = resume(plain, "went ")
        assert(ok and v == "went through", tostring(v))
        assert(status(plain) == "suspended")
        local ok2, a, b = resume(plain, "more")
        assert(ok2 and a == "more" and b == true)
        assert(status(plain) == "dead")
        return v
    end)
    local ok, v = resume(outer)
    assert(ok and v == "went through")
end

local function two_levels_of_plain_coroutines_wait_test()
    local target = spawn(function()
        for _ = 1, 4 do
            yield()
        end
        return 7
    end)
    local outer = spawn(function()
        local middle = create(function()
            local inner = coroutine.wrap(function()
                local ok, v = resume(target)
                yield(v)
                return v + 1
            end)
            local first = inner()
            local second = inner()
            return first, second
        end)
        return resume(middle)
    end)
    local r = pack(resume(outer))
    assert(r.n == 4 and r[1] == true and r[2] == true and r[3] == 7 and r[4] == 8)
end

local function a_wait_inside_a_native_call_runs_the_scheduler_test()
    -- The comparator of table.sort cannot suspend, so its resume keeps
    -- the coroutine on the stack and runs the scheduler until the target
    -- ends.
    local target = spawn(function()
        for _ = 1, 3 do
            yield()
        end
        return "sorted"
    end)
    local collected
    local outer = spawn(function()
        local t = { 3, 1, 2 }
        table.sort(t, function(a, b)
            if not collected then
                local ok, v = resume(target)
                assert(ok)
                collected = v
            end
            return a < b
        end)
        return table.concat(t)
    end)
    local ok, text = resume(outer)
    assert(ok and text == "123" and collected == "sorted")
end

local function a_coroutine_cannot_wait_for_itself_test()
    local co = spawn(function()
        return resume(coroutine.running())
    end)
    local r = pack(resume(co))
    assert(r.n == 3 and r[1] == true and r[2] == false and r[3] == "cannot resume non-suspended coroutine")
end

local function waiting_in_a_circle_is_a_deadlock_test()
    local a, b
    a = spawn(function()
        return resume(b)
    end)
    b = spawn(function()
        return resume(a)
    end)
    local ok, err = resume(a)
    assert(ok == false and string.find(err, "deadlock", 1, true), tostring(err))
    assert(close(a) and close(b))
end

local function the_main_chunk_runs_the_scheduler_while_it_waits_test()
    local progress = 0
    local background = spawn(function()
        for _ = 1, 10 do
            progress = progress + 1
            yield()
        end
    end)
    local target = spawn(function()
        for _ = 1, 4 do
            yield()
        end
        return progress
    end)
    local ok, seen = resume(target)
    -- The background coroutine ran while the main chunk waited.
    assert(ok and seen >= 4)
    assert(resume(background))
    assert(progress == 10)
end

local function a_plain_coroutine_outside_runs_the_scheduler_test()
    local target = spawn(function()
        yield()
        yield()
        return "driven"
    end)
    local plain = create(function()
        local ok, v = resume(target)
        yield(v)
        return ok
    end)
    local ok, v = resume(plain)
    assert(ok and v == "driven")
    local ok2, inner_ok = resume(plain)
    assert(ok2 and inner_ok == true)
end

-- ===== close =====

local function close_cancels_a_coroutine_that_never_ran_test()
    local ran = false
    local co = spawn(function()
        ran = true
    end)
    assert(close(co) == true)
    assert(status(co) == "dead" and not ran)
    local r = pack(resume(co))
    assert(r.n == 2 and r[1] == false and r[2] == "cannot resume dead coroutine")
    assert(close(co) == true)
end

-- Every waiter that the end of a coroutine woke receives its results,
-- also when one of them closes the coroutine before the others ran.
local function close_keeps_the_results_for_woken_waiters_test()
    local co = spawn(function()
        yield()
        yield()
        return "first", { 1, 2 }, nil
    end)
    local got = {}
    local hasty = spawn(function()
        got.hasty = pack(resume(co))
        got.closed = pack(close(co))
    end)
    local late = spawn(function()
        got.late = pack(resume(co))
    end)
    local last = spawn(function()
        got.last = pack(resume(co))
    end)
    assert(resume(hasty) and resume(late) and resume(last))
    assert(got.closed.n == 1 and got.closed[1] == true)
    for _, name in ipairs({ "hasty", "late", "last" }) do
        local r = got[name]
        assert(r.n == 4 and r[1] == true and r[2] == "first" and r[3][2] == 2 and r[4] == nil, name)
    end
    assert(got.hasty[3] == got.late[3] and got.late[3] == got.last[3])
    local r = pack(resume(co))
    assert(r.n == 2 and r[1] == false and r[2] == "cannot resume dead coroutine")
end

local function close_keeps_the_error_for_woken_waiters_test()
    local co = spawn(function()
        yield()
        error({ code = 7 })
    end)
    local got = {}
    local hasty = spawn(function()
        got.hasty = pack(resume(co))
        got.closed = pack(close(co))
    end)
    local late = spawn(function()
        got.late = pack(resume(co))
    end)
    assert(resume(hasty) and resume(late))
    assert(got.hasty.n == 2 and got.hasty[1] == false and got.hasty[2].code == 7)
    assert(got.closed.n == 2 and got.closed[1] == false and got.closed[2] == got.hasty[2])
    assert(got.late.n == 2 and got.late[1] == false and got.late[2] == got.hasty[2])
    collectgarbage()
    local r = pack(resume(co))
    assert(r.n == 2 and r[1] == false and r[2] == "cannot resume dead coroutine")
end

local function close_runs_the_pending_close_variables_test()
    local log = {}
    local target = spawn(function()
        yield()
        yield()
        yield()
    end)
    local co = spawn(function()
        local a <close> = closer(log, "a")
        local b <close> = closer(log, "b")
        local function nested()
            local c <close> = closer(log, "c")
            resume(target)
            log[#log + 1] = "unreachable"
        end
        nested()
    end)
    local warm = spawn(function()
        yield()
    end)
    assert(resume(warm))
    -- The coroutine waits for the target inside `nested`.
    assert(status(co) == "suspended" and #log == 0)
    local r = pack(close(co))
    assert(r.n == 1 and r[1] == true)
    assert(table.concat(log, " ") == "c b a")
    assert(status(co) == "dead")
    assert(resume(target))
end

local function close_of_a_yielded_coroutine_test()
    local log = {}
    local co = spawn(function()
        local a <close> = closer(log, "closed")
        while true do
            yield()
        end
    end)
    local warm = spawn(function()
        yield()
        yield()
    end)
    assert(resume(warm))
    assert(close(co) == true and log[1] == "closed")
end

local function close_reports_an_error_of_a_close_variable_test()
    local co = spawn(function()
        local a <close> = setmetatable({}, { __close = function()
            error("close failed", 0)
        end })
        while true do
            yield()
        end
    end)
    local warm = spawn(function()
        yield()
    end)
    assert(resume(warm))
    local r = pack(close(co))
    assert(r.n == 2 and r[1] == false and r[2] == "close failed")
    assert(status(co) == "dead")
end

local function close_collects_the_error_of_a_failed_coroutine_test()
    local co = spawn(function()
        error("failed", 0)
    end)
    local warm = spawn(function()
        yield()
    end)
    assert(resume(warm))
    local expected = create(function()
        error("failed", 0)
    end)
    resume(expected)
    local want = pack(close(expected))
    local got = pack(close(co))
    assert(want.n == 2 and want[1] == false and want[2] == "failed")
    assert(got.n == want.n and got[1] == want[1] and got[2] == want[2])
    local again = pack(close(co))
    assert(again.n == 1 and again[1] == true)
end

local function close_of_a_finished_coroutine_drops_its_results_test()
    local co = spawn(function()
        return "never collected"
    end)
    local warm = spawn(function()
        yield()
    end)
    assert(resume(warm))
    assert(close(co) == true)
    local r = pack(resume(co))
    assert(r.n == 2 and r[1] == false and r[2] == "cannot resume dead coroutine")
end

local function close_wakes_the_waiters_test()
    local target = spawn(function()
        while true do
            yield()
        end
    end)
    local waiter = spawn(function()
        return resume(target)
    end)
    local warm = spawn(function()
        yield()
    end)
    assert(resume(warm))
    assert(close(target) == true)
    local r = pack(resume(waiter))
    assert(r.n == 3 and r[1] == true and r[2] == false and r[3] == "cannot resume dead coroutine")
end

local function close_of_a_waiter_leaves_the_target_alone_test()
    local target = spawn(function()
        yield()
        yield()
        return "still here"
    end)
    local waiter = spawn(function()
        return resume(target)
    end)
    local warm = spawn(function()
        yield()
    end)
    assert(resume(warm))
    assert(close(waiter) == true)
    local ok, v = resume(target)
    assert(ok and v == "still here")
end

local function a_coroutine_closes_itself_test()
    local log = {}
    local co = spawn(function()
        local a <close> = closer(log, "self")
        yield()
        close()
        log[#log + 1] = "unreachable"
    end)
    local r = pack(resume(co))
    assert(r.n == 1 and r[1] == true)
    assert(table.concat(log, " ") == "self" and status(co) == "dead")
end

local function close_rejects_a_coroutine_that_runs_test()
    local outer
    local message
    outer = spawn(function()
        local inner = create(function()
            local ok, err = catch close(outer)
            message = err
        end)
        assert(resume(inner))
    end)
    assert(resume(outer))
    assert(string.find(message, "cannot close a normal coroutine", 1, true))
end

local function close_of_a_plain_coroutine_that_waits_test()
    local log = {}
    local target = spawn(function()
        for _ = 1, 3 do
            yield()
        end
        return "late"
    end)
    local plain
    local outer = spawn(function()
        plain = create(function()
            local a <close> = closer(log, "plain")
            return resume(target)
        end)
        return resume(plain)
    end)
    local closer_co = spawn(function()
        yield()
        return close(plain)
    end)
    local ok, closed = resume(closer_co)
    assert(ok and closed == true and log[1] == "plain")
    -- The outer coroutine finds its plain coroutine closed.
    local r = pack(resume(outer))
    assert(r.n == 3 and r[1] == true and r[2] == false and r[3] == "cannot resume dead coroutine")
    assert(resume(target))
end

-- ===== Errors after a wait =====

local function an_error_of_the_target_reaches_a_handler_of_the_waiter_test()
    local target = spawn(function()
        yield()
        error("inner failure", 0)
    end)
    local co = spawn(function()
        local ok, err = catch (function()
            local done, message = resume(target)
            if not done then
                error(message, 0)
            end
        end)()
        -- The coroutine goes on after its handler.
        yield()
        return ok, err
    end)
    local r = pack(resume(co))
    assert(r.n == 3 and r[1] == true and r[2] == false and r[3] == "inner failure")
end

-- ===== The collector =====

-- The coroutines of these tests are created inside a call, so that no
-- register of the test keeps them alive.
local function a_scheduled_coroutine_is_a_root_test()
    local weak = setmetatable({}, { __mode = "v" })
    local finalized = false
    local done = false
    local function start()
        weak[1] = spawn(function()
            local keep = setmetatable({}, { __gc = function()
                finalized = true
            end })
            for _ = 1, 5 do
                yield()
                collectgarbage()
            end
            done = keep ~= nil
        end)
    end
    start()
    collectgarbage()
    collectgarbage()
    -- Nothing but the scheduler refers to the coroutine.
    assert(weak[1] ~= nil and not finalized)
    local stepper = spawn(function()
        for _ = 1, 8 do
            yield()
        end
    end)
    assert(resume(stepper))
    assert(done)
    collectgarbage()
    collectgarbage()
    assert(weak[1] == nil and finalized)
end

local function a_coroutine_that_waits_is_a_root_test()
    local weak = setmetatable({}, { __mode = "k" })
    local target = spawn(function()
        for _ = 1, 4 do
            yield()
        end
        return "value"
    end)
    local result
    local function start()
        weak[spawn(function()
            local ok, v = resume(target)
            result = v
        end)] = true
    end
    start()
    local warm = spawn(function()
        yield()
    end)
    assert(resume(warm))
    collectgarbage()
    collectgarbage()
    -- The waiter waits for the target, and only the scheduler holds it.
    assert(next(weak) ~= nil and result == nil)
    local ok, v = resume(target)
    assert(ok and v == "value")
    local stepper = spawn(function()
        yield()
    end)
    assert(resume(stepper))
    assert(result == "value")
    collectgarbage()
    collectgarbage()
    assert(next(weak) == nil)
end

local function results_survive_a_collection_test()
    local co = spawn(function()
        return { "fresh" }, string.rep("x", 100)
    end)
    local warm = spawn(function()
        yield()
    end)
    assert(resume(warm))
    for _ = 1, 3 do
        collectgarbage()
    end
    local ok, t, s = resume(co)
    assert(ok and t[1] == "fresh" and #s == 100)
end

local function a_collected_success_is_silent_test()
    local function start()
        spawn(function()
            return "nobody asks"
        end)
    end
    start()
    local warm = spawn(function()
        yield()
    end)
    assert(resume(warm))
    collectgarbage()
    collectgarbage()
end

local function many_coroutines_come_and_go_test()
    local total = 0
    local last
    for round = 1, 20 do
        local batch = {}
        for i = 1, 50 do
            batch[i] = spawn(function(n)
                local t = {}
                for j = 1, 5 do
                    t[j] = { n, j }
                    yield()
                end
                return #t
            end, i)
        end
        for i = 1, 50 do
            local ok, n = resume(batch[i])
            assert(ok and n == 5)
            total = total + n
        end
        last = batch
    end
    assert(total == 20 * 50 * 5 and #last == 50)
end

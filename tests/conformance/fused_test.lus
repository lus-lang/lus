--[[
  Tests for fused instructions.

  The compiler fuses a few pairs of instructions that the interpreter then
  runs without a dispatch in between: an addition or a table store followed
  by the end of a numeric loop, and an upvalue read followed by a
  subtraction of a constant. A fused pair must behave exactly as its two
  instructions do, whichever path each of them takes, when a jump lands on
  the second one, under hooks, and after a round trip through a binary
  chunk.
]]

pledge("load", "debug")

local function addition_at_the_end_of_an_integer_loop_test()
    local s = 0

    for i = 1, 1000 do
        s = s + i
    end

    assert(s == 500500)
    local down = 0

    for i = 10, 1, -3 do
        down = down + i
    end

    assert(down == 10 + 7 + 4 + 1)
end

local function addition_at_the_end_of_a_float_loop_test()
    local s = 0.0

    for x = 0.5, 4.5, 1.0 do
        s = s + x
    end

    assert(s == 0.5 + 1.5 + 2.5 + 3.5 + 4.5)
    local n = 0

    for _ = 1.0, 3.0 do
        n = n + 1
    end

    assert(n == 3)
end

local function addition_at_the_end_of_an_exact_loop_test()
    local s = 0n

    for i = 1n, 5n do
        s = s + i
    end

    assert(s == 15n)
end

local function addition_that_takes_a_metamethod_at_the_end_of_a_loop_test()
    local calls = 0
    local mt = {}

    mt.__add = function(a, b)
        calls = calls + 1
        return setmetatable({ v = a.v + b }, mt)
    end

    local acc = setmetatable({ v = 0 }, mt)

    for i = 1, 50 do
        acc = acc + i
    end

    assert(acc.v == 1275)
    assert(calls == 50)
end

local function addition_that_fails_at_the_end_of_a_loop_raises_test()
    local rounds = 0

    local function run()
        local s = "a"

        for _i = 1, 3 do
            rounds = rounds + 1
            s = s + {}
        end

        return s
    end

    local ok = catch run()
    assert(not ok)
    assert(rounds == 1)
end

local function a_jump_lands_on_the_loop_instruction_test()
    -- The skipped branch jumps to the loop instruction, which follows an
    -- addition.
    local s = 0

    for i = 1, 100 do
        if i % 2 == 0 then
            s = s + i
        end
    end

    assert(s == 2550)
    local t = 0

    for i = 1, 100 do
        if i % 3 == 0 then
            continue
        end

        t = t + 1
    end

    assert(t == 67)
end

local function store_at_the_end_of_a_loop_test()
    local a = {}

    for i = 1, 100 do
        a[i] = i * 2
    end

    assert(#a == 100 and a[1] == 2 and a[100] == 200)
    local f = {}

    for i = 1, 10 do
        f[i] = i + 0.5
    end

    assert(f[10] == 10.5)
    local mixed = {}

    for i = 1, 6 do
        mixed[i] = i % 2 == 0 and "even" or i
    end

    assert(mixed[2] == "even" and mixed[5] == 5)
    local keys = { "x", "y", "z" }
    local named = {}

    for i = 1, 3 do
        named[keys[i]] = i
    end

    assert(named.x == 1 and named.y == 2 and named.z == 3)
end

local function store_through_a_metamethod_at_the_end_of_a_loop_test()
    local log = {}

    local proxy = setmetatable({}, {
        __newindex = function(_, k, v)
            log[#log + 1] = k * 100 + v
        end,
    })

    for i = 1, 5 do
        proxy[i] = i + 1
    end

    assert(#log == 5)
    assert(log[1] == 102 and log[5] == 506)
end

local function store_into_a_read_only_value_at_the_end_of_a_loop_fails_test()
    local function run()
        local target = 5

        for i = 1, 3 do
            target[i] = i
        end
    end

    local ok, err = catch run()
    assert(not ok)
    assert(string.find(tostring(err), "index", 1, true))
end

local function upvalue_minus_a_constant_test()
    local n = 10

    local function int()
        return n - 3
    end

    assert(int() == 7)
    n = 2.5
    assert(int() == -0.5)
    n = math.mininteger
    assert(int() == math.maxinteger - 2)
    n = "12"
    assert(int() == 9)
    n = {}
    local ok = catch int()
    assert(not ok)
    local calls = 0

    n = setmetatable({}, {
        __sub = function(_, k)
            calls = calls + 1
            return k * 2
        end,
    })

    assert(int() == 6 and calls == 1)
end

local function recursion_through_an_upvalue_test()
    local function fib(n)
        if n < 2 then
            return n
        end

        return fib(n - 1) + fib(n - 2)
    end

    assert(fib(20) == 6765)
end

local function hooks_see_each_instruction_of_a_pair_test()
    local function work()
        local s = 0

        for i = 1, 10 do
            s = s + i
        end

        return s
    end

    local plain = 0

    debug.sethook(function()
        plain = plain + 1
    end, "", 1)

    local r = work()
    debug.sethook()
    assert(r == 55)
    -- Ten iterations of an addition and a loop instruction each, with
    -- the instructions around the loop.
    assert(plain >= 20, plain)
    local lines = {}

    debug.sethook(function(_, line)
        lines[#lines + 1] = line
    end, "l")

    work()
    debug.sethook()
    assert(#lines >= 3)
end

-- A binary chunk loads only with the `bytecode` permission, which the
-- command line grants, as in `lus test -P bytecode`.
local has_bytecode = (catch load(string.dump(function()
end)))

local needs_bytecode = "needs the bytecode permission, granted with -P bytecode"

local function fused_code_survives_a_binary_chunk_test()
    if not has_bytecode then
        skip(needs_bytecode)
    end

    local src = [[
        local base = 100
        local function f(n)
            local s = 0
            local t = {}
            for i = 1, n do s = s + i end
            for i = 1, n do t[i] = base - 1 end
            return s, #t, t[n]
        end
        return f(...)
    ]]
    local chunk = assert(load(src))
    local s, n, last = chunk(10)
    assert(s == 55 and n == 10 and last == 99)
    local again = assert(load(string.dump(chunk)))
    local s2, n2, last2 = again(10)
    assert(s2 == 55 and n2 == 10 and last2 == 99)
end

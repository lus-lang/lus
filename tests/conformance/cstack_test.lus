pledge("load")

local function deep_recursion_test()
    local count = 0

    local function recurse(n)
        count = count + 1

        if n > 0 then
            return recurse(n - 1) + 1
        end

        return 0
    end

    assert(recurse(100) == 100)
    assert(count == 101)
end

local function stack_overflow_detection_test()
    local function loop()
        return 1 + loop()
    end

    local ok, err = catch loop()
    assert(not ok)
    assert(string.find(err, "stack overflow") or string.find(err, "stack"))
end

local function recursion_in_pattern_matching_test()
    local function f(size)
        local s = string.rep("a", size)
        local p = string.rep(".?", size)
        return string.match(s, p)
    end

    local m = f(80)
    assert(#m == 80)
end

local function stack_overflow_in_gsub_test()
    -- Unbounded gsub reentrancy: every replacement call enters the C
    -- function again, so this must exhaust the call budget and raise a
    -- catchable overflow error instead of crashing the process.
    local count = 0

    local function foo()
        count = count + 1
        string.gsub("a", ".", foo)
    end

    local ok, err = catch foo()
    assert(not ok, "unbounded gsub reentrancy must fail with an error")
    assert(string.find(err, "stack overflow"), `the error should mention stack overflow, got: $err`)
    assert(count > 1, "the recursion must actually have reentered gsub")
    -- the VM must remain usable after recovering from the overflow
    assert(string.gsub("abc", "b", "x") == "axc")
end

-- Workers and detached coroutines (spec/design/coroutines.md). A worker
-- runs the coroutines that its body detached to their end, and
-- `worker.receive` and `worker.peek` are suspension points: the other
-- coroutines of the state run while one waits for a message. Each test
-- writes its worker script into the temporary working directory.
pledge("load", "network", "fs:read=./*", "fs:write=./*", "seal")

local create, detach, resume, yield = coroutine.create, coroutine.detach, coroutine.resume, coroutine.yield
local script_number = 0

local function spawn(f, ...)
    return detach(create(f), ...)
end

local function start(source, ...)
    script_number = script_number + 1
    local path = `./workercoro_$script_number.lus`
    local file = assert(io.open(path, "wb"))
    assert(file:write(source))
    assert(file:close())
    return worker.create(path, ...)
end

-- Several tests wait for an answer that depends on another coroutine,
-- which sends the request. An allocation that fails in that coroutine, as
-- the allocation sweep injects, stops it before it sends, and the wait
-- would never end. A guard sends the worker "timeout" after a few seconds
-- unless the test closes it first, so the worker answers and the test
-- fails on an answer it rejects. It waits for a UDP socket with a
-- timeout, which suspends it without using the processor.
local guard_seconds = 10

local function guard(w)
    return spawn(function()
        local ok, sock = catch network.udp.open(0, "127.0.0.1")

        if not ok then
            return
        end

        sock:settimeout(guard_seconds)
        local _ = catch sock:receive()
        sock:close()
        worker.send(w, "timeout")
    end)
end

-- Collects the messages of a worker until it ends.
local function drain(w)
    local messages = {}

    while true do
        local message = worker.receive(w)

        if message == nil then
            return messages
        end

        messages[#messages + 1] = message
    end
end

-- ===== The end of a worker body =====

local function a_worker_runs_its_coroutines_after_its_body_test()
    local w = start([[
        worker.message("start")
        coroutine.detach(coroutine.create(function(name)
            for turn = 1, 3 do
                worker.message(name .. " " .. turn)
                coroutine.yield()
            end
        end), "detached")
        worker.message("body ends")
    ]])
    local messages = drain(w)
    assert(
        table.concat(messages, ", ") == "start, body ends, detached 1, detached 2, detached 3",
        table.concat(messages, ", ")
    )
    assert(worker.status(w) == "dead")
end

local function an_uncollected_error_is_the_error_of_the_worker_test()
    local w = start([[
        coroutine.detach(coroutine.create(function()
            worker.message("first turn")
            coroutine.yield()
            error("the detached coroutine failed")
        end))
        worker.message("body ends")
    ]])
    -- A worker that has failed raises its error from the next receive,
    -- ahead of the messages it sent before.
    local ok, err

    repeat
        ok, err = catch worker.receive(w)
    until not ok or err == nil

    assert(
        not ok and string.find(err, "workercoro_%d+%.lus:%d+: the detached coroutine failed$"),
        tostring(err)
    )
    assert(worker.status(w) == "dead")
end

local function a_collected_error_leaves_the_worker_sound_test()
    local w = start([[
        local co = coroutine.detach(coroutine.create(function()
            error("collected")
        end))
        coroutine.detach(coroutine.create(function()
            local ok, err = coroutine.resume(co)
            worker.message(tostring(ok) .. " " .. string.gsub(err, "^.*: ", ""))
        end))
    ]])
    local messages = drain(w)
    assert(#messages == 1 and messages[1] == "false collected", messages[1])
end

-- ===== worker.receive =====

-- Answers every message with its upper case form, and ends at "stop".
local shout = [[
    while true do
        local text = worker.peek()
        if text == "stop" then
            break
        end
        worker.message(string.upper(text))
    end
]]

local function receive_suspends_a_detached_coroutine_test()
    local w = start(shout)
    local watchdog = guard(w)
    local turns = 0

    local receiver = spawn(function()
        return worker.receive(w)
    end)

    -- The worker answers only after this coroutine ran, which it does
    -- while the receiver waits.
    local sender = spawn(function()
        for i = 1, 5 do
            turns = turns + 1
            yield()
        end

        assert(coroutine.status(receiver) == "suspended")
        worker.send(w, "hello")
    end)

    local ok, answer = resume(receiver)
    coroutine.close(watchdog)
    assert(ok and answer == "HELLO", tostring(answer))
    assert(turns == 5 and resume(sender))
    worker.send(w, "stop")
    assert(#drain(w) == 0)
end

local function receive_in_the_main_chunk_runs_the_coroutines_test()
    local w = start(shout)
    local watchdog = guard(w)

    local sender = spawn(function()
        for i = 1, 5 do
            yield()
        end

        worker.send(w, "main")
    end)

    -- The main chunk keeps its native on the stack and runs the scheduler.
    local answer = worker.receive(w)
    coroutine.close(watchdog)
    assert(answer == "MAIN", tostring(answer))
    assert(resume(sender))
    worker.send(w, "stop")
    assert(#drain(w) == 0)
end

local function several_coroutines_receive_from_their_workers_test()
    local total = 6
    local receivers = {}
    local workers = {}

    for i = 1, total do
        workers[i] = start(shout)

        receivers[i] = spawn(function()
            local answers = {}

            for round = 1, 3 do
                worker.send(workers[i], `w$(i)r$round`)
                answers[round] = worker.receive(workers[i])
            end

            worker.send(workers[i], "stop")
            return table.concat(answers, " ")
        end)
    end

    for i = 1, total do
        local ok, answers = resume(receivers[i])
        assert(ok and answers == `W$(i)R1 W$(i)R2 W$(i)R3`, tostring(answers))
        assert(#drain(workers[i]) == 0)
    end
end

local function receive_passes_a_worker_error_to_a_detached_coroutine_test()
    local w = start([[
        worker.peek()
        error("the worker failed")
    ]])
    local watchdog = guard(w)

    local receiver = spawn(function()
        return catch worker.receive(w)
    end)

    local sender = spawn(function()
        yield()
        worker.send(w, "go")
    end)

    local ok, good, err = resume(receiver)
    coroutine.close(watchdog)
    assert(ok and good == false and string.find(err, "the worker failed$"), tostring(err))
    assert(resume(sender))
end

local function close_cancels_a_coroutine_that_waits_for_a_worker_test()
    local w = start(shout)
    local log = {}

    local receiver = spawn(function()
        local mark <close> = setmetatable({}, {
            __close = function()
                log[#log + 1] = "closed"
            end,
        })

        worker.receive(w)
        log[#log + 1] = "unreachable"
    end)

    local warm = spawn(function()
        yield()
    end)

    assert(resume(warm))
    assert(coroutine.status(receiver) == "suspended")
    assert(coroutine.close(receiver))
    assert(table.concat(log, " ") == "closed")
    -- The worker is still there for the next receive.
    worker.send(w, "after")
    assert(worker.receive(w) == "AFTER")
    worker.send(w, "stop")
    assert(#drain(w) == 0)
end

-- ===== worker.peek =====

local function peek_suspends_a_detached_coroutine_test()
    local w = start([[
        local create, detach, resume, yield = coroutine.create, coroutine.detach, coroutine.resume, coroutine.yield
        local turns = 0
        local reader = detach(create(function()
            local text = worker.peek()
            return text .. " after " .. turns .. " turns"
        end))
        -- The creator sends only after it saw these turns, which run while
        -- the reader waits.
        local ticker = detach(create(function()
            for i = 1, 4 do
                turns = turns + 1
                yield()
            end
            worker.message("ticked")
        end))
        local ok, answer = resume(reader)
        worker.message(answer)
    ]])
    local watchdog = guard(w)
    local ticked = worker.receive(w)
    coroutine.close(watchdog)
    assert(ticked == "ticked", tostring(ticked))
    worker.send(w, "value")
    assert(worker.receive(w) == "value after 4 turns")
    assert(#drain(w) == 0)
end

local function peek_in_a_worker_body_runs_its_coroutines_test()
    local w = start([[
        coroutine.detach(coroutine.create(function()
            for i = 1, 3 do
                coroutine.yield()
            end
            worker.message("ready")
        end))
        worker.message(worker.peek() .. " received")
    ]])
    local watchdog = guard(w)
    local ready = worker.receive(w)
    coroutine.close(watchdog)
    assert(ready == "ready", tostring(ready))
    worker.send(w, "value")
    assert(worker.receive(w) == "value received")
    assert(#drain(w) == 0)
end

-- ===== The end of the creator =====

-- These workers still run when this file ends: one waits in `peek` inside
-- a detached coroutine after its body returned, and one waits for a
-- socket there. Closing the state of the creator ends both.
local function workers_that_wait_end_with_their_creator_test()
    local parked = start([[
        coroutine.detach(coroutine.create(function()
            worker.message("parked")
            while true do
                worker.peek()
            end
        end))
    ]])
    assert(worker.receive(parked) == "parked")
    local listening = start([[
        pledge("network")
        local bound, server = catch network.tcp.bind("127.0.0.1", 0)
        if not bound then
            worker.message("unavailable")
            return
        end
        coroutine.detach(coroutine.create(function()
            worker.message("listening")
            server:accept()
        end))
    ]])
    local state = worker.receive(listening)
    assert(state == "listening" or state == "unavailable", tostring(state))
    assert(worker.status(parked) == "running")
end

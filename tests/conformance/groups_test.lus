pledge("load")

-- ===== groups =====
-- basic group declaration and access
local function basic_group_declaration_and_access_test()
    local z <group> = {
        a = 1,
        b = 2,
        c = 3
    }
    assert(z.a == 1)
    assert(z.b == 2)
    assert(z.c == 3)
end

-- group with arithmetic on fields
local function group_with_arithmetic_on_fields_test()
    local z <group> = { a = 10, b = 20 }
    assert(z.a + z.b == 30)
    assert(z.a * z.b == 200)
end

-- group with function values
local function group_with_function_values_test()
    local utils <group> = {
        add = function(x, y) return x + y end,
        sub = function(x, y) return x - y end
    }
    assert(utils.add(5, 3) == 8)
    assert(utils.sub(5, 3) == 2)
end

-- group with mixed value types
local function group_with_mixed_value_types_test()
    local mixed <group> = {
        num = 42,
        str = "hello",
        bool = true,
        tbl = {1, 2, 3}
    }
    assert(mixed.num == 42)
    assert(mixed.str == "hello")
    assert(mixed.bool == true)
    assert(mixed.tbl[1] == 1)
end

-- multiple groups in same scope
local function multiple_groups_in_same_scope_test()
    local a <group> = { x = 1, y = 2 }
    local b <group> = { x = 10, y = 20 }
    assert(a.x == 1)
    assert(b.x == 10)
    assert(a.y + b.y == 22)
end

-- field mutation
local function field_mutation_test()
    local z <group> = { a = 1, b = 2 }
    z.a = 100
    z.b = 200
    assert(z.a == 100)
    assert(z.b == 200)
end

-- const field
local function const_field_test()
    local z <group> = { a = 1, b <const> = 2 }
    assert(z.a == 1)
    assert(z.b == 2)
    z.a = 100  -- allowed
    assert(z.a == 100)
    -- Assigning to the const field is rejected at compile time
    local bad, err = load("local z <group> = { a = 1, b <const> = 2 } z.b = 100")
    assert(bad == nil, "assignment to a const group field should not compile")
    assert(string.find(err, "attempt to assign to const variable") ~= nil)
end

-- subgroups
local function subgroups_test()
    local parent <group> = {
        a = 1,
        b = 2,
        c <group> = {
            d = 3,
            e = 4
        }
    }
    assert(parent.a == 1)
    assert(parent.b == 2)
    assert(parent.c.d == 3)
    assert(parent.c.e == 4)
end

-- subgroup field mutation
local function subgroup_field_mutation_test()
    local parent <group> = {
        a = 1,
        c <group> = {
            d = 10
        }
    }
    parent.c.d = 100
    assert(parent.c.d == 100)
end

-- deeply nested subgroups
local function deeply_nested_subgroups_test()
    local root <group> = {
        a <group> = {
            b <group> = {
                c = 42
            }
        }
    }
    assert(root.a.b.c == 42)
end

-- multiple sibling subgroups
local function multiple_sibling_subgroups_test()
    local parent <group> = {
        a = 1,
        first <group> = {
            x = 10,
            y = 20
        },
        second <group> = {
            x = 100,
            y = 200
        },
        b = 2
    }
    assert(parent.a == 1)
    assert(parent.b == 2)
    assert(parent.first.x == 10)
    assert(parent.first.y == 20)
    assert(parent.second.x == 100)
    assert(parent.second.y == 200)
end

-- deeply nested sibling subgroups
local function deeply_nested_sibling_subgroups_test()
    local root <group> = {
        left <group> = {
            inner <group> = {
                val = 1
            }
        },
        right <group> = {
            inner <group> = {
                val = 2
            }
        }
    }
    assert(root.left.inner.val == 1)
    assert(root.right.inner.val == 2)
end

-- group copying
local function group_copying_test()
    local z <group> = { a = 1, b = 2 }
    local y <group> = z
    assert(y.a == 1)
    assert(y.b == 2)
    -- Copies are independent
    z.a = 100
    assert(z.a == 100)
    assert(y.a == 1)  -- y unchanged
end

-- group overwriting
local function group_overwriting_test()
    local z <group> = { a = 1, b = 2 }
    z = { a = 10 }  -- partial overwrite
    assert(z.a == 10)
    assert(z.b == 2)  -- unchanged
end

-- group overwriting multiple fields
local function group_overwriting_multiple_fields_test()
    local z <group> = { a = 1, b = 2, c = 3 }
    z = { a = 100, c = 300 }
    assert(z.a == 100)
    assert(z.b == 2)  -- unchanged
    assert(z.c == 300)
end

-- from deconstruction on group

-- from deconstruction on group
local function from_deconstruction_on_group_test()
    local player <group> = {
        name = "Hero",
        health = 100,
        position <group> = { x = 0, y = 0 }
    }
    local name from player
    assert(name == "Hero")
end

-- from multiple fields from group
local function from_multiple_fields_from_group_test()
    local player <group> = {
        name = "Hero",
        health = 100
    }
    local name, health from player
    assert(name == "Hero" and health == 100)
end

-- if-from with group
local function if_from_with_group_test()
    local player <group> = {
        name = "Hero",
        health = 100
    }
    if name, health from player then
        assert(name == "Hero")
        assert(health == 100)
    end
end

-- nested functions reach the fields of an enclosing group
local function nested_function_reads_group_field_test()
    local z <group> = { a = 1 }
    local function f() return z.a end
    assert(f() == 1)
    z.a = 2
    assert(f() == 2)
end

-- a nested function shares the field local with the enclosing function
local function nested_function_writes_group_field_test()
    local z <group> = { a = 1, b <const> = 2, s <group> = { d = 4 }, t = { k = 5 } }
    local function g() z.a = z.a + 10 end
    g()
    assert(z.a == 11)
    local function h()
        return function()
            z.a = 99
            return z.a, z.b, z.s.d, z.t.k
        end
    end
    local a, b, d, k = h()()
    assert(a == 99 and b == 2 and d == 4 and k == 5)
    assert(z.a == 99)
end

-- overwrite, copy, and from work on an enclosing group
local function nested_function_group_forms_test()
    local z <group> = { a = 1, b = 2 }
    local function o() z = { a = 7 } end
    o()
    assert(z.a == 7 and z.b == 2)
    local function c()
        local y <group> = z
        y.a = 0
        return y.a, z.a
    end
    local ya, za = c()
    assert(ya == 0 and za == 7)
    local function fr()
        local a, b from z
        return a, b
    end
    local fa, fb = fr()
    assert(fa == 7 and fb == 2)
    local function fa2()
        z.a from { a = 5 }
    end
    fa2()
    assert(z.a == 5)
end

-- each loop iteration's group gets its own captured field
local function nested_function_group_per_iteration_test()
    local fns = {}
    for i = 1, 3 do
        local w <group> = { n = i }
        fns[i] = function()
            w.n = w.n * 10
            return w.n
        end
    end
    assert(fns[1]() == 10 and fns[2]() == 20 and fns[3]() == 30 and fns[1]() == 100)
end

-- the group rules hold inside nested functions
local function nested_function_group_errors_test()
    local _, e1 = load("local z <group> = { b <const> = 2 } local function f() z.b = 3 end")
    assert(string.find(e1, "attempt to assign to const variable 'b'", 1, true))
    local _, e2 = load("local z <group> = { b = 2 } local function f() return z.q end")
    assert(string.find(e2, "'q' is not a field of group 'z'", 1, true))
    local _, e3 = load("local z <group> = { b = 2 } local function f() return z end")
    assert(string.find(e3, "cannot pass local group", 1, true))
end

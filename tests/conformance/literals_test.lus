pledge("load")

-- ===== ported from h1/literals.lus =====
-- escape sequences
local function escape_sequences_test()
    assert('\n\"\'\\'  == [[

"'\]])
    assert(string.find("\a\b\f\n\r\t\v", "^%c%c%c%c%c%c%c$"))
end

-- hexadecimal escapes
local function hexadecimal_escapes_test()
    assert("\x00\x05\x10\x1f\x3C\x7f\x7E" == "\0\5\16\31\60\127\126")
end

-- Escapes that would produce invalid UTF-8 are compile errors, because raw
-- bytes live in vectors (spec/design/strings.md).
local function high_byte_escapes_are_compile_errors_test()
    for _, src in ipairs { [[return "\xff"]], [[return "\255"]], [[return "\xC3"]] } do
        local f, err = load(src)
        assert(f == nil)
        assert(string.find(err, "UTF%-8"))
    end
    -- A valid multi-byte sequence spelled with escapes is accepted.
    assert(load([[return "\xC3\xA9"]])() == "\u{E9}")
end

-- unicode escapes
local function unicode_escapes_test()
    assert("\u{0041}" == "A")
    assert("\u{20AC}" == "€")
    assert("\u{0}" == "\0")
end

-- long strings
local function long_strings_test()
    local b = string.rep("0123456789", 96)
    assert(string.len(b) == 960)

    -- nested brackets
    assert([=[one [[two]] one]=] == 'one [[two]] one')
    assert([===[one [==[two]==] one]===] == 'one [==[two]==] one')
end

-- number literals
local function number_literals_test()
    assert(0xff == 255)
    assert(0xFF == 255)
    assert(0x10 == 16)
    assert(0xABCDEF == 11259375)
    assert(0e12 == 0)
    assert(.0 == 0)
    assert(0. == 0)
    assert(.2e2 == 20)
    assert(2.E-1 == 0.2)
end

-- hex float literals
local function hex_float_literals_test()
    assert(0x0.1E == 0x1E / 0x100)
    assert(0x0p10 == 0)
    assert(0x1p10 == 1024)
    assert(0x1.0p10 == 1024)
end

-- string coercion to number
local function string_coercion_to_number_test()
    local a,b,c = "2", " 3e0 ", " 10  "
    assert(a+b == 5 and -b == -3 and b+"2" == 5 and "10"-c == 0)
    assert(type(a) == 'string' and type(b) == 'string' and type(c) == 'string')
end

-- syntax errors in literals
local function syntax_errors_in_literals_test()
    local function lexerror (s, err)
      local ok, st, msg = catch load('return ' .. s, '')
      if not ok then
          -- load threw error - that's expected for syntax errors
          if err then
             assert(string.find(st, err), "Expected error '"..err.."' in '"..tostring(st).."'")
          end
          return
      end
      if not st then
          -- load returned nil, msg
          if err then
             assert(string.find(msg, err), "Expected error '"..err.."' in '"..tostring(msg).."'")
          end
      end
    end

    lexerror("`", "unfinished interpolated string")  -- backtick starts interpolated strings in Lus
    lexerror(" ' ", "unfinished string")
end

-- decimal point locale
local function decimal_point_locale_test()
    -- Skip on systems without pt_BR locale (e.g., musl Linux)
    local original = os.setlocale(nil, "numeric")
    if os.setlocale("pt_BR") or os.setlocale("pt_BR.UTF-8") then
      -- Only test if locale change succeeded and changes decimal separator
      local n = tonumber("3,4")
      if n then
        assert(n == 3.4)
      end
      assert(tonumber"3.4" == 3.4)
      os.setlocale(original or "C")
    end
end

-- string length operator
local function string_length_operator_test()
    assert(#"" == 0)
    assert(#"hello" == 5)
    -- Strings count characters, so the euro sign has length 1 (spec/design/strings.md).
    assert(#"€" == 1)
    assert(#vector.fromstring("€") == 3)
end

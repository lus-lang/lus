--[[
    Edges of the collector.

    Strings, bigints, and decimals are values that a weak table never
    loses. An object with a finalizer leaves the weak values of a table
    when the collector finalizes it, and stays among the weak keys until
    its finalizer has run. Generational mode collects young objects in
    minor collections and still runs finalizers. Each test checks one of
    those rules in both incremental and generational mode.
]]

local function each_mode(f)
    for _, mode in ipairs{ "incremental", "generational" } do
        collectgarbage(mode)
        f(mode)
    end

    collectgarbage("incremental")
end

local function weak_tables_keep_strings_and_exact_numbers_test()
    each_mode(function(mode)
        for _, weak in ipairs{ "k", "v", "kv" } do
            local t = setmetatable({}, { __mode = weak })
            local long = string.rep("x", 100) .. mode
            t[long] = long
            t[10n ^ 30] = 10n ^ 30
            t[decimal("1.25")] = decimal("1.25")
            t.short = "s"
            t[{}] = 1
            t[1] = {}
            collectgarbage()
            collectgarbage()
            assert(t[long] == long and t[10n ^ 30] == 10n ^ 30, `$mode$weak`)
            assert(t[decimal("1.25")] == decimal("1.25") and t.short == "s", `$mode$weak`)

            if weak == "v" or weak == "kv" then
                assert(t[1] == nil, `$mode$weak`)
            end

            local n = 0

            for k in pairs(t) do
                if type(k) == "table" then
                    n = n + 1
                end
            end

            if weak ~= "v" then
                assert(n == 0, `$mode$weak`)
            end
        end
    end)
end

local function finalized_objects_leave_weak_values_test()
    each_mode(function(mode)
        local values = setmetatable({}, { __mode = "v" })
        local keys = setmetatable({}, { __mode = "k" })
        local seen_key

        do
            local obj = setmetatable({}, {
                __gc = function(o)
                    seen_key = keys[o]
                end,
            })

            values[1] = obj
            keys[obj] = "kept until finalized"
        end

        collectgarbage()
        collectgarbage()
        assert(values[1] == nil, mode)
        assert(seen_key == "kept until finalized", `$mode: $(tostring(seen_key))`)
    end)
end

local function generational_mode_runs_finalizers_of_young_objects_test()
    collectgarbage("generational")
    local ran = 0

    for _ = 1, 200 do
        local _ = setmetatable({}, {
            __gc = function()
                ran = ran + 1
            end,
        })

        local _ = { 1, 2, 3, {} }
    end

    for _ = 1, 20 do
        collectgarbage("step", 0)
    end

    collectgarbage()
    collectgarbage("incremental")
    assert(ran == 200, ran)
end

local function small_steps_finish_a_cycle_test()
    each_mode(function(mode)
        local t = {}

        for i = 1, 2000 do
            t[i] = { i }
        end

        t = nil
        local finished = false

        for _ = 1, 100000 do
            if collectgarbage("step", 0) then
                finished = true
                break
            end
        end

        assert(finished, mode)
    end)
end

local function a_large_table_is_marked_in_parts_test()
    each_mode(function(mode)
        local big = {}

        for i = 1, 50000 do
            big[i] = { i }
        end

        for i = 1, 5000 do
            big[`k$i`] = { i }
        end

        collectgarbage()
        local sum = 0

        for i = 1, 50000, 997 do
            sum = sum + big[i][1]
        end

        assert(sum > 0 and big.k5000[1] == 5000, mode)
    end)
end

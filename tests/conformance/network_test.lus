-- ===== network =====
--[[
  Network Library Tests for Lus
  Tests: TCP, UDP, and HTTP/HTTPS functionality

  Note: Uses 'catch' expression for protected execution.
]]

-- ============================================
-- Library Structure Tests
-- ============================================

-- network global exists
local function network_global_exists_test()
    assert(type(network) == "table", "network should be a table")
end

-- network.tcp subtable exists
local function network_tcp_subtable_exists_test()
    assert(type(network.tcp) == "table", "network.tcp should be a table")
    assert(type(network.tcp.connect) == "function", "network.tcp.connect should be a function")
    assert(type(network.tcp.bind) == "function", "network.tcp.bind should be a function")
end

-- network.udp subtable exists
local function network_udp_subtable_exists_test()
    assert(type(network.udp) == "table", "network.udp should be a table")
    assert(type(network.udp.open) == "function", "network.udp.open should be a function")
end

-- network.fetch function exists
local function network_fetch_function_exists_test()
    assert(type(network.fetch) == "function", "network.fetch should be a function")
end

-- ============================================
-- TCP Basic Tests
-- ============================================

-- TCP server bind and close
local function tcp_server_bind_and_close_test()
    local server = tcp_bind("127.0.0.1", 0)
    assert(server ~= nil, "server should be created")
    assert(tostring(server):find("server"), "tostring should indicate server")
    server:close()
    assert(tostring(server):find("closed"), "tostring should indicate closed")
end

-- TCP connection refused error
local function tcp_connection_refused_error_test()
    local server = tcp_bind("127.0.0.1", 0)
    local _, port = server:getsockname()
    server:close()
    local sock, err = network.tcp.connect("127.0.0.1", port)
    assert(sock == nil, "should fail to connect to closed port")
    assert(
        err.code == "refused" and type(err.message) == "string",
        "error should carry a code and a message"
    )
end

-- TCP server has expected methods
local function tcp_server_has_expected_methods_test()
    local server = tcp_bind("127.0.0.1", 0)
    assert(type(server.accept) == "function", "should have accept")
    assert(type(server.close) == "function", "should have close")
    assert(type(server.settimeout) == "function", "should have settimeout")
    server:close()
end

-- ============================================
-- UDP Tests
-- ============================================

-- UDP socket create and close
local function udp_socket_create_and_close_test()
    local sock = udp_open()
    assert(sock ~= nil, "UDP socket should be created")
    assert(tostring(sock):find("udpsocket"), "tostring should indicate udpsocket")
    sock:close()
    assert(tostring(sock):find("closed"), "tostring should indicate closed")
end

-- UDP socket has expected methods
local function udp_socket_has_expected_methods_test()
    local sock = udp_open()
    assert(type(sock.sendto) == "function", "should have sendto")
    assert(type(sock.receive) == "function", "should have receive")
    assert(type(sock.setsockname) == "function", "should have setsockname")
    assert(type(sock.close) == "function", "should have close")
    sock:close()
end

-- UDP socket bind to port
local function udp_socket_bind_to_port_test()
    local sock = udp_open(0, "127.0.0.1")
    assert(sock ~= nil, "bound UDP socket should be created")
    sock:close()
end

-- using closed UDP socket raises error
local function using_closed_udp_socket_raises_error_test()
    local sock = udp_open()
    sock:close()
    local ok, err = catch sock:sendto("test", "127.0.0.1", 1234)
    assert(not ok, "should fail on closed socket")
    assert(err:find("closed"), "error should mention closed")
end

-- ============================================
-- HTTP response tests
-- ============================================

local function local_fetch(status, location, body)
    local probe = tcp_bind("127.0.0.1", 0)
    local _, port = probe:getsockname()
    probe:close()

    local fixture = worker.create(FIXTURES .. "/http_server.lus")
    worker.send(fixture, { status = status, location = location, body = body, port = port })
    assert(worker.receive(fixture) == "ready", "local HTTP fixture should bind")
    local got_status, got_body, got_headers = fetch(
        "http://127.0.0.1:" .. tostring(port) .. "/fixture"
    )
    assert(worker.receive(fixture) == "done", "local HTTP fixture should finish")
    return got_status, got_body, got_headers
end

-- HTTP GET returns status, body, and headers
local function http_get_returns_status_body_and_headers_test()
    local status, body, headers = local_fetch(200, nil, "OK")
    assert(status == 200, "status should be 200, got: " .. tostring(status))
    assert(txt(body) == "OK", "response body should be preserved")
    assert(type(headers) == "table", "headers should be a table")
end

-- HTTP GET exposes different success status codes
local function http_get_exposes_different_success_status_codes_test()
    local status201 = local_fetch(201, nil, "created")
    assert(status201 == 201, "should get 201, got: " .. tostring(status201))
    local status204 = local_fetch(204, nil, "")
    assert(status204 == 204, "should get 204, got: " .. tostring(status204))
end

-- HTTP returns redirect status to the caller
local function http_returns_redirect_status_to_the_caller_test()
    local status, _, headers = local_fetch(301, "/next", "")
    assert(status == 301, "redirect must not be followed, got: " .. tostring(status))
    assert(type(headers) == "table", "headers should be a table")
    assert(headers.location == "/next", "location header should be exposed")
end

-- HTTP exposes client error status codes
local function http_exposes_client_error_status_codes_test()
    local status404 = local_fetch(404, nil, "missing")
    assert(status404 == 404, "should get 404, got: " .. tostring(status404))
    local status400 = local_fetch(400, nil, "bad request")
    assert(status400 == 400, "should get 400, got: " .. tostring(status400))
end

-- HTTP exposes server error status codes
local function http_exposes_server_error_status_codes_test()
    local status500 = local_fetch(500, nil, "failure")
    assert(status500 == 500, "should get 500, got: " .. tostring(status500))
end

-- a closed local endpoint reports a fetch error
local function a_closed_local_endpoint_reports_a_fetch_error_test()
    local server = tcp_bind("127.0.0.1", 0)
    local _, port = server:getsockname()
    server:close()
    local ok, err = catch network.fetch("https://127.0.0.1:" .. tostring(port) .. "/")
    assert(not ok, "should fail for a closed local endpoint")
    assert(
        err.code == "refused" and type(tostring(err)) == "string",
        "error should carry a code and a message"
    )
end

-- TCP line receive enforces its default one MiB limit
local function tcp_line_receive_enforces_its_default_one_mib_limit_test()
    local mib = 1024 * 1024
    local server, conn, sender = make_sender(mib, "\n")
    assert(#txt(conn:receive("*l")) == mib)
    finish_sender(sender)
    conn:close()
    server:close()

    server, conn, sender = make_sender(mib + 1, "\n")
    local got, err = conn:receive("*l")
    assert(got == nil)
    assert(string.find(tostring(err), "receive limit exceeded"))
    catch worker.receive(sender)
    conn:close()
    server:close()
end

-- TCP all-data receive enforces its default 64 MiB limit
local function tcp_all_data_receive_enforces_its_default_64_mib_limit_test()
    local limit = 64 * 1024 * 1024
    local server, conn, sender = make_sender(limit)
    assert(#txt(conn:receive("*a")) == limit)
    finish_sender(sender)
    conn:close()
    server:close()

    server, conn, sender = make_sender(limit + 1)
    local got, err = conn:receive("*a")
    assert(got == nil)
    assert(string.find(tostring(err), "receive limit exceeded"))
    catch worker.receive(sender)
    conn:close()
    server:close()
end

-- A UDP socket opens and works right after a receive limit error that a
-- worker drove, which an early build of 2.0 could not do.
local function udp_opens_after_a_receive_limit_error_test()
    local server, conn, sender = make_sender(1024 * 1024 + 1, "\n")
    local got, err = conn:receive("*l")
    assert(got == nil and string.find(tostring(err), "receive limit exceeded"))
    catch worker.receive(sender)
    conn:close()
    server:close()
    local receiver = udp_open(0, "127.0.0.1")
    local _, port = receiver:getsockname()
    local sock = udp_open()
    sock:sendto("after", "127.0.0.1", port)
    receiver:settimeout(5)
    assert(txt(receiver:receive()) == "after")
    receiver:close()
    sock:close()
end

-- A receive smaller than the datagram returns its first bytes and drops
-- the rest, on every platform. Windows fails a short receive buffer, so
-- the runtime receives into a buffer that holds any datagram.
local function udp_receive_truncates_a_large_datagram_test()
    local receiver = udp_open(0, "127.0.0.1")
    local sender = udp_open()
    local _, port = receiver:getsockname()
    sender:sendto(string.rep("a", 3000), "127.0.0.1", port)
    sender:sendto("next", "127.0.0.1", port)
    local data, address = receiver:receive(5)
    assert(txt(data) == "aaaaa" and address == "127.0.0.1")
    assert(txt(receiver:receive()) == "next")
    receiver:close()
    sender:close()
end

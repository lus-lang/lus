local FIXTURES = TEST_DIR .. "/fixtures/network"

pledge("load", "network", "fs:read=" .. FIXTURES .. "/*")

-- ===== netio =====
--[[
  Network data-path tests for Lus (netio suite)

  This suite exercises the loopback data path that network.lus never touches.
  It binds real TCP servers and UDP sockets on 127.0.0.1, connects to them in
  the same process, accepts the queued connection, and asserts exact bytes in
  both directions. It also pins the error wording for the validation paths that
  need no bind at all.

  The bind syscall is blocked inside the sandbox with "Operation not permitted".
  Every bind-dependent test therefore performs its bind as the very first
  fallible call so that the only local failures are that one environmental
  error. These stay as tests:it because they pass once run outside the sandbox.
  The validation and connect-refused tests below do not bind and must pass
  locally.
]]

-- Network reads return vectors in 2.0 (spec/design/strings.md), so the tests
-- decode them before comparing against text.
local function txt(v)
    if type(v) == "vector" then
        return vector.tostring(v)
    end

    return v
end

-- Binding a socket is not permitted in every environment, so a refused bind
-- skips the test instead of failing it.
local function skip_if_denied(ok, err)
    if not ok
        and (string.find(tostring(err), "ermission denied", 1, true)
            or string.find(tostring(err), "not permitted", 1, true)
            or string.find(tostring(err), "EPERM", 1, true)
            or string.find(tostring(err), "UDP socket: Unexpected", 1, true)) then
        -- A sandbox that forbids UDP sockets surfaces as an unmapped error.

        skip("loopback sockets unavailable")
    end
end

local function tcp_bind(...)
    local ok, server = catch network.tcp.bind(...)
    skip_if_denied(ok, server)

    if not ok then
        error(server, 0)
    end

    return server
end

local function udp_open(...)
    local ok, sock = catch network.udp.open(...)
    skip_if_denied(ok, sock)

    if not ok then
        error(sock, 0)
    end

    return sock
end

-- Establish a connected loopback pair on an ephemeral port. The bind is the
-- first fallible call so a sandbox EPERM surfaces here and nowhere else. On
-- loopback the connect lands in the listen backlog and completes before accept
-- runs, so accept returns the queued connection without blocking.
local function make_pair()
    local server = tcp_bind("127.0.0.1", 0)
    local _, port = server:getsockname()
    local client = network.tcp.connect("127.0.0.1", port)
    local conn = server:accept()
    return server, client, conn
end

-- The waits of these tests depend on a server in a detached coroutine or
-- on a worker. An allocation that fails there, as the allocation sweep
-- injects, stops that peer, so every wait carries a timeout or ends when
-- the peer has died, and the test fails where it would otherwise hang.
local wait_seconds = 10

-- network.fetch with a timeout of `wait_seconds` unless `options` sets one.
local function fetch(url, method, headers, body, options)
    options = options or {}

    if options.timeout == nil then
        options.timeout = wait_seconds
    end

    return network.fetch(url, method or "GET", headers, body, options)
end

-- Accepts one connection on `server` while worker `w` connects. When the
-- worker ends first, its error is raised from worker.receive.
local function accept_from(server, w)
    server:settimeout(0.05)
    local started = os.time()

    while true do
        local ok, conn = catch server:accept()

        if ok and conn then
            conn:settimeout(wait_seconds)
            return conn
        end

        if worker.status(w) == "dead" then
            worker.receive(w)
            error("the worker ended before it connected", 0)
        end

        if os.time() - started > wait_seconds then
            error("the worker did not connect", 0)
        end
    end
end

local function make_sender(bytes, suffix)
    local server = tcp_bind("127.0.0.1", 0)
    local _, port = server:getsockname()
    local sender = worker.create(FIXTURES .. "/net_sender.lus")
    worker.send(sender, { port = port, bytes = bytes, suffix = suffix })
    return server, accept_from(server, sender), sender
end

local function finish_sender(sender)
    assert(worker.receive(sender) == "done")
    assert(worker.receive(sender) == nil)
end

local function closed_tcp_port()
    local server = tcp_bind("127.0.0.1", 0)
    local _, port = server:getsockname()
    server:close()
    return port
end

-- Answers one request on `server` with `head` and closes the connection,
-- while a worker runs network.fetch with `method`. Returns what the worker
-- reported.
local function fetch_once(method, head, headers)
    local server = tcp_bind("127.0.0.1", 0)
    local _, port = server:getsockname()
    local w = worker.create(FIXTURES .. "/net_fetch.lus")
    worker.send(w, { port = port, method = method, headers = headers })
    local conn = accept_from(server, w)
    local request = {}

    while true do
        local line = txt(conn:receive("*l"))

        if line == nil or line == "" then
            break
        end

        request[#request + 1] = line
    end

    conn:send(head)
    conn:close()
    server:close()
    local r = worker.receive(w)
    r.request = request
    return r
end

-- A header that the caller names replaces the default one, and a response
-- header that repeats keeps every value.
local function fetch_merges_caller_and_repeated_headers_test()
    local r = fetch_once(
        "GET",
        "HTTP/1.1 200 OK\r\nX-Tag: one\r\nX-Tag: two\r\nContent-Length: 0\r\n\r\n",
        { ["User-Agent"] = "probe/2" }
    )
    assert(r.ok, r.err)
    local agents = {}

    for _, line in ipairs(r.request) do
        if line:lower():find("^user%-agent:") then
            agents[#agents + 1] = line
        end
    end

    assert(#agents == 1 and agents[1] == "User-Agent: probe/2", table.concat(agents, " | "))
    assert(r.headers["x-tag"] == "one, two", r.headers["x-tag"])
end

-- The default User-Agent names the full version of the runtime.
local function fetch_sends_the_version_in_its_user_agent_test()
    local r = fetch_once("GET", "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n")
    assert(r.ok, r.err)
    local agent

    for _, line in ipairs(r.request) do
        agent = agent or line:match("^User%-Agent: (.*)$")
    end

    assert(agent and agent:match("^Lus/%d+%.%d+%.%d+"), agent)
end

-- A list as the value of a request header sends one line for each value.
local function fetch_sends_a_list_header_as_several_lines_test()
    local r = fetch_once("GET", "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n", {
        ["X-Multi"] = { "one", "two", 3 },
    })
    assert(r.ok, r.err)
    local values = {}

    for _, line in ipairs(r.request) do
        local v = line:match("^X%-Multi: (.*)$")

        if v then
            values[#values + 1] = v
        end
    end

    assert(table.concat(values, ",") == "one,two,3", table.concat(values, ","))
end

-- A response to HEAD ends after its headers, even with a Content-Length.
local function fetch_head_reads_no_body_test()
    local r = fetch_once("HEAD", "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n")
    assert(r.ok, r.err)
    assert(r.status == 200 and r.size == 0 and r.length == "5")
end

-- A 204 or 304 response has no body either.
local fetch_bodiless_statuses_read_no_body_cases = { { 204 }, { 304 } }

local function fetch_bodiless_statuses_read_no_body_test(status)
    local r = fetch_once("GET", `HTTP/1.1 $status X\r\nContent-Length: 5\r\n\r\n`)
    assert(r.ok, r.err)
    assert(r.status == status and r.size == 0)
end

-- Outside a detached coroutine, fetch runs the coroutines while it waits,
-- so the main code reaches a network.serve of the same state.
local function fetch_reaches_a_serve_of_the_same_state_test()
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()

    local server = coroutine.detach(coroutine.create(function()
        network.serve(listener, function(req)
            return 200, "hi " .. req.path
        end)
    end))

    local status, body = fetch(`http://127.0.0.1:$port/x`)
    coroutine.close(server)
    listener:close()
    assert(status == 200 and txt(body) == "hi /x", txt(body))
end

-- Serves `handler` in a detached coroutine and calls `body` with the URL
-- of the server.
local function with_server(handler, body)
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()
    local server = coroutine.detach(coroutine.create(network.serve), listener, handler)
    local ok, err = catch body(`http://127.0.0.1:$port`)
    coroutine.close(server)
    listener:close()

    if not ok then
        error(err, 0)
    end
end

local function fetch_streams_a_response_body_test()
    with_server(function(req)
        local i = 0

        return 200, function()
            i = i + 1

            if i <= 3 then
                return `data: $i\n\n`
            end
        end, { ["Content-Type"] = "text/event-stream" }
    end, function(base)
        local status, body, headers = fetch(base .. "/events", "GET", nil, nil, { stream = true })
        assert(status == 200 and headers["content-type"] == "text/event-stream")
        assert(type(body) == "thread")
        local lines = {}

        for line in network.lines(body) do
            lines[#lines + 1] = txt(line)
        end

        assert(table.concat(lines, "|") == "data: 1||data: 2||data: 3|", table.concat(lines, "|"))
        assert(coroutine.status(body) == "dead")
    end)
end

local function fetch_yields_a_streamed_body_in_parts_test()
    with_server(function(req)
        return 200, string.rep("abcdefgh", 20000)
    end, function(base)
        local _, body = fetch(base .. "/", "GET", nil, nil, { stream = true })
        local total = 0

        while true do
            local ok, part = coroutine.resume(body)
            assert(ok, part)

            if part == nil then
                break
            end

            assert(type(part) == "vector" and #part <= 65536)
            total = total + #part
        end

        assert(total == 160000)
    end)
end

-- Closing the coroutine of a body ends the response early and closes its
-- connection.
local function closing_a_body_closes_its_connection_test()
    with_server(function(req)
        return 200, string.rep("z", 500000)
    end, function(base)
        local _, body = fetch(base .. "/", "GET", nil, nil, { stream = true })
        local ok, part = coroutine.resume(body)
        assert(ok and #part > 0)
        assert(coroutine.close(body))
        assert(coroutine.status(body) == "dead")
    end)
end

local function fetch_sends_a_body_from_a_function_test()
    with_server(function(req)
        return 200, `$(req.headers["transfer-encoding"]) $(txt(req.body))`
    end, function(base)
        local parts = { "ab", "", vector.fromstring("cd") }
        local i = 0

        local status, body = fetch(base .. "/up", "POST", nil, function()
            i = i + 1
            return parts[i]
        end)

        assert(status == 200 and txt(body) == "chunked abcd", txt(body))
    end)
end

local function fetch_sends_a_body_from_a_coroutine_test()
    with_server(function(req)
        return 200, `$(req.headers["transfer-encoding"]) $(txt(req.body))`
    end, function(base)
        local status, body = fetch(base .. "/up", "POST", nil, coroutine.create(function()
            coroutine.yield("ab")
            coroutine.yield(vector.fromstring("cd"))
            return "ef"
        end))

        assert(status == 200 and txt(body) == "chunked abcdef", txt(body))
    end)
end

local function fetch_names_the_step_that_timed_out_test()
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()

    local server = coroutine.detach(coroutine.create(function()
        local c = listener:accept()
        c:receive("*l")
        c:send("HTTP/1.1 200 OK\r\nContent-Length: 10\r\n")
        -- The client sends nothing more, so this waits until it gives up.
        c:receive("*a")
        c:close()
    end))

    local ok, err = catch network.fetch(`http://127.0.0.1:$port/`, "GET", nil, nil, {
        timeout = 0.1,
    })
    assert(
        not ok
            and string.find(
                tostring(err),
                "fetch timeout while waiting for the response headers",
                1,
                true
            ),
        tostring(err)
    )
    coroutine.close(server)
    listener:close()
end

local function fetch_sends_a_function_body_with_a_length_as_is_test()
    with_server(function(req)
        return 200, `$(req.headers["content-length"]) $(tostring(req.headers["transfer-encoding"])) $(txt(
            req.body
        ))`
    end, function(base)
        local sent = false

        local status, body = fetch(base .. "/up", "PUT", { ["Content-Length"] = 3 }, function()
            if sent then
                return nil
            end

            sent = true
            return "xyz"
        end)

        assert(txt(body) == "3 nil xyz", txt(body))
    end)
end

local function fetch_rejects_unknown_options_test()
    local ok, err = catch network.fetch("http://127.0.0.1:1/", "GET", nil, nil, { strem = true })
    assert(not ok and string.find(tostring(err), "unknown option 'strem'", 1, true), tostring(err))
end

local function fetch_reads_a_body_that_ends_with_the_connection_test()
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()

    local server = coroutine.detach(coroutine.create(function()
        local c = listener:accept()
        c:receive("*l")
        c:send("HTTP/1.1 200 OK\r\n\r\nall of it")
        c:close()
    end))

    local status, body = fetch(`http://127.0.0.1:$port/`)
    coroutine.close(server)
    listener:close()
    assert(status == 200 and txt(body) == "all of it")
end

-- The server and the client each run in a detached coroutine of the same
-- state. The fetch suspends its coroutine, so the server answers it at
-- once rather than after the timeout of the fetch.
local function fetch_and_serve_in_two_detached_coroutines_test()
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()

    local server = coroutine.detach(coroutine.create(network.serve), listener, function(req)
        return 200, "served " .. req.path
    end)

    local result, failure

    local client = coroutine.create(function()
        local ok, status, body = catch network.fetch(
            `http://127.0.0.1:$port/pair`,
            "GET",
            nil,
            nil,
            { timeout = 5 }
        )

        if ok then
            result = `$status $(txt(body))`
        else
            failure = status
        end
    end)

    coroutine.detach(client)
    local started = os.clock()
    coroutine.resume(client)
    coroutine.close(server)
    listener:close()
    assert(failure == nil, tostring(failure))
    assert(result == "200 served /pair", tostring(result))
    assert(os.clock() - started < 2)
end

-- A fetch that waits for a slow server leaves the other detached
-- coroutines running.
local function a_slow_fetch_leaves_other_coroutines_running_test()
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()
    local release = false

    local server = coroutine.detach(coroutine.create(network.serve), listener, function(req)
        if req.path == "/slow" then
            while not release do
                coroutine.yield()
            end
        end

        return 200, req.path
    end)

    local slow, fast

    local slow_co = coroutine.detach(coroutine.create(function()
        local _, body = fetch(`http://127.0.0.1:$port/slow`)
        slow = txt(body)
    end))

    local fast_co = coroutine.detach(coroutine.create(function()
        local _, body = fetch(`http://127.0.0.1:$port/fast`)
        fast = txt(body)
    end))

    -- The fast fetch ends while the slow one still waits.
    coroutine.resume(fast_co)
    assert(fast == "/fast" and slow == nil, tostring(slow))
    release = true
    coroutine.resume(slow_co)
    assert(slow == "/slow")
    coroutine.close(server)
    listener:close()
end

-- Inside a detached coroutine, fetch suspends only its coroutine, so the
-- server of the same state answers it.
local function fetch_in_a_detached_coroutine_suspends_test()
    with_server(function(req)
        return 200, "from " .. req.path
    end, function(base)
        local result

        local client = coroutine.detach(coroutine.create(function()
            local _, body = fetch(base .. "/inner")
            result = txt(body)
        end))

        while coroutine.status(client) ~= "dead" do
            coroutine.resume(coroutine.detach(coroutine.create(coroutine.yield)))
        end

        assert(result == "from /inner", tostring(result))
    end)
end

-- A socket reader yields what has arrived on each resume and ends at the
-- end of the stream.
local function a_socket_reader_yields_what_arrived_test()
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()
    local step = 0

    local server = coroutine.detach(coroutine.create(function()
        local c <close> = listener:accept()
        c:send("first")

        while step < 1 do
            coroutine.yield()
        end

        c:send("second part")
    end))

    local sock <close> = network.tcp.connect("127.0.0.1", port)
    sock:settimeout(5)
    local reader = sock:reader(6)
    assert(type(reader) == "thread")
    local ok, part = coroutine.resume(reader)
    assert(ok and txt(part) == "first", tostring(part))
    step = 1
    local rest = {}

    while true do
        local more, piece = coroutine.resume(reader)
        assert(more, piece)

        if piece == nil then
            break
        end

        assert(#piece <= 6)
        rest[#rest + 1] = txt(piece)
    end

    assert(table.concat(rest) == "second part")
    assert(coroutine.status(reader) == "dead")
    coroutine.close(server)
    listener:close()
end

local function network_lines_reads_a_socket_test()
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()

    local server = coroutine.detach(coroutine.create(function()
        local c <close> = listener:accept()
        c:send("one\r\ntw")
        c:send("o\nthree")
    end))

    local sock <close> = network.tcp.connect("127.0.0.1", port)
    local lines = {}

    for line in network.lines(sock:reader()) do
        lines[#lines + 1] = txt(line)
    end

    coroutine.close(server)
    listener:close()
    assert(table.concat(lines, ",") == "one,two,three")
end

-- A socket reader is a body: serve streams it out, and fetch sends it.
local function a_socket_reader_is_a_body_test()
    local source = tcp_bind("127.0.0.1", 0)
    local _, sport = source:getsockname()

    local feeder = coroutine.detach(coroutine.create(function()
        for _ = 1, 2 do
            local c <close> = source:accept()
            c:send("relayed bytes")
        end
    end))

    with_server(function(req)
        if req.path == "/relay" then
            local upstream = network.tcp.connect("127.0.0.1", sport)
            return 200, upstream:reader()
        end

        return 200, `got $(txt(req.body))`
    end, function(base)
        local _, body = network.fetch(base .. "/relay")
        assert(txt(body) == "relayed bytes", txt(body))
        local up <close> = network.tcp.connect("127.0.0.1", sport)
        local _, echoed = network.fetch(base .. "/up", "POST", nil, up:reader())
        assert(txt(echoed) == "got relayed bytes", txt(echoed))
    end)

    coroutine.close(feeder)
    source:close()
end

local function a_socket_reader_raises_on_timeout_test()
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()
    local sock <close> = network.tcp.connect("127.0.0.1", port, { timeout = 0.05 })
    local ok, err = coroutine.resume(sock:reader())
    listener:close()
    assert(not ok and string.find(tostring(err), "receive timeout", 1, true), tostring(err))
end

-- The iterator of network.lines holds its state, so it works alone.
local function network_lines_works_as_a_plain_function_test()
    local co = coroutine.create(function()
        coroutine.yield("one\ntw")
        coroutine.yield("o\n")
    end)

    local nextline = network.lines(co)
    assert(txt(nextline()) == "one" and txt(nextline()) == "two" and nextline() == nil)
end

local function settimeout_nil_clears_the_timeout_test()
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()
    local sock <close> = network.tcp.connect("127.0.0.1", port)
    -- 0 polls: a receive with nothing to read fails at once.
    sock:settimeout(0)
    local got, err = sock:receive(1)
    assert(
        got == nil and err.code == "timeout" and tostring(err) == "receive timeout",
        tostring(err)
    )
    -- nil waits without limit again.
    sock:settimeout(nil)

    local server = coroutine.detach(coroutine.create(function()
        local c <close> = listener:accept()
        c:send("z")
    end))

    assert(txt(sock:receive(1)) == "z")
    coroutine.close(server)
    listener:close()
end

local function receive_reads_more_than_a_mebibyte_test()
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()
    local size = 3 * 1024 * 1024 + 7

    local server = coroutine.detach(coroutine.create(function()
        local c <close> = listener:accept()
        c:send(vector.create(size))
    end))

    local sock <close> = network.tcp.connect("127.0.0.1", port)
    local got = sock:receive(size)
    coroutine.close(server)
    listener:close()
    assert(#got == size)
end

-- send(data, i, j) sends a part: characters of a string, bytes of a
-- vector, and returns the position of the last one.
local function send_takes_a_range_test()
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()
    local sock <close> = network.tcp.connect("127.0.0.1", port)
    local c <close> = listener:accept()
    assert(sock:send("héllo wörld", 3, 5) == 5)
    assert(sock:send("héllo", -2) == 5)
    assert(sock:send(vector.fromstring("abcdef"), 2, 3) == 3)
    assert(sock:send("xyz", 3, 2) == 0)
    sock:close()
    assert(txt(c:receive("*a")) == "llolobc")
    listener:close()
end

-- A connection to a server whose queue is full waits until its timeout,
-- which covers every address of the host and names the address.
local function tcp_connect_times_out_test()
    local listener = tcp_bind("127.0.0.1", 0, 1)
    local _, port = listener:getsockname()
    local held = {}
    local timed_out

    for _ = 1, 256 do
        local sock, err = network.tcp.connect("127.0.0.1", port, { timeout = 0.05 })

        if sock == nil then
            timed_out = err
            break
        end

        held[#held + 1] = sock
    end

    for _, sock in ipairs(held) do
        sock:close()
    end

    listener:close()

    if timed_out == nil then
        skip("the system accepted every connection")
    end

    -- Some systems refuse a connection to a full queue at once, and others
    -- leave it waiting, which the timeout ends.
    if timed_out.code ~= "timeout" then
        skip("the system refuses connections to a full queue")
    end

    assert(
        string.find(tostring(timed_out), `timeout while connecting to 127.0.0.1:$port`, 1, true),
        tostring(timed_out)
    )
end

-- A server on 127.0.0.1 alone and a short timeout: the name localhost
-- may resolve to ::1 first, which a system may refuse slowly, so the
-- attempt at the next address starts beside it after a short delay.
local function tcp_connect_reaches_the_second_address_of_a_host_in_time_test()
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()
    local sock, err = network.tcp.connect("localhost", port, { timeout = 1 })
    listener:close()
    assert(sock, tostring(err))
    local address = sock:getpeername()
    sock:close()
    assert(address == "127.0.0.1", address)
end

local function tcp_connect_gives_the_socket_its_timeout_test()
    local listener = tcp_bind("127.0.0.1", 0)
    local _, port = listener:getsockname()
    local sock <close> = network.tcp.connect("127.0.0.1", port, { timeout = 0.05 })
    local got, err = sock:receive(1)
    listener:close()
    assert(got == nil and err.code == "timeout", tostring(err))
end

local function tcp_connect_rejects_bad_options_test()
    local cases = {
        { { bogus = 1 }, "unknown option 'bogus'" },
        { { timeout = "soon" }, "timeout must be a number of seconds" },
        { "fast", "table expected" },
    }

    for _, case in ipairs(cases) do
        local ok, err = catch network.tcp.connect("127.0.0.1", 1, case[1])
        assert(not ok and string.find(tostring(err), case[2], 1, true), tostring(err))
    end
end

-- ============================================================
-- TCP loopback data path (bind-dependent)
-- ============================================================

-- TCP send then receive delivers the exact bytes
local function tcp_send_then_receive_delivers_the_exact_bytes_test()
    local server, client, conn = make_pair()
    local n = client:send("hello")
    assert(n == 5)
    assert(txt(conn:receive(5)) == "hello")
    conn:close()
    client:close()
    server:close()
end

-- TCP data flows in both directions
local function tcp_data_flows_in_both_directions_test()
    local server, client, conn = make_pair()
    client:send("ping")
    assert(txt(conn:receive(4)) == "ping")
    conn:send("pong")
    assert(txt(client:receive(4)) == "pong")
    conn:close()
    client:close()
    server:close()
end

-- TCP receive with a size splits a payload into chunks
local function tcp_receive_with_a_size_splits_a_payload_into_chunks_test()
    local server, client, conn = make_pair()
    client:send("hello world")
    assert(txt(conn:receive(5)) == "hello")
    assert(txt(conn:receive(6)) == " world")
    conn:close()
    client:close()
    server:close()
end

-- TCP receive coalesces bytes from multiple sends
local function tcp_receive_coalesces_bytes_from_multiple_sends_test()
    local server, client, conn = make_pair()
    client:send("ab")
    client:send("cd")
    assert(txt(conn:receive(4)) == "abcd")
    conn:close()
    client:close()
    server:close()
end

-- TCP receive '*a' returns all bytes up to peer close
local function tcp_receive_a_returns_all_bytes_up_to_peer_close_test()
    local server, client, conn = make_pair()
    client:send("goodbye")
    client:close()
    assert(txt(conn:receive("*a")) == "goodbye")
    conn:close()
    server:close()
end

-- TCP receive '*l' returns one line without the newline
local function tcp_receive_l_returns_one_line_without_the_newline_test()
    local server, client, conn = make_pair()
    client:send("first\nsecond\n")
    assert(txt(conn:receive("*l")) == "first")
    assert(txt(conn:receive("*l")) == "second")
    conn:close()
    client:close()
    server:close()
end

-- TCP receive strips a trailing carriage return on '*l'
local function tcp_receive_strips_a_trailing_carriage_return_on_l_test()
    local server, client, conn = make_pair()
    client:send("crlf\r\nrest")
    assert(txt(conn:receive("*l")) == "crlf")
    conn:close()
    client:close()
    server:close()
end

-- TCP line receive accepts its exact limit and buffered next line
local function tcp_line_receive_accepts_its_exact_limit_and_buffered_next_line_test()
    local server, client, conn = make_pair()
    client:send("abcd\r\nnext\n")
    assert(txt(conn:receive("*l", 4)) == "abcd")
    assert(txt(conn:receive("*l", 4)) == "next")
    conn:close()
    client:close()
    server:close()
end

-- TCP line receive closes the socket when its limit is exceeded
local function tcp_line_receive_closes_the_socket_when_its_limit_is_exceeded_test()
    local server, client, conn = make_pair()
    client:send("abcde\n")
    client:close()
    local got, err = conn:receive("*l", 4)
    assert(got == nil and err.code == "limit")
    assert(string.find(tostring(err), "receive limit exceeded", 1, true) ~= nil)
    assert(string.find(tostring(conn), "closed"))

    raises(function()
        conn:receive("*l", 4)
    end, "closed")

    conn:close()
    server:close()
end

-- TCP line receive counts an unterminated carriage return
local function tcp_line_receive_counts_an_unterminated_carriage_return_test()
    local server, client, conn = make_pair()
    client:send("abc\r")
    client:close()
    assert(txt(conn:receive("*l", 4)) == "abc\r")
    conn:close()
    server:close()

    server, client, conn = make_pair()
    client:send("abcd\r")
    client:close()
    local got, err = conn:receive("*l", 4)
    assert(got == nil)
    assert(string.find(tostring(err), "receive limit exceeded"))
    assert(string.find(tostring(conn), "closed"))
    conn:close()
    server:close()
end

-- TCP all-data receive enforces an explicit limit
local function tcp_all_data_receive_enforces_an_explicit_limit_test()
    local server, client, conn = make_pair()
    client:send("abcd")
    client:close()
    assert(txt(conn:receive("*a", 4)) == "abcd")
    conn:close()
    server:close()

    server, client, conn = make_pair()
    client:send("abcde")
    client:close()
    local got, err = conn:receive("*a", 4)
    assert(got == nil)
    assert(string.find(tostring(err), "receive limit exceeded", 1, true) ~= nil)
    assert(string.find(tostring(conn), "closed"))
    server:close()
end

-- TCP pattern receive requires a positive integer limit
local function tcp_pattern_receive_requires_a_positive_integer_limit_test()
    local server, client, conn = make_pair()

    raises(function()
        conn:receive("*l", 0)
    end, "positive")

    raises(function()
        conn:receive("*a", -1)
    end, "positive")

    raises(function()
        conn:receive("*l", 0.5)
    end, "integer")

    client:send("ping")
    assert(txt(conn:receive(4, -1)) == "ping")
    conn:close()
    client:close()
    server:close()
end

-- TCP receive times out cleanly when no data is pending
local function tcp_receive_times_out_cleanly_when_no_data_is_pending_test()
    local server, client, conn = make_pair()
    conn:settimeout(0.05)
    local got, err = conn:receive(4)
    assert(got == nil and err.code == "timeout", tostring(err))
    conn:close()
    client:close()
    server:close()
end

-- TCP accept times out cleanly on an idle server
local function tcp_accept_times_out_cleanly_on_an_idle_server_test()
    local server = tcp_bind("127.0.0.1", 0)
    server:settimeout(0.05)
    local got, err = server:accept()
    assert(got == nil and err.code == "timeout", tostring(err))
    server:close()
end

-- TCP send on a closed connection errors about the closed socket
local function tcp_send_on_a_closed_connection_errors_about_the_closed_socket_test()
    local server, client, conn = make_pair()
    client:close()

    raises(function()
        client:send("nope")
    end, "closed")

    conn:close()
    server:close()
end

-- TCP receive on a closed connection errors about the closed socket
local function tcp_receive_on_a_closed_connection_errors_about_the_closed_socket_test()
    local server, client, conn = make_pair()
    conn:close()

    raises(function()
        conn:receive(1)
    end, "closed")

    client:close()
    server:close()
end


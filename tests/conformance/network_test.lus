-- ============================================================
-- UDP datagram round trip (bind-dependent)
-- ============================================================

-- UDP delivers a datagram with the sender address
local function udp_delivers_a_datagram_with_the_sender_address_test()
    -- The receiver binds first so a sandbox EPERM surfaces on this line.
    local receiver = udp_open(0, "127.0.0.1")
    local _, receiver_port = receiver:getsockname()
    local sender = udp_open(0, "127.0.0.1")
    local _, sender_port = sender:getsockname()
    local n = sender:sendto("ping", "127.0.0.1", receiver_port)
    assert(n == 4)
    local data, ip, port = receiver:receive()
    assert(txt(data) == "ping")
    assert(ip == "127.0.0.1")
    assert(port == sender_port)
    sender:close()
    receiver:close()
end

-- UDP round trips a second datagram in the other direction
local function udp_round_trips_a_second_datagram_in_the_other_direction_test()
    local a = udp_open(0, "127.0.0.1")
    local _, aport = a:getsockname()
    local b = udp_open(0, "127.0.0.1")
    local _, bport = b:getsockname()
    a:sendto("from-a", "127.0.0.1", bport)
    local data, ip, port = b:receive()
    assert(txt(data) == "from-a")
    assert(port == aport)
    b:sendto("from-b", ip, port)
    local reply = a:receive()
    assert(txt(reply) == "from-b")
    a:close()
    b:close()
end

-- UDP open with a port only binds to all interfaces
local function udp_open_with_a_port_only_binds_to_all_interfaces_test()
    local sock = udp_open(0)
    assert(string.find(tostring(sock), "udpsocket"))
    sock:close()
end


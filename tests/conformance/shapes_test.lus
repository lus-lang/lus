--[[
  Tests for shaped tables (spec/design/tables.md, Shapes).

  A table whose hash part holds only short string keys shares their list
  with every table that received the same keys in the same order. These
  tests check that such tables behave as any table does: transitions,
  deletes, iteration, the move to a dictionary, metatables, weak values,
  and the caches of every JIT tier, which run the loops below hot enough
  to compile.
]]

local function keys_of(t)
    local ks = {}
    for k in pairs(t) do ks[#ks + 1] = k end
    return ks
end

local function same_list(a, b)
    if #a ~= #b then return false end
    for i = 1, #a do
        if a[i] ~= b[i] then return false end
    end
    return true
end

local function fields_in_store_order_test()
    -- A record built field by field yields its keys in the order they
    -- were first stored.
    local function build()
        local t = {}
        t.charlie = 1
        t.alpha = 2
        t.bravo = 3
        return t
    end
    for _ = 1, 50 do
        local t = build()
        assert(same_list(keys_of(t), { "charlie", "alpha", "bravo" }))
        assert(t.charlie == 1 and t.alpha == 2 and t.bravo == 3)
    end
end

local function delete_keeps_the_slot_test()
    -- Clearing a field and storing it again keeps its place in the order.
    local t = { x = 1, y = 2, z = 3 }
    t.y = nil
    assert(t.y == nil)
    assert(same_list(keys_of(t), { "x", "z" }) or same_list(keys_of(t), { "z", "x" }))
    local before = keys_of(t)
    t.y = 20
    assert(t.y == 20)
    local after = keys_of(t)
    assert(#after == 3)
    -- The order of the keys that stayed does not change.
    local pos = {}
    for i, k in ipairs(after) do pos[k] = i end
    assert(pos[before[1]] < pos[before[2]])
end

local function clearing_during_traversal_test()
    local t = {}
    for _, k in ipairs({ "a", "b", "c", "d", "e", "f" }) do t[k] = k end
    local seen = 0
    for k in pairs(t) do
        seen = seen + 1
        t[k] = nil
    end
    assert(seen == 6)
    assert(next(t) == nil)
end

local function assigning_during_traversal_test()
    local t = { a = 1, b = 2, c = 3, d = 4 }
    local n = 0
    for k, v in pairs(t) do
        n = n + 1
        t[k] = v * 10
    end
    assert(n == 4)
    assert(t.a == 10 and t.b == 20 and t.c == 30 and t.d == 40)
end

local function non_string_key_makes_a_dictionary_test()
    local t = { name = "n", size = 3 }
    t[2.5] = "float"
    t[true] = "bool"
    local k = {}
    t[k] = "table"
    assert(t.name == "n" and t.size == 3)
    assert(t[2.5] == "float" and t[true] == "bool" and t[k] == "table")
    local count = 0
    for _ in pairs(t) do count = count + 1 end
    assert(count == 5)
    t.extra = 1
    assert(t.extra == 1)
end

local function long_string_key_makes_a_dictionary_test()
    local long = string.rep("k", 60)
    local t = { a = 1 }
    t[long] = 2
    assert(t.a == 1 and t[long] == 2)
    assert(t[string.rep("k", 60)] == 2)
end

local function many_keys_make_a_dictionary_test()
    local t = {}
    for i = 1, 100 do t["key" .. i] = i end
    for i = 1, 100 do assert(t["key" .. i] == i) end
    local count = 0
    for _ in pairs(t) do count = count + 1 end
    assert(count == 100)
    for i = 1, 100, 2 do t["key" .. i] = nil end
    for i = 1, 100 do assert(t["key" .. i] == (i % 2 == 0 and i or nil)) end
end

local function array_part_and_fields_test()
    local t = { name = "list" }
    for i = 1, 20 do t[i] = i * i end
    assert(#t == 20 and t.name == "list")
    local ints, strs = 0, 0
    for k in pairs(t) do
        if math.type(k) == "integer" then ints = ints + 1 else strs = strs + 1 end
    end
    assert(ints == 20 and strs == 1)
    -- Integer keys come first, from the array part.
    local first = next(t)
    assert(first == 1)
end

local function many_shapes_at_one_site_test()
    -- One field access that sees tables of several shapes.
    local function get_x(t) return t.x end
    local function set_x(t, v) t.x = v end
    local shapes = {
        { x = 1 },
        { a = 0, x = 2 },
        { b = 0, c = 0, x = 3 },
        { x = 4, d = 0 },
    }
    local dict = { x = 5 }
    dict[1.5] = 0
    shapes[#shapes + 1] = dict
    for _ = 1, 200 do
        for i, t in ipairs(shapes) do
            assert(get_x(t) == i)
            set_x(t, i)
        end
    end
    for i, t in ipairs(shapes) do assert(t.x == i) end
end

local function transitions_at_one_store_test()
    -- A store that adds the same key to tables of the same shape, and
    -- then to a table of another shape and to a dictionary.
    local function add(t, v) t.extra = v end
    for i = 1, 300 do
        local t = { a = i }
        add(t, i * 2)
        assert(t.a == i and t.extra == i * 2)
    end
    local other = { b = 1, c = 2 }
    add(other, 7)
    assert(other.extra == 7 and other.b == 1 and other.c == 2)
    local d = { a = 1 }
    d[0.5] = true
    add(d, 9)
    assert(d.extra == 9)
    -- Storing nil under an absent key adds nothing.
    local e = { a = 1 }
    add(e, nil)
    assert(next(e, "a") == nil)
end

local function constructor_learns_its_shape_test()
    -- A constructor whose tables gain fields after it ran. Tables that
    -- skip a field do not show it.
    local function make(i, full)
        local t = { id = i }
        t.name = "n" .. i
        if full then t.extra = i end
        return t
    end
    for i = 1, 100 do
        local t = make(i, i % 2 == 0)
        assert(t.id == i and t.name == "n" .. i)
        if i % 2 == 0 then
            assert(t.extra == i)
        else
            assert(t.extra == nil)
            local count = 0
            for _ in pairs(t) do count = count + 1 end
            assert(count == 2)
        end
    end
end

local function variable_keys_test()
    -- A store and a load with a key that changes between runs.
    local t = { a = 1, b = 2, c = 3 }
    local ks = { "a", "b", "c" }
    for round = 1, 100 do
        for i, k in ipairs(ks) do
            t[k] = round * i
        end
        for i, k in ipairs(ks) do
            assert(t[k] == round * i)
        end
    end
    local built = "b" .. ""
    assert(t[built] == 200)
end

local function metatables_test()
    -- A class table and its instances.
    local Point = {}
    Point.__index = Point
    function Point.new(x, y) return setmetatable({ x = x, y = y }, Point) end
    function Point:len2() return self.x * self.x + self.y * self.y end
    local sum = 0
    for i = 1, 200 do
        local p = Point.new(i, 1)
        sum = sum + p:len2()
    end
    assert(sum > 0)
    -- An instance that gets its own field with the name of a method.
    local p = Point.new(3, 4)
    assert(p:len2() == 25)
    p.len2 = function() return -1 end
    assert(p:len2() == -1)
    p.len2 = nil
    assert(p:len2() == 25)
    -- `__index` through a table built by a constructor.
    local proto = { greet = function() return "hi" end, kind = "proto" }
    local obj = setmetatable({ own = 1 }, { __index = proto })
    for _ = 1, 100 do
        assert(obj.greet() == "hi" and obj.kind == "proto" and obj.own == 1)
    end
    -- `__newindex` sees stores of absent keys.
    local log = {}
    local guarded = setmetatable({ a = 1 }, { __newindex = function(t, k, v) log[#log + 1] = k rawset(t, k, v) end })
    guarded.a = 2
    guarded.b = 3
    assert(#log == 1 and log[1] == "b" and guarded.b == 3)
end

local function weak_values_test()
    local cache = setmetatable({}, { __mode = "v" })
    cache.keep = {}
    cache.drop = {}
    local held = cache.keep
    collectgarbage()
    collectgarbage()
    assert(cache.keep == held)
    assert(cache.drop == nil)
    local weak_keys = setmetatable({ name = {} }, { __mode = "k" })
    collectgarbage()
    -- String keys are values for weak tables, so the entry stays.
    assert(type(weak_keys.name) == "table")
end

local function clone_and_json_test()
    local t = { id = 1, name = "x", tags = { "a", "b" } }
    local c = table.clone(t)
    assert(c ~= t and c.id == 1 and c.name == "x" and c.tags == t.tags)
    local back = fromjson(tojson({ t, { id = 2, name = "y", tags = {} } }))
    assert(back[1].id == 1 and back[1].name == "x" and back[1].tags[2] == "b")
    assert(back[2].id == 2 and next(back[2].tags) == nil)
    local text = tojson({ z = 1, a = 2 })
    assert(text == '{"z":1,"a":2}' or text == '{"a":2,"z":1}')
end

local function collector_keeps_slot_values_test()
    local list = {}
    for i = 1, 2000 do
        list[i] = { name = "item" .. i, value = { i } }
        if i % 500 == 0 then collectgarbage() end
    end
    collectgarbage()
    for i = 1, 2000 do
        assert(list[i].name == "item" .. i and list[i].value[1] == i)
    end
end

local function transition_cache_after_another_shape_test()
    -- A store site that learned a transition, then met the key in a table
    -- of another shape, adds it again to a table of the first shape.
    local function setx(t, v) t.x = v end
    for i = 1, 300 do
        local t = { a = 1, b = 2 }
        setx(t, i)
    end
    local s = { x = 0 }
    setx(s, 1)
    local t = { a = 1, b = 2 }
    setx(t, 9)
    assert(t.a == 1 and t.b == 2 and t.x == 9)
    for _ = 1, 100 do
        local u = { a = 1, b = 2 }
        setx(u, 3)
        assert(u.a == 1 and u.b == 2 and u.x == 3)
    end
end

local function transition_cache_with_variable_keys_test()
    local function set(t, k, v) t[k] = v end
    local t1 = { a = 1 }
    set(t1, "z", 1)
    local t2 = { a = 1 }
    t2.z = 2
    set(t2, "a", 5)
    local all = {}
    for i = 1, 2000 do
        local t3 = { a = 1 }
        set(t3, "a", 7)
        all[i] = t3
    end
    for i = 1, 2000 do all[i].z = i end
    collectgarbage()
    for i = 1, 2000 do assert(all[i].a == 7 and all[i].z == i) end
end

local function traversal_while_serving_as_index_test()
    -- A table that becomes the `__index` of a metatable while a traversal
    -- walks it keeps its order.
    local proto = { a = 1, b = 2, c = 3, d = 4, e = 5, f = 6 }
    local n, seen = 0, {}
    for k in pairs(proto) do
        n = n + 1
        assert(not seen[k])
        seen[k] = true
        if n == 2 then
            local o = setmetatable({}, { __index = proto })
            local _ = o.zzz
            assert(o.e == 5)
        end
    end
    assert(n == 6)
    local p2 = { a = 1, b = 2, c = 3 }
    local steps = 0
    for k in pairs(p2) do
        steps = steps + 1
        p2[k] = nil
        local o = setmetatable({}, { __index = p2 })
        local _ = o.zzz
    end
    assert(steps == 3 and next(p2) == nil)
end

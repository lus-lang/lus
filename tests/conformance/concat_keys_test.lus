-- Short results of concatenation and interpolation are interned only when
-- they become table keys. These tests check that they compare, index,
-- and iterate like any other string, in loops hot enough for every tier.

local function make(prefix, n)
    return prefix .. n
end

-- a built string equals a literal with the same text
local function built_strings_equal_literals_test()
    local hits = 0

    for i = 1, 2000 do
        local s = make("ke", "y")

        if s == "key" then
            hits = hits + 1
        end

        if s ~= "key" then
            error("differs")
        end

        local t = `k$(i % 3)`

        if t == "k1" then
            hits = hits + 1
        end
    end

    assert(hits == 2000 + 667)
end

-- a built string compares false against other literals
local function built_strings_differ_from_other_literals_test()
    local n = 0

    for i = 1, 2000 do
        local s = "a" .. (i % 10)

        if s == "b1" or s == "a10" then
            n = n + 1
        end
    end

    assert(n == 0)
end

-- a built key finds a field stored under a literal, and the reverse
local function built_keys_index_like_literals_test()
    local t = { alpha = 1 }

    for i = 1, 2000 do
        assert(t["al" .. "pha"] == 1)
        t[`beta$(i % 2)`] = i
    end

    assert(t.beta0 == 2000 and t.beta1 == 1999)
    local count = 0

    for _k in pairs(t) do
        count = count + 1
    end

    assert(count == 3)
end

-- a built key replaces the value of the same key, never adds a second
local function built_keys_do_not_duplicate_test()
    local t = {}

    for i = 1, 100 do
        t["x" .. "y"] = i
        t.xy = i + 1
    end

    local n = 0

    for k, v in pairs(t) do
        n = n + 1
        assert(k == "xy" and v == 101)
    end

    assert(n == 1)
    assert(rawget(t, "x" .. "y") == 101)
    rawset(t, "x" .. "y", 7)
    assert(t.xy == 7)
end

-- next accepts a built key for a field stored under a literal
local function next_accepts_built_keys_test()
    local t = { one = 1 }
    local k, v = next(t, "o" .. "ne")
    assert(k == nil and v == nil)
    assert(next({ one = 1, two = 2 }, "tw" .. "o") ~= "two")
end

-- built strings work as keys of methods and upvalue tables
local function built_names_reach_methods_test()
    local obj = {
        greet = function()
            return "hi"
        end,
    }

    for _i = 1, 500 do
        assert(obj["gr" .. "eet"]() == "hi")
    end

    assert(rawequal("ab" .. "c", "abc"))
    assert(("x" .. 1) < "x2" and ("x" .. 3) > "x2")
end

-- an enum member found by a built name
local function enum_members_by_built_name_test()
    local color = enum RED, GREEN, BLUE end
    assert(color["GR" .. "EEN"] == color.GREEN)
end

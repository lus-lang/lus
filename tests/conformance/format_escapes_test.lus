-- The formatter keeps every string literal as written: its quotes, its
-- long brackets, and each escape, since it changes the layout of a
-- program and never the spelling of its literals. Each case is a line
-- that is already laid out, so formatting must return it byte for byte.

local keeps_every_escape_as_written_cases = {
    { [[local s = "\u{A0}\u{200F}"]] },
    { [[local s = "\u{2014}\u{2013}"]] },
    { [[local s = "\27[0m\x1b[1m"]] },
    { [[local s = "\x41\065\97"]] },
    { [[local s = "\0\00\000\x00"]] },
    { [[local s = "\a\b\f\n\r\t\v\\\"\'"]] },
    { [[local s = 'single \'quoted\' "text"']] },
    { "local s = \"line\\z\n    continued\"" },
    { "local s = \"break\\\nafter\"" },
    { [===[local s = [==[long ]] text]==]]===] },
    { "local s = [[\nfirst line\nsecond line]]" },
    { [[local s = `escaped \$ and $$ and \` and \n`]] },
    { [[local s = `a\t$(1 + 2)b\\$x c\r`]] },
    { [[local s = `outer $(`inner \n $(1)`) done`]] },
    { [[local t = { ["k\x41"] = 1, ["two words"] = 2, plain = 3 }]] },
    { [[print("\u{1F600}")]] },
    { "local s = \"raw é and \\u{E9}\"" },
}

local function keeps_every_escape_as_written_test(source)
    local formatted, err = debug.format(source .. "\n", "=escapes")
    assert(formatted, err)
    assert(formatted == source .. "\n", "\n" .. source .. "\n" .. formatted)
end

-- A string key written without escapes becomes a plain name, which is a
-- change of layout.
local function a_plain_string_key_becomes_a_name_test()
    local formatted = debug.format([[local t = {["ok"]=1}]] .. "\n", "=keys")
    assert(formatted == "local t = { ok = 1 }\n", formatted)
end

-- Formatting needs a parse alone, so a program whose names would fail to
-- resolve still formats.
local function a_program_with_undeclared_names_formats_test()
    local formatted, err = debug.format("global worker\nprint(ipairs)\n", "=names")
    assert(formatted == "global worker\nprint(ipairs)\n", tostring(err))
end

-- Comments keep their place inside tables and at the end of blocks.
local function comments_keep_their_place_test()
    local src = "local t = {\n    a = 1,  -- first\n}\nfor i = 1, 2 do\n    f(i)\n    -- after\nend\n"
    local formatted, err = debug.format(src, "=comments")
    assert(formatted == src, tostring(err) .. "\n" .. tostring(formatted))
end

-- Sockets as suspension points (spec/design/coroutines.md). Inside a
-- detached coroutine, connect, accept, send, and receive suspend the
-- coroutine while the socket is not ready. Anywhere else they keep their
-- caller blocked and run the scheduler while they wait. Every test binds
-- port 0 on the loopback interface and collects the coroutines it
-- detaches.
pledge("network")

local create, detach, resume, yield = coroutine.create, coroutine.detach, coroutine.resume, coroutine.yield
local status, close = coroutine.status, coroutine.close

local function txt(v)
    if type(v) == "vector" then
        return vector.tostring(v)
    end
    return v
end

local function spawn(f, ...)
    return detach(create(f), ...)
end

local function pack(...)
    return { n = select("#", ...), ... }
end

-- Binding a socket is not permitted in every environment, so a refused
-- bind skips the test.
local function denied(err)
    local text = tostring(err)
    return string.find(text, "ermission denied", 1, true) or string.find(text, "not permitted", 1, true)
        or string.find(text, "EPERM", 1, true) or string.find(text, "UDP socket: Unexpected", 1, true)
end

local function listen()
    local server, err = network.tcp.bind("127.0.0.1", 0)
    if not server then
        if denied(err) then
            skip("loopback sockets unavailable")
        end
        error(err, 0)
    end
    local _, port = server:getsockname()
    return server, port
end

local function connect(port)
    local sock = network.tcp.connect("127.0.0.1", port)
    sock:settimeout(10)
    return sock
end

-- Echoes every line of a connection until the peer closes it.
local function echo(sock)
    local conn <close> = sock
    while true do
        local line = conn:receive("*l")
        if #line == 0 then
            break
        end
        conn:send(txt(line) .. "\n")
    end
end

-- Starts a server whose connections each run `serve` in a detached
-- coroutine. Returns the port and the function that stops the server.
local function start(serve)
    local server, port = listen()
    local acceptor = spawn(function()
        while true do
            local sock = server:accept()
            spawn(serve, sock)
        end
    end)
    return port, function()
        assert(close(acceptor))
        server:close()
    end
end

-- ===== Many connections =====

local function many_connections_run_at_once_test()
    local port, stop = start(echo)
    local clients = {}
    for i = 1, 64 do
        clients[i] = spawn(function(n)
            local sock <close> = connect(port)
            local replies = {}
            for round = 1, 5 do
                sock:send(`client $(n) round $(round)\n`)
                replies[round] = txt(sock:receive("*l"))
            end
            return n, table.concat(replies, "|")
        end, i)
    end
    for i = 1, 64 do
        local ok, n, text = resume(clients[i])
        assert(ok, tostring(n))
        local expected = {}
        for round = 1, 5 do
            expected[round] = `client $(i) round $(round)`
        end
        assert(n == i and text == table.concat(expected, "|"), text)
    end
    stop()
end

local function connections_interleave_test()
    local port, stop = start(echo)
    local log = {}
    local function client(name)
        local sock <close> = connect(port)
        for round = 1, 3 do
            sock:send(name .. round .. "\n")
            local line = txt(sock:receive("*l"))
            log[#log + 1] = line
        end
    end
    local a = spawn(client, "a")
    local b = spawn(client, "b")
    assert(resume(a))
    assert(resume(b))
    stop()
    -- Neither client finished before the other started.
    local text = table.concat(log, " ")
    local first_b = string.find(text, "b1", 1, true)
    local last_a = string.find(text, "a3", 1, true)
    assert(#log == 6 and first_b < last_a, text)
end

local function several_acceptors_share_a_server_test()
    local server, port = listen()
    local served = { 0, 0, 0 }
    local acceptors = {}
    for i = 1, 3 do
        acceptors[i] = spawn(function()
            while true do
                local sock <close> = server:accept()
                served[i] = served[i] + 1
                sock:send(txt(sock:receive("*l")) .. "\n")
            end
        end)
    end
    local clients = {}
    for i = 1, 9 do
        clients[i] = spawn(function()
            local sock <close> = connect(port)
            sock:send(`hello $(i)\n`)
            return txt(sock:receive("*l"))
        end)
    end
    for i = 1, 9 do
        local ok, reply = resume(clients[i])
        assert(ok and reply == `hello $(i)`, tostring(reply))
    end
    assert(served[1] + served[2] + served[3] == 9)
    for i = 1, 3 do
        assert(close(acceptors[i]))
    end
    server:close()
end

-- ===== Code outside detached coroutines =====

local function the_main_chunk_runs_the_scheduler_while_it_waits_test()
    local port, stop = start(echo)
    -- The server only runs when this test waits on its own socket.
    local sock <close> = connect(port)
    for round = 1, 5 do
        assert(sock:send(`main $(round)\n`) == #`main $(round)\n`)
        assert(txt(sock:receive("*l")) == `main $(round)`)
    end
    sock:close()
    stop()
end

local function a_plain_coroutine_outside_runs_the_scheduler_test()
    local port, stop = start(echo)
    local plain = create(function()
        local sock <close> = connect(port)
        sock:send("one\n")
        yield(txt(sock:receive("*l")))
        sock:send("two\n")
        return txt(sock:receive("*l"))
    end)
    local r = pack(resume(plain))
    assert(r.n == 2 and r[1] == true and r[2] == "one")
    r = pack(resume(plain))
    assert(r.n == 2 and r[1] == true and r[2] == "two")
    stop()
end

local function background_coroutines_run_while_the_main_chunk_waits_test()
    local server, port = listen()
    local ticks = 0
    local ticker = spawn(function()
        while true do
            ticks = ticks + 1
            yield()
        end
    end)
    local responder = spawn(function()
        local sock <close> = server:accept()
        local line = txt(sock:receive("*l"))
        for _ = 1, 50 do
            yield()
        end
        sock:send(line .. "!\n")
    end)
    local sock <close> = connect(port)
    sock:send("ping\n")
    assert(txt(sock:receive("*l")) == "ping!")
    assert(ticks >= 50, `the ticker ran $(ticks) times`)
    assert(resume(responder))
    assert(close(ticker))
    server:close()
end

-- ===== Plain coroutines inside detached ones =====

-- Sends three lines with a turn of the scheduler between them, so the
-- reader really waits for each one.
local function slow_lines(sock)
    local conn <close> = sock
    for i = 1, 3 do
        for _ = 1, 5 do
            yield()
        end
        conn:send(`line $(i)\n`)
    end
end

local function resume_passes_a_socket_wait_on_test()
    local port, stop = start(slow_lines)
    local co = spawn(function()
        local sock <close> = connect(port)
        local reader = create(function()
            while true do
                local line = txt(sock:receive("*l"))
                if line == "" then
                    return "end"
                end
                yield(line)
            end
        end)
        local seen = {}
        while true do
            local r = pack(resume(reader))
            assert(r.n == 2 and r[1] == true, tostring(r[2]))
            seen[#seen + 1] = r[2]
            if status(reader) == "dead" then
                break
            end
            assert(status(reader) == "suspended")
        end
        return table.concat(seen, ", ")
    end)
    local ok, text = resume(co)
    assert(ok and text == "line 1, line 2, line 3, end", tostring(text))
    stop()
end

local function a_wrapped_generator_reads_a_socket_test()
    local port, stop = start(slow_lines)
    local co = spawn(function()
        local sock <close> = connect(port)
        local function lines()
            return coroutine.wrap(function()
                while true do
                    local line = txt(sock:receive("*l"))
                    if line == "" then
                        return
                    end
                    yield(line)
                end
            end)
        end
        local seen = {}
        for line in lines() do
            seen[#seen + 1] = line
        end
        return table.concat(seen, ", ")
    end)
    local ok, text = resume(co)
    assert(ok and text == "line 1, line 2, line 3", tostring(text))
    stop()
end

local function two_levels_of_plain_coroutines_read_a_socket_test()
    local port, stop = start(slow_lines)
    local co = spawn(function()
        local sock <close> = connect(port)
        local outer = coroutine.wrap(function()
            local inner = create(function()
                return txt(sock:receive("*l")), txt(sock:receive("*l"))
            end)
            local ok, a, b = resume(inner)
            yield(ok)
            return a .. " and " .. b
        end)
        local first = outer()
        local second = outer()
        return first, second
    end)
    local ok, first, second = resume(co)
    assert(ok and first == true and second == "line 1 and line 2", tostring(second))
    stop()
end

local function the_status_of_a_coroutine_that_waits_for_a_socket_test()
    local port, stop = start(slow_lines)
    local reader = spawn(function()
        local sock <close> = connect(port)
        return txt(sock:receive("*l"))
    end)
    local observer = spawn(function()
        yield()
        yield()
        return status(reader)
    end)
    local ok, seen = resume(observer)
    assert(ok and seen == "suspended")
    local ok2, line = resume(reader)
    assert(ok2 and line == "line 1")
    stop()
end

local function a_socket_wait_inside_a_native_call_runs_the_scheduler_test()
    local port, stop = start(echo)
    local co = spawn(function()
        local sock <close> = connect(port)
        -- The callback of gsub cannot suspend, so each receive keeps the
        -- coroutine on the stack and runs the scheduler while it waits.
        local text = string.gsub("abc", ".", function(c)
            sock:send(c .. c .. "\n")
            return txt(sock:receive("*l"))
        end)
        return text
    end)
    local ok, text = resume(co)
    assert(ok and text == "aabbcc", tostring(text))
    stop()
end

-- A wait inside a native callback keeps the coroutine on the stack once.
-- The waits that follow the callback suspend the coroutine again, so the
-- threads below it on the native stack go on.
local function a_coroutine_suspends_again_after_a_wait_inside_a_native_call_test()
    local server, port = listen()
    local client <close> = connect(port)
    local peer <close> = server:accept()
    local order = {}
    local reader = spawn(function()
        local first = true
        table.sort({ 3, 1, 2 }, function(a, b)
            if first then
                first = false
                peer:settimeout(0.02)
                local got, err = peer:receive(1)
                assert(got == nil and err.code == "timeout")
            end
            return a < b
        end)
        order[#order + 1] = "sorted"
        peer:settimeout(10)
        local byte = txt(peer:receive(1))
        order[#order + 1] = "received " .. byte
        return byte
    end)
    local ticker = spawn(function()
        while #order == 0 do
            yield()
        end
        for i = 1, 3 do
            yield()
        end
        order[#order + 1] = "ticker done"
        return "ticks"
    end)
    -- The main chunk waits for the ticker below the reader. It continues
    -- while the reader waits for its byte, which arrives afterwards.
    local ok, ticks = resume(ticker)
    assert(ok and ticks == "ticks")
    assert(status(reader) == "suspended")
    client:send("x")
    local ok2, byte = resume(reader)
    assert(ok2 and byte == "x")
    assert(table.concat(order, ", ") == "sorted, ticker done, received x", table.concat(order, ", "))
    server:close()
end

-- ===== Timeouts =====

-- Accepts connections and keeps them open without sending anything.
local function silent(sock)
    local conn <close> = sock
    conn:receive("*l")
end

local function receive_timeout_in_a_detached_coroutine_test()
    local port, stop = start(silent)
    local co = spawn(function()
        local sock <close> = network.tcp.connect("127.0.0.1", port)
        sock:settimeout(0.05)
        local got, err = sock:receive(10)
        return got, err
    end)
    local r = pack(resume(co))
    assert(r.n == 3 and r[1] == true and r[2] == nil)
    assert(r[3].code == "timeout" and tostring(r[3]) == "receive timeout", tostring(r[3]))
    stop()
end

local function a_coroutine_goes_on_after_a_timeout_test()
    local server, port = listen()
    local responder = spawn(function()
        local sock <close> = server:accept()
        local line = txt(sock:receive("*l"))
        sock:send("late " .. line .. "\n")
    end)
    local co = spawn(function()
        local sock <close> = network.tcp.connect("127.0.0.1", port)
        sock:settimeout(0.03)
        local got, err = sock:receive("*l")
        assert(got == nil and err.code == "timeout")
        sock:settimeout(10)
        sock:send("answer\n")
        return txt(sock:receive("*l"))
    end)
    local ok, line = resume(co)
    assert(ok and line == "late answer", tostring(line))
    assert(resume(responder))
    server:close()
end

local function accept_timeout_in_a_detached_coroutine_test()
    local server = listen()
    server:settimeout(0.05)
    local co = spawn(function()
        return server:accept()
    end)
    local r = pack(resume(co))
    assert(r.n == 3 and r[1] == true and r[2] == nil)
    assert(r[3].code == "timeout" and string.find(tostring(r[3]), "accept timeout$"), tostring(r[3]))
    server:close()
end

-- A timeout runs from the first wait of an operation. A wake that leaves
-- the operation blocked, such as a connection that another acceptor took,
-- continues toward the same deadline.
local function a_timeout_spans_the_wakes_of_one_operation_test()
    local server, port = listen()
    local order = {}
    local taken = 0
    -- The timeout of a server belongs to the server, so this acceptor
    -- has it too for a while. It goes on after a timeout of its own.
    local greedy = spawn(function()
        while true do
            local sock = server:accept()
            if sock then
                taken = taken + 1
                sock:close()
            end
        end
    end)
    local waiting = false
    local patient = spawn(function()
        -- The other acceptor waits first, so it takes the connections.
        yield()
        server:settimeout(0.1)
        waiting = true
        local sock, err = server:accept()
        server:settimeout(-1)
        order[#order + 1] = "patient"
        return sock, err
    end)
    local dialer = spawn(function()
        local idle = listen()
        idle:settimeout(0.02)
        -- The first connection arrives once both acceptors wait.
        while not waiting do
            yield()
        end
        -- A connection arrives every 20 ms for longer than the timeout.
        for i = 1, 30 do
            network.tcp.connect("127.0.0.1", port):close()
            idle:accept()
        end
        idle:close()
        order[#order + 1] = "dialer"
    end)
    local r = pack(resume(patient))
    local dialed = resume(dialer)
    assert(close(greedy))
    server:close()
    -- The acceptor with the timeout ends while connections still arrive.
    assert(dialed and table.concat(order, " ") == "patient dialer", table.concat(order, " "))
    assert(r[1] == true)
    if r[2] then
        -- Its deadline passed in the same moment in which a connection
        -- arrived, and a connection that is there is accepted.
        r[2]:close()
        taken = taken + 1
    else
        assert(string.find(tostring(r[3]), "accept timeout$"), tostring(r[3]))
    end
    assert(taken == 30, tostring(taken))
end

local function a_zero_timeout_never_waits_test()
    local port, stop = start(silent)
    local co = spawn(function()
        local sock <close> = network.tcp.connect("127.0.0.1", port)
        sock:settimeout(0)
        return sock:receive(1)
    end)
    local r = pack(resume(co))
    assert(r.n == 3 and r[1] == true and r[2] == nil and r[3].code == "timeout", tostring(r[3]))
    stop()
end

local function timeouts_fire_in_the_order_of_their_deadlines_test()
    local port, stop = start(silent)
    local log = {}
    local function waiter(name, seconds)
        local sock <close> = network.tcp.connect("127.0.0.1", port)
        sock:settimeout(seconds)
        local got, err = sock:receive(1)
        assert(got == nil and err.code == "timeout")
        log[#log + 1] = name
    end
    local a = spawn(waiter, "slow", 0.23)
    local b = spawn(waiter, "fast", 0.03)
    local c = spawn(waiter, "middle", 0.13)
    assert(resume(a))
    assert(resume(b))
    assert(resume(c))
    assert(table.concat(log, " ") == "fast middle slow", table.concat(log, " "))
    stop()
end

local function receive_timeout_in_the_main_chunk_test()
    local port, stop = start(silent)
    local ticks = 0
    local ticker = spawn(function()
        while true do
            ticks = ticks + 1
            yield()
        end
    end)
    local sock <close> = network.tcp.connect("127.0.0.1", port)
    sock:settimeout(0.05)
    local got, err = sock:receive(1)
    assert(got == nil and err.code == "timeout", tostring(err))
    -- The scheduler ran while the main chunk waited for its deadline.
    assert(ticks > 0)
    assert(close(ticker))
    sock:close()
    stop()
end

local function a_timeout_that_does_not_fire_leaves_no_trace_test()
    local port, stop = start(echo)
    local co = spawn(function()
        local sock <close> = network.tcp.connect("127.0.0.1", port)
        sock:settimeout(5)
        for i = 1, 20 do
            sock:send(`n$(i)\n`)
            assert(txt(sock:receive("*l")) == `n$(i)`)
        end
        return "done"
    end)
    local ok, text = resume(co)
    assert(ok and text == "done")
    stop()
end

-- ===== Large transfers =====

local function a_large_send_waits_for_its_reader_test()
    local server, port = listen()
    local pattern = {}
    for i = 1, 251 do
        pattern[i] = string.char(32 + i % 90)
    end
    local payload = string.rep(table.concat(pattern), 12000)
    local receiver = spawn(function()
        local sock <close> = server:accept()
        local parts = {}
        local total = 0
        while total < #payload do
            local chunk = sock:receive(math.min(65536, #payload - total))
            assert(#chunk > 0)
            parts[#parts + 1] = txt(chunk)
            total = total + #chunk
            -- The sender fills the socket while the reader takes turns.
            yield()
        end
        return table.concat(parts)
    end)
    local sender = spawn(function()
        local sock <close> = connect(port)
        return sock:send(payload)
    end)
    local ok, sent = resume(sender)
    assert(ok and sent == #payload, tostring(sent))
    local ok2, received = resume(receiver)
    assert(ok2 and #received == #payload)
    assert(received == payload)
    server:close()
end

local function receive_collects_a_message_that_arrives_in_pieces_test()
    local server, port = listen()
    local sender = spawn(function()
        local sock <close> = server:accept()
        for i = 1, 10 do
            sock:send(string.rep(tostring(i % 10), 100))
            for _ = 1, 3 do
                yield()
            end
        end
    end)
    local receiver = spawn(function()
        local sock <close> = connect(port)
        return txt(sock:receive(1000)), #sock:receive("*a")
    end)
    local ok, text, rest = resume(receiver)
    assert(ok and #text == 1000 and rest == 0)
    assert(string.sub(text, 1, 100) == string.rep("1", 100) and string.sub(text, 901, 1000) == string.rep("0", 100))
    assert(resume(sender))
    server:close()
end

-- ===== Closing =====

local function closing_a_socket_wakes_its_reader_test()
    local port, stop = start(silent)
    local sock = connect(port)
    local reader = spawn(function()
        return catch sock:receive(1)
    end)
    local closer = spawn(function()
        yield()
        yield()
        sock:close()
    end)
    assert(resume(closer))
    local r = pack(resume(reader))
    assert(r.n == 3 and r[1] == true and r[2] == false)
    assert(string.find(r[3], "attempt to use a closed socket", 1, true), r[3])
    stop()
end

local function closing_a_server_wakes_its_acceptor_test()
    local server = listen()
    local acceptor = spawn(function()
        return catch server:accept()
    end)
    local closer = spawn(function()
        yield()
        server:close()
    end)
    assert(resume(closer))
    local r = pack(resume(acceptor))
    assert(r.n == 3 and r[1] == true and r[2] == false)
    assert(string.find(r[3], "attempt to use a closed server", 1, true), r[3])
end

local function close_cancels_a_coroutine_that_waits_for_a_socket_test()
    local server, port = listen()
    local log = {}
    local peer
    local accepted = spawn(function()
        peer = server:accept()
    end)
    local sock = connect(port)
    local reading = false
    local reader = spawn(function()
        local mark <close> = setmetatable({}, { __close = function()
            log[#log + 1] = "closed"
        end })
        reading = true
        sock:receive("*l")
        log[#log + 1] = "unreachable"
    end)
    assert(resume(accepted))
    -- The reader waits in `receive` once it has set the flag.
    local warm = spawn(function()
        while not reading do
            yield()
        end
        yield()
    end)
    assert(resume(warm))
    assert(status(reader) == "suspended")
    local r = pack(close(reader))
    assert(r.n == 1 and r[1] == true and status(reader) == "dead")
    assert(table.concat(log, " ") == "closed")
    -- The socket itself stays open and usable.
    peer:send("still open\n")
    assert(txt(sock:receive("*l")) == "still open")
    peer:close()
    sock:close()
    server:close()
end

local function close_of_a_plain_coroutine_that_waits_for_a_socket_test()
    local port, stop = start(silent)
    local plain
    local reading = false
    local outer = spawn(function()
        local sock <close> = connect(port)
        plain = create(function()
            reading = true
            return sock:receive(1)
        end)
        return resume(plain)
    end)
    local closer = spawn(function()
        while not reading do
            yield()
        end
        yield()
        return close(plain)
    end)
    local ok, closed = resume(closer)
    assert(ok and closed == true)
    local r = pack(resume(outer))
    assert(r.n == 3 and r[1] == true and r[2] == false and r[3] == "cannot resume dead coroutine")
    stop()
end

-- ===== Connect =====

local function connect_reports_a_refused_connection_test()
    local server, port = listen()
    server:close()
    local keep = spawn(function()
        yield()
    end)
    local co = spawn(function()
        return network.tcp.connect("127.0.0.1", port)
    end)
    local r = pack(resume(co))
    assert(r.n == 3 and r[1] == true and r[2] == nil and r[3].code == "refused")
    assert(string.find(tostring(r[3]), "cannot connect to 127.0.0.1:" .. port, 1, true), tostring(r[3]))
    assert(resume(keep))
end

local function connect_returns_a_socket_with_both_addresses_test()
    local server, port = listen()
    local acceptor = spawn(function()
        local sock <close> = server:accept()
        return sock:getpeername()
    end)
    local co = spawn(function()
        local sock <close> = network.tcp.connect("127.0.0.1", port)
        local peer_host, peer_port = sock:getpeername()
        local host, local_port = sock:getsockname()
        sock:send("x\n")
        return peer_host, peer_port, host, local_port
    end)
    local ok, peer_host, peer_port, host, local_port = resume(co)
    assert(ok and peer_host == "127.0.0.1" and peer_port == port and host == "127.0.0.1")
    local ok2, seen_host, seen_port = resume(acceptor)
    assert(ok2 and seen_host == "127.0.0.1" and seen_port == local_port)
    server:close()
end

-- ===== UDP =====

local function udp_open()
    local sock, err = network.udp.open(0, "127.0.0.1")
    if not sock then
        sock = err
        if denied(sock) then
            skip("loopback sockets unavailable")
        end
        error(sock, 0)
    end
    local _, port = sock:getsockname()
    return sock, port
end

local function datagrams_between_two_coroutines_test()
    local a, port_a = udp_open()
    local b, port_b = udp_open()
    local ponger = spawn(function()
        for _ = 1, 3 do
            local data, host, port = b:receive()
            b:sendto("pong " .. txt(data), host, port)
        end
    end)
    local pinger = spawn(function()
        local replies = {}
        for i = 1, 3 do
            a:sendto(`ping $(i)`, "127.0.0.1", port_b)
            replies[i] = txt((a:receive()))
        end
        return table.concat(replies, ", ")
    end)
    local ok, text = resume(pinger)
    assert(ok and text == "pong ping 1, pong ping 2, pong ping 3", tostring(text))
    assert(resume(ponger))
    a:close()
    b:close()
end

local function udp_receive_timeout_in_a_detached_coroutine_test()
    local sock = udp_open()
    sock:settimeout(0.05)
    local co = spawn(function()
        return sock:receive()
    end)
    local r = pack(resume(co))
    assert(r[1] == true and r[2] == nil and r[3].code == "timeout", tostring(r[3]))
    sock:close()
end

-- A peer that sends a whole response and closes before `fetch` reads it.
-- The body runs until the end of the stream, which arrives together with
-- the last bytes.
local function closing_peer(server, response)
    return spawn(function()
        local sock <close> = server:accept()
        while true do
            local line = sock:receive("*l")
            if #line == 0 then
                break
            end
        end
        sock:send(response)
    end)
end

local function fetch_reads_a_body_that_ends_with_the_connection_while_coroutines_wait_test()
    local server, port = listen()
    local idle, idle_port = listen()
    -- A coroutine that waits keeps the scheduler running during the fetch.
    local waiting = spawn(function()
        return idle:accept()
    end)
    local peer = closing_peer(server, "HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nthe whole body")
    local status, body = network.fetch("http://127.0.0.1:" .. port .. "/")
    assert(status == 200 and txt(body) == "the whole body", txt(body))
    assert(resume(peer))
    close(waiting)
    idle:close()
    server:close()
end

local function an_https_fetch_from_a_plain_http_peer_raises_test()
    local server, port = listen()
    -- Every wait of the peer has an end, so a fetch that fails before it
    -- connects or sends fails the test instead of keeping it waiting.
    server:settimeout(10)
    local peer = spawn(function()
        local sock <close> = assert(server:accept())
        sock:settimeout(10)
        sock:receive(1)
        sock:send("HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n")
    end)
    local ok, err = catch network.fetch("https://127.0.0.1:" .. port .. "/")
    assert(not ok and string.find(tostring(err), "TLS handshake failed: ", 1, true), tostring(err))
    resume(peer)
    server:close()
end

local function a_failing_detached_coroutine_closes_its_socket_at_once_test()
    local server, port = listen()
    local held
    local seen
    local co = spawn(function()
        local sock <close> = connect(port)
        local mark <close> = setmetatable({}, { __close = function(_, err)
            seen = err
        end })
        held = sock
        yield()
        error("failed", 0)
    end)
    -- Another coroutine runs until the first one has failed.
    local watcher = spawn(function()
        while status(co) ~= "dead" do
            yield()
        end
    end)
    assert(resume(watcher))
    assert(seen == "failed", tostring(seen))
    local ok, err = catch held:send("x")
    assert(not ok and string.find(tostring(err), "attempt to use a closed socket", 1, true), tostring(err))
    local r = pack(resume(co))
    assert(r[1] == false and r[2] == "failed", tostring(r[2]))
    server:close()
end


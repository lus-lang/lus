pledge("load")

-- ===== format =====
-- Dedicated string.format suite.
-- Covers every printf-style conversion the spec lists (%d %i %u %c %x %X %o
-- %e %E %f %g %G %a %A %s %q %%), the %q reloadable-literal contract through
-- load(), width and precision and flag combinations, __tostring dispatch under
-- %s, and the full set of error paths (non-integer-representable numbers,
-- missing arguments, invalid conversions, wrong argument types, and oversized
-- conversion specifications).


local string = string
local math = math

-- Reload a formatted literal back into a value through load, which is the
-- property %q is designed to guarantee for its output.
local function reload(literal)
    return load("return " .. literal)()
end

-- ============================================================
-- Every conversion produces its expected canonical rendering.
-- ============================================================

-- integer conversions render as expected
local integer_conversions_render_as_expected_cases = {
    {"%d", 123, "123"},
    {"%d", -123, "-123"},
    {"%d", 0, "0"},
    {"%i", 123, "123"},
    {"%i", -7, "-7"},
    {"%u", 10, "10"},
    {"%u", 0, "0"},
    {"%x", 255, "ff"},
    {"%X", 255, "FF"},
    {"%x", 0, "0"},
    {"%o", 8, "10"},
    {"%o", 64, "100"},
    {"%c", 65, "A"},
    {"%c", 97, "a"},
}

local function integer_conversions_render_as_expected_test(fmt, arg, expected)
    assert(string.format(fmt, arg) == expected)
end

-- %i is an exact alias of %d
local function i_is_an_exact_alias_of_d_test()
    assert(string.format("%i", 42) == string.format("%d", 42))
    assert(string.format("%i", -1) == string.format("%d", -1))
    assert(string.format("%5i", 7) == string.format("%5d", 7))
end

-- float conversions render as expected
local float_conversions_render_as_expected_cases = {
    {"%f", 1.5, "1.500000"},
    {"%f", 0.0, "0.000000"},
    {"%e", 1.5, "1.500000e+00"},
    {"%E", 1.5, "1.500000E+00"},
    {"%g", 0.0001, "0.0001"},
    {"%g", 1.0, "1"},
    {"%g", 100.0, "100"},
    {"%G", 0.00001, "1E-05"},
    {"%a", 1.0, "0x1p+0"},
    {"%A", 1.0, "0X1P+0"},
    {"%a", 0.15625, "0x1.4p-3"},
}

local function float_conversions_render_as_expected_test(fmt, arg, expected)
    assert(string.format(fmt, arg) == expected)
end

-- string conversions
local string_conversions_cases = {
    {"%s", "test", "test"},
    {"%s", "", ""},
    {"%s%%", "x", "x%"},
}

local function string_conversions_test(fmt, arg, expected)
    assert(string.format(fmt, arg) == expected)
end

-- the %% directive emits a single literal percent
local function the_directive_emits_a_single_literal_percent_test()
    assert(string.format("%%") == "%")
    assert(string.format("100%%") == "100%")
    assert(string.format("%d%%", 50) == "50%")
end

-- %s coerces non-string scalars
local function s_coerces_non_string_scalars_test()
    assert(string.format("%s", 123) == "123")
    assert(string.format("%s", true) == "true")
    assert(string.format("%s", false) == "false")
    assert(string.format("%s", nil) == "nil")
    assert(string.format("%s", 1.5) == "1.5")
end

-- ============================================================
-- Width, precision, and flag handling.
-- ============================================================

-- width and precision and flag combinations
local width_and_precision_and_flag_combinations_cases = {
    {"%5.2f", 3.14159, " 3.14"},
    {"%-5d", 42, "42   "},
    {"%05d", 42, "00042"},
    {"%+d", 42, "+42"},
    {"% d", 42, " 42"},
    {"%+d", -42, "-42"},
    {"%10s", "hi", "        hi"},
    {"%-10s", "hi", "hi        "},
    {"%.3s", "hello", "hel"},
    {"%.0f", 2.5, "2"},
    {"%#x", 255, "0xff"},
    {"%#o", 8, "010"},
    {"%+.3e", 1234.5, "+1.234e+03"},
    {"%08.2f", 3.5, "00003.50"},
    {"%-8.2f", 3.5, "3.50    "},
}

local function width_and_precision_and_flag_combinations_test(fmt, arg, expected)
    assert(string.format(fmt, arg) == expected)
end

-- multiple conversions in one format string
local function multiple_conversions_in_one_format_string_test()
    assert(string.format("%d-%s-%x", 1, "a", 255) == "1-a-ff")
    assert(string.format("%c%c%c", 104, 105, 33) == "hi!")
end

-- ============================================================
-- Unsigned and hex conversions treat integers as two's complement.
-- ============================================================

-- unsigned and hex conversions wrap negative integers
local function unsigned_and_hex_conversions_wrap_negative_integers_test()
    assert(string.format("%x", -1) == "ffffffffffffffff")
    assert(string.format("%X", -1) == "FFFFFFFFFFFFFFFF")
    assert(string.format("%u", -1) == "18446744073709551615")
    assert(string.format("%o", -1) == "1777777777777777777777")
end

-- hex of the maximum integer
local function hex_of_the_maximum_integer_test()
    assert(string.format("%x", math.maxinteger) == "7fffffffffffffff")
    assert(string.format("%x", math.mininteger) == "8000000000000000")
end

-- ============================================================
-- %c builds a character from a code point (spec/design/strings.md) and
-- rejects values outside the code point range.
-- ============================================================

-- %c builds one character from a code point
local function c_builds_one_character_from_a_code_point_test()
    assert(string.byte(string.format("%c", 65)) == 65)
    assert(string.byte(string.format("%c", 256)) == 256)
    assert(string.format("%c", 1000000) == "\u{F4240}")
    assert(#string.format("%c", 256) == 1)
    assert(#string.format("%c", 0) == 1)
    raises(function() return string.format("%c", -1) end, "out of range")
    raises(function() return string.format("%c", 0x110000) end, "out of range")
end

-- ============================================================
-- %s dispatches to __tostring for tables.
-- ============================================================

-- %s invokes __tostring on a table
local function s_invokes_tostring_on_a_table_test()
    local t = setmetatable({}, {__tostring = function() return "CUSTOM" end})
    assert(string.format("%s", t) == "CUSTOM")
    assert(string.format("[%10s]", t) == "[    CUSTOM]")
    assert(string.format("[%.3s]", t) == "[CUS]")
end

-- %s accepts a numeric __tostring result by coercing it
local function s_accepts_a_numeric_tostring_result_by_coercing_it_test()
    local t = setmetatable({}, {__tostring = function() return 42 end})
    assert(string.format("%s", t) == "42")
end

-- %s errors when __tostring returns a non-coercible value
local function s_errors_when_tostring_returns_a_non_coercible_value_test()
    local t = setmetatable({}, {__tostring = function() return true end})
    raises(function() return string.format("%s", t) end, "must return a string")
end

-- ============================================================
-- %q escaping and the reload-through-load round-trip contract.
-- ============================================================

-- %q of a plain string reloads identically
local function q_of_a_plain_string_reloads_identically_test()
    local s = "hello world"
    assert(reload(string.format("%q", s)) == s)
end

-- %q escapes quotes, backslashes, newlines, and NUL and reloads
local function q_escapes_quotes_backslashes_newlines_and_nul_and_reloads_test()
    local s = "he\"llo\n\\wor\0ld\r\ttail"
    local literal = string.format("%q", s)
    assert(reload(literal) == s)
    -- The escaped literal must not contain a bare double quote in its interior
    -- beyond the two delimiters, so the string content survives reparsing.
    assert(reload(literal) == s)
end

-- %q reloads strings across control characters and the full code point range
-- (strings are WTF-8 text, so the old high byte 255 is a multi-byte character).
local q_reloads_binary_strings_across_the_full_byte_range_cases = {
    {"\0\1\2\127\u{FF}\u{20AC}\u{1F600}\u{D800}"},
    {"line1\nline2"},
    {"tab\there"},
    {"quote\"inside"},
    {"back\\slash"},
    {"\13carriage"},
}

local function q_reloads_binary_strings_across_the_full_byte_range_test(s)
    assert(reload(string.format("%q", s)) == s)
end

-- %q of an integer reloads as the same integer
local function q_of_an_integer_reloads_as_the_same_integer_test()
    local literal = string.format("%q", 100)
    local back = reload(literal)
    assert(back == 100)
    assert(math.type(back) == "integer")
end

-- %q of math.mininteger reloads as an integer
local function q_of_math_mininteger_reloads_as_an_integer_test()
    local literal = string.format("%q", math.mininteger)
    local back = reload(literal)
    assert(back == math.mininteger)
    assert(math.type(back) == "integer")
end

-- %q of math.maxinteger reloads exactly
local function q_of_math_maxinteger_reloads_exactly_test()
    local back = reload(string.format("%q", math.maxinteger))
    assert(back == math.maxinteger)
    assert(math.type(back) == "integer")
end

-- %q of floats reloads exactly through hex-float output
local q_of_floats_reloads_exactly_through_hex_float_output_cases = {
    {0.1},
    {3.14159},
    {0.15625},
    {-2.5},
    {1e300},
    {0.0},
}

local function q_of_floats_reloads_exactly_through_hex_float_output_test(f)
    local back = reload(string.format("%q", f))
    assert(back == f)
    assert(math.type(back) == "float")
end

-- %q of infinities reloads to the same infinities
local function q_of_infinities_reloads_to_the_same_infinities_test()
    assert(reload(string.format("%q", 1/0)) == 1/0)
    assert(reload(string.format("%q", -1/0)) == -1/0)
end

-- %q of NaN reloads to a value that is not equal to itself
local function q_of_nan_reloads_to_a_value_that_is_not_equal_to_itself_test()
    local back = reload(string.format("%q", 0/0))
    assert(back ~= back)
end

-- %q of the nil literal reloads to nil
local function q_of_the_nil_literal_reloads_to_nil_test()
    local literal = string.format("%q", nil)
    assert(literal == "nil")
    assert(reload(literal) == nil)
end

-- %q of the boolean literals reload identically
local q_of_the_boolean_literals_reload_identically_cases = {
    {true, "true"},
    {false, "false"},
}

local function q_of_the_boolean_literals_reload_identically_test(v, shown)
    local literal = string.format("%q", v)
    assert(literal == shown)
    assert(reload(literal) == v)
end

-- %q rejects values with no literal form
local function q_rejects_values_with_no_literal_form_test()
    raises(function() return string.format("%q", {}) end, "no literal form")
end

-- ============================================================
-- Integer conversions reject non-integer-representable numbers.
-- ============================================================

-- %d accepts a float with an integral value
local function d_accepts_a_float_with_an_integral_value_test()
    assert(string.format("%d", 2.0) == "2")
    assert(string.format("%d", -5.0) == "-5")
end

-- integer conversions reject fractional floats
local integer_conversions_reject_fractional_floats_cases = {
    {"%d", 1.5},
    {"%i", 2.7},
    {"%u", 3.5},
    {"%x", 1.5},
    {"%o", 9.9},
    {"%c", 1.5},
}

local function integer_conversions_reject_fractional_floats_test(fmt, arg)
    raises(function() return string.format(fmt, arg) end, "no integer representation")
end

-- %d coerces numeric strings including hex
local function d_coerces_numeric_strings_including_hex_test()
    assert(string.format("%d", "42") == "42")
    assert(string.format("%d", "0x1A") == "26")
    assert(string.format("%d", "  17  ") == "17")
end

-- %d rejects a non-numeric string
local function d_rejects_a_non_numeric_string_test()
    raises(function() return string.format("%d", "foo") end, "number expected")
end

-- ============================================================
-- Wrong argument types for each conversion family.
-- ============================================================

-- conversions reject the wrong argument type
local conversions_reject_the_wrong_argument_type_cases = {
    {"%d", {}, "number expected"},
    {"%f", "notnum", "number expected"},
    {"%x", {}, "number expected"},
    {"%e", true, "number expected"},
    {"%g", {}, "number expected"},
    {"%c", {}, "number expected"},
    {"%d", nil, "number expected"},
    {"%f", nil, "number expected"},
}

local function conversions_reject_the_wrong_argument_type_test(fmt, arg, pattern)
    raises(function() return string.format(fmt, arg) end, pattern)
end

-- ============================================================
-- Missing arguments, invalid conversions, oversized specs.
-- ============================================================

-- too few arguments raise a no-value error
local too_few_arguments_raise_a_no_value_error_cases = {
    {"%d"},
    {"%s"},
    {"%d %d"},
    {"%f%f%f"},
    {"%q"},
}

local function too_few_arguments_raise_a_no_value_error_test(fmt)
    raises(function() return string.format(fmt) end, "no value")
end

-- invalid conversion characters raise an error
local invalid_conversion_characters_raise_an_error_cases = {
    {"%k"},
    {"%y"},
    {"%w"},
    {"%"},
    {"%1.2z"},
}

local function invalid_conversion_characters_raise_an_error_test(fmt)
    raises(function() return string.format(fmt, 1) end, "invalid conversion")
end

-- an extremely large width raises rather than crashing
local function an_extremely_large_width_raises_rather_than_crashing_test()
    raises(function() return string.format("%1000000d", 1) end, "invalid conversion specification")
    raises(function() return string.format("%.1000000f", 1.0) end, "invalid conversion specification")
end

-- a moderately large but legal width still formats
local function a_moderately_large_but_legal_width_still_formats_test()
    local s = string.format("%99d", 1)
    assert(#s == 99)
    assert(string.byte(s, 99) == 49)
end

-- format with no directives returns the string verbatim
local function format_with_no_directives_returns_the_string_verbatim_test()
    assert(string.format("plain text") == "plain text")
    assert(string.format("") == "")
    assert(string.format("no percent here") == "no percent here")
end

-- format preserves embedded NUL bytes in the literal text
local function format_preserves_embedded_nul_bytes_in_the_literal_text_test()
    local out = string.format("a\0%d\0b", 5)
    assert(#out == 5)
    assert(string.byte(out, 2) == 0)
    assert(string.sub(out, 3, 3) == "5")
end

-- Every NaN prints as nan, whatever its sign bit. The sign bit of 0/0
-- differs between x86-64 and arm64, so printing it would make output
-- depend on the platform.
local function nan_prints_without_a_sign_on_every_platform_test()
    local z = 0
    local nans = { 0 / z, -(0 / z), math.huge - math.huge, math.sqrt(-1), -(math.huge - math.huge) }
    for i, n in ipairs(nans) do
        assert(n ~= n, `value $i is not a NaN`)
        assert(tostring(n) == "nan", `tostring of NaN $i`)
        assert("x" .. n == "xnan", `concatenation of NaN $i`)
        assert(string.format("%f|%g|%e|%a|%s", n, n, n, n, n) == "nan|nan|nan|nan|nan", `string.format of NaN $i`)
        assert(string.format("%F|%G|%E|%A", n, n, n, n) == "NAN|NAN|NAN|NAN", `uppercase conversions of NaN $i`)
        assert(string.format("%5.1f|%-5g|%+f", n, n, n) == "  nan|nan  |+nan", `flags with NaN $i`)
        assert(string.format("%q", n) == "(0/0)")
        assert(tojson(n) == "null")
    end
    assert(tostring(-math.huge) == "-inf" and string.format("%f", -math.huge) == "-inf")
end

-- ===== conversions at their edges =====

local conversions_at_their_edges_cases = {
    {"[%3c][%-3c]", table.pack(66, 0xE9), "[  B][é  ]"},
    {"[%p][%8p]", table.pack(nil, 1), "[(null)][  (null)]"},
    {"%.1a", table.pack(1.96875), "0x2.0p+0"},
    {"%.3A", table.pack(0.1), "0X1.99AP-4"},
    {"%A %a %a", table.pack(0/0, -1/0, 0.0), "NAN -inf 0x0p+0"},
    {"%#.0a", table.pack(1.0), "0x1.p+0"},
    {"%a", table.pack(5e-324), "0x1p-1074"},
    {"[%5.2s][%-6s][%.1s]", table.pack("héllo", "ab", "é"), "[   hé][ab    ][é]"},
    {"[%08.3f][%+.2e]", table.pack(3.14159, 12345.678), "[0003.142][+1.23e+04]"},
    {"[%#x][%#o][% d][%05d][%.3d]", table.pack(255, 8, 7, -42, 5), "[0xff][010][ 7][-0042][005]"},
    {"%d|%5d", table.pack(123456789012345678901234567890n, -12n), "123456789012345678901234567890|  -12"},
    {"%.2f|%10.3e", table.pack(1.25d, 2.5d), "1.25| 2.500e+00"},
    {"%q|%q", table.pack(12345678901234567890123n, 1.5d), "12345678901234567890123|1.5"},
}

local function conversions_at_their_edges_test(fmt, args, want)
    local got = string.format(fmt, table.unpack(args, 1, args.n))
    assert(got == want, got)
end

local function conversions_in_a_hot_loop_take_the_same_path_test()
    local out = {}
    for i = 1, 300 do
        out[i] = string.format("%c%3c%p%.1a%5.2s", 65 + i % 26, 66, nil, 1.5, "héllo")
    end
    assert(out[1] == "B  B(null)0x1.8p+0   hé")
    assert(out[300] == string.format("%c", 65 + 300 % 26) .. "  B(null)0x1.8p+0   hé")
end

local conversion_errors_at_their_edges_cases = {
    {"%c", -1, "value out of range"},
    {"%c", 0x110000, "value out of range"},
    {"%10q", "x", "specifier '%%q' cannot have modifiers"},
    {"%", 1, "invalid conversion '%%' to 'format'"},
    {"%0123456789012345678901d", 1, "invalid format %(too long%)"},
}

local function conversion_errors_at_their_edges_test(fmt, arg, pattern)
    raises(function() string.format(fmt, arg) end, pattern)
end

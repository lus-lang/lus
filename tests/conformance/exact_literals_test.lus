-- Bigint and decimal literals (spec/language/grammar.md section 1.5 and
-- the guide). Each case goes through load so that a malformed literal is
-- a compile error the test can inspect.
pledge("load")

local function eval(src)
    local f, err = load("return " .. src)
    assert(f, err)
    return f()
end

local function malformed(src)
    local f, err = load("return " .. src, "=lit")
    assert(f == nil, src .. " should not compile")
    assert(err == `lit:1: malformed number near '$src'`, err)
end

-- Group: bigint literals

local function an_n_suffix_makes_a_bigint_test()
    local cases = {
        { "123n", "123" },
        { "0n", "0" },
        { "007n", "7" },
        { "0xffn", "255" },
        { "0XFFn", "255" },
        { "0xff_ffn", "65535" },
        { "1_000n", "1000" },
        { "12345678901234567890123n", "12345678901234567890123" },
        { "9223372036854775808n", "9223372036854775808" },
        { "0x10000000000000000n", "18446744073709551616" },
    }

    for _, c in ipairs(cases) do
        local v = eval(c[1])
        assert(math.type(v) == "bigint", c[1])
        assert(tostring(v) == c[2], `$(c[1]) printed $(tostring(v))`)
    end
end

local function bigint_literals_compare_by_value_test()
    assert(123n == 123)
    assert(0xffn == 255)
    assert(1n == 1.0)
    assert(-5n == -5)
    assert(tostring(-9223372036854775808n) == "-9223372036854775808")
    assert(tostring(2n ^ 100) == "1267650600228229401496703205376")
    -- An unsuffixed literal past 64 bits is a float, as in Lua.
    assert(math.type(9223372036854775808) == "float")
end

-- Group: decimal literals

local function a_d_suffix_makes_a_decimal_that_keeps_its_digits_test()
    local cases = {
        { "1.50d", "1.50" },
        { "1e-2d", "0.01" },
        { "3d", "3" },
        { "1.d", "1" },
        { ".5d", "0.5" },
        { "0.0d", "0.0" },
        { "1e3d", "1000" },
        { "1E+3d", "1000" },
        { "1.e5d", "100000" },
        { "1_000.000_1d", "1000.0001" },
        { "123456789012345678901234567890.123456789d", "123456789012345678901234567890.123456789" },
    }

    for _, c in ipairs(cases) do
        local v = eval(c[1])
        assert(math.type(v) == "decimal", c[1])
        assert(tostring(v) == c[2], `$(c[1]) printed $(tostring(v))`)
    end
end

local function decimal_literals_compare_by_value_test()
    assert(1.50d == 1.5d)
    assert(1.0d == 1n)
    assert(0.1d + 0.2d == 0.3d)
    assert(0.5d == 0.5)
    assert(0.1d ~= 0.1)
    local t = {}
    t[1] = "one"
    assert(t[1d] == "one" and t[1.00d] == "one" and t[1n] == "one")
end

local function decimal_exponents_reach_the_limits_test()
    assert(tostring(eval("1e131071d")) == "1e+131071")
    assert(tostring(eval("1e-16383d")) == "1e-16383")

    for _, src in ipairs({ "1e131072d", "1e-16384d", "1e2147483648d", "1e-2147483649d" }) do
        local f, err = load("return " .. src, "=lit")
        assert(f == nil, src)
        assert(string.find(err, `decimal literal out of range near '$src'`, 1, true), err)
    end
end

-- Group: suffix rules

-- In a hexadecimal numeral `d` is a digit, so a hexadecimal decimal does
-- not exist and the letter extends the integer.
local function d_is_a_hexadecimal_digit_test()
    assert(math.type(0xffd) == "integer" and 0xffd == 4093)
    assert(0x10d == 269)
end

local function invalid_suffixed_forms_are_malformed_test()
    local forms = {
        -- `n` applies only to integer numerals.
        "1.5n",
        "1e3n",
        ".5n",
        "0x1.8n",
        "0x1p4n",
        -- `d` applies only to decimal notation, and a hexadecimal float takes
        -- no suffix.
        "0x1p4d",
        -- One suffix, lowercase, at the very end.
        "1nn",
        "1nd",
        "1dn",
        "1.5dd",
        "1N",
        "1.5D",
        "1d5",
        "1n5",
        "0n1",
        -- Separators sit between two digits.
        "1__0n",
        "1_n",
        "1n_",
        "0x_1n",
        "1_d",
        "1._5d",
        "1_.5d",
        -- An exponent needs digits.
        "1ed",
    }

    for _, src in ipairs(forms) do
        malformed(src)
    end
end

-- Group: literals in compiled code

local function literals_survive_a_binary_chunk_round_trip_test()
    local f = assert(load("return 1.50d, 0xffn, 12345678901234567890123n, 1e-2d, -7n"))
    local g = assert(load(string.dump(f)))
    local a, b, c, d, e = g()
    assert(tostring(a) == "1.50" and math.type(a) == "decimal")
    assert(tostring(b) == "255" and math.type(b) == "bigint")
    assert(tostring(c) == "12345678901234567890123")
    assert(tostring(d) == "0.01")
    assert(e == -7 and math.type(e) == "bigint")
end

local function literals_in_a_hot_loop_keep_their_subtype_test()
    local sum, total = 0n, 0d

    for _ = 1, 200 do
        sum = sum + 0xffn
        total = total + 0.05d
    end

    assert(math.type(sum) == "bigint" and sum == 51000)
    assert(math.type(total) == "decimal" and tostring(total) == "10.00")
end

-- Group: the limits of decimals

-- A decimal holds at most 131072 digits before the point and 16383 after,
-- the limits of the numeric type of PostgreSQL, so no operation on
-- decimals takes unbounded time.
local function a_decimal_literal_past_the_limits_is_a_compile_error_test()
    for _, src in ipairs({ "return 1e131072d", "return 1e-16384d", "return 1e2147483647d" }) do
        local f, err = load(src)
        assert(f == nil, src)
        assert(string.find(err, "decimal literal out of range", 1, true), err)
    end

    assert(load("return 1e131071d")() == decimal("1e131071"))
    assert(load("return 1e-16383d")() == decimal("1e-16383"))
end

local function decimal_text_past_the_limits_raises_test()
    raises(function()
        return decimal("1e131072")
    end, "more than 131072 digits before the point")

    raises(function()
        return decimal(string.rep("9", 131073))
    end, "more than 131072 digits before the point")

    raises(function()
        return decimal("1e-16384")
    end, "more than 16383 digits after the point")

    raises(function()
        return decimal(`0.$(string.rep("0", 16383))1`)
    end, "after the point")

    raises(function()
        return decimal(2n ^ 440000)
    end, "before the point")

    -- Text that is not a numeral still gives nil.
    assert(decimal("abc") == nil)
end

local function a_result_past_the_limits_raises_test()
    local big = decimal(string.rep("9", 131072))
    local tiny = decimal("1e-16383")

    local cases = {
        {
            function()
                return big + 1
            end,
            "before",
        },
        {
            function()
                return big * 10
            end,
            "before",
        },
        {
            function()
                return tiny * tiny
            end,
            "after",
        },
        {
            function()
                return big / 0.1d
            end,
            "before",
        },
        {
            function()
                return tiny / big
            end,
            "after",
        },
        {
            function()
                return 2d ^ 435420
            end,
            "before",
        },
        {
            function()
                return 0.5d ^ 16384
            end,
            "after",
        },
        {
            function()
                return big + 2n ^ 440000
            end,
            "before",
        },
    }

    for i, case in ipairs(cases) do
        local ok, err = catch case[1]()
        assert(not ok, i)
        local limit = case[2] == "before" and "131072" or "16383"
        assert(
            string.find(
                tostring(err),
                `decimal out of range: more than $limit digits $(case[2]) the point`,
                1,
                true
            ),
            err
        )
    end

    -- Sums at the limits stay exact.
    assert(#tostring(big + tiny) == 131072 + 1 + 16383)
    assert(2d ^ 435400 == decimal(2n ^ 435400))
    assert(0.5d ^ 16383 == decimal("1e-16383") * 5d ^ 16383)
end

-- The case the fuzz target for numbers found: decimal("1e9999999") + 0d
-- aligned ten million digits. It now raises at once.
local function an_extreme_exponent_raises_at_once_test()
    local t = os.clock()

    raises(function()
        return decimal("1e9999999") + 0d
    end, "out of range")

    raises(function()
        return decimal("1e-9999999") + 1d
    end, "out of range")

    raises(function()
        return 2d ^ 2000000000
    end, "out of range")

    assert(os.clock() - t < 1)
end

local function decimals_at_the_limits_compare_by_magnitude_test()
    assert(not (1e131071d == 1n))
    assert(not (1e131071d < 1))
    assert(-1e131071d < 1)
    assert(1e-16383d < 1e-16382d)
    assert(1e131071d > 1e308)
    assert(not (0d < -1e-2000d))
    assert(-2d < -1.99d)
    assert(1.5d < 1.50001d)
    assert(1e10d == 10000000000)
end

-- Division by zero raises the messages of integers, whatever the type of
-- the operands. Bigints and decimals used to name the operation in
-- another form, `'n//0'` and `'n%%0'`.
local exact_division_by_zero_cases = {
    {
        "bigint floor division",
        function()
            return 10n // 0n
        end,
        "attempt to divide by zero",
    },
    {
        "bigint modulo",
        function()
            return 10n % 0n
        end,
        "attempt to perform 'n%0'",
    },
    {
        "decimal floor division",
        function()
            return 1d // 0d
        end,
        "attempt to divide by zero",
    },
    {
        "decimal modulo",
        function()
            return 1d % 0d
        end,
        "attempt to perform 'n%0'",
    },
    {
        "decimal division",
        function()
            return 1d / 0d
        end,
        "attempt to divide a decimal by zero",
    },
    {
        "negative power of a zero decimal",
        function()
            return 0d ^ -1
        end,
        "attempt to divide a decimal by zero",
    },
    {
        "negative power of a zero decimal with digits",
        function()
            return 0.00d ^ -3
        end,
        "attempt to divide a decimal by zero",
    },
    {
        "integer floor division",
        function()
            return 10 // 0
        end,
        "attempt to divide by zero",
    },
    {
        "integer modulo",
        function()
            return 10 % 0
        end,
        "attempt to perform 'n%0'",
    },
}

local function exact_division_by_zero_test(label, f, want)
    local ok, err = catch f()
    assert(not ok, label)
    assert(err:gsub("^.-:%d+: ", "") == want, `$label: $err`)
end

-- A negative bigint exponent gives a float, as for integers, and the
-- other mixed operations keep the type their operands give.
local mixed_exact_results_cases = {
    {
        "negative bigint exponent",
        function()
            return 2n ^ -1n
        end,
        "float",
        "0.5",
    },
    {
        "bigint floor division rounds down",
        function()
            return -7n // 2n
        end,
        "bigint",
        "-4",
    },
    {
        "decimal modulo takes the sign of the divisor",
        function()
            return -7d % 2d
        end,
        "decimal",
        "1",
    },
    {
        "float modulo by a bigint",
        function()
            return 7.5 % -2n
        end,
        "float",
        "-0.5",
    },
    {
        "bigint division",
        function()
            return 1n / 4n
        end,
        "float",
        "0.25",
    },
}

local function mixed_exact_results_test(label, f, kind, text)
    local v = f()
    assert(math.type(v) == kind and tostring(v) == text, `$label: $(tostring(v))`)
end

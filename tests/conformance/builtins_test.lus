-- ==== Correctness: string.split() ====
-- string.split correctness
local function string_split_correctness_test()
    local r = string.split("a,b,c", ",")
    assert(#r == 3)
    assert(r[1] == "a" and r[2] == "b" and r[3] == "c")
    -- Empty delimiter: split into characters
    r = string.split("abc", "")
    assert(#r == 3)
    assert(r[1] == "a" and r[2] == "b" and r[3] == "c")
    -- Trailing delimiter
    r = string.split("a,b,", ",")
    assert(#r == 3)
    assert(r[3] == "")
    -- Empty string
    r = string.split("", ",")
    assert(#r == 1 and r[1] == "")
    -- Multi-char delimiter
    r = string.split("a::b::c", "::")
    assert(#r == 3 and r[1] == "a" and r[2] == "b" and r[3] == "c")
end


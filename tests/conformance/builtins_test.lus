-- ==== Correctness: assert() ====
-- assert correctness
local function assert_correctness_test()
    assert(assert(42) == 42)
    assert(assert("hello") == "hello")
    assert(assert(true) == true)

    local ok, err = catch (function()
        assert(false)
    end)()

    assert(not ok)

    local ok2, err2 = catch (function()
        assert(nil, "msg")
    end)()

    assert(not ok2)
end

-- ==== Correctness: getmetatable() ====
-- getmetatable correctness
local function getmetatable_correctness_test()
    local mt = {
        __index = function()
        end,
    }

    local t = setmetatable({}, mt)
    assert(getmetatable(t) == mt)
    assert(getmetatable({}) == nil)
    assert(getmetatable("hello") ~= nil)  -- strings have metatable
    -- __metatable field
    local mt2 = { __metatable = "protected" }
    local t2 = setmetatable({}, mt2)
    assert(getmetatable(t2) == "protected")
end

-- ==== Correctness: setmetatable() ====
-- setmetatable correctness
local function setmetatable_correctness_test()
    local t = {}
    local mt = {}
    assert(setmetatable(t, mt) == t)
    assert(getmetatable(t) == mt)
    setmetatable(t, nil)
    assert(getmetatable(t) == nil)
end

-- ==== Correctness: tonumber() ====
-- tonumber correctness
local function tonumber_correctness_test()
    assert(tonumber(42) == 42)
    assert(tonumber(3.14) == 3.14)
    assert(tonumber("123") == 123)
    assert(tonumber("3.14") == 3.14)
    assert(tonumber("hello") == nil)
    assert(tonumber(nil) == nil)
    assert(tonumber(true) == nil)
end

-- ==== Correctness: tostring() ====
-- tostring correctness
local function tostring_correctness_test()
    assert(tostring(42) == "42")
    assert(tostring(3.14) == "3.14")
    assert(tostring("hello") == "hello")
    assert(tostring(nil) == "nil")
    assert(tostring(true) == "true")
    assert(tostring(false) == "false")
end

-- ==== Correctness: math.ceil/floor ====
-- math.ceil/floor correctness
local function math_ceil_floor_correctness_test()
    assert(math.ceil(3.2) == 4)
    assert(math.ceil(3.0) == 3)
    assert(math.ceil(-3.2) == -3)
    assert(math.ceil(5) == 5)
    assert(math.floor(3.7) == 3)
    assert(math.floor(3.0) == 3)
    assert(math.floor(-3.2) == -4)
    assert(math.floor(5) == 5)
end

-- ==== Correctness: math.sqrt ====
-- math.sqrt correctness
local function math_sqrt_correctness_test()
    assert(math.sqrt(4) == 2.0)
    assert(math.sqrt(9) == 3.0)
    assert(math.sqrt(0) == 0.0)
    assert(math.abs(math.sqrt(2) - 1.4142135623730951) < 1e-10)
end

-- ==== Correctness: math trig ====
-- math trig correctness
local function math_trig_correctness_test()
    assert(math.abs(math.sin(0)) < 1e-10)
    assert(math.abs(math.cos(0) - 1.0) < 1e-10)
    assert(math.abs(math.tan(0)) < 1e-10)
    assert(math.abs(math.asin(0)) < 1e-10)
    assert(math.abs(math.acos(1.0)) < 1e-10)
    assert(math.abs(math.atan(0)) < 1e-10)
end

-- ==== Correctness: math.exp/log ====
-- math.exp/log correctness
local function math_exp_log_correctness_test()
    assert(math.abs(math.exp(0) - 1.0) < 1e-10)
    assert(math.abs(math.exp(1) - 2.718281828459045) < 1e-10)
    assert(math.abs(math.log(1) - 0.0) < 1e-10)
    assert(math.abs(math.log(math.exp(1)) - 1.0) < 1e-10)
end

-- ==== Correctness: math.deg/rad ====
-- math.deg/rad correctness
local function math_deg_rad_correctness_test()
    assert(math.abs(math.deg(math.pi) - 180.0) < 1e-6)
    assert(math.abs(math.rad(180) - math.pi) < 1e-10)
    assert(math.deg(0) == 0.0)
    assert(math.rad(0) == 0.0)
end

-- ==== Correctness: math.fmod ====
-- math.fmod correctness
local function math_fmod_correctness_test()
    assert(math.fmod(7, 3) == 1)
    assert(math.fmod(7.5, 3.0) == 1.5)
    assert(math.fmod(-7, 3) == -1)
    assert(math.fmod(10, 5) == 0)
end

-- ==== Correctness: math.ult ====
-- math.ult correctness
local function math_ult_correctness_test()
    assert(math.ult(1, 2) == true)
    assert(math.ult(2, 1) == false)
    assert(math.ult(0, 1) == true)
    -- -1 as unsigned is very large
    assert(math.ult(1, -1) == true)
    assert(math.ult(-1, 1) == false)
end

-- ==== Correctness: math.tointeger ====
-- math.tointeger correctness
local function math_tointeger_correctness_test()
    assert(math.tointeger(5) == 5)
    assert(math.tointeger(5.0) == 5)
    assert(math.tointeger(5.5) == nil)
    assert(math.tointeger("hello") == nil)
end

-- ==== Correctness: math.type ====
-- math.type correctness
local function math_type_correctness_test()
    assert(math.type(42) == "integer")
    assert(math.type(3.14) == "float")
    assert(math.type("hello") == nil)
    assert(math.type(nil) == nil)
end

-- ==== Correctness: math.ldexp ====
-- math.ldexp correctness
local function math_ldexp_correctness_test()
    assert(math.ldexp(1, 10) == 1024.0)
    assert(math.ldexp(0.5, 1) == 1.0)
    assert(math.ldexp(3, 0) == 3.0)
end

-- ==== Correctness: vector operations ====
-- vector.create/size/resize correctness
local function vector_create_size_resize_correctness_test()
    local v = vector.create(10)
    assert(vector.size(v) == 10)
    vector.resize(v, 20)
    assert(vector.size(v) == 20)
    vector.resize(v, 5)
    assert(vector.size(v) == 5)
end

-- vector.clone correctness
local function vector_clone_correctness_test()
    local v = vector.create(8)
    local c = vector.clone(v)
    assert(vector.size(c) == 8)
    assert(v ~= c)  -- different objects
end

-- ==== Correctness: utf8 operations ====
-- utf8.len correctness
local function utf8_len_correctness_test()
    assert(utf8.len("hello") == 5)
    assert(utf8.len("") == 0)
    assert(utf8.len("café") == 4)
end

-- utf8.codepoint correctness
local function utf8_codepoint_correctness_test()
    assert(utf8.codepoint("A") == 65)
    assert(utf8.codepoint("é") == 233)
end

-- utf8.char correctness
local function utf8_char_correctness_test()
    assert(utf8.char(65) == "A")
    assert(utf8.char(233) == "é")
end

-- utf8.offset correctness
local function utf8_offset_correctness_test()
    local s, e = utf8.offset("hello", 1)
    assert(s == 1 and e == 1)
    s, e = utf8.offset("hello", 2)
    assert(s == 2 and e == 2)
    s, e = utf8.offset("café", 4)
    -- Positions count characters in 2.0, so the 2 byte é spans 4 to 4.
    -- (spec/design/strings.md)
    assert(s == 4 and e == 4)
end

-- ==== Edge cases ====
-- edge cases.

-- setmetatable blocked by __metatable
local function setmetatable_blocked_by_metatable_test()
    local mt = { __metatable = "locked" }
    local t = setmetatable({}, mt)
    local ok, err = catch setmetatable(t, {})
    assert(not ok)
end

-- rawset returns the table
local function rawset_returns_the_table_test()
    local t = {}
    local result = rawset(t, "key", "value")
    assert(result == t)
end

-- fastcall in coroutine
local function fastcall_in_coroutine_test()
    local co = coroutine.wrap(function()
        coroutine.yield(type(42))
        coroutine.yield(math.abs(-5))
        return string.len("hello")
    end)

    assert(co() == "number")
    assert(co() == 5)
    assert(co() == 5)
end

-- math.abs type error
local function math_abs_type_error_test()
    raises(function()
        return math.abs("hello")
    end)
end

-- table.reshape rejects overflow dimensions
local function table_reshape_rejects_overflow_dimensions_test()
    local t = { 1, 2, 3, 4 }

    raises(function()
        table.reshape(t, math.maxinteger, math.maxinteger)
    end)
end

-- ==== Time scalar constructor correctness ====
-- time constructors.

-- fast time constructors build correct durations and instants
local function fast_time_constructors_build_correct_durations_and_instants_test()
    assert(time.days(1) == time.hours(24))
    assert(time.hours(1) == time.minutes(60))
    assert(time.minutes(1) == time.seconds(60))
    assert(time.seconds(1) == time.millis(1000))
    assert(time.seconds(90):seconds() == 90.0)
    assert(time.millis(1500):millis() == 1500.0)
    assert(time.instant(1000):epoch() == 1000)
    local alias = time.millis
    assert(tostring(time.millis(-1)) == tostring(alias(-1)))
    assert(time.instant(5) == time.instant(5, 0))
end

-- allocating fastcalls give the collector a step
local function allocating_fastcalls_give_the_collector_a_step_test()
    collectgarbage("collect")
    local before = collectgarbage("count")

    for i = 1, 200000 do
        local d = time.seconds(i)
        local s = string.sub("hello world", 1, 5)
    end

    local after = collectgarbage("count")
    assert(after - before < 8192)
end

pledge("load")

-- ===== fastcall =====
-- The fastcall layer is gone in 2.0, so the emission checks are dropped and the
-- value checks remain: builtins must agree in every call position.
-- ==== Correctness: type() ====
-- type correctness
local function type_correctness_test()
    assert(type(nil) == "nil")
    assert(type(true) == "boolean")
    assert(type(false) == "boolean")
    assert(type(42) == "number")
    assert(type(3.14) == "number")
    assert(type("hello") == "string")
    assert(type({}) == "table")
    assert(type(print) == "function")
    assert(type(type) == "function")
end

-- ==== Correctness: rawlen() ====
-- rawlen correctness
local function rawlen_correctness_test()
    assert(rawlen({ 1, 2, 3 }) == 3)
    assert(rawlen({}) == 0)
    assert(rawlen("hello") == 5)
    assert(rawlen("") == 0)
    assert(rawlen({ 1, 2, 3, 4, 5 }) == 5)
end

-- ==== Correctness: rawget() ====
-- rawget correctness
local function rawget_correctness_test()
    local t = { a = 1, b = 2, [3] = "three" }
    assert(rawget(t, "a") == 1)
    assert(rawget(t, "b") == 2)
    assert(rawget(t, 3) == "three")
    assert(rawget(t, "c") == nil)
    assert(rawget(t, 999) == nil)
end

-- ==== Correctness: rawset() ====
-- rawset correctness
local function rawset_correctness_test()
    local t = {}
    rawset(t, "x", 10)
    assert(t.x == 10)
    rawset(t, 1, "one")
    assert(t[1] == "one")
    rawset(t, "x", nil)
    assert(t.x == nil)
end

-- ==== Correctness: rawequal() ====
-- rawequal correctness
local function rawequal_correctness_test()
    assert(rawequal(1, 1) == true)
    assert(rawequal(1, 2) == false)
    assert(rawequal("a", "a") == true)
    assert(rawequal("a", "b") == false)
    assert(rawequal(nil, nil) == true)
    assert(rawequal(nil, false) == false)
    local t = {}
    assert(rawequal(t, t) == true)
    assert(rawequal({}, {}) == false)
end

-- ==== Correctness: math.abs() ====
-- math.abs correctness
local function math_abs_correctness_test()
    assert(math.abs(5) == 5)
    assert(math.abs(-5) == 5)
    assert(math.abs(0) == 0)
    assert(math.abs(3.14) == 3.14)
    assert(math.abs(-3.14) == 3.14)
    assert(math.abs(0.0) == 0.0)
    -- Edge case: mininteger (abs of mininteger wraps in two's complement)
    local result = math.abs(math.mininteger)
    assert(type(result) == "number")
end

-- ==== Correctness: math.max() ====
-- math.max correctness
local function math_max_correctness_test()
    assert(math.max(1, 2) == 2)
    assert(math.max(2, 1) == 2)
    assert(math.max(-1, -2) == -1)
    assert(math.max(0, 0) == 0)
    -- Integer-integer
    assert(math.max(100, 200) == 200)
    -- Float-float
    assert(math.max(1.5, 2.5) == 2.5)
    -- Mixed int-float
    assert(math.max(1, 2.5) == 2.5)
    assert(math.max(3, 2.5) == 3.0)
end

-- ==== Correctness: math.min() ====
-- math.min correctness
local function math_min_correctness_test()
    assert(math.min(1, 2) == 1)
    assert(math.min(2, 1) == 1)
    assert(math.min(-1, -2) == -2)
    assert(math.min(0, 0) == 0)
    -- Float-float
    assert(math.min(1.5, 2.5) == 1.5)
    -- Mixed int-float
    assert(math.min(1, 2.5) == 1.0)
    assert(math.min(3, 2.5) == 2.5)
end

-- ==== Correctness: string.len() ====
-- string.len correctness
local function string_len_correctness_test()
    assert(string.len("hello") == 5)
    assert(string.len("") == 0)
    assert(string.len("a") == 1)
    assert(string.len("hello world") == 11)
end

-- ==== NaN handling for math.max/min ====
-- math.max/min NaN
local function math_max_min_nan_test()
    local nan = 0 / 0
    local smax = math.max
    local smin = math.min

    local function isnan(x)
        return x ~= x
    end

    local function check(fast, slow, label)
        assert(
            isnan(fast) == isnan(slow),
            label .. ": fast path NaN-ness should match the C function"
        )

        if not isnan(slow) then
            assert(fast == slow, label .. ": values should match")
        end
    end

    -- the direct calls take the fast path, the local aliases force the
    -- C function, and both must agree for every argument order
    local f_max_a = math.max(nan, 1)
    local f_max_b = math.max(1, nan)
    local f_min_a = math.min(nan, 1)
    local f_min_b = math.min(1, nan)
    check(f_max_a, smax(nan, 1), "max(nan, 1)")
    check(f_max_b, smax(1, nan), "max(1, nan)")
    check(f_min_a, smin(nan, 1), "min(nan, 1)")
    check(f_min_b, smin(1, nan), "min(1, nan)")
end

-- ==== Environment tainting: type ====
-- tainted type fallback
local function tainted_type_fallback_test()
    local original_type = type
    local custom_called = false

    -- Rebind type in a new environment
    local env = setmetatable({
        type = function(x)
            custom_called = true
            return "custom"
        end,
    }, { __index = _G })

    local chunk = load("return type(42)", "test", "t", env)
    local result = chunk()
    assert(result == "custom", "expected custom, got " .. tostring(result))
    assert(custom_called)

    -- Verify original still works
    assert(original_type(42) == "number")
end

-- ==== Environment tainting: math.max ====
-- tainted math.max fallback
local function tainted_math_max_fallback_test()
    local custom_called = false

    local env = setmetatable({
        math = {
            max = function(a, b)
                custom_called = true
                return a + b
            end,
        },
    }, { __index = _G })

    local chunk = load("return math.max(3, 5)", "test", "t", env)
    local result = chunk()
    assert(result == 8, "expected 8, got " .. tostring(result))
    assert(custom_called)
end

-- ==== Argument count: math.max with 3 args (should NOT be fastcall'd) ====
-- math.max 3 args normal call
local function math_max_3_args_normal_call_test()
    -- math.max with 3 args should use normal OP_CALL (not fastcall)
    local r = math.max(1, 2, 3)
    assert(r == 3)
end

-- ==== Argument count: type with 0 args ====
-- type 0 args error
local function type_0_args_error_test()
    local ok, err = catch (function()
        return type()
    end)()

    assert(not ok, "type() with 0 args should error")
end

-- ==== Fastcall inside catch ====
-- fastcall in catch
local function fastcall_in_catch_test()
    local ok, val = catch (function()
        return type(42)
    end)()

    assert(ok == true)
    assert(val == "number")
end

-- ==== Fastcall inside loops ====
-- fastcall in for loop
local function fastcall_in_for_loop_test()
    local results = {}

    for i = 1, 5 do
        results[i] = math.abs(-i)
    end

    assert(results[1] == 1)
    assert(results[5] == 5)
end

-- fastcall in while loop
local function fastcall_in_while_loop_test()
    local i = -5
    local sum = 0

    while i <= 5 do
        sum = sum + math.abs(i)
        i = i + 1
    end

    assert(sum == 30)  -- |(-5)|+|(-4)|+...+|5| = 2*(1+2+3+4+5) = 30
end

-- ==== Multi-return context ====
-- fastcall multi-return context
local function fastcall_multi_return_context_test()
    -- When type() is used as last arg in a call, C may be changed
    -- from 2 to 0 (multi-return). The VM should fall back to slow path.
    local function capture(...)
        return select("#", ...), ...
    end

    local n, v = capture(type(42))
    assert(n == 1)
    assert(v == "number")
end

-- ==== Fastcall with local _ENV rebinding ====
-- local ENV rebinding fallback
local function local_env_rebinding_fallback_test()
    -- When _ENV is rebound locally, the compiler should still
    -- emit OP_CALL (not OP_FASTCALL) since upvalue 0 won't be _ENV
    local custom_type_called = false

    local _ENV = setmetatable({
        type = function(x)
            custom_type_called = true
            return "rebound"
        end,
    }, { __index = _G })

    local result = type(42)
    assert(result == "rebound", "expected rebound, got " .. tostring(result))
    assert(custom_type_called)
end

-- ==== Rawset GC correctness ====
-- rawset GC barrier
local function rawset_gc_barrier_test()
    -- Stress test rawset with string values to exercise GC barrier
    local t = {}

    for i = 1, 1000 do
        rawset(t, "key" .. i, "value" .. i)
    end

    -- Force a GC cycle
    collectgarbage("collect")
    -- Verify values survived
    assert(rawget(t, "key1") == "value1")
    assert(rawget(t, "key1000") == "value1000")
end

-- ==== rawget/rawset bypass metamethods ====
-- rawget bypasses __index
local function rawget_bypasses_index_test()
    local mt = {
        __index = function(t, k)
            return "meta"
        end,
    }

    local t = setmetatable({}, mt)
    assert(t.x == "meta")  -- through metamethod
    assert(rawget(t, "x") == nil)  -- bypasses metamethod
end

-- rawset bypasses __newindex
local function rawset_bypasses_newindex_test()
    local blocked = false

    local mt = {
        __newindex = function(t, k, v)
            blocked = true
        end,
    }

    local t = setmetatable({}, mt)
    rawset(t, "x", 42)
    assert(not blocked)  -- metamethod not called
    assert(rawget(t, "x") == 42)
end


            end,
        },
    }, { __index = _G })

    local chunk = load("return table.stdev({1,2,3})", "test", "t", env)
    local result = chunk()
    assert(result == 77)
    assert(custom_called)
end

-- ==== table.stdev 2-arg (sample) falls back ====
-- table.stdev sample fallback
local function table_stdev_sample_fallback_test()
    -- 2-arg variant is not fastcalled (nargs mismatch) and must compute
    -- the SAMPLE stdev, not the population stdev (2.0) of the same data
    local r = table.stdev({ 2, 4, 4, 4, 5, 5, 7, 9 }, true)
    assert(
        math.abs(r - 2.1380899352994) < 1e-9,
        "sample stdev should be ~2.1381, got " .. tostring(r)
    )
end

-- ==== Correctness: table.transpose() ====
-- table.transpose correctness
local function table_transpose_correctness_test()
    local m = { { 1, 2, 3 }, { 4, 5, 6 } }
    local r = table.transpose(m)
    assert(#r == 3)
    assert(r[1][1] == 1 and r[1][2] == 4)
    assert(r[2][1] == 2 and r[2][2] == 5)
    assert(r[3][1] == 3 and r[3][2] == 6)
    -- Empty matrix
    r = table.transpose({})
    assert(#r == 0)
end

-- ==== Environment tainting: table.transpose ====
-- tainted table.transpose fallback
local function tainted_table_transpose_fallback_test()
    local custom_called = false

    local env = setmetatable({
        table = {
            transpose = function(t)
                custom_called = true
                return { { 99 } }
            end,
        },
    }, { __index = _G })

    local chunk = load("return table.transpose({{1,2},{3,4}})", "test", "t", env)
    local result = chunk()
    assert(result[1][1] == 99)
    assert(custom_called)
end

-- ==== table.transpose type error fallback ====
-- table.transpose type error fallback
local function table_transpose_type_error_fallback_test()
    local ok, err = catch (function()
        return table.transpose("nope")
    end)()

    assert(not ok, "table.transpose('nope') should error")
end

-- ==== Correctness: table.reshape() ====
-- table.reshape correctness
local function table_reshape_correctness_test()
    local r = table.reshape({ 1, 2, 3, 4, 5, 6 }, 2, 3)
    assert(#r == 2)
    assert(r[1][1] == 1 and r[1][2] == 2 and r[1][3] == 3)
    assert(r[2][1] == 4 and r[2][2] == 5 and r[2][3] == 6)
    -- 1x4
    r = table.reshape({ 10, 20, 30, 40 }, 1, 4)
    assert(#r == 1 and #r[1] == 4)
    assert(r[1][4] == 40)
end

-- ==== Environment tainting: table.reshape ====
-- tainted table.reshape fallback
local function tainted_table_reshape_fallback_test()
    local custom_called = false

    local env = setmetatable({
        table = {
            reshape = function(t, r, c)
                custom_called = true
                return { { 0 } }
            end,
        },
    }, { __index = _G })

    local chunk = load("return table.reshape({1,2,3,4}, 2, 2)", "test", "t", env)
    local result = chunk()
    assert(result[1][1] == 0)
    assert(custom_called)
end

-- ==== table.reshape dimension mismatch fallback ====
-- table.reshape dimension error
local function table_reshape_dimension_error_test()
    local ok, err = catch (function()
        return table.reshape({ 1, 2, 3 }, 2, 2)
    end)()

    assert(not ok, "reshape with mismatched dimensions should error")
end


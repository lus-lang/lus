pledge("load")

-- The compressors return vectors in Lus 2.0 (spec/design/strings.md), so these
-- helpers turn byte data into vectors and compare vectors through hex text.
local function bytes(x)
    if type(x) == "string" then
        return vector.fromstring(x)
    end

    return x
end

local function hex(x)
    return string.transcode(bytes(x), "binary", "hex")
end

-- The first n bytes of a vector as a new vector.
local function head(v, n)
    local c = vector.clone(v)
    vector.resize(c, n)
    return c
end

-- A new vector holding the bytes of every argument in order.
local function join(...)
    local parts = { ... }
    local total = 0

    for i, p in ipairs(parts) do
        parts[i] = bytes(p)
        total = total + #parts[i]
    end

    local out = vector.create(total)
    local at = 0

    for _, p in ipairs(parts) do
        for i = 0, #p - 1 do
            vector.set(out, at + i, vector.get(p, i))
        end

        at = at + #p
    end

    return out
end

local sample = "Hello, World! This is a test of the compression library. "
    .. "We need enough data to make compression meaningful. "
    .. string.rep("abcdefghijklmnopqrstuvwxyz ", 20)

local empty = ""

-- ===================================================================
-- Gzip
-- ===================================================================

-- Group: vector.archive.gzip.

local function gzip_roundtrip_string_test()
    local compressed = vector.archive.gzip.compress(sample)
    assert(type(compressed) == "vector")
    assert(#compressed < #sample, "compressed should be smaller")
    local decompressed = vector.archive.gzip.decompress(compressed)
    assert(vector.tostring(decompressed) == sample)
end

local function gzip_roundtrip_vector_test()
    local v = vector.create(#sample, true)
    vector.pack(v, 0, "c" .. #sample, sample)
    local compressed = vector.archive.gzip.compress(v)
    assert(type(compressed) == "vector")
    local decompressed = vector.archive.gzip.decompress(compressed)
    assert(type(decompressed) == "vector")
    assert(#decompressed == #sample)
    local result = vector.unpack(decompressed, 0, "c" .. #sample)
    assert(result == sample)
end

local function gzip_empty_data_test()
    local compressed = vector.archive.gzip.compress(empty)
    local decompressed = vector.archive.gzip.decompress(compressed)
    assert(vector.tostring(decompressed) == empty)
end

local function gzip_compression_levels_test()
    local c0 = vector.archive.gzip.compress(sample, 0)
    local c9 = vector.archive.gzip.compress(sample, 9)
    -- Both should decompress correctly
    assert(vector.tostring(vector.archive.gzip.decompress(c0)) == sample)
    assert(vector.tostring(vector.archive.gzip.decompress(c9)) == sample)
    -- Level 9 should be at least as small as level 0
    assert(#c9 <= #c0)
end

local function gzip_invalid_data_test()
    raises(function()
        vector.archive.gzip.decompress("not valid gzip data!!")
    end)
end

local function gzip_invalid_level_test()
    raises(function()
        vector.archive.gzip.compress(sample, 10)
    end)
end


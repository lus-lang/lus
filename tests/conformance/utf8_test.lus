--[[
    The utf8 library in Lus 2.0 (spec/design/strings.md). Strings are well formed WTF-8
    and every position is a character position, so `utf8.len(s) == #s`. A string can
    only be invalid in strict mode through a lone surrogate. Malformed byte sequences
    can arrive only as vectors, so the invalid-byte matrix of the legacy suite runs
    through `vector.tostring` in its strict and lossy modes.
]]

pledge("load")

local function bytes(...)
    local n = select("#", ...)
    local v = vector.create(n)

    for i = 1, n do
        vector.set(v, i - 1, (select(i, ...)))
    end

    return v
end

local function octets(v)
    local t = {}

    for i = 0, #v - 1 do
        t[#t + 1] = vector.get(v, i)
    end

    return t
end

-- Group: encoding and decoding

local function utf8_char_single_test()
    assert(utf8.char(65) == "A")
    assert(utf8.char(0x20AC) == "€")
    assert(utf8.char(0x1F600) == "😀")
end

local function utf8_char_multiple_test()
    assert(utf8.char(65, 66, 67) == "ABC")
    assert(utf8.char(0x20AC, 0x20AC) == "€€")
end

local function utf8_codepoint_test()
    assert(utf8.codepoint("A") == 65)
    assert(utf8.codepoint("€") == 0x20AC)
    local a, b, c = utf8.codepoint("ABC", 1, 3)
    assert(a == 65 and b == 66 and c == 67)
end

local function utf8_len_test()
    assert(utf8.len("A") == 1)
    assert(utf8.len("€") == 1)
    assert(utf8.len("abc") == 3)
    assert(utf8.len("£") == 1)
    assert(utf8.len("") == 0)
    assert(utf8.len("hello") == 5)
    assert(utf8.len("héllo") == 5)
    assert(utf8.len("héllo") == #"héllo")
end

-- Offsets are character positions, so the euro sign occupies one position.
local function utf8_offset_test()
    local s = "A€B"
    assert(utf8.offset(s, 1) == 1)
    assert(utf8.offset(s, 2) == 2)
    assert(utf8.offset(s, 3) == 3)
    assert(utf8.offset(s, 4) == 4)
end

local function utf8_offset_negative_test()
    local s = "ABC"
    assert(utf8.offset(s, -1) == 3)
    assert(utf8.offset(s, -2) == 2)
    assert(utf8.offset(s, -3) == 1)
end

local function utf8_codes_iterator_test()
    local t = {}

    for p, c in utf8.codes("A€") do
        table.insert(t, { p = p, c = c })
    end

    assert(#t == 2)
    assert(t[1].p == 1 and t[1].c == 65)
    assert(t[2].p == 2 and t[2].c == 0x20AC)
end

-- A lone surrogate is the only invalid character a string can hold.
local function invalid_sequences_test()
    local lone = utf8.char(0xD800)
    local n, pos = utf8.len(lone)
    assert(n == nil and pos == 1)
    local ok = catch utf8.codepoint(lone)
    assert(not ok)
end

-- Patterns match whole characters, so the character pattern is a single dot.
local function utf8_charpattern_test()
    assert(utf8.charpattern)
    local count = 0

    for _ in string.gmatch("hello", utf8.charpattern) do
        count = count + 1
    end

    assert(count == 5)
end

local function four_byte_character_round_trip_test()
    local s = utf8.char(0x1F600)
    assert(utf8.codepoint(s) == 0x1F600)
    assert(#s == 1)
end

local function boundary_codepoint_round_trips_test()
    local codepoints = { 0x007F, 0x0080, 0x07FF, 0x0800, 0xFFFF, 0x10000, 0x10FFFF }

    for _, cp in ipairs(codepoints) do
        local s = utf8.char(cp)
        assert(utf8.codepoint(s) == cp)
        assert(#s == 1)
    end
end

local function utf8_len_with_character_range_test()
    local s = "A" .. utf8.char(0x20AC) .. "B"
    assert(utf8.len(s) == 3)
    assert(utf8.len(s, 2, 2) == 1)
    assert(utf8.len(s, 1, 1) == 1)
    assert(utf8.len(s, 3, 3) == 1)
    assert(utf8.len(s, 1, 2) == 2)
end

local function utf8_offset_negative_n_with_multi_byte_test()
    local s = utf8.char(0x20AC) .. "AB"
    assert(utf8.offset(s, -1) == 3)
    assert(utf8.offset(s, -2) == 2)
    assert(utf8.offset(s, -3) == 1)
end

-- An overlong encoding cannot be written as a string, and decoding its bytes fails.
local function rejects_overlong_encoding_test()
    local overlong = bytes(0xC0, 0xAF)

    raises(function()
        return vector.tostring(overlong)
    end)

    assert(string.find(vector.tostring(overlong, 0, 2, "lossy"), "\u{FFFD}", 1, true))
end

local function codes_iterates_mixed_multi_byte_correctly_test()
    local s = "A" .. utf8.char(0xE9) .. utf8.char(0x20AC) .. utf8.char(0x1F600)
    local cps = {}

    for _, c in utf8.codes(s) do
        cps[#cps + 1] = c
    end

    assert(#cps == 4)
    assert(cps[1] == 65)
    assert(cps[2] == 0xE9)
    assert(cps[3] == 0x20AC)
    assert(cps[4] == 0x1F600)
end

-- Group: utf8.charpattern

local function charpattern_exact_value_and_type_test()
    assert(type(utf8.charpattern) == "string")
    assert(utf8.charpattern == ".")
end

local function charpattern_matches_exactly_one_character_test()
    local euro = utf8.char(0x20AC)
    assert(string.match(euro .. "xyz", "^" .. utf8.charpattern) == euro)
    assert(string.match("A" .. euro, "^" .. utf8.charpattern) == "A")
end

local function charpattern_over_mixed_text_yields_one_match_per_character_test()
    local mixed = "A" .. utf8.char(0xE9) .. utf8.char(0x20AC) .. utf8.char(0x1F600)
    local count = 0
    local rebuilt = ""

    for m in string.gmatch(mixed, utf8.charpattern) do
        count = count + 1
        rebuilt = rebuilt .. m
    end

    assert(count == 4)
    assert(count == utf8.len(mixed))
    assert(rebuilt == mixed)
end

-- Group: malformed byte sequences

-- Each case is a malformed byte sequence with the zero-based offset where strict
-- decoding reports the failure.
local malformed_bytes_fail_strict_decoding_and_become_replacement_characters_cases = {
    { { 0x80 }, 0 },
    { { 0xBF }, 0 },
    { { 0x41, 0x80 }, 1 },
    { { 0x61, 0x62, 0xBF }, 2 },
    { { 0xC2 }, 0 },
    { { 0x41, 0xC2 }, 1 },
    { { 0xE2 }, 0 },
    { { 0xE2, 0x82 }, 0 },
    { { 0x41, 0xE2, 0x82 }, 1 },
    { { 0xF0 }, 0 },
    { { 0xF0, 0x9F }, 0 },
    { { 0xF0, 0x9F, 0x98 }, 0 },
    { { 0xC0, 0xAF }, 0 },
    { { 0xC1, 0xBF }, 0 },
    { { 0xE0, 0x80, 0x80 }, 0 },
    { { 0xE0, 0x9F, 0xBF }, 0 },
    { { 0xF0, 0x80, 0x80, 0x80 }, 0 },
    { { 0xF0, 0x8F, 0xBF, 0xBF }, 0 },
    { { 0xF4, 0x90, 0x80, 0x80 }, 0 },
    { { 0xF7, 0xBF, 0xBF, 0xBF }, 0 },
    { { 0xFE }, 0 },
    { { 0xFF }, 0 },
    { { 0x68, 0x65, 0x6C, 0x6C, 0x6F, 0xFF, 0x77, 0x6F, 0x72, 0x6C, 0x64 }, 5 },
}

local function malformed_bytes_fail_strict_decoding_and_become_replacement_characters_test(
    list,
    offset
)
    local v = bytes(table.unpack(list))

    local err = raises(function()
        return vector.tostring(v)
    end)

    assert(string.find(tostring(err), tostring(offset), 1, true))
    local lossy = vector.tostring(v, 0, #v, "lossy")
    assert(string.find(lossy, "\u{FFFD}", 1, true))
end

-- An encoded surrogate half is a valid WTF-8 character. It is invalid only for the
-- strict utf8 functions, and the lax mode accepts it.
local function encoded_surrogates_are_valid_wtf_8_characters_test()
    local decoded = vector.tostring(bytes(0xED, 0xA0, 0x80))
    assert(#decoded == 1)
    assert(utf8.len(decoded) == nil)
    local lone = utf8.char(0xD800)
    assert(#lone == 1)
    assert(utf8.len(lone) == nil)
    assert(utf8.len(lone, 1, -1, true) == 1)
end

local function the_wtf_8_bytes_of_a_lone_surrogate_survive_a_vector_round_trip_test()
    local lone = utf8.char(0xD800)
    local raw = vector.fromstring(lone)
    assert(same(octets(raw), { 0xED, 0xA0, 0x80 }))
    assert(utf8.len(vector.tostring(raw, 0, #raw, "lossy"), 1, -1, true) >= 1)
end

-- Group: utf8.len

-- A lone surrogate is invalid in strict mode and counts as a character in lax mode.
local utf8_len_reports_nil_and_the_surrogate_position_cases = {
    { utf8.char(0xD800), 1 },
    { utf8.char(0xDFFF), 1 },
    { "A" .. utf8.char(0xD800), 2 },
    { "ab" .. utf8.char(0xDBFF) .. "c", 3 },
}

local function utf8_len_reports_nil_and_the_surrogate_position_test(s, pos)
    local n, p = utf8.len(s)
    assert(n == nil)
    assert(p == pos)
    assert(utf8.len(s, 1, -1, true) == #s)
end

local utf8_len_out_of_bounds_argcheck_cases = {
    {
        function()
            return utf8.len("abc", 0)
        end,
        "initial position out of bounds",
    },
    {
        function()
            return utf8.len("abc", 5)
        end,
        "initial position out of bounds",
    },
    {
        function()
            return utf8.len("abc", 1, 4)
        end,
        "final position out of bounds",
    },
}

local function utf8_len_out_of_bounds_argcheck_test(fn, pat)
    raises(fn, pat)
end

local function utf8_len_empty_range_edges_count_zero_test()
    assert(utf8.len("abc", 4) == 0)
    assert(utf8.len("abc", 3, 2) == 0)
    assert(utf8.len("", 1) == 0)
end

local function utf8_len_negative_indices_resolve_from_the_end_test()
    local s = "A" .. utf8.char(0x20AC) .. "B"
    assert(utf8.len(s, -1) == 1)
    assert(utf8.len(s, 1, -1) == 3)
    assert(utf8.len(s, -2, -1) == 2)
end

-- Group: utf8.codepoint

local function utf8_codepoint_negative_indices_test()
    local s = "A" .. utf8.char(0x20AC) .. "B"
    assert(utf8.codepoint(s, -1) == 66)
    assert(utf8.codepoint(s, -2) == 0x20AC)
    local a, b, c = utf8.codepoint(s, -3, -1)
    assert(a == 65)
    assert(b == 0x20AC)
    assert(c == 66)
end

local function utf8_codepoint_default_j_equals_i_test()
    local s = "A" .. utf8.char(0x20AC) .. "B"
    assert(select("#", utf8.codepoint(s, 2)) == 1)
    assert(utf8.codepoint(s, 2) == 0x20AC)
end

local function utf8_codepoint_explicit_range_spans_multi_byte_characters_test()
    local s = "A" .. utf8.char(0x20AC) .. "B"
    local a, b, c = utf8.codepoint(s, 1, 3)
    assert(a == 65)
    assert(b == 0x20AC)
    assert(c == 66)
end

local utf8_codepoint_out_of_bounds_argcheck_cases = {
    {
        function()
            return utf8.codepoint("abc", 0)
        end,
        "out of bounds",
    },
    {
        function()
            return utf8.codepoint("abc", 5)
        end,
        "out of bounds",
    },
    {
        function()
            return utf8.codepoint("abc", 1, 4)
        end,
        "out of bounds",
    },
    {
        function()
            return utf8.codepoint("")
        end,
        "out of bounds",
    },
}

local function utf8_codepoint_out_of_bounds_argcheck_test(fn, pat)
    raises(fn, pat)
end

local function utf8_codepoint_on_a_lone_surrogate_reports_the_invalid_message_test()
    local ok, err = catch utf8.codepoint(utf8.char(0xD800))
    assert(not ok)
    assert(string.find(tostring(err), "invalid UTF%-8 code"))
end

local function utf8_codepoint_rejects_surrogates_strictly_and_accepts_them_in_lax_mode_test()
    local lone = utf8.char(0xD800)

    raises(function()
        return utf8.codepoint(lone)
    end, "invalid UTF%-8 code")

    assert(utf8.codepoint(lone, 1, 1, true) == 0xD800)
end

-- Group: utf8.codes

local function utf8_codes_over_an_empty_string_never_iterates_test()
    local count = 0

    for _ in utf8.codes("") do
        count = count + 1
    end

    assert(count == 0)
end

local function utf8_codes_reports_character_positions_across_a_1_2_3_4_byte_mix_test()
    local s = "A" .. utf8.char(0xE9) .. utf8.char(0x20AC) .. utf8.char(0x1F600)
    local positions = {}
    local codes = {}

    for p, c in utf8.codes(s) do
        positions[#positions + 1] = p
        codes[#codes + 1] = c
    end

    assert(same(positions, { 1, 2, 3, 4 }))
    assert(same(codes, { 65, 0xE9, 0x20AC, 0x1F600 }))
end

local function utf8_codes_raises_on_a_lone_surrogate_mid_iteration_test()
    local s = "A" .. utf8.char(0xD800) .. "b"
    local last

    local err = raises(function()
        for p in utf8.codes(s) do
            last = p
        end
    end, "invalid UTF%-8 code")

    assert(last == 1)
end

local function utf8_codes_lax_mode_yields_a_surrogate_without_error_test()
    local seen = {}

    for p, c in utf8.codes(utf8.char(0xD800), true) do
        seen[#seen + 1] = { p, c }
    end

    assert(#seen == 1)
    assert(seen[1][1] == 1)
    assert(seen[1][2] == 0xD800)
end

-- A number coerces to a string here, so only non-coercible types raise.
local utf8_codes_rejects_non_string_argument_cases = {
    {
        function()
            return utf8.codes(nil)
        end,
    },
    {
        function()
            return utf8.codes({})
        end,
    },
    {
        function()
            return utf8.codes(true)
        end,
    },
}

local function utf8_codes_rejects_non_string_argument_test(fn)
    raises(fn)
end

-- Group: utf8.char

local function utf8_char_with_no_arguments_is_the_empty_string_test()
    assert(utf8.char() == "")
end

local function utf8_char_encodes_the_nul_code_point_as_one_character_test()
    assert(utf8.char(0) == "\0")
    assert(#utf8.char(0) == 1)
end

-- Code points stop at U+10FFFF in 2.0 (spec/design/strings.md), so larger values are out of range.
local utf8_char_out_of_range_raises_value_out_of_range_cases = {
    {
        function()
            return utf8.char(0x110000)
        end,
    },
    {
        function()
            return utf8.char(-1)
        end,
    },
    {
        function()
            return utf8.char(0x100000000)
        end,
    },
    {
        function()
            return utf8.char(0x80000000)
        end,
    },
}

local function utf8_char_out_of_range_raises_value_out_of_range_test(fn)
    raises(fn, "value out of range")
end

local function utf8_char_coerces_integral_values_and_rejects_fractional_ones_test()
    assert(utf8.char(65.0) == "A")
    assert(utf8.char("65") == "A")

    raises(function()
        return utf8.char(65.5)
    end, "number has no integer representation")
end

local utf8_char_rejects_non_number_arguments_cases = {
    {
        function()
            return utf8.char("A")
        end,
    },
    {
        function()
            return utf8.char({})
        end,
    },
    {
        function()
            return utf8.char(true)
        end,
    },
}

local function utf8_char_rejects_non_number_arguments_test(fn)
    raises(fn, "number expected")
end

-- Direct byte level assertions prove the encoder independently of the decoder.
-- The bytes come from vector.fromstring, which returns the WTF-8 form of a string.
local utf8_char_produces_the_exact_byte_encoding_cases = {
    { 0x7F, { 0x7F } },
    { 0x80, { 0xC2, 0x80 } },
    { 0x7FF, { 0xDF, 0xBF } },
    { 0x800, { 0xE0, 0xA0, 0x80 } },
    { 0xFFFF, { 0xEF, 0xBF, 0xBF } },
    { 0x10000, { 0xF0, 0x90, 0x80, 0x80 } },
    { 0x10FFFF, { 0xF4, 0x8F, 0xBF, 0xBF } },
    { 0x1F600, { 0xF0, 0x9F, 0x98, 0x80 } },
}

local function utf8_char_produces_the_exact_byte_encoding_test(cp, expected)
    local s = utf8.char(cp)
    assert(same(octets(vector.fromstring(s)), expected))
    assert(utf8.codepoint(vector.tostring(bytes(table.unpack(expected)))) == cp)
end

-- Group: utf8.offset

-- A character occupies one position, so both results of utf8.offset name the same position.
local function utf8_offset_returns_the_character_position_twice_test()
    local s = "A" .. utf8.char(0x20AC) .. "B"
    assert(select("#", utf8.offset(s, 2)) == 2)
    local a, b = utf8.offset(s, 2)
    assert(a == 2)
    assert(b == 2)
end

local function utf8_offset_with_n_0_finds_the_enclosing_character_test()
    local s = "A" .. utf8.char(0x20AC) .. "B"
    assert(utf8.offset(s, 0, 2) == 2)
    assert(utf8.offset(s, 0, 1) == 1)
    assert(utf8.offset(s, 0, 3) == 3)
end

local function utf8_offset_counts_from_an_explicit_position_i_with_positive_n_test()
    local s = "A" .. utf8.char(0x20AC) .. "B"
    assert(utf8.offset(s, 1, 2) == 2)
    assert(utf8.offset(s, 2, 2) == 3)
end

local function utf8_offset_counts_backward_from_an_explicit_position_i_test()
    local s = "A" .. utf8.char(0x20AC) .. "B"
    assert(utf8.offset(s, -1, 3) == 2)
end

local function utf8_offset_returns_nil_when_the_character_does_not_exist_test()
    assert(utf8.offset("ABC", 5) == nil)
    assert(utf8.offset("ABC", -4) == nil)
    assert(utf8.offset("ABC", 4) == 4)
end

local utf8_offset_position_out_of_bounds_argcheck_cases = {
    {
        function()
            return utf8.offset("abc", 1, 0)
        end,
    },
    {
        function()
            return utf8.offset("abc", 1, 5)
        end,
    },
}

local function utf8_offset_position_out_of_bounds_argcheck_test(fn)
    raises(fn, "position out of bounds")
end

local function utf8_offset_over_the_empty_string_test()
    assert(utf8.offset("", 1) == 1)
    assert(utf8.offset("", -1) == nil)
end

local function utf8_offset_rejects_a_non_integer_n_test()
    raises(function()
        return utf8.offset("abc", 1.5)
    end, "number has no integer representation")
end

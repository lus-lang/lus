local function break_inside_dead_branch_does_not_leak_into_the_loop_test()
    check("break_inside_dead_branch_does_not_leak_into_the_loop")
end

local function closures_and_to_be_closed_locals_in_dead_branches_test()
    check("closures_and_to_be_closed_locals_in_dead_branches")
end

local function goto_in_dead_branch_test()
    check("goto_in_dead_branch")
end

local function nested_folds_test()
    check("nested_folds")
end

local function assigning_to_flags_is_a_parse_error_test()
    check("assigning_to_flags_is_a_parse_error")

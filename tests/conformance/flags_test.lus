local function workers_see_the_same_flags_test()
    check("workers_see_the_same_flags")
end

-- interpreter without -F still has an empty flags table
local function interpreter_without_f_still_has_an_empty_flags_table_test()
    if setup_error then skip("2.0 gap: " .. setup_error .. " (set LUS_EXE to the interpreter path)") end
    local script = "if type(flags) == 'table' and next(flags) == nil and not flags.debug then os.exit(0) end os.exit(1)"
    local out, ok = run("-Pload -e \"" .. script .. "\"")
    assert(ok == true or ok == 0)
end

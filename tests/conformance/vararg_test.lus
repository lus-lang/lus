pledge("load")

local function basic_vararg_test()
    local function f(a, ...)
        local arg = {...}
        assert(a == 10)
        assert(arg[1] == 20)
        assert(arg[2] == 30)
        return select("#", ...)
    end
    
    assert(f(10, 20, 30) == 2)
end

local function named_vararg_test()
    -- '...b' binds the extra arguments as a packed table with an 'n' count
    local function f(a, ...b)
        return a, b
    end
    local a, b = f(10, 20, 30)
    assert(a == 10)
    assert(type(b) == "table")
    assert(b[1] == 20 and b[2] == 30)
    assert(b.n == 2)
    assert(#b == 2)
end

local function named_vararg_with_zero_extra_arguments_test()
    local function f(a, ...b)
        return b
    end
    local b = f(10)
    assert(type(b) == "table")
    assert(b.n == 0)
    assert(b[1] == nil)
end

local function named_vararg_preserves_nil_holes_via_n_test()
    local function f(...b)
        return b
    end
    local b = f(nil, 2, nil)
    assert(b.n == 3)
    assert(b[1] == nil and b[2] == 2 and b[3] == nil)
end

local function named_vararg_keeps_usable_in_the_same_function_test()
    local function f(...b)
        return select("#", ...), b.n
    end
    local dots_count, packed_count = f(7, 8, 9)
    assert(dots_count == 3)
    assert(packed_count == 3)
end

local function named_vararg_binds_a_fresh_table_per_call_test()
    local function f(...b)
        return b
    end
    local t1 = f(1, 2)
    local t2 = f(1, 2)
    assert(t1 ~= t2)
    t1[1] = 99
    assert(t2[1] == 1)
end

local function select_basics_test()
    assert(select("#", 1, 2, 3) == 3)
    assert(select(2, "a", "b", "c") == "b")
    local a, b = select(-2, 1, 2, 3)
    assert(a == 2 and b == 3)
end

local function select_edge_cases_test()
    assert(select(1) == nil)
    assert(select("#") == 0)
    local f = select
    assert(f(1, "a", "b") == "a")
    assert(f("#", "a", "b") == 2)
end

local function table_pack_unpack_test()
    local t = table.pack(nil, 1, nil)
    assert(t.n == 3)
    assert(t[1] == nil and t[2] == 1)
    
    local a, b, c = table.unpack(t, 1, t.n)
    assert(a == nil and b == 1 and c == nil)
end

local function vararg_expression_with_nil_test()
    local function f(...) return select("#", ...) end
    assert(f(nil, nil) == 2)
    assert(f() == 0)
    assert(f(nil) == 1)
end

local function forwarding_varargs_test()
    local function g(...) return ... end
    local function f(...) return g(...) end
    local a, b = f(10, 20)
    assert(a == 10 and b == 20)
end

local function varargs_in_closures_test()
    local function create(...)
        local args = {...}
        return function ()
            return table.unpack(args)
        end
    end
    
    local f = create(1, 2, 3)
    local a, b, c = f()
    assert(a == 1 and b == 2 and c == 3)
end

local function vararg_call_chain_test()
    local function id(...) return ... end
    local function passthrough(...) return id(...) end
    local function collect(...) return {...} end
    
    local t = collect(passthrough(1, 2, 3))
    assert(t[1] == 1 and t[2] == 2 and t[3] == 3)
end

local function vararg_with_multiple_returns_test()
    local function retmany() return 1, 2, 3, 4 end
    local function f(a, ...)
        return select("#", ...)
    end
    assert(f(retmany()) == 3)
end

local function vararg_in_table_constructor_test()
    local function f(...) return {...} end
    local t = f(nil, 1, nil, 2)
    assert(#t >= 2)  -- behavior may vary with trailing nils
    assert(t[2] == 1 and t[4] == 2)
end

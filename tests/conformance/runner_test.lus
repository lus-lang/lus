--[[
    The timeouts of `lus test`. Each case runs the runner on fixture files
    in a subprocess and reads its report. A file that writes no output for
    the timeout is stopped, and so is a file that runs longer than the file
    timeout while it writes output. A file whose worker never comes back is
    reported with the time it ran, and any number of such files leave the
    runner able to finish the rest.
]]

pledge("exec", "env=LUS_EXE")

local LUS = os.getenv("LUS_EXE")
local windows = package.config:sub(1, 1) == "\\"
local FIX = TEST_DIR .. "/fixtures/runner/"

-- Runs `lus test` with the given options on fixture files and returns its
-- report and whether it exited with status 0.
local function run_tests(options, ...)
    if LUS == nil then skip("the interpreter is not reachable, set LUS_EXE") end
    local cmd = `"$LUS" test $options`
    for _, name in ipairs({...}) do
        cmd = cmd .. ` "$FIX$name"`
    end
    local f = io.popen(cmd .. " 2>&1")
    local report = f:read("a")
    local ok = f:close()
    return report, ok == true
end

local function file_line(report, name)
    for line in report:gmatch("[^\n]+") do
        if line:find(name, 1, true) and (line:find("^ok") or line:find("^FAIL")) then return line end
    end
end

-- A test that fails closes the coroutines it detached, so one that waits
-- for a message the test never sent cannot stop the file.
local function a_failed_test_closes_its_waiting_coroutines_test()
    local report, ok = run_tests("--timeout 10", "abandoned.lus")
    assert(not ok, report)
    assert(not report:find("timed out", 1, true), report)
    assert(report:find("the test fails before it sends anything", 1, true), report)
    assert(file_line(report, "abandoned.lus"):find("1 passed, 1 failed", 1, true), report)
end

local function a_chatty_file_stops_at_the_file_timeout_test()
    local report, ok = run_tests("--timeout 30 --file-timeout 1", "chatty.lus")
    assert(not ok, report)
    assert(report:find("timed out after running for the file timeout of 1 s", 1, true), report)
    assert(file_line(report, "chatty.lus"):find("^FAIL"), report)
end

local function two_files_left_behind_in_one_pass_test()
    if windows then skip("the fixture detaches a process with POSIX setsid") end
    if not os.execute("command -v perl >/dev/null 2>&1") then skip("needs perl") end
    local report, ok = run_tests("--jobs 2 --timeout 1", "stuck.lus", "stuck2.lus", "waiting.lus")
    assert(not ok, report)
    assert(not report:find("panic", 1, true), report)
    assert(file_line(report, "waiting.lus"):find("^ok"), report)
    for _, name in ipairs({"stuck.lus", "stuck2.lus"}) do
        local line = file_line(report, name)
        assert(line and line:find("^FAIL"), report)
        -- The time reported is the time the file ran before the runner
        -- left it behind.
        local ms = tonumber(line:match("(%d+) ms%)"))
        assert(ms and ms >= 1000, line)
    end
    assert(report:find("left it behind", 1, true), report)
    assert(report:find("3 files, 1 passed", 1, true), report)
end

local function a_skip_reason_keeps_its_characters_test()
    local ok, err = catch skip("réservé pour plus tard")
    assert(not ok)
    assert(err:len() == utf8.len(err))
    assert(err:sub(-5) == " tard")
    assert(err:find("réservé", 1, true))
end

-- In a test file, `assert` becomes a power assert that reports the failing
-- expression, and it still returns every value that the standard assert
-- returns, including the values of a call in the last position.
local function power_assert_returns_every_value_test()
    local function pack(...) return { n = select("#", ...), ... } end
    local function three() return true, 2, 3 end
    local co = coroutine.create(function() return "x", "y" end)
    local r = pack(assert(coroutine.resume(co)))
    local t = pack(assert(three()))
    local a = pack(assert(1, 2, 3))
    local l = pack(assert(true, three()))
    local c = pack(assert(1 == 1, "message", "more"))
    local results = {
        { r.n, 3 }, { r[2], "x" }, { r[3], "y" },
        { t.n, 3 }, { t[3], 3 },
        { a.n, 3 }, { a[3], 3 },
        { l.n, 4 }, { l[4], 3 },
        { c.n, 3 }, { c[1], true }, { c[3], "more" },
    }
    for i, pair in ipairs(results) do
        if pair[1] ~= pair[2] then error(`result $(i): $(tostring(pair[1])) where $(tostring(pair[2])) was expected`, 0) end
    end
    assert(select(2, assert(coroutine.resume(coroutine.create(function() return "only" end)))) == "only")
end

-- A failing call in the last position passes its message to the report.
local function power_assert_takes_the_message_of_a_failing_call_test()
    local function fails() return nil, "the reason" end
    local ok, err = catch assert(fails())
    if ok or not string.find(tostring(err), "the reason", 1, true) then error(tostring(err), 0) end
    ok, err = catch assert(1 > 2, "bigger")
    if ok or not string.find(tostring(err), "bigger", 1, true) then error(tostring(err), 0) end
end


pledge("load")

-- The runner rewrites calls named assert into power asserts, so the tests of
-- the real assert builtin call it through this alias.
local raw_assert = assert


-- ============================================================================
-- Basic syntax and semantics
-- ============================================================================

local function catch_statement_syntax_test()
    local called = false
    catch (function() called = true end)()
    assert(called == true)
end

local function catch_statement_suppresses_error_test()
    catch error("suppressed error")
    assert(true)
end

local function catch_statement_works_with_function_calls_test()
    local x = 0
    local function f() x = 1 return 1, 2 end
    catch f()
    assert(x == 1)
end

local function catch_statement_ignores_return_values_test()
    local calls = 0
    local function f()
        calls = calls + 1
        return 1, 2, 3, 4, 5
    end
    local a, b = 10, 20
    catch f()
    local c = 30
    -- the call must still happen, and the discarded multret values must
    -- not disturb locals living below or allocated after the statement
    assert(calls == 1)
    assert(a == 10 and b == 20 and c == 30)
end

-- ============================================================================
-- Register management (the bug we just fixed)
-- ============================================================================

local function multiple_catch_statements_don_t_leak_registers_test()
    local a = 1
    catch error("1")
    local b = 2
    catch error("2")
    local c = 3
    catch error("3")
    local d = 4
    catch error("4")
    local e = 5
    -- If registers leaked, we'd eventually run out or corrupt values
    assert(a == 1 and b == 2 and c == 3 and d == 4 and e == 5)
end

local function catch_in_loop_doesn_t_accumulate_registers_test()
    local sum = 0
    for i = 1, 100 do
        catch error("error " .. i)
        sum = sum + i
    end
    assert(sum == 5050)
end

local function variables_after_catch_are_correctly_allocated_test()
    catch error("test")
    local x = 10
    local y = 20
    local z = 30
    assert(x + y + z == 60)
end

-- ============================================================================
-- Different expression types
-- ============================================================================

local function catch_with_arithmetic_expression_test()
    catch (1 + 2 + 3)
    assert(true)
end

local function catch_with_string_concatenation_test()
    catch ("hello" .. " " .. "world")
    assert(true)
end

local function catch_with_table_constructor_test()
    catch ({1, 2, 3, key = "value"})
    assert(true)
end

local function catch_with_function_definition_test()
    catch (function() return 42 end)
    assert(true)
end

local function catch_with_nil_expression_test()
    catch nil
    assert(true)
end

local function catch_with_boolean_expressions_test()
    catch (true and false)
    catch (true or false)
    catch (not true)
    assert(true)
end

-- ============================================================================
-- Error suppression
-- ============================================================================

local function catch_suppresses_nil_arithmetic_test()
    local x = nil
    catch (x + 1)
    assert(true)
end

local function catch_suppresses_nil_indexing_test()
    local x = nil
    catch (x.foo)
    assert(true)
end

local function catch_suppresses_nil_call_test()
    local x = nil
    catch x()
    assert(true)
end

local function catch_suppresses_explicit_error_test()
    local reached_error = false
    local after_error = false
    catch (function()
        reached_error = true
        error("this should be suppressed")
        after_error = true
    end)()
    assert(reached_error, "the body must run up to the error() call")
    assert(not after_error, "error() must abort the body immediately")
end

local function catch_suppresses_assert_failure_test()
    catch raw_assert(false, "assertion failed")
    assert(true)
end

local function catch_suppresses_division_by_zero_for_integers_test()
    -- Note: Lua float division by zero returns inf, not error
    -- But integer floor division does error
    catch (1 // 0)
    assert(true)
end

-- ============================================================================
-- Side effects
-- ============================================================================

local function side_effects_happen_before_error_test()
    local effects = {}
    local function effect(n)
        table.insert(effects, n)
        return n
    end
    
    local function failing()
        effect(1)
        effect(2)
        error("fail")
        effect(3)  -- This should not execute
    end
    
    catch failing()
    
    assert(#effects == 2)
    assert(effects[1] == 1)
    assert(effects[2] == 2)
end

local function function_call_side_effects_execute_test()
    local counter = 0
    local function increment()
        counter = counter + 1
        return counter
    end
    
    catch increment()
    catch increment()
    catch increment()
    
    assert(counter == 3)
end

-- ============================================================================
-- Nested and complex scenarios
-- ============================================================================

local function nested_catch_statements_test()
    local outer_ran = false
    local inner_ran = false
    
    catch (function()
        outer_ran = true
        catch error("inner error")
        inner_ran = true
    end)()
    
    assert(outer_ran)
    assert(inner_ran)
end

local function catch_in_if_statement_test()
    local x = true
    if x then
        catch error("in if")
    end
    assert(true)
end

local function catch_in_else_branch_test()
    local x = false
    if x then
        assert(false)
    else
        catch error("in else")
    end
    assert(true)
end

local function catch_in_while_loop_test()
    local count = 0
    while count < 3 do
        catch error("in while")
        count = count + 1
    end
    assert(count == 3)
end

local function catch_in_repeat_until_test()
    local count = 0
    repeat
        catch error("in repeat")
        count = count + 1
    until count >= 3
    assert(count == 3)
end

local function catch_in_function_body_test()
    local function f()
        catch error("in function")
        return 42
    end
    assert(f() == 42)
end

local function catch_before_return_test()
    local function f()
        catch error("before return")
        return "success"
    end
    assert(f() == "success")
end

-- ============================================================================
-- Method calls and metatables
-- ============================================================================

local function catch_with_method_call_test()
    local obj = {
        method = function(self) return self.value end,
        value = 42
    }
    catch obj:method()
    assert(true)
end

local function catch_with_failing_method_test()
    local obj = {
        method = function(self) error("method error") end
    }
    catch obj:method()
    assert(true)
end

local function catch_with_call_metamethod_test()
    local mt = {
        __call = function(t, ...) return "called" end
    }
    local obj = setmetatable({}, mt)
    catch obj()
    assert(true)
end

local function catch_with_failing_call_test()
    local mt = {
        __call = function(t, ...) error("__call error") end
    }
    local obj = setmetatable({}, mt)
    catch obj()
    assert(true)
end

local function catch_with_index_error_test()
    local mt = {
        __index = function(t, k) error("__index error") end
    }
    local obj = setmetatable({}, mt)
    catch (obj.foo)
    assert(true)
end

local function catch_with_newindex_error_test()
    local mt = {
        __newindex = function(t, k, v) error("__newindex error") end
    }
    local obj = setmetatable({}, mt)
    catch (function() obj.foo = 1 end)()
    assert(true)
end

-- ============================================================================
-- Varargs and multiple returns
-- ============================================================================

local function catch_with_vararg_function_test()
    local function varfunc(...)
        return select("#", ...), ...
    end
    catch varfunc(1, 2, 3, 4, 5)
    assert(true)
end

local function catch_with_multiple_return_function_test()
    local function multi()
        return 1, 2, 3, 4, 5
    end
    catch multi()
    assert(true)
end

local function catch_with_table_unpack_test()
    local t = {1, 2, 3, 4, 5}
    catch table.unpack(t)
    assert(true)
end

-- ============================================================================
-- Edge cases
-- ============================================================================

local function catch_with_empty_function_call_test()
    local function empty() end
    catch empty()
    assert(true)
end

local function catch_followed_by_assignment_test()
    catch error("test")
    local x = 10
    assert(x == 10)
end

local function catch_as_only_statement_in_block_test()
    do
        catch error("only statement")
    end
    assert(true)
end

local function multiple_catches_on_same_line_semicolon_separated_test()
    catch error("1"); catch error("2"); catch error("3")
    assert(true)
end

local function catch_with_complex_expression_test()
    local t = {a = {b = {c = function() return 42 end}}}
    catch t.a.b.c()
    assert(true)
end

local function catch_with_chained_method_calls_test()
    local obj = {
        value = 0,
        add = function(self, n) self.value = self.value + n; return self end,
        mul = function(self, n) self.value = self.value * n; return self end,
    }
    catch obj:add(5):mul(2):add(3)
    assert(obj.value == 13)
end

-- ============================================================================
-- Interaction with catch expression
-- ============================================================================

local function catch_statement_followed_by_catch_expression_test()
    catch error("statement")
    local ok, err = catch error("expression")
    assert(ok == false)
    assert(type(err) == "string")
end

local function catch_statement_inside_catch_expression_handler_test()
    local function handler()
        catch error("inner statement")
        error("outer error")
    end
    local ok = catch handler()
    assert(ok == false)
end

-- ============================================================================
-- Multi-value catch expressions
-- ============================================================================

local function catch_expression_returns_ok_and_value_test()
    local ok, val = catch 42
    assert(ok == true)
    assert(val == 42)
end

local function catch_expression_returns_false_and_error_on_failure_test()
    -- a failing catch must yield exactly two values: false plus the error
    local results = { catch error("msg") }
    assert(#results == 2)
    assert(results[1] == false)
    assert(type(results[2]) == "string")
end

local function catch_expression_with_successful_function_call_test()
    local function f() return "hello" end
    local ok, val = catch f()
    assert(ok == true)
    assert(val == "hello")
end

local function catch_expression_with_multiple_return_values_test()
    local function multi() return 1, 2, 3 end
    local ok, a, b, c = catch multi()
    assert(ok == true)
    assert(a == 1)
    assert(b == 2)
    assert(c == 3)
end

local function catch_expression_with_error_returns_error_message_test()
    local ok, err = catch error("specific error")
    assert(ok == false)
    assert(string.find(tostring(err), "specific error"))
end

local function catch_expression_with_nil_return_test()
    local function f() return nil end
    local ok, val = catch f()
    assert(ok == true)
    assert(val == nil)
end

local function catch_expression_with_table_error_test()
    local ok, err = catch error({code = 404, msg = "not found"})
    assert(ok == false)
    -- catch delivers the error object exactly as raised
    assert(type(err) == "table")
    assert(err.code == 404 and err.msg == "not found")
end

local function nested_catch_expressions_test()
    local ok1, val1 = catch (function()
        local ok2, val2 = catch error("inner")
        assert(ok2 == false)
        return "outer"
    end)()
    assert(ok1 == true)
    assert(val1 == "outer")
end

local function catch_expression_error_handler_test()
    local ok, val = catch[function(e) return "handled: " .. tostring(e) end] error("oops")
    assert(ok == false)
    assert(string.find(val, "handled:"))
end

-- Regression: catching an error thrown from a C function that grew a
-- luaL_Buffer (registered as a to-be-closed box) must close that box, or the
-- dangling tbc entry corrupts later operations (globals would read as nil).
local function catch_of_a_large_buffer_c_error_does_not_corrupt_state_test()
    local t = {}
    for i = 1, 100000 do t[i] = "abcdefghij" end
    t[100001] = {} -- non-string: table.concat errors after a big buffer
    local ok = catch(table.concat(t))
    assert(ok == false)
    -- if the tbc box was left dangling, this print/assert path would break:
    assert(type(print) == "function")
    assert(#t == 100001)
end

-- ============================================================================
-- Stress: catch machinery under stack reallocation, coroutines, C boundaries
-- ============================================================================

local function catch_inside_deep_recursion_with_stack_growth_test()
    local function deep(n)
        if n == 0 then
            local ok = catch error("bottom")
            assert(ok == false)
            return 1
        end
        return deep(n - 1) + 1
    end
    assert(deep(3000) == 3001)
end

local function deeply_nested_active_catch_frames_test()
    local function grow(n)
        local ok = catch (function()
            if n > 0 then
                grow(n - 1)
            else
                error("deep boom")
            end
        end)()
        if n == 0 then
            assert(ok == false)
        end
        return n
    end
    grow(500)
end

local function catch_across_coroutine_boundaries_test()
    local co = coroutine.create(function()
        local ok, err = catch error("inside coroutine")
        assert(ok == false and tostring(err):find("inside coroutine") ~= nil)
        coroutine.yield("caught")
        local ok2 = catch error("second")
        assert(ok2 == false)
        return "done"
    end)
    local succ, val = coroutine.resume(co)
    assert(succ and val == "caught")
    succ, val = coroutine.resume(co)
    assert(succ and val == "done")
end

-- Regression (1.6.2): errors unwinding across a C-call boundary used to leak
-- the interpreter's C-call counter, and enough repetitions then produced a bogus
-- "C stack overflow".
local function repeated_errors_across_c_boundaries_keep_nccalls_balanced_test()
    for i = 1, 200 do
        local ok = catch table.sort({3, 1, 2}, function() error("cmp") end)
        assert(ok == false)
    end
    local t = {3, 1, 2}
    table.sort(t)
    assert(t[1] == 1 and t[2] == 2 and t[3] == 3)
end

-- Regression: luaD_pcall did not suspend the active Lua catch block, so an
-- error inside a C function's internal protected call (load, debug.parse,
-- lua_pcall from C) was intercepted by an enclosing 'catch' statement --
-- bypassing the C-level protection, breaking those functions' documented
-- return values, and leaking their internal resources.
local function load_reports_errors_normally_inside_a_catch_block_test()
    local ok = catch (function()
        local f, err = load("local x = ((")
        assert(f == nil)
        assert(type(err) == "string")
    end)()
    assert(ok == true)
end

local function debug_parse_reports_errors_normally_inside_a_catch_block_test()
    local ok = catch (function()
        local ast, err = debug.parse("local x = ((", "bad", {recover = false})
        assert(ast == nil)
        assert(type(err) == "string")
    end)()
    assert(ok == true)
end

-- Regression: to-be-closed variables in a catch body must be closed when the
-- body errors and the error is caught.
local function to_be_closed_variables_are_closed_on_caught_error_test()
    local closed = false
    local function mk()
        return setmetatable({}, {__close = function() closed = true end})
    end
    local ok = catch((function()
        local x <close> = mk()
        error("boom")
    end)())
    assert(ok == false)
    assert(closed == true)
end


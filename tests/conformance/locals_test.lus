pledge("load")

-- ===== locals =====
local _debug = require "debug"

local function func2close(f, x, y)
    local obj = setmetatable({}, { __close = f })

    if x then
        return x, obj, y
    else
        return obj
    end
end

-- local variables scope
local function local_variables_scope_test()
    local i = 10

    do
        local i = 100  -- lus: allow(shadowed-local)
        assert(i == 100)
    end

    do
        local i = 1000  -- lus: allow(shadowed-local)
        assert(i == 1000)
    end

    assert(i == 10)

    if i ~= 10 then
        local _i = 20
    else
        local i = 30  -- lus: allow(shadowed-local)
        assert(i == 30)
    end
end

-- function with locals
local function function_with_locals_test()
    local function f(a)
        local x = 3
        local b = a
        local _c, d = a, b

        if (d == b) then
            local x = "q"  -- lus: allow(shadowed-local)
            x = b
            assert(x == 2)
        end

        assert(x == 3)
    end

    f(2)
end

-- lexical environment _ENV
local function lexical_environment_env_test()
    assert(_ENV == _G)
    local c = {}
    local f = load("a = 3", nil, nil, c)
    assert(c.a == nil)
    f()
    assert(c.a == 3)
end

-- local constants
local function local_constants_test()
    local a <const> = 10
    assert(a == 10)

    -- const variables maintain their value
    local b <const>, c = 20, 30
    assert(b == 20 and c == 30)
    c = 40  -- c is not const
    assert(c == 40)
    assert(b == 20)  -- b still const
end

-- to-be-closed variables basic
local function to_be_closed_variables_basic_test()
    local closed = false

    local function test()
        local x <close> = setmetatable({}, {
            __close = function()
                closed = true
            end,
        })
    end

    test()
    assert(closed)
end

-- to-be-closed order
local function to_be_closed_order_test()
    local a = {}

    do
        local b <close> = false  -- not to be closed

        local x <close> = setmetatable({ "x" }, {
            __close = function(self)
                a[#a + 1] = self[1]
            end,
        })

        local w, y <close>, z = func2close(function(self, err)
            assert(err == nil)
            a[#a + 1] = "y"
        end, 10, 20)

        local c <close> = nil  -- not to be closed
        a[#a + 1] = "in"
        assert(w == 10 and z == 20)
    end

    a[#a + 1] = "out"
    assert(a[1] == "in" and a[2] == "y" and a[3] == "x" and a[4] == "out")
end

-- to-be-closed with return
local function to_be_closed_with_return_test()
    local X = false

    local x, closescope = func2close(function(_, msg)
        assert(msg == nil)
        X = true
    end, 100)

    assert(x == 100)

    local function foo(x)  -- lus: allow(shadowed-local)
        local _ <close> = closescope
        return x, X, 23
    end

    local a, b, c = foo(1.5)
    assert(a == 1.5 and b == false and c == 23 and X == true)
end

-- to-be-closed x compile-time constants
local function to_be_closed_x_compile_time_constants_test()
    local flag = false

    local x = setmetatable({}, {
        __close = function()
            assert(flag == false)
            flag = true
        end,
    })

    local y <const> = nil  -- lus: allow(unused-local)
    local z <const> = nil  -- lus: allow(unused-local)

    do
        local a <close> = x
    end

    assert(flag)  -- 'x' must be closed here
end

-- tbc inside close methods
local function tbc_inside_close_methods_test()
    local track = {}

    local function foo()
        local x <close> = func2close(function()
            local xx <close> = func2close(function(_, msg)
                assert(msg == nil)
                track[#track + 1] = "xx"
            end)

            track[#track + 1] = "x"
        end)

        track[#track + 1] = "foo"
        return 20, 30, 40
    end

    local a, b, c, d = foo()
    assert(a == 20 and b == 30 and c == 40 and d == nil)
    assert(track[1] == "foo" and track[2] == "x" and track[3] == "xx")
end

-- errors in __close - original
local function errors_in_close_original_test()
    local function foo()
        local z <close> = func2close(function(self, msg)
            assert(msg == nil)
            error("@z")
        end)

        return 200
    end

    local stat, msg = catch foo()
    assert(not stat and string.find(msg, "@z"))
end

-- non-closable value error
local function non_closable_value_error_test()
    local function foo()
        local x <close> = {}
        return 1
    end

    local stat, msg = catch foo()
    assert(not stat and string.find(msg, "non%-closable"))
end

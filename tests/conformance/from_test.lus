pledge("load")

-- Global declarations make every other free name an error in their scope, so
-- the names the tests use are declared once here.
global print, setmetatable, assert, type, os, pledge, load, string, table, ipairs, pairs, tostring,
    tonumber, select

-- ===== from =====
--[[
    Test suite for the 'from' table deconstruction feature in Lus.

    Syntax:
    - local a, b, c from t   -- equivalent to: local a, b, c = t.a, t.b, t.c
    - global a, b, c from t  -- equivalent to: global a, b, c = t.a, t.b, t.c
    - a, b, c from t         -- equivalent to: a, b, c = t.a, t.b, t.c
]]

-- local from basic
local function local_from_basic_test()
    local t = { a = 1, b = 2, c = 3 }
    local a, b, c from t
    assert(a == 1 and b == 2 and c == 3)
end

-- local from single variable
local function local_from_single_variable_test()
    local t = { x = 10 }
    local x from t
    assert(x == 10)
end

-- local from mixed types
local function local_from_mixed_types_test()
    local t = { name = "test", value = 42, flag = true }
    local name, value, flag from t
    assert(name == "test" and value == 42 and flag == true)
end

-- local from with nil value
local function local_from_with_nil_value_test()
    local t = { a = nil, b = 2 }
    local a, b from t
    assert(a == nil and b == 2)
end

-- local from empty table
local function local_from_empty_table_test()
    local t = {}
    local x, y, z from t
    assert(x == nil and y == nil and z == nil)
end

-- local from nested table
local function local_from_nested_table_test()
    local t = { data = { inner = 1 }, count = 5 }
    local data, count from t
    assert(type(data) == "table" and data.inner == 1 and count == 5)
end

-- local from with function value
local function local_from_with_function_value_test()
    local t = {
        fn = function()
            return 42
        end,
    }

    local fn from t
    assert(type(fn) == "function" and fn() == 42)
end

-- local from function call
local function local_from_function_call_test()
    local function getTable()
        return { a = 100, b = 200 }
    end

    local a, b from getTable()
    assert(a == 100 and b == 200)
end

-- local from conditional expression
local function local_from_conditional_expression_test()
    local t1 = { x = 1 }
    local t2 = { x = 2 }
    local condition = true
    local x from (condition and t1 or t2)
    assert(x == 1)
end

-- local from nested field access
local function local_from_nested_field_access_test()
    local outer = { inner = { deep = 42 } }
    local deep from outer.inner
    assert(deep == 42)
end

-- global from basic
local function global_from_basic_test()
    local t = { gd = 4, ge = 5, gf = 6 }
    global gd, ge, gf from t
    assert(gd == 4 and ge == 5 and gf == 6)
end

-- global from single variable
local function global_from_single_variable_test()
    local t = { gsingle = 99 }
    global gsingle from t
    assert(gsingle == 99)
end

-- global from mixed types
local function global_from_mixed_types_test()
    local t = { gmixed = "hello", gnum = 3.14 }
    global gmixed, gnum from t
    assert(gmixed == "hello" and gnum == 3.14)
end

-- bare assignment from to locals
local function bare_assignment_from_to_locals_test()
    local t = { x = 10, y = 20 }
    local x, y
    x, y from t
    assert(x == 10 and y == 20)
end

-- bare assignment from multiple locals
local function bare_assignment_from_multiple_locals_test()
    local t = { ba = 1, bb = 2, bc = 3 }
    local ba, bb, bc
    ba, bb, bc from t
    assert(ba == 1 and bb == 2 and bc == 3)
end

-- bare assignment from single local
local function bare_assignment_from_single_local_test()
    local t = { val = 42 }
    local val = 0
    val from t
    assert(val == 42)
end

-- reassignment with missing field sets nil
local function reassignment_with_missing_field_sets_nil_test()
    local t1 = { x = 1, y = 2 }
    local t2 = { x = 10 }
    local x, y from t1
    x, y from t2
    assert(x == 10)
    assert(y == nil, "from is not a merge, a missing field overwrites with nil")
end

-- reassignment from t2
local function reassignment_from_t2_test()
    local t1 = { x = 1, y = 2 }
    local t2 = { x = 10, y = 20 }
    local x, y from t1
    x, y from t2
    assert(x == 10 and y == 20)
end

-- from ignores array part
local function from_ignores_array_part_test()
    local t = { [1] = "array", a = "hash" }
    local a from t
    assert(a == "hash")
end

-- from copies values, not references
local function from_copies_values_not_references_test()
    local t = { v = 1 }
    local v from t
    t.v = 99
    assert(v == 1, "v holds the value read when from executed")
end

-- from with 5 variables
local function from_with_5_variables_test()
    local t = { a = 1, b = 2, c = 3, d = 4, e = 5 }
    local a, b, c, d, e from t
    assert(a == 1 and b == 2 and c == 3 and d == 4 and e == 5)
end

-- table expression evaluated once
local function table_expression_evaluated_once_test()
    local call_count = 0

    local function getTable()
        call_count = call_count + 1
        return { a = call_count, b = call_count }
    end

    local a, b from getTable()
    assert(call_count == 1 and a == 1 and b == 1)
end

-- from with indexed source expression
local function from_with_indexed_source_expression_test()
    local list = { { x = 1 }, { x = 2 } }
    local x from list[2]
    assert(x == 2)
end

-- from inside if block
local function from_inside_if_block_test()
    local t = { success = true, value = 100 }
    local result

    if s = t.success then
        local value from t
        result = value
    end

    assert(result == 100)
end

-- from inside caught function
local function from_inside_caught_function_test()
    local t = { a = 1 }

    local ok, err = catch (function()
        local a from t
        return a
    end)()

    assert(ok == true and err == 1)
end

-- inner scope shadows outer
local function inner_scope_shadows_outer_test()
    local _a = 999

    do
        local t = { a = 1 }
        local a from t
        assert(a == 1)
    end
end

-- outer scope unchanged
local function outer_scope_unchanged_test()
    local a = 999

    do
        local t = { a = 1 }
        local _a from t
    end

    assert(a == 999)
end

-- from followed by regular assignment
local function from_followed_by_regular_assignment_test()
    local t = { a = 1, b = 2 }
    local a, b from t
    local c = 3
    assert(a == 1 and b == 2 and c == 3)
end

-- regular assignment then from
local function regular_assignment_then_from_test()
    local t = { x = 10, y = 20 }
    local z = 30
    local x, y from t
    assert(x == 10 and y == 20 and z == 30)
end

-- from + group tests

-- local from group source
local function local_from_group_source_test()
    local p <group> = { x = 10, y = 20, z = 30 }
    local x, y from p
    assert(x == 10 and y == 20)
end

-- local from group single field
local function local_from_group_single_field_test()
    local cfg <group> = { host = "localhost", port = 8080 }
    local host from cfg
    assert(host == "localhost")
end

-- local from group all fields
local function local_from_group_all_fields_test()
    local p <group> = { a = 1, b = 2, c = 3 }
    local a, b, c from p
    assert(a == 1 and b == 2 and c == 3)
end

-- bare assignment from group
local function bare_assignment_from_group_test()
    local g <group> = { x = 100, y = 200 }
    local x, y = 0, 0
    x, y from g
    assert(x == 100 and y == 200)
end

-- if-from with group source
local function if_from_with_group_source_test()
    local p <group> = { ok = true, value = 42 }

    if ok, value from p then
        assert(ok == true)
        assert(value == 42)
    end
end

-- local from group field mutation independent
local function local_from_group_field_mutation_independent_test()
    local p <group> = { x = 10, y = 20 }
    local x from p
    p.x = 999
    assert(x == 10)  -- x was copied, not aliased
end

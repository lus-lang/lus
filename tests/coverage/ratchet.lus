-- Compares a coverage report with the baseline of the code that every
-- program runs, and fails when a group falls more than the margin below
-- its baseline. With --write it stores the report as the new baseline.
--
-- Usage: lus ratchet.lus REPORT BASELINE [--write]

global arg, assert, io, ipairs, os, pledge, print, string, table, tonumber

pledge("fs")

local MARGIN = 0.2

local function readFile(path)
    local f = io.open(path, "r")

    if not f then
        return nil
    end

    local s = f:read("a")
    f:close()
    return s
end

-- The groups of the section "code that every program runs", in order.
local function groupsOf(report)
    local out = {}
    local inside = false

    for line in report:gmatch("[^\n]*") do
        if line:find("^code that every program runs:") then
            inside = true
        elseif inside then
            if name, pct = line:match("^  (%S.-)%s+(%d+%.%d)%%") then
                out[#out + 1] = { name = name, pct = tonumber(pct) }
            elseif line ~= "" then
                break
            end
        end
    end

    return out
end

local reportPath, basePath, mode = arg[1], arg[2], arg[3]
assert(reportPath and basePath, "usage: lus ratchet.lus REPORT BASELINE [--write]")
local report = assert(readFile(reportPath), "cannot read " .. reportPath)
local groups = groupsOf(report)
assert(#groups > 0, "the report has no groups")

if mode == "--write" then
    local lines = {
        "# The share of branches covered in each group of the code that every",
        "# program runs. `mise run coverage:ratchet` writes this file.",
        "",
    }

    for _, g in ipairs(groups) do
        lines[#lines + 1] = string.format("%s %.1f", g.name, g.pct)
    end

    local f = assert(io.open(basePath, "w"))
    f:write(table.concat(lines, "\n"), "\n")
    f:close()
    print("wrote " .. basePath)
    os.exit(0)
end

local base = {}

for line in (assert(readFile(basePath), "cannot read " .. basePath)):gmatch("[^\n]+") do
    if name, pct = line:match("^([^#].-)%s+(%d+%.%d)$") then
        base[name] = tonumber(pct)
    end
end

local failed = false

for _, g in ipairs(groups) do
    local b = base[g.name]

    if not b then
        print(string.format("%-10s %5.1f%%  no baseline", g.name, g.pct))
    elseif g.pct < b - MARGIN then
        print(string.format("%-10s %5.1f%%  below the baseline of %.1f%%", g.name, g.pct, b))
        failed = true
    else
        print(string.format("%-10s %5.1f%%  baseline %.1f%%", g.name, g.pct, b))
    end
end

if failed then
    print(
        "coverage fell below the baseline: cover the new code, or explain the drop in a commit that lowers tests/coverage/baseline.txt"
    )
    os.exit(1)
end

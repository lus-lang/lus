-- An HTTP server on `network.serve`, with keep-alive connections that
-- each run in a detached coroutine.
--
-- With a port argument it serves until it is stopped, which is how an
-- external load generator measures it:
--
--     lus tests/bench/http_serve.lus 8080
--     oha -z 10s -c 64 --no-tui http://127.0.0.1:8080/
--
-- `http_serve.js` is the same server on the `http` module of Node.
--
-- Without an argument it binds a free port and drives itself: 64 client
-- coroutines send 100,000 requests in total over loopback, and the
-- program ends when every response has arrived. The benchmark runner
-- times that form.

pledge("network")

local headers = { ["Content-Type"] = "text/plain" }

local function handler(req)
    return 200, "Hello, World!\n", headers
end

local port = tonumber(arg and arg[1])
if port then
    network.serve("127.0.0.1", port, handler)
    return
end

local clients <const> = 64
local requests <const> = 100000

local server = network.tcp.bind("127.0.0.1", 0)
local _, bound = server:getsockname()
local serving = coroutine.detach(coroutine.create(network.serve), server, handler)

local request <const> = "GET / HTTP/1.1\r\nHost: 127.0.0.1\r\nAccept: */*\r\n\r\n"

local function client(count)
    local sock <close> = network.tcp.connect("127.0.0.1", bound)
    for i = 1, count do
        sock:send(request)
        local length = 0
        while true do
            local line = vector.tostring(sock:receive("*l"))
            if line == "" then
                break
            end
            local n = line:match("^[Cc]ontent%-[Ll]ength: (%d+)")
            if n then
                length = tonumber(n)
            end
        end
        if length > 0 then
            sock:receive(length)
        end
    end
end

local running = {}
for i = 1, clients do
    running[i] = coroutine.detach(coroutine.create(client), requests // clients)
end
for i = 1, clients do
    assert(coroutine.resume(running[i]))
end
coroutine.close(serving)
server:close()

-- Measures assignments to an observed source without dependents and with
-- one dependent, and reads of an observed variable, against an ordinary
-- local. Run directly, the program prints the time of each case
-- (spec/design/observe.md).
local N = 5000000

local function plain_writes()
    local x = 0
    for i = 1, N do x = i end
    return x
end

local function source_writes()
    local x <observe> = 0
    for i = 1, N do x = i end
    return x
end

local function dependent_writes()
    local x <observe> = 0
    local y <observe> = x + 1
    for i = 1, N // 10 do x = i end
    return y
end

local function plain_reads()
    local x = 3
    local s = 0
    for i = 1, N do s = s + x end
    return s
end

local function observed_reads()
    local x <observe> = 3
    local y <observe> = x + 1
    local s = 0
    for i = 1, N do s = s + y end
    return s
end

local function time(f)
    local best = math.huge
    for _ = 1, 3 do
        local t0 = os.clock()
        f()
        best = math.min(best, os.clock() - t0)
    end
    return best
end

local p, o = time(plain_writes), time(source_writes)
print(string.format("%-34s plain %.3f s  observed %.3f s", "write, no dependent", p, o))
print(string.format("%-34s %.0f ns per write", "write, one dependent", time(dependent_writes) / (N // 10) * 1e9))
local pr, orr = time(plain_reads), time(observed_reads)
print(string.format("%-34s plain %.3f s  observed %.3f s", "read", pr, orr))

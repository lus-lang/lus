-- Resume and yield round trips through plain coroutines, against a plain
-- call. Prints nanoseconds per round trip. Usage: lus roundtrip.lus [n]
local n = tonumber(arg and arg[1]) or 5000000
local function best(f)
    local b = math.huge
    for _ = 1, 5 do
        local t0 = os.clock()
        f()
        local dt = os.clock() - t0
        if dt < b then
            b = dt
        end
    end
    return b * 1000000000.0 / n
end

local resume, yield from coroutine

local plain = best(function()
    local co = coroutine.create(function(x)
        while true do
            x = yield(x + 1)
        end
    end)
    local s = 0
    for i = 1, n do
        local _, v = resume(co, i)
        s = s + v
    end
    assert(s > 0)
end)

local wrapped = best(function()
    local f = coroutine.wrap(function(x)
        while true do
            x = yield(x + 1)
        end
    end)
    local s = 0
    for i = 1, n do
        s = s + f(i)
    end
    assert(s > 0)
end)

local forin = best(function()
    local s = 0
    for v in coroutine.wrap(function()
        for i = 1, n do
            yield(i)
        end
    end) do
        s = s + v
    end
    assert(s > 0)
end)

local call = best(function()
    local f = function(x)
        return x + 1
    end
    local s = 0
    for i = 1, n do
        s = s + f(i)
    end
    assert(s > 0)
end)

print(string.format("resume %.1f ns  wrap %.1f ns  for-in-wrap %.1f ns  plain-call %.1f ns", plain, wrapped, forin, call))

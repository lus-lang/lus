-- Creates 2,000 workers with an empty body one after the other and waits
-- for each to finish. Every worker starts a state of its own and opens
-- the standard library, so this measures how fast a state starts.
pledge("load", "fs:read")
local dir = arg[0]:match("^(.*)/") or "."

for i = 1, tonumber(arg[1]) or 2000 do
    local w = worker.create(dir .. "/workers/empty.lus")

    while worker.receive(w) ~= nil do
    end
end

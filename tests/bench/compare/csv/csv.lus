-- csv: generate CSV text, parse it with fromcsv, and aggregate per region.

local N = tonumber(arg and arg[1]) or 2000000

local state = 42

local function rand(n)
    state = (state * 48271) % 2147483647
    return state % n
end

local REGIONS = { "north", "south", "east", "west", "central", "coastal", "mountain", "island" }
local WORDS = { "fragile", "gift", "urgent", "bulk", "sample" }

local function generate(n)
    local parts = { "id,region,product,quantity,price_cents,note\n" }

    for id = 1, n do
        local region = REGIONS[rand(8) + 1]
        local product = rand(200)
        local quantity = rand(20) + 1
        local price = rand(100000)
        local k = rand(10)
        local note

        if k == 0 then
            note = '"big, ""rush"" order"'
        elseif k < 4 then
            note = ""
        else
            note = WORDS[rand(5) + 1]
        end

        parts[#parts + 1] = `$id,$region,p$product,$quantity,$price,$note\n`
    end

    return table.concat(parts)
end

local rows = fromcsv(generate(N))

local stats = {}

for i = 1, #REGIONS do
    stats[REGIONS[i]] = { 0, 0, 0, 0 }
end

local commas = 0

for i = 2, #rows do
    local r = rows[i]
    local st = stats[r[2]]
    local q = tonumber(r[4])
    local p = tonumber(r[5])
    st[1] = st[1] + 1
    st[2] = st[2] + q
    st[3] = st[3] + q * p

    if p > st[4] then
        st[4] = p
    end

    if string.find(r[6], ",", 1, true) then
        commas = commas + 1
    end
end

local out = { "csv" }

for i = 1, #REGIONS do
    local st = stats[REGIONS[i]]
    out[#out + 1] = `$(st[1]) $(st[2]) $(st[3] % 1000000007) $(st[4])`
end

out[#out + 1] = tostring(commas)
print(table.concat(out, " "))

-- HTTP server benchmark: answers GET / with a small JSON document.
-- It runs on network.serve from the standard library, which gives every
-- keep-alive connection a detached coroutine that the runtime resumes
-- whenever its socket is ready.
pledge("network")

local port = tonumber(arg[1]) or 8080

local json_headers = { ["Content-Type"] = "application/json" }
local text_headers = { ["Content-Type"] = "text/plain" }
local counter = 0

network.serve("127.0.0.1", port, function(req)
    if req.method == "GET" and req.path == "/" then
        counter = counter + 1
        return 200, tojson({ message = "hello", n = counter }), json_headers
    end

    return 404, "not found\n", text_headers
end)

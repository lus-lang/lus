--- These programs run outside mise run test, which could prove a rewrite
--- of their concatenations, so they stay as written.
--- lus: allow(use-interpolation)

-- Network faults (`LUS_FAIL_NET`, `runtime/src/vm/faultio.zig`) for
-- programs that talk to peers on the loopback interface.
--
-- Each scenario runs a server in a detached coroutine and a client in the
-- main chunk. The scenarios cover `network.fetch` against `network.serve`,
-- a peer that trickles its response one byte at a time and ends the body
-- by closing, a TCP exchange of lines, and an HTTPS request to a peer that
-- speaks plain HTTP, whose handshake fails. For every kind of fault and
-- every step N of that kind, the checker asserts that the run ends within
-- its time limit, so no coroutine is left waiting, that every error the
-- client saw is one the manual lists, that a fresh request after the
-- fault succeeds, and that no socket is open when the process exits.
--
-- Usage: lus network.lus [--lus BIN] [--timeout SECONDS]
--
-- BIN is a runtime built with `-Dfail-io=true`.

global arg, assert, error, fs, io, ipairs, math, os, package, pledge, print, string, table,
    tonumber, tostring

pledge("exec", "fs", "env")

local opts = { lus = "runtime/zig-out-io/bin/lus", timeout = 40 }

do
    local i = 1

    while i <= #arg do
        local a, v = arg[i], arg[i + 1]

        if a == "--lus" then
            opts.lus = v
        elseif a == "--timeout" then
            opts.timeout = tonumber(v)
        else
            error("unknown option " .. a)
        end

        i = i + 2
    end
end

if package.config:sub(1, 1) == "\\" then
    print("the scenarios use perl for their time limit, so they skip Windows")
    os.exit(0)
end

-- The messages that the manual and the reference list for a failed
-- request or socket operation. Each is a pattern for a whole message.
local LISTED = {
    "^cannot resolve '[^']+': Domain name not found$",
    "^cannot connect to [^ ]+: Connection refused$",
    "^failed to send request: [%a ]+$",
    "^failed to read response: [%a ]+$",
    "^failed to read response headers: [%a ]+$",
    "^failed to read response body: [%a ]+$",
    "^truncated response body$",
    "^TLS handshake failed: [^\n]+$",
    "^certificate verification failed for [^:]+: [^\n]+$",
    "^receive: TLS: [^\n]+$",
    "^send: TLS: [^\n]+$",
    "^failed to [%a ]+: TLS: [^\n]+$",
    "^failed to [%a ]+: Connection closed by peer$",
    "^receive: Connection reset by peer$",
    "^send: Connection reset by peer$",
    -- A send after the peer reset the connection gets the message of
    -- EPIPE, under the code "reset" of the reference.
    "^send: Broken pipe$",
    -- The message of the tcp scenario itself for an end of the stream,
    -- which `receive` reports with an empty vector.
    "^the peer ended the connection$",
}

-- Shared by every scenario: a server on a free port of the loopback
-- interface, and a report of what the client saw. `report(name, ok, v)`
-- prints "ok NAME" or "error NAME: MESSAGE", with the position of a
-- raised string removed. The error objects of the network library carry
-- no position.
local PRELUDE = [[
pledge("network", "fs:read")
local function report(name, ok, v)
    if ok then
        print("ok " .. name)
    else
        -- An error object carries no position. A raised string does.
        -- Only the position of a raised error goes, a chunk name that ends
        -- in .lus and a line number, so a message such as "cannot connect to
        -- 127.0.0.1:N: REASON" keeps its own colons.
        local msg = type(v) == "table" and tostring(v) or tostring(v):gsub("^[^:]*%.lus:%d+: ", "")
        print("error " .. name .. ": " .. msg)
    end
end
local function hello(req)
    return 200, "hello " .. req.path
end
local function serveHello()
    local server = network.tcp.bind("127.0.0.1", 0)
    local _, port = server:getsockname()
    local serving = coroutine.detach(coroutine.create(network.serve), server, hello)
    return server, port, serving
end
local function stop(server, serving)
    coroutine.close(serving)
    server:close()
    print("status " .. coroutine.status(serving))
end
-- A request after the fault, which must succeed. The fault fires once,
-- so when it lands on the first attempt the second one must succeed.
local function fresh(port)
    for attempt = 1, 2 do
        local ok, status, body = catch network.fetch(`http://127.0.0.1:$(port)/fresh`)
        if ok and status == 200 and vector.tostring(body) == "hello /fresh" then
            print("fresh ok")
            return
        end
        report("fresh", ok, ok and `unexpected response $(status)` or status)
    end
end
]]

local SCENARIOS = {
    fetch = [[
local server, port, serving = serveHello()
local ok, status, body = catch network.fetch(`http://localhost:$(port)/first`)
if ok and not (status == 200 and vector.tostring(body) == "hello /first") then
    report("first", false, `unexpected response $(status) $(vector.tostring(body))`)
else
    report("first", ok, status)
end
fresh(port)
stop(server, serving)
]],
    trickle = [[
local server, port, serving = serveHello()
local peer = network.tcp.bind("127.0.0.1", 0)
local _, peer_port = peer:getsockname()
local trickling = coroutine.detach(coroutine.create(function()
    local sock <close> = peer:accept()
    while true do
        local line = sock:receive("*l")
        if line == nil or #line == 0 then break end
    end
    local response = "HTTP/1.1 200 OK\r\nConnection: close\r\n\r\ntrickled body"
    for i = 1, #response do
        if not sock:send(response:sub(i, i)) then break end
        coroutine.yield()
    end
end))
local ok, status, body = catch network.fetch(`http://127.0.0.1:$(peer_port)/slow`)
-- The body ends where the peer closes the connection. A fault on the side
-- of the peer makes it close early, which the client cannot tell from
-- the end of the body, so any start of the body is a response.
local text = ok and vector.tostring(body)
if ok and not (status == 200 and ("trickled body"):sub(1, #text) == text) then
    report("trickle", false, `unexpected response $(status) $(text)`)
else
    report("trickle", ok, status)
end
coroutine.close(trickling)
peer:close()
fresh(port)
stop(server, serving)
]],
    tcp = [[
local server, port, serving = serveHello()
local peer = network.tcp.bind("127.0.0.1", 0)
local _, peer_port = peer:getsockname()
local echoing = coroutine.detach(coroutine.create(function()
    local sock <close> = peer:accept()
    while true do
        local line = sock:receive("*l")
        if line == nil or #line == 0 then break end
        if not sock:send(vector.tostring(line):upper() .. "\n") then break end
    end
end))
local function exchange()
    -- A failed connection returns nil and its error object.
    local sock <close>, cerr = network.tcp.connect("127.0.0.1", peer_port)
    if not sock then error(cerr, 0) end
    sock:settimeout(5)
    for _, word in ipairs({ "one", "two", "three" }) do
        local sent, e = sock:send(word .. "\n")
        if not sent then error(e, 0) end
        local line, e2 = sock:receive("*l")
        if line == nil then error(e2, 0) end
        if #line == 0 then error("the peer ended the connection", 0) end
        assert(vector.tostring(line) == word:upper())
    end
end
local ok, err = catch exchange()
report("tcp", ok, err)
coroutine.close(echoing)
peer:close()
fresh(port)
stop(server, serving)
]],
    tls = [[
local server, port, serving = serveHello()
local peer = network.tcp.bind("127.0.0.1", 0)
local _, peer_port = peer:getsockname()
local plain = coroutine.detach(coroutine.create(function()
    local sock <close> = peer:accept()
    sock:receive(1)
    sock:send("HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n")
end))
local ok, err = catch network.fetch(`https://127.0.0.1:$(peer_port)/secure`)
-- The handshake must fail, since the peer speaks plain HTTP.
if ok then report("tls", false, "the handshake succeeded") else report("tls", false, err) end
coroutine.close(plain)
peer:close()
fresh(port)
stop(server, serving)
]],
    -- The TLS scenarios read the certificates that the harness made with
    -- openssl from the files beside them.
    https = [[
local function slurp(name)
    local f <close> = assert(io.open(name, "rb"))
    return f:read("a")
end
local identity = { cert = slurp("server.pem"), key = slurp("server.key") }
local ca = slurp("ca.pem")
local server, port, serving = serveHello()
local secure = network.tcp.bind("127.0.0.1", 0)
local _, secure_port = secure:getsockname()
local tls_serving = coroutine.detach(coroutine.create(network.serve), secure, hello, { tls = identity, idle_timeout = 5 })
local ok, status, body = catch network.fetch(`https://127.0.0.1:$(secure_port)/secure`, "GET", nil, nil, { tls = { ca = ca }, timeout = 10 })
if ok and not (status == 200 and vector.tostring(body) == "hello /secure") then
    report("https", false, `unexpected response $(status)`)
else
    report("https", ok, status)
end
coroutine.close(tls_serving)
secure:close()
fresh(port)
stop(server, serving)
]],
    tlsclient = [[
local function slurp(name)
    local f <close> = assert(io.open(name, "rb"))
    return f:read("a")
end
local identity = { cert = slurp("server.pem"), key = slurp("server.key") }
local ca = slurp("ca.pem")
local server, port, serving = serveHello()
local secure = network.tcp.bind("127.0.0.1", 0)
local _, secure_port = secure:getsockname()
local tls_serving = coroutine.detach(coroutine.create(network.serve), secure, hello, { tls = identity, idle_timeout = 5 })
-- Two requests on one TLS connection, so faults land after the handshake
-- as well as in it.
local function exchange()
    -- A failed connection or handshake returns nil and an error object.
    local opened, failure = network.tls.connect("127.0.0.1", secure_port, { ca = ca, servername = "localhost", timeout = 10 })
    if opened == nil then error(tostring(failure), 0) end
    local sock <close> = opened
    sock:settimeout(10)
    for _, path in ipairs({ "/one", "/two" }) do
        local sent, e = sock:send(`GET $(path) HTTP/1.1\r\nHost: localhost\r\n\r\n`)
        if not sent then error(e, 0) end
        local length
        while true do
            local line, e2 = sock:receive("*l")
            if line == nil then error(e2, 0) end
            local text = vector.tostring(line)
            if #text == 0 then break end
            length = length or tonumber(text:match("^[Cc]ontent%-[Ll]ength: (%d+)"))
        end
        if length == nil then error("the peer ended the connection", 0) end
        local data, e3 = sock:receive(length)
        if data == nil then error(e3, 0) end
        if vector.tostring(data) ~= "hello " .. path then error("the peer ended the connection", 0) end
    end
end
local ok, err = catch exchange()
report("tlsclient", ok, err)
coroutine.close(tls_serving)
secure:close()
fresh(port)
stop(server, serving)
]],
}

-- Makes a certificate authority and a certificate for localhost that it
-- signs, with openssl, into `where`. Returns false without openssl.
local function makeCerts(where)
    local function sh(cmd)
        local p = io.popen(cmd .. " 2>&1")
        local out = p:read("a")
        local ok = p:close()
        return ok == true or ok == 0, out
    end

    if not sh("openssl version") then
        return false
    end

    local function q(name)
        return "'" .. fs.path.join(where, name) .. "'"
    end

    local f = assert(io.open(fs.path.join(where, "req.cnf"), "w"))
    f:write("[req]\ndistinguished_name = dn\nprompt = no\n[dn]\nCN = test\n")
    f:close()
    f = assert(io.open(fs.path.join(where, "server.ext"), "w"))
    f:write("subjectAltName=DNS:localhost,IP:127.0.0.1\nextendedKeyUsage=serverAuth\n")
    f:close()

    for _, cmd in ipairs({
        "openssl ecparam -name prime256v1 -genkey -noout -out " .. q("ca.key"),
        "openssl req -x509 -new -key "
            .. q("ca.key")
            .. " -subj '/CN=Lus Fault CA' -sha256 -days 2 -config "
            .. q("req.cnf")
            .. " -addext 'basicConstraints=critical,CA:TRUE' -addext 'keyUsage=critical,keyCertSign,cRLSign' -out "
            .. q("ca.pem"),
        "openssl ecparam -name prime256v1 -genkey -noout -out " .. q("server.key"),
        "openssl req -new -key "
            .. q("server.key")
            .. " -subj '/CN=localhost' -config "
            .. q("req.cnf")
            .. " -out "
            .. q("server.csr"),
        "openssl x509 -req -in "
            .. q("server.csr")
            .. " -CA "
            .. q("ca.pem")
            .. " -CAkey "
            .. q("ca.key")
            .. " -CAcreateserial -sha256 -days 2 -extfile "
            .. q("server.ext")
            .. " -out "
            .. q("server.pem"),
    }) do
        local ok, out = sh(cmd)
        assert(ok, out)
    end

    return true
end

local KINDS = { "reset", "eof", "dns", "refuse", "abort", "tls" }
local STEP_OF = {
    reset = "transfers",
    eof = "receives",
    dns = "lookups",
    refuse = "connects",
    abort = "accepts",
    tls = "tlsreceives",
}

local dir = fs.path.join(os.getenv("TMPDIR") or "/tmp", "lus-network-faults")
local _ = catch fs.remove(dir, true)
fs.createdirectory(dir, true)
local names = {}
local scenario_names = { "fetch", "trickle", "tcp", "tls" }

if makeCerts(dir) then
    scenario_names[#scenario_names + 1] = "https"
    scenario_names[#scenario_names + 1] = "tlsclient"
else
    print("openssl is not available, so the scenarios with a TLS server are left out")
end

for _, name in ipairs(scenario_names) do
    local f = assert(io.open(fs.path.join(dir, name .. ".lus"), "w"))
    f:write(PRELUDE, SCENARIOS[name])
    f:close()
    names[#names + 1] = name
end

local function quote(s)
    return "'" .. s:gsub("'", "'\\''") .. "'"
end

local function run(spec, name)
    local cmd = string.format(
        "cd %s && LUS_FAIL_NET=%s perl -e 'alarm %d; exec @ARGV' %s %s.lus 2>&1",
        quote(dir),
        spec,
        opts.timeout,
        quote(fs.path.join(os.getenv("PWD"), opts.lus)),
        name
    )
    local p = assert(io.popen(cmd, "r"))
    local out = p:read("a")
    local _, _, code = p:close()
    return out, code
end

local function listed(msg)
    for _, pat in ipairs(LISTED) do
        if msg:find(pat) then
            return true
        end
    end

    return false
end

-- The problems of one run's output, or nil.
local function check(out, code)
    if code == 142 then
        return "the run did not end within its time limit"
    end

    if code ~= 0 then
        return `the run exited with $(tostring(code)): $out`
    end

    for msg in out:gmatch("error [%w]+: ([^\n]+)") do
        if not listed(msg) then
            return "an error the manual does not list: " .. msg
        end
    end

    if not out:find("fresh ok", 1, true) then
        return "the request after the fault failed: " .. out
    end

    if not out:find("status dead", 1, true) then
        return "the server did not stop: " .. out
    end

    local open = tonumber(out:match("lus: (%d+) sockets open at exit"))

    if open ~= 0 then
        return `$(tostring(open)) sockets open at exit`
    end
end

-- The steps of each kind that a scenario makes, from a run that counts
-- them.
local function countSteps(name)
    local out, code = run("count", name)
    local line = out:match("lus: network steps: ([^\n]+)")
    assert(line, "the scenario did not run: " .. out)
    local counts = {}

    for n, step in line:gmatch("(%d+) (%a+)") do
        counts[step] = tonumber(n)
    end

    return counts, out, code
end

local problems = {}
local summary = {}
local runs = 0

for _, name in ipairs(names) do
    local counts, out, code = countSteps(name)

    if problem = check(out, code) then
        problems[#problems + 1] = `$name without faults: $problem`
    end

    local parts = {}

    for _, kind in ipairs(KINDS) do
        local step = STEP_OF[kind]
        local steps = counts[step] or 0
        parts[#parts + 1] = string.format("%d %s", steps, step)

        for n = 1, steps do
            local o, c = run(n .. ":" .. kind, name)
            runs = runs + 1

            if p = check(o, c) then
                problems[#problems + 1] = string.format("%s, %s %d: %s", name, kind, n, p)
            end
        end
    end

    summary[#summary + 1] = string.format("%-8s %s", name, table.concat(parts, ", "))
end

fs.remove(dir, true)

for _, s in ipairs(summary) do
    print(s)
end

print(string.format("%d runs, %d problems", runs, #problems))

for _, p in ipairs(problems) do
    print("  " .. p)
end

if #problems > 0 then
    os.exit(1)
end

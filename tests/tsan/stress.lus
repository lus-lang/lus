-- Threads at work together, for ThreadSanitizer. Sixteen workers run at
-- once. Each runs detached coroutines that churn through tables, answers
-- the messages of its creator, and sends results of its own, while the
-- creator receives from all of them through the scheduler and makes
-- garbage of its own. A build with `-Dsanitize-thread=true` reports any
-- data race that the run reaches, and the program checks every answer.
--
-- Usage: LUS_JIT=off lus stress.lus [ROUNDS]

global arg, assert, collectgarbage, coroutine, fs, io, ipairs, os, pledge, print, string, table,
    tonumber, worker

pledge("load", "fs")

local ROUNDS = tonumber(arg[1]) or 200
local WORKERS = 16

local body = [[
local rounds = ...
local done = 0
for c = 1, 4 do
    coroutine.detach(coroutine.create(function()
        local keep = {}
        for i = 1, rounds do
            keep[i % 32 + 1] = { i, tostring(i), { c } }
            if i % 16 == 0 then coroutine.yield() end
        end
        done = done + 1
    end))
end
for i = 1, rounds do
    local m = worker.peek()
    worker.message({ n = m.n * 2, text = string.rep("x", m.n % 64), list = { m.n, m.n + 1 } })
end
while done < 4 do coroutine.yield() end
worker.message("finished")
]]

local path = os.tmpname()
local f = assert(io.open(path, "w"))
f:write(body)
f:close()

local workers = {}

for w = 1, WORKERS do
    workers[w] = worker.create(path, ROUNDS)
end

-- The creator answers in coroutines too, so its waits go through the
-- scheduler while it collects.
local checked = 0
local tasks = {}

for w, handle in ipairs(workers) do
    tasks[w] = coroutine.detach(coroutine.create(function()
        for i = 1, ROUNDS do
            worker.send(handle, { n = i })
            local m = worker.receive(handle)
            assert(m.n == i * 2 and #m.text == i % 64 and m.list[2] == i + 1)
            checked = checked + 1
        end

        assert(worker.receive(handle) == "finished")
    end))
end

local junk = {}

for _, t in ipairs(tasks) do
    while coroutine.status(t) ~= "dead" do
        for i = 1, 64 do
            junk[i] = { i }
        end

        collectgarbage("step")
        coroutine.resume(coroutine.detach(coroutine.create(coroutine.yield)))
    end

    assert(coroutine.resume(t))
end

fs.remove(path)
assert(checked == WORKERS * ROUNDS)
print(string.format("%d workers, %d messages each way, all checked", WORKERS, checked))

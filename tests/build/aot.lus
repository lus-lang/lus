-- The entry script of the `lus build --aot` test. The training run
-- optimizes its hot functions, and the executable reports that they have
-- optimized code from the start and computes the same results.

local square = require("lib.square").square

local function fib(n)
    if n < 2 then
        return n
    end
    return fib(n - 1) + fib(n - 2)
end

local Point = {}
Point.__index = Point

function Point.new(x, y)
    return setmetatable({ x = x, y = y }, Point)
end

function Point:length2()
    return square(self.x) + square(self.y)
end

local function sum(t)
    local s = 0
    for i = 1, #t do
        s = s + t[i]
    end
    return s
end

local _, optimized = debug.jit(fib)
print(`fib optimized $optimized`)
local acc = 0
for i = 1, 2000 do
    acc = acc + Point.new(i, i + 1):length2()
end
local t = {}
for i = 1, 1000 do
    t[i] = i
end
print(fib(20), acc, sum(t))
-- A float where the code expects integers leaves it through an exit.
t[500] = 0.5
print(sum(t))

-- Shared parts of the differential runner and the reducer: the
-- configurations of the runtime, running one program under several of
-- them at once in fresh processes, and comparing the results.

global assert, error, fs, io, ipairs, math, os, pairs, string, table, tonumber, tostring

local M = {}

-- Every configuration must print the same trace as the interpreter of the
-- same architecture. The thresholds of 2 and 3 make functions tier up
-- after their first calls, in the middle of the loops that drive them,
-- which the eager modes never do. `stress` names a binary built with
-- `-Dgc-stress` and `-Dgc-verify`, `x64` a binary built for x86-64, which
-- runs its own JIT backend, and `wasm` the WebAssembly build, which runs
-- through `wasm.mjs` in Node. The `fmt` configuration runs the program
-- after `lus fmt`, which must keep its meaning. The `nofold` configuration
-- runs the program with every `flags.` read through the local `__F` and
-- every `<meta>` local made an ordinary local, so the compiler folds no
-- condition on a flag and computes nothing at compile time. Every fold
-- and every compile-time value must agree with evaluation at run time.
M.CONFIGS = {
    { name = "off", env = { LUS_JIT = "off" } },
    { name = "default", env = {} },
    { name = "eager", env = { LUS_JIT = "eager" } },
    { name = "baseline-hot", env = { LUS_JIT = "baseline", LUS_JIT_THRESHOLD = "2" } },
    { name = "opt-eager", env = { LUS_JIT = "opt-eager" } },
    { name = "opt-hot", env = { LUS_JIT_THRESHOLD = "2", LUS_JIT_OPT_THRESHOLD = "3" } },
    { name = "opt-direct", env = { LUS_JIT = "opt-eager", LUS_JIT_DIRECT = "1024" } },
    { name = "fmt", env = { LUS_JIT = "off" }, fmt = true },
    { name = "nofold", env = { LUS_JIT = "off" }, nofold = true },
    { name = "stress-eager", env = { LUS_JIT = "eager" }, binary = "stress" },
    {
        name = "stress-opt",
        env = { LUS_JIT_THRESHOLD = "2", LUS_JIT_OPT_THRESHOLD = "3" },
        binary = "stress",
    },
    { name = "x64-off", env = { LUS_JIT = "off" }, binary = "x64" },
    { name = "x64-eager", env = { LUS_JIT = "eager" }, binary = "x64" },
    { name = "x64-opt-eager", env = { LUS_JIT = "opt-eager" }, binary = "x64" },
    {
        name = "x64-opt-hot",
        env = { LUS_JIT_THRESHOLD = "2", LUS_JIT_OPT_THRESHOLD = "3" },
        binary = "x64",
    },
    { name = "wasm-off", env = { LUS_JIT = "off" }, binary = "wasm" },
    { name = "wasm-on", env = { LUS_JIT = "on" }, binary = "wasm" },
    { name = "wasm-eager", env = { LUS_JIT = "eager" }, binary = "wasm" },
}

function M.config(name)
    for _, c in ipairs(M.CONFIGS) do
        if c.name == name then
            return c
        end
    end

    error("unknown configuration " .. tostring(name), 0)
end

-- The configurations to run: the names given, or every configuration
-- whose binary was given.
function M.select(names, binaries)
    local out = {}

    if names then
        for name in names:gmatch("[^,]+") do
            out[#out + 1] = M.config(name)
        end

        return out
    end

    for _, c in ipairs(M.CONFIGS) do
        if not c.binary or binaries[c.binary] then
            out[#out + 1] = c
        end
    end

    return out
end

M.windows = os.platform() == "windows"

-- Quotes one argument for the system shell: double quotes for the
-- `cmd.exe /s /c` of Windows, whose paths hold no quote, and single quotes
-- for /bin/sh elsewhere.
local function quote(s)
    s = tostring(s)

    if M.windows then
        return '"' .. s .. '"'
    end

    return "'" .. s:gsub("'", [['\'']]) .. "'"
end

M.quote = quote

-- The directory part of a path, with either separator.
function M.dirname(path)
    return path:match("^(.*)[/\\][^/\\]*$") or "."
end

function M.readFile(path)
    local f = io.open(path, "r", { lossy = true })

    if not f then
        return ""
    end

    local s = f:read("a") or ""
    f:close()
    return s
end

function M.writeFile(path, text)
    local f = assert(io.open(path, "w"))
    f:write(text)
    f:close()
end

-- A fresh temporary directory, at a name that os.tmpname reserves.
function M.tempDir()
    local name = os.tmpname()
    fs.remove(name)
    local dir = name .. ".d"
    fs.createdirectory(dir)
    return dir
end

function M.removeDir(dir)
    catch fs.remove(dir, true)
end

local function removeFile(path)
    catch fs.remove(path)
end

local JIT_VARS = { "LUS_JIT", "LUS_JIT_THRESHOLD", "LUS_JIT_OPT_THRESHOLD", "LUS_JIT_DIRECT" }

-- Starts `cmd` through io.popen with exactly the variables of `env` among
-- the JIT variables, and restores those of this process afterwards, so a
-- child sees its configuration on every system.
function M.spawn(cmd, env)
    local saved = {}

    for _, v in ipairs(JIT_VARS) do
        saved[v] = os.getenv(v)
        os.setenv(v, env[v])
    end

    local p = assert(io.popen(cmd))

    for _, v in ipairs(JIT_VARS) do
        os.setenv(v, saved[v])
    end

    return p
end

-- The build flags of every native run. The WebAssembly host takes no
-- flags, and its configurations compare only with each other.
M.FLAGS = "-Fdebug -Flevel=3 -Fratio=1.5 -Fchannel=beta"

-- On POSIX systems perl stops a program at its time limit with SIGALRM.
-- Windows gives a shell command no time limit, so there a program that
-- never ends stops the run at the time limit of its caller, such as the
-- CI job.
local SIGALRM = 14

-- Prepares the program that `config` runs, and returns its path, or nil
-- when the preparation failed with its message in `base`.err.
local function prepare(file, config, binaries, base)
    if config.fmt then
        local target = base .. ".fmt.lus"
        os.execute(
            quote(binaries.lus)
                .. " fmt "
                .. quote(file)
                .. " > "
                .. quote(target)
                .. " 2> "
                .. quote(base .. ".err")
        )
        return target
    elseif config.nofold then
        local target = base .. ".nofold.lus"
        local text = M.readFile(file):gsub("flags%.", "__F.")
        M.writeFile(target, (text:gsub(" <meta>", "")))
        return target
    end

    return file
end

-- The shell command that runs `target` under `config`, with its outputs
-- in `base`.out and `base`.err.
local function command(target, config, binaries, seconds, base)
    local run

    if config.binary == "wasm" then
        seconds = seconds * 2
        run = quote(binaries.node or "node")
            .. " "
            .. quote(binaries.wasmRunner)
            .. " "
            .. config.env.LUS_JIT
            .. " "
            .. quote(target)
            .. " "
            .. quote(binaries.wasm)
    else
        if config.binary == "stress" then
            seconds = seconds * 4
        end

        run = quote(binaries[config.binary or "lus"]) .. " " .. M.FLAGS .. " " .. quote(target)
    end

    if not M.windows then
        run = "exec perl -e 'alarm shift; exec @ARGV' " .. math.floor(seconds) .. " " .. run
    end

    return run .. " > " .. quote(base .. ".out") .. " 2>> " .. quote(base .. ".err")
end

-- Runs `file` under every configuration of `configs` at once, each in a
-- process of its own, and returns one result per configuration. A status
-- of 128 plus N means signal N.
function M.runAll(file, configs, binaries, seconds, dir)
    local procs = {}

    for i, c in ipairs(configs) do
        local base = dir .. "/c" .. i
        removeFile(base .. ".err")
        removeFile(base .. ".out")
        local target = prepare(file, c, binaries, base)
        procs[i] = M.spawn(command(target, c, binaries, seconds, base), c.env)
    end

    local results = {}

    for i, c in ipairs(configs) do
        local base = dir .. "/c" .. i
        local _, how, status = procs[i]:close()
        local code = how == "signal" and 128 + status or (status or -1)
        results[i] = {
            config = c.name,
            binary = c.binary or "lus",
            fmt = c.fmt,
            renamed = c.nofold,
            code = code,
            timeout = code == 128 + SIGALRM,
            stdout = M.readFile(base .. ".out"),
            stderr = M.readFile(base .. ".err"),
        }

        -- Node in a sandbox may warn about the system certificates, which
        -- says nothing about the program.
        if c.binary == "wasm" then
            results[i].stderr = results[i].stderr:gsub(
                "ERROR: failed to copy trust settings[^\n]*\n",
                ""
            )
        end
    end

    return results
end

-- A crash is a signal, an abort, or a panic message, whatever the output.
function M.crashOf(res)
    if res.timeout then
        return "timeout"
    end

    if panic = res.stderr:match("panic: ([^\n]*)") then
        return "panic: " .. panic:gsub("0x%x+", "0x?")
    end

    if res.code >= 128 and res.code < 256 then
        return "signal " .. (res.code - 128)
    end

    if res.code ~= 0 and res.code ~= 1 then
        return "exit " .. res.code
    end

    if res.stderr:find("leaked", 1, true) then
        return "leak"
    end

    return nil
end

local function lines(s)
    local out = {}

    for line in (s .. "\n"):gmatch("([^\n]*)\n") do
        out[#out + 1] = line
    end

    return out
end

-- Positions in messages change with the layout of a formatted program.
local function maskPositions(s)
    return (s:gsub("[^%s\"]*%.lus:%d+:", "@:"))
end

-- A program rewritten line for line keeps its positions but not its name.
local function maskPaths(s)
    return (s:gsub("[^%s\"]*%.lus:(%d+):", "@:%1:"))
end

-- The first line where two results differ, or nil when they agree.
function M.firstDifference(a, b)
    local function whole(r)
        local s = r.stdout .. "\n--stderr--\n" .. r.stderr .. "\n--exit " .. r.code

        if a.fmt or b.fmt then
            s = maskPositions(s)
        elseif a.renamed or b.renamed then
            s = maskPaths(s)
        end

        return s
    end

    local x, y = whole(a), whole(b)

    if x == y then
        return nil
    end

    local xs, ys = lines(x), lines(y)

    for i = 1, math.max(#xs, #ys) do
        if xs[i] ~= ys[i] then
            return { line = i, want = xs[i] or "", got = ys[i] or "" }
        end
    end

    return { line = #xs, want = "", got = "" }
end

local function arch(r)
    if r.binary == "x64" or r.binary == "wasm" then
        return r.binary
    end

    return "native"
end

-- Classifies the results of one program. Every crash is a finding. So is
-- every result that differs from the first result of its architecture.
-- The gc-stress build shares the native reference. Two architectures
-- differ in their math library and in the sign of a NaN, and the
-- WebAssembly host reports errors without a traceback, so they are never
-- compared with each other.
function M.judge(results)
    local all = true

    for _, r in ipairs(results) do
        if not r.timeout then
            all = false
        end
    end

    if all then
        return { { kind = "slow", config = "all", what = "timeout" } }
    end

    local findings = {}

    for _, r in ipairs(results) do
        if c = M.crashOf(r) then
            findings[#findings + 1] = { kind = "crash", config = r.config, what = c }
        end
    end

    local refs = {}

    for _, r in ipairs(results) do
        if not refs[arch(r)] then
            refs[arch(r)] = r
        end
    end

    for _, r in ipairs(results) do
        local ref = refs[arch(r)]

        if r ~= ref and not M.crashOf(ref) and not M.crashOf(r) then
            if d = M.firstDifference(ref, r) then
                findings[#findings + 1] = {
                    kind = "mismatch",
                    config = r.config,
                    ref = ref.config,
                    what = d,
                }
            end
        end
    end

    return findings
end

return M

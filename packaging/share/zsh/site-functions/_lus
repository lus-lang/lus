#compdef lus
# Generated by tools/build-cli.js from spec/tools/cli.json. Do not edit.
# Completion of the lus command line for zsh.

_lus_permissions() {
    compadd -- fs fs:read fs:write fs:exec network network:tcp network:udp network:http network:tls network:server exec env env:read env:write load ffi worker debug
}

_lus_installed() {
    local -a releases
    releases=(${${(f)"$(_call_program releases lus version list 2>/dev/null)"}%% *})
    compadd -a releases
}

_lus_commands() {
    local -a commands
    commands=(
        'run:run a script (default)'
        'test:run the tests of a project'
        'fmt:format source files'
        'check:find errors and likely mistakes without running the code'
        'doc:generate API documentation from doc comments'
        'ast:print the syntax tree of a file as JSON'
        'build:bundle a script and its modules into a standalone executable'
        'compile:compile a script to a binary chunk'
        'debug:run a script under a debugger'
        'help:print the standard library reference for a name'
        'agents:set a project up for coding agents'
        'tree:print the modules a script requires, as a tree'
        'lsp:run the language server on standard input and output'
        'version:install, list, and select releases of Lus'
        'completions:print a shell completion script'
    )
    _describe -t commands command commands
}

_lus_run() {
    _arguments -s -S \
        '*-e[run the string stat as a chunk]:stat: ' \
        '-i[enter interactive mode after the script ends]' \
        '*-l[require the module mod into the global mod, or into g]:mod: ' \
        '*'{-P,--pledge}'[grant a permission to the script]:perm:_lus_permissions' \
        '*'{-F,--flag}'[define a build flag]:name: ' \
        '*--include[compile a module file or directory at startup for require]:path:_files' \
        '--readonly-env[make the globals and the library tables readonly once the script starts]' \
        '--sandbox[seal the permissions after the grants of -P, before any code runs]' \
        '--offline[load remote modules only from the module cache]' \
        '--reload[revalidate every remote module before the run]' \
        '--no-prefetch[download each remote module at its require]' \
        '--gc-pause[heap growth before a collection, in percent]:N: ' \
        '-W[turn warnings on]' \
        '-E[ignore the environment variables of the interpreter]' \
        '--dis[print the bytecode of the script instead of running it]' \
        '(-v --version)'{-v,--version}'[print the version and exit]' \
        '(-h --help)'{-h,--help}'[print the commands and options and exit]' \
        '::script:_files -g "*.lus"' \
        '*:args:_files'
}

_lus_test() {
    _arguments -s -S \
        '--filter[run only the tests whose names contain TEXT]:TEXT: ' \
        '--list[print the tests and benchmarks without running them]' \
        '(-u --update)'{-u,--update}'[rewrite the snapshots that no longer match]' \
        '--bench[measure the benchmarks and compare them with the baseline]' \
        '--bench-time[measure each benchmark for S seconds (default 1)]:S: ' \
        '--coverage[report which lines of the code under test ran]' \
        '--coverage-out[also write the coverage to FILE as an lcov tracefile]:FILE:_files' \
        '--doc[run the lus code blocks of Markdown files and doc comments]' \
        '-v[list the skipped tests of passing files too]' \
        '--json[print one JSON record per test]' \
        '--jobs[run at most N files at once]:N: ' \
        '*'{-P,--pledge}'[grant a permission to every test file]:perm:_lus_permissions' \
        '--timeout[stop a file that writes no output for S seconds (default 60)]:S: ' \
        '--file-timeout[stop a file that runs longer than S seconds in all]:S: ' \
        '(-h --help)'{-h,--help}'[print this help and exit]' \
        '*:path:_files'
}

_lus_fmt() {
    _arguments -s -S \
        '--write[rewrite the files in place]' \
        '--check[list the files that are not formatted and change nothing]' \
        '--strict[write the strict style that lus check --strict checks]' \
        '--indent[spaces per indentation level (default 4)]:N: ' \
        '(-h --help)'{-h,--help}'[print this help and exit]' \
        '*:path:_files'
}

_lus_check() {
    _arguments -s -S \
        '--json[print the diagnostics as one JSON array]' \
        '--strict[also report departures from the strict style]' \
        '--list[print every diagnostic code and exit]' \
        '--fix[apply the rewrites that keep behavior, then report the rest]' \
        '--explain[explain a diagnostic code with an example and exit]:code: ' \
        '(-h --help)'{-h,--help}'[print this help and exit]' \
        '*:path:_files'
}

_lus_doc() {
    _arguments -s -S \
        '-o[write one file per module into DIR]:DIR:_files -/' \
        '--format[the output format (default md)]:md|json|html:(md json html)' \
        '(-h --help)'{-h,--help}'[print this help and exit]' \
        '*:file:_files -g "*.lus"'
}

_lus_ast() {
    _arguments -s -S \
        '--no-comments[omit comments from the tree]' \
        '--no-recover[stop at the first syntax error]' \
        '(-h --help)'{-h,--help}'[print this help and exit]' \
        ':file:_files -g "*.lus"'
}

_lus_build() {
    _arguments -s -S \
        '-o[write the executable to FILE]:FILE:_files' \
        '*'{-P,--pledge}'[grant a permission every time the executable runs]:perm:_lus_permissions' \
        '*'{-F,--flag}'[define a build flag for the bundled code]:name: ' \
        '*--include[bundle a module file or directory]:path:_files' \
        '--aot[compile the program to machine code from a training run]' \
        '--train[the arguments of the training run, separated by spaces]:args: ' \
        '--aot-keep-jit[start the executable from lus, which keeps the JIT]' \
        '--aot-static[compile ahead of time for a system without executable memory]' \
        '--runtime[start the executable from the runtime FILE]:FILE:_files' \
        '--link-object[link the executable from the link object FILE]:FILE:_files' \
        '--link-all[keep every library function of the link object]' \
        '--link-map[write the size of each linked part of the runtime to FILE]:FILE:_files' \
        '(-h --help)'{-h,--help}'[print this help and exit]' \
        ':script:_files -g "*.lus"'
}

_lus_compile() {
    _arguments -s -S \
        '-o[write the chunk to FILE (default: the script with .lusc)]:FILE:_files' \
        '(-s --strip)'{-s,--strip}'[omit debug information]' \
        '*'{-F,--flag}'[define a build flag, fixed in the chunk]:name: ' \
        '*'{-P,--pledge}'[grant a permission to the initializers of <meta> variables]:perm:_lus_permissions' \
        '(-h --help)'{-h,--help}'[print this help and exit]' \
        ':script:_files -g "*.lus"'
}

_lus_debug() {
    _arguments -s -S \
        '--stdio[speak the Debug Adapter Protocol on standard input and output (default)]' \
        '--port[accept one client on 127.0.0.1:N]:N: ' \
        '*'{-P,--pledge}'[grant a permission to the program]:perm:_lus_permissions' \
        '(-h --help)'{-h,--help}'[print this help and exit]' \
        '::script:_files -g "*.lus"' \
        '*:args:_files'
}

_lus_help() {
    _arguments -s -S \
        '(-s --search)'{-s,--search}'[list the entries whose name or description contains text]:text: ' \
        '(-h --help)'{-h,--help}'[print this help and exit]' \
        '::name: '
}

_lus_agents() {
    local curcontext="$curcontext" state line ret=1
    _arguments -C -s -S \
        '(-h --help)'{-h,--help}'[print this help and exit]' \
        '1: :->sub' \
        '*:: :->args' && ret=0
    case $state in
        sub)
            local -a subs
            subs=('init:write the Lus skills and an AGENTS.md section into a project')
            _describe -t commands command subs && ret=0
            ;;
        args)
            case $words[1] in
                init)
                    _arguments -s -S '(-h --help)'{-h,--help}'[print this help and exit]' '::dir:_files -/' && ret=0
                    ;;
            esac
            ;;
    esac
    return ret
}

_lus_tree() {
    _arguments -s -S \
        '--json[print the tree as JSON]' \
        '(-h --help)'{-h,--help}'[print this help and exit]' \
        ':file:_files -g "*.lus"'
}

_lus_lsp() {
    _arguments -s -S \
        '--version[print the version of the server and exit]'
}

_lus_version() {
    local curcontext="$curcontext" state line ret=1
    _arguments -C -s -S \
        '--json[print one JSON object per command]' \
        '(-h --help)'{-h,--help}'[print this help and exit]' \
        '1: :->sub' \
        '*:: :->args' && ret=0
    case $state in
        sub)
            local -a subs
            subs=('list:list the installed releases' 'install:download, verify, and install a release' 'use:make an installed release the default' 'remove:delete an installed release' 'which:print the path of an installed release')
            _describe -t commands command subs && ret=0
            ;;
        args)
            case $words[1] in
                list)
                    _arguments -s -S '--json[print one JSON object per command]' '(-h --help)'{-h,--help}'[print this help and exit]' '--remote[list the published releases of a channel]::channel:(stable unstable)' && ret=0
                    ;;
                install)
                    _arguments -s -S '--json[print one JSON object per command]' '(-h --help)'{-h,--help}'[print this help and exit]' ':request:(stable unstable)' && ret=0
                    ;;
                use)
                    _arguments -s -S '--json[print one JSON object per command]' '(-h --help)'{-h,--help}'[print this help and exit]' ':request:_lus_installed' && ret=0
                    ;;
                remove)
                    _arguments -s -S '--json[print one JSON object per command]' '(-h --help)'{-h,--help}'[print this help and exit]' ':version:_lus_installed' && ret=0
                    ;;
                which)
                    _arguments -s -S '--json[print one JSON object per command]' '(-h --help)'{-h,--help}'[print this help and exit]' '::request:_lus_installed' && ret=0
                    ;;
            esac
            ;;
    esac
    return ret
}

_lus_completions() {
    _arguments -s -S \
        '(-h --help)'{-h,--help}'[print this help and exit]' \
        ':shell:(bash zsh fish powershell)'
}

_lus() {
    local curcontext="$curcontext" state line ret=1
    _arguments -C -s -S \
        '*-e[run the string stat as a chunk]:stat: ' \
        '-i[enter interactive mode after the script ends]' \
        '*-l[require the module mod into the global mod, or into g]:mod: ' \
        '*'{-P,--pledge}'[grant a permission to the script]:perm:_lus_permissions' \
        '*'{-F,--flag}'[define a build flag]:name: ' \
        '*--include[compile a module file or directory at startup for require]:path:_files' \
        '--readonly-env[make the globals and the library tables readonly once the script starts]' \
        '--sandbox[seal the permissions after the grants of -P, before any code runs]' \
        '--offline[load remote modules only from the module cache]' \
        '--reload[revalidate every remote module before the run]' \
        '--no-prefetch[download each remote module at its require]' \
        '--gc-pause[heap growth before a collection, in percent]:N: ' \
        '-W[turn warnings on]' \
        '-E[ignore the environment variables of the interpreter]' \
        '--dis[print the bytecode of the script instead of running it]' \
        '(-v --version)'{-v,--version}'[print the version and exit]' \
        '(-h --help)'{-h,--help}'[print the commands and options and exit]' \
        '1: :->first' \
        '*:: :->rest' && ret=0
    case $state in
        first)
            _alternative 'commands:command:_lus_commands' 'scripts:script:_files -g "*.lus"' && ret=0
            ;;
        rest)
            case $words[1] in
                run) _lus_run && ret=0 ;;
                test) _lus_test && ret=0 ;;
                fmt) _lus_fmt && ret=0 ;;
                check) _lus_check && ret=0 ;;
                doc) _lus_doc && ret=0 ;;
                ast) _lus_ast && ret=0 ;;
                build) _lus_build && ret=0 ;;
                compile) _lus_compile && ret=0 ;;
                debug) _lus_debug && ret=0 ;;
                help) _lus_help && ret=0 ;;
                agents) _lus_agents && ret=0 ;;
                tree) _lus_tree && ret=0 ;;
                lsp) _lus_lsp && ret=0 ;;
                version) _lus_version && ret=0 ;;
                completions) _lus_completions && ret=0 ;;
                *) _files && ret=0 ;;
            esac
            ;;
    esac
    return ret
}

if [ "$funcstack[1]" = "_lus" ]; then
    _lus "$@"
else
    compdef _lus lus
fi

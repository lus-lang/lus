# Completion of the lus command line for fish.

# The command of the command line: its first argument when that names a
# command, otherwise run.
function __lus_command
    set -l tokens (commandline -opc)
    if set -q tokens[2]; and contains -- $tokens[2] run test fmt check doc ast build compile debug help agents tree lsp version completions
        echo $tokens[2]
    else
        echo run
    end
end

function __lus_using
    test (__lus_command) = $argv[1]
end

# True when the command is $argv[1] and its subcommand is $argv[2].
function __lus_sub
    set -l tokens (commandline -opc)
    __lus_using $argv[1]; or return 1
    set -q tokens[3]; or return 1
    test $tokens[3] = $argv[2]
end

# True when the command is $argv[1] and the command line names none of
# its subcommands $argv[2..] yet.
function __lus_no_sub
    set -l tokens (commandline -opc)
    __lus_using $argv[1]; or return 1
    set -q tokens[3]; or return 0
    not contains -- $tokens[3] $argv[2..]
end

function __lus_installed
    lus version list 2>/dev/null | string replace -r ' .*' ''
end


